{#
 Template: templates/composant/__header/_locale_switcher.html.twig
 Role: Sélecteur de langue du header (FR / EN). La langue active est sélectionnée ;
       choisir l'autre enregistre le choix (cookie) et ouvre la même page traduite.
#}

{% set currentLocale = app.request.locale starts with 'fr' ? 'fr' : 'en' %}
{% set localeLabels = {fr: 'Français (FR)', en: 'English (EN)'} %}

<div class="topbar-locale">
    <label class="visually-hidden" for="{{ switcherId }}">{{ currentLocale == 'fr' ? 'Langue du site' : 'Site language' }}</label>
    <select
        id="{{ switcherId }}"
        class="topbar-locale__select"
        data-controller="locale-switcher"
        data-action="change->locale-switcher#go"
    >
        {# Langue active en premier, puis l'alternative. #}
        {% for locale in currentLocale == 'fr' ? ['fr', 'en'] : ['en', 'fr'] %}
            <option
                value="{{ locale_switch_url(locale) }}"
                lang="{{ locale }}"
                {{ locale == currentLocale ? 'selected' }}
            >{{ localeLabels[locale] }}</option>
        {% endfor %}
    </select>
    <span class="topbar-locale__code" aria-hidden="true">{{ currentLocale|upper }}</span>
    <i class="icon-chevron-down topbar-locale__chevron" aria-hidden="true"></i>
</div>

<style>
    .topbar-locale {
        position: relative;
        display: inline-flex;
        align-items: center;
    }

    /* Le select natif (accessible clavier / lecteur d'écran) recouvre le libellé court "FR ▼". */
    .topbar-locale__select {
        position: absolute;
        inset: 0;
        width: 100%;
        opacity: 0;
        cursor: pointer;
    }

    .topbar-locale__code {
        padding: 6px 28px 6px 12px;
        border: 1px solid #ebecec;
        border-radius: 8px;
        background: #fff;
        color: #0b0f14;
        font-weight: 600;
        line-height: 1.5;
    }

    .topbar-locale__chevron {
        position: absolute;
        right: 8px;
        color: #0b0f14;
        font-size: 16px;
        pointer-events: none;
    }

    .topbar-locale__select:focus-visible + .topbar-locale__code {
        outline: 2px solid #0b0f14;
        outline-offset: 2px;
    }
</style>
