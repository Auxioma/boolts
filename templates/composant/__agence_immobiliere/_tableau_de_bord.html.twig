{#
 Template: templates/composant/__agence_immobiliere/_tableau_de_bord.html.twig
 Role: Renders the composant/__agence_immobiliere Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

{% set agency_restricted_dashboard_enabled = is_granted(constant('App\\Security\\Voter\\AgencyDocumentVoter::ACCESS_RESTRICTED_DASHBOARD')) %}

<!-- Sidebar 1 -->
<aside class="col-3 col-lg-2 pt-48 pb-32 px-12 aside-dashboard-navbar d-none d-md-block">
    <div class="h-100">

        <div class="px-10 py-10 color-active">
            <a href="{{ path('agence_immobiliere_dashboard') }}"
               class="menu-dashboard-title {{ app.request.attributes.get('_canonical_route', app.request.attributes.get('_route')) == 'agence_immobiliere_dashboard' ? 'active' : '' }}">
                <span>
                    <i class="icon-layout-dashboard mr-10"></i>
                    {{ 'agency_dashboard.sidebar.dashboard'|trans }}
                </span>
            </a>
        </div>

        <div class="mt-16">
            <p class="mb-0">{{ 'agency_dashboard.sidebar.activity'|trans }}</p>
        </div>

        <div class="px-10 py-10 mt-22 color-active">
            <a href="{{ path('agence_immobiliere_mes_biens_list') }}"
               class="menu-dashboard-title {{ app.request.attributes.get('_canonical_route', app.request.attributes.get('_route')) starts with 'agence_immobiliere_mes_biens' ? 'active' : '' }}">
                <span>
                    <i class="icon-building-2 mr-10"></i>
                    {{ 'agency_dashboard.sidebar.listings'|trans }}
                </span>
            </a>
        </div>

        {# Les notifications restent toujours accessibles, même si les documents
           de l'agence ne sont pas encore déposés ou validés : c'est là que
           l'agence lit l'issue de la revue de ses documents. #}
        <div class="px-10 py-10 mt-8 color-active">
            <a href="{{ path('agence_immobiliere_notifications') }}"
               class="menu-dashboard-title {{ app.request.attributes.get('_canonical_route', app.request.attributes.get('_route')) == 'agence_immobiliere_notifications' ? 'active' : '' }}">
                <span>
                    <i class="icon-bell mr-10"></i>
                    {{ 'agency_dashboard.notifications'|trans }}
                </span>
            </a>
        </div>

        <div class="px-10 py-10 mt-8 color-active">
            <a {% if agency_restricted_dashboard_enabled %}href="{{ path('agence_immobiliere_messagerie') }}"{% else %}aria-disabled="true" tabindex="-1"{% endif %}
               class="menu-dashboard-title {{ app.request.attributes.get('_canonical_route', app.request.attributes.get('_route')) == 'agence_immobiliere_messagerie' ? 'active' : '' }} {{ agency_restricted_dashboard_enabled ? '' : 'menu-dashboard-title--disabled' }}">
                <span>
                    <i class="icon-message-circle-more mr-10"></i>
                    {{ 'agency_dashboard.sidebar.messaging'|trans }}
                </span>
            </a>
        </div>

        <div class="mt-16">
            <p class="mb-0">{{ 'agency_dashboard.sidebar.account'|trans }}</p>
        </div>

        <div class="px-10 py-10 mt-22 color-active">
            <a {% if agency_restricted_dashboard_enabled %}href="{{ path('agence_immobiliere_options') }}"{% else %}aria-disabled="true" tabindex="-1"{% endif %}
               class="menu-dashboard-title {{ app.request.attributes.get('_canonical_route', app.request.attributes.get('_route')) == 'agence_immobiliere_options' ? 'active' : '' }} {{ agency_restricted_dashboard_enabled ? '' : 'menu-dashboard-title--disabled' }}">
                <span>
                    <i class="icon-credit-card mr-10"></i>
                    {{ 'agency_dashboard.sidebar.options'|trans }}
                </span>
            </a>
        </div>

        <div class="px-10 py-10 mt-8 color-active">
            <a {% if agency_restricted_dashboard_enabled %}href="{{ path('agence_immobiliere_mes_factures') }}"{% else %}aria-disabled="true" tabindex="-1"{% endif %}
               class="menu-dashboard-title {{ app.request.attributes.get('_canonical_route', app.request.attributes.get('_route')) == 'agence_immobiliere_mes_factures' ? 'active' : '' }} {{ agency_restricted_dashboard_enabled ? '' : 'menu-dashboard-title--disabled' }}">
                <span>
                    <i class="icon-receipt mr-10"></i>
                    {{ 'agency_dashboard.sidebar.invoices'|trans }}
                </span>
            </a>
        </div>

        <div class="px-10 py-10 mt-8 color-active">
            <a href="{{ path('agence_immobiliere_parametres') }}"
               class="menu-dashboard-title {{ app.request.attributes.get('_canonical_route', app.request.attributes.get('_route')) == 'agence_immobiliere_parametres' ? 'active' : '' }}">
                <span>
                    <i class="icon-settings mr-10"></i>
                    {{ 'agency_dashboard.sidebar.settings'|trans }}
                </span>
            </a>
        </div>

        <div class="mt-16">
            <p class="mb-0">{{ 'agency_dashboard.sidebar.more_options'|trans }}</p>
        </div>

        <div class="px-10 py-10 mt-22 color-active">
            <a href="{{ path('agence_immobiliere_aide') }}"
               class="menu-dashboard-title {{ app.request.attributes.get('_canonical_route', app.request.attributes.get('_route')) == 'agence_immobiliere_aide' ? 'active' : '' }}">
                <span>
                    <i class="icon-circle-help mr-10"></i>
                    {{ 'agency_dashboard.sidebar.help'|trans }}
                </span>
            </a>
        </div>

        <div class="mt-8 px-10 py-10 mt-8 deconnection">
            <a href="{{ path('app_logout') }}" class="menu-dashboard-title">
                <span>
                    <i class="icon-log-out mr-10"></i>
                    {{ 'agency_dashboard.sidebar.logout'|trans }}
                </span>
            </a>
        </div>

    </div>
</aside>

{# Barre de navigation fixe en bas de l'écran (mobile, < 768px) — Figma « SideBar - Dashboard » 3678:16444 #}
{% set current_route = app.request.attributes.get('_canonical_route', app.request.attributes.get('_route')) %}
{% set more_routes = ['agence_immobiliere_notifications', 'agence_immobiliere_options', 'agence_immobiliere_mes_factures', 'agence_immobiliere_aide'] %}
<div class="d-md-none" data-controller="dashboard-bottom-bar">
{# Menu Paramètres : s'ouvre entre la topbar et la barre du bas, sans les recouvrir #}
<div class="dashboard-settings-menu" id="dashboard-settings-menu" data-dashboard-bottom-bar-target="panel" hidden>
    <h2 class="dashboard-settings-menu__title">{{ 'agency_dashboard.sidebar.settings'|trans }}</h2>

    {{ include('dashboard/agence_immobiliere/_partials/parametres/_menu_parametres_data.html.twig', {variant: 'mobile'}) }}
</div>

<nav class="dashboard-bottom-bar" aria-label="Navigation du dashboard">
    <a href="{{ path('agence_immobiliere_dashboard') }}"
       class="dashboard-bottom-bar__item {{ current_route == 'agence_immobiliere_dashboard' ? 'active' : '' }}">
        <i class="icon-layout-dashboard"></i>
        <span>{{ 'agency_dashboard.sidebar.dashboard'|trans }}</span>
    </a>

    <a href="{{ path('agence_immobiliere_mes_biens_list') }}"
       class="dashboard-bottom-bar__item {{ current_route starts with 'agence_immobiliere_mes_biens' ? 'active' : '' }}">
        <i class="icon-building-2"></i>
        <span>{{ 'agency_dashboard.sidebar.listings'|trans }}</span>
    </a>

    <a {% if agency_restricted_dashboard_enabled %}href="{{ path('agence_immobiliere_messagerie') }}"{% else %}aria-disabled="true" tabindex="-1"{% endif %}
       class="dashboard-bottom-bar__item {{ current_route == 'agence_immobiliere_messagerie' ? 'active' : '' }} {{ agency_restricted_dashboard_enabled ? '' : 'is-disabled' }}">
        <i class="icon-message-circle-more"></i>
        <span>{{ 'agency_dashboard.sidebar.messaging'|trans }}</span>
    </a>

    <button type="button"
            class="dashboard-bottom-bar__item {{ current_route == 'agence_immobiliere_parametres' ? 'active' : '' }}"
            aria-controls="dashboard-settings-menu"
            aria-expanded="false"
            data-dashboard-bottom-bar-target="settingsButton"
            data-action="dashboard-bottom-bar#toggle">
        <i class="icon-settings"></i>
        <span>{{ 'agency_dashboard.sidebar.settings'|trans }}</span>
    </button>

    {# « Plus » : regroupe les autres entrées de la sidebar desktop #}
    <div class="dropup">
        <button type="button"
                class="dashboard-bottom-bar__item dashboard-bottom-bar__more {{ current_route in more_routes ? 'active' : '' }}"
                data-bs-toggle="dropdown"
                aria-expanded="false">
            <i class="icon-grid-2x2"></i>
            <span>Plus</span>
        </button>

        <ul class="dropdown-menu dropdown-menu-end dashboard-bottom-bar__menu">
            <li>
                <a class="dropdown-item {{ current_route == 'agence_immobiliere_notifications' ? 'active' : '' }}" href="{{ path('agence_immobiliere_notifications') }}">
                    <i class="icon-bell mr-10"></i>{{ 'agency_dashboard.notifications'|trans }}
                </a>
            </li>
            <li>
                <a class="dropdown-item {{ current_route == 'agence_immobiliere_options' ? 'active' : '' }} {{ agency_restricted_dashboard_enabled ? '' : 'disabled' }}"
                   {% if agency_restricted_dashboard_enabled %}href="{{ path('agence_immobiliere_options') }}"{% else %}aria-disabled="true" tabindex="-1"{% endif %}>
                    <i class="icon-credit-card mr-10"></i>{{ 'agency_dashboard.sidebar.options'|trans }}
                </a>
            </li>
            <li>
                <a class="dropdown-item {{ current_route == 'agence_immobiliere_mes_factures' ? 'active' : '' }} {{ agency_restricted_dashboard_enabled ? '' : 'disabled' }}"
                   {% if agency_restricted_dashboard_enabled %}href="{{ path('agence_immobiliere_mes_factures') }}"{% else %}aria-disabled="true" tabindex="-1"{% endif %}>
                    <i class="icon-receipt mr-10"></i>{{ 'agency_dashboard.sidebar.invoices'|trans }}
                </a>
            </li>
            <li>
                <a class="dropdown-item {{ current_route == 'agence_immobiliere_aide' ? 'active' : '' }}" href="{{ path('agence_immobiliere_aide') }}">
                    <i class="icon-circle-help mr-10"></i>{{ 'agency_dashboard.sidebar.help'|trans }}
                </a>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
                <a class="dropdown-item" href="{{ path('app_logout') }}">
                    <i class="icon-log-out mr-10"></i>{{ 'agency_dashboard.sidebar.logout'|trans }}
                </a>
            </li>
        </ul>
    </div>
</nav>
</div>
