{#
 Template: templates/composant/__agence_immobiliere/_tableau_de_bord.html.twig
 Role: Renders the composant/__agence_immobiliere Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}


<!-- Sidebar 1 -->
<aside class="col-3 col-lg-2 pt-48 pb-32 px-12 aside-dashboard-navbar d-none d-md-block">
    <div class="h-100">

        <div class="mt-16"> 
            <p class="mb-0">{{ 'agency_dashboard.sidebar.activity'|trans }}</p>
        </div>

        <div class="px-10 py-10 mt-22 color-active">
            <a href="{{ path('app_dashboard_visiteur_favoris_bien') }}"
               class="menu-dashboard-title p-accent  {{ app.request.attributes.get('_canonical_route', app.request.attributes.get('_route')) starts with 'agence_immobiliere_mes_biens' ? 'active' : '' }}">
                <span>
                    <i class="icon-building-2 mr-10"></i>
                    Favoris
                </span>
            </a>
        </div>

        <div class="px-10 py-10 mt-8 color-active">
            <a href="{{ path('app_dashboard_visiteur_notifications') }}"
               class="menu-dashboard-title p-accent  {{ app.request.attributes.get('_canonical_route', app.request.attributes.get('_route')) == 'agence_immobiliere_notifications' ? 'active' : '' }}">
                <span>
                    <i class="icon-bell mr-10"></i>
                    {{ 'agency_dashboard.notifications'|trans }}
                </span>
            </a>
        </div>

        <div class="px-10 py-10 mt-8 color-active">
            <a href="{{ path('app_dashboard_visiteur_messagerie') }}"
               class="menu-dashboard-title p-accent  {{ app.request.attributes.get('_canonical_route', app.request.attributes.get('_route')) == 'agence_immobiliere_messagerie' ? 'active' : '' }}">
                <span>
                    <i class="icon-message-circle-more mr-10"></i>
                    {{ 'agency_dashboard.sidebar.messaging'|trans }}
                </span>
            </a>
        </div>

        <div class="mt-16">
            <p class="mb-0">{{ 'agency_dashboard.sidebar.account'|trans }}</p>
        </div>

        <div class="px-10 py-10 mt-22 color-active">
            <a href="{{ path('app_dashboard_visiteur_parametres') }}"
               class="menu-dashboard-title p-accent  {{ app.request.attributes.get('_canonical_route', app.request.attributes.get('_route')) == 'agence_immobiliere_parametres' ? 'active' : '' }}">
                <span>
                    <i class="icon-settings mr-10"></i>
                    {{ 'agency_dashboard.sidebar.settings'|trans }}
                </span>
            </a>
        </div>

        <div class="mt-16">
            <p class="mb-0">{{ 'agency_dashboard.sidebar.more_options'|trans }}</p>
        </div>

        <div class="px-10 py-10 mt-22 color-active">
            <a href="{{ path('app_dashboard_visiteur_aides') }}"  
               class="menu-dashboard-title p-accent  {{ app.request.attributes.get('_canonical_route', app.request.attributes.get('_route')) == 'agence_immobiliere_aide' ? 'active' : '' }}">
                <span>
                    <i class="icon-circle-help mr-10"></i>
                    {{ 'agency_dashboard.sidebar.help'|trans }}
                </span>
            </a>
        </div>

        <div class="mt-8 px-10 py-10 mt-8 deconnection">
            <a href="{{ path('app_logout') }}" class="menu-dashboard-title p-accent ">
                <span>
                    <i class="icon-log-out mr-10"></i>
                    {{ 'agency_dashboard.sidebar.logout'|trans }}
                </span>
            </a>
        </div>

    </div>
</aside>

{# Barre de navigation fixe en bas de l'écran (mobile, < 768px) — Figma « SideBar - Dashboard » 6934:17418 #}
{% set current_route = app.request.attributes.get('_canonical_route', app.request.attributes.get('_route')) %}
{% set more_routes = ['agence_immobiliere_notifications', 'agence_immobiliere_aide'] %}
<div class="d-md-none" data-controller="dashboard-bottom-bar" data-action="dashboard-settings-menu:open@window->dashboard-bottom-bar#open dashboard-more-menu:open@window->dashboard-bottom-bar#openMore">
{# Menu Paramètres : s'ouvre entre la topbar et la barre du bas, sans les recouvrir #}
<div class="dashboard-settings-menu" id="dashboard-settings-menu" data-dashboard-bottom-bar-target="panel" hidden>
    <h2 class="dashboard-settings-menu__title">{{ 'agency_dashboard.sidebar.settings'|trans }}</h2>

    {{ include('dashboard/agence_immobiliere/_partials/parametres/_menu_parametres_data.html.twig', {variant: 'mobile'}) }}
</div>

{# Menu Plus — Figma « Plus » 6934:17398 #}
<div class="dashboard-settings-menu dashboard-more-menu" id="dashboard-more-menu" data-dashboard-bottom-bar-target="morePanel" hidden>
    <h2 class="dashboard-settings-menu__title">Plus</h2>

    <div class="dashboard-more-menu__sections">
        <div class="dashboard-settings-menu__section">
            <p class="dashboard-settings-menu__section-title">Mon activité</p>

            <div class="dashboard-settings-menu__items">
                <a href="{{ path('agence_immobiliere_notifications') }}"
                   class="dashboard-settings-menu__item {{ current_route == 'agence_immobiliere_notifications' ? 'active' : '' }}">
                    <span class="dashboard-settings-menu__item-label p-accent">
                        <i class="icon-bell"></i>
                        Notifications
                    </span>
                    <i class="icon-chevron-right"></i>
                </a>
            </div>
        </div>

        <div class="dashboard-settings-menu__section">
            <p class="dashboard-settings-menu__section-title">Options supplémentaires</p>

            <div class="dashboard-settings-menu__items">
                <a href="{{ path('agence_immobiliere_aide') }}"
                   class="dashboard-settings-menu__item dashboard-more-menu__item--plain {{ current_route == 'agence_immobiliere_aide' ? 'active' : '' }}">
                    <span class="dashboard-settings-menu__item-label p-accent">
                        <i class="icon-circle-help"></i>
                        Aide
                    </span>
                </a>

                <a href="{{ path('app_logout') }}" class="dashboard-settings-menu__item dashboard-more-menu__logout">
                    <span class="dashboard-settings-menu__item-label p-accent">
                        <i class="icon-log-out"></i>
                        Déconnexion
                    </span>
                </a>
            </div>
        </div>
    </div>
</div>

<nav class="dashboard-bottom-bar" aria-label="Navigation du dashboard">
    <a href="{{ path('agence_immobiliere_mes_biens_list') }}"
       class="dashboard-bottom-bar__item {{ current_route starts with 'agence_immobiliere_mes_biens' ? 'active' : '' }}">
        <i class="icon-building-2"></i>
        <span>Favoris</span>
    </a>

    <a href="{{ path('agence_immobiliere_messagerie') }}"
       class="dashboard-bottom-bar__item {{ current_route == 'agence_immobiliere_messagerie' ? 'active' : '' }}">
        <i class="icon-message-circle-more"></i>
        <span>{{ 'agency_dashboard.sidebar.messaging'|trans }}</span>
    </a>

    <button type="button"
            class="dashboard-bottom-bar__item {{ current_route == 'agence_immobiliere_parametres' ? 'active' : '' }}"
            aria-controls="dashboard-settings-menu"
            aria-expanded="false"
            data-dashboard-bottom-bar-target="settingsButton"
            data-action="dashboard-bottom-bar#toggle">
        <i class="icon-settings"></i>
        <span>{{ 'agency_dashboard.sidebar.settings'|trans }}</span>
    </button>

    {# « Plus » : ouvre le menu Plus, affiché comme une page entre la topbar et la barre du bas #}
    <button type="button"
            class="dashboard-bottom-bar__item {{ current_route in more_routes ? 'active' : '' }}"
            aria-controls="dashboard-more-menu"
            aria-expanded="false"
            data-dashboard-bottom-bar-target="moreButton"
            data-action="dashboard-bottom-bar#toggleMore">
        <i class="icon-grid-2x2"></i>
        <span>Plus</span>
    </button>
</nav>
</div>
