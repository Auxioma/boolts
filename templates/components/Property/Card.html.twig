{# templates/components/Property/Card.html.twig #}

{%- props
    title = 'Appartement à louer',
    price = '765€',
    period = '/mois',
    badge = 'Charges comprises',
    description = 'Appartement très spacieux et lumineu...',
    details = '2 pièces · 1 chambre · 50m2',
    address = 'Rue de Courteneueve, 76510 Saint Ni...',
    image = null,
    url = '#',
    favoriteUrl = null,
    favoriteToken = null,
    isFavorite = false
-%}

{% set imagePath = image %}

{% if image is not empty %}
    {% set imagePath = image|replace({
        '/images/bien/': '',
        'images/bien/': '',
        '/bien/': '',
        'bien/': '',
        'public/bien/': ''
    }) %}
{% endif %}


<a href="{{ url }}" class="property-card-link">
<twig:Card class="property-card">
    <div class="property-card__media">
        {% if image %}
            <picture class="property-card__picture">
                {# Mobile - WebP #}
                <source
                    media="(max-width: 575px)"
                    srcset="{{ imagePath|imagine_filter('property_card_mobile_webp') }}"
                    type="image/webp"
                >

                {# Mobile - PNG fallback #}
                <source
                    media="(max-width: 575px)"
                    srcset="{{ imagePath|imagine_filter('property_card_mobile_png') }}"
                    type="image/png"
                >

                {# Tablette - WebP #}
                <source
                    media="(min-width: 576px) and (max-width: 991px)"
                    srcset="{{ imagePath|imagine_filter('property_card_tablet_webp') }}"
                    type="image/webp"
                >

                {# Tablette - PNG fallback #}
                <source
                    media="(min-width: 576px) and (max-width: 991px)"
                    srcset="{{ imagePath|imagine_filter('property_card_tablet_png') }}"
                    type="image/png"
                >

                {# Desktop - WebP #}
                <source
                    media="(min-width: 992px)"
                    srcset="{{ imagePath|imagine_filter('property_card_desktop_webp') }}"
                    type="image/webp"
                >

                {# Desktop - PNG fallback #}
                <source
                    media="(min-width: 992px)"
                    srcset="{{ imagePath|imagine_filter('property_card_desktop_png') }}"
                    type="image/png"
                >

                <img
                    src="{{ imagePath|imagine_filter('property_card_desktop_png') }}"
                    alt="{{ title }}"
                    class="property-card__image"
                    loading="lazy"
                    decoding="async"
                >
            </picture>
        {% endif %}
    </div>

    <twig:Card:Header class="property-card__header border-0 bg-white">
        <div class="property-card__header-content">
            <twig:Card:Title as="h3" class="property-card__title mb-0">
                {{ title }}
            </twig:Card:Title>
        </div>

        {% if not is_granted('ROLE_AGENCE') %}
            <button
                type="button"
                class="property-card__favorite {{ isFavorite ? 'is-active' : '' }}"
                aria-label="{{ isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris' }}"
                aria-pressed="{{ isFavorite ? 'true' : 'false' }}"
                data-controller="favorite"
                data-action="click->favorite#toggle"
                data-favorite-url-value="{{ favoriteUrl }}"
                data-favorite-token-value="{{ favoriteToken }}"
            >
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <path d="M2 9.50004C2.00002 8.38724 2.33759 7.30062 2.96813 6.3837C3.59867 5.46678 4.49252 4.7627 5.53161 4.36444C6.5707 3.96618 7.70616 3.89248 8.78801 4.15308C9.86987 4.41368 10.8472 4.99632 11.591 5.82404C11.6434 5.88005 11.7067 5.92471 11.7771 5.95524C11.8474 5.98577 11.9233 6.00152 12 6.00152C12.0767 6.00152 12.1526 5.98577 12.2229 5.95524C12.2933 5.92471 12.3566 5.88005 12.409 5.82404C13.1504 4.99094 14.128 4.40341 15.2116 4.13964C16.2952 3.87588 17.4335 3.94839 18.4749 4.34752C19.5163 4.74666 20.4114 5.45349 21.0411 6.37394C21.6708 7.29439 22.0053 8.3848 22 9.50004C22 11.79 20.5 13.5 19 15L13.508 20.313C13.3217 20.527 13.0919 20.699 12.834 20.8173C12.5762 20.9357 12.296 20.9979 12.0123 20.9997C11.7285 21.0015 11.4476 20.9429 11.1883 20.8278C10.9289 20.7127 10.697 20.5437 10.508 20.332L5 15C3.5 13.5 2 11.8 2 9.50004Z" stroke="#858789" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
        {% endif %}
    </twig:Card:Header>

    <twig:Card:Content class="property-card__content">
        <div class="property-card__price-row">
            <p class="property-card__price">
                {{ price }} <span>{{ period }}</span>
            </p>

            <span class="property-card__badge">
                {{ badge }}
            </span>
        </div>

        <twig:Card:Description class="property-card__description">
            {{ description }}
        </twig:Card:Description>

        <p class="property-card__details">
            {{ details }}
        </p>
    </twig:Card:Content>

    <twig:Card:Footer class="property-card__footer border-0 bg-white">
        {{ address }}
    </twig:Card:Footer>
</twig:Card>
</a>
