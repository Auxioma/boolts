{# templates/components/Property/Card.html.twig #}

{%- props
    title = 'Appartement à louer',
    price = '765€',
    period = '/mois',
    badge = 'Charges comprises',
    description = 'Appartement très spacieux et lumineu...',
    details = '2 pièces · 1 chambre · 50m2',
    address = 'Rue de Courteneueve, 76510 Saint Ni...',
    image = null,
    favoriteUrl = null
-%}

<twig:Card class="property-card">
    <div class="property-card__media">
        {% if image %}
            <img
                src="{{ image }}"
                alt="{{ title }}"
                class="property-card__image"
            >
        {% endif %}
    </div>

    <twig:Card:Header class="property-card__header border-0 bg-white">
        <div class="property-card__header-content">
            <twig:Card:Title as="h3" class="property-card__title mb-0">
                {{ title }}
            </twig:Card:Title>
        </div>

        {% if favoriteUrl %}
            <twig:Button
                as="a"
                href="{{ favoriteUrl }}"
                variant="ghost"
                size="icon"
                class="property-card__favorite"
                aria-label="Ajouter aux favoris"
            >
                <svg
                    width="28"
                    height="28"
                    viewBox="0 0 24 24"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                >
                    <path
                        d="M20.84 4.61C20.3292 4.099 19.7228 3.69365 19.0554 3.41708C18.3879 3.14052 17.6725 2.99817 16.95 2.99817C16.2275 2.99817 15.5121 3.14052 14.8446 3.41708C14.1772 3.69365 13.5708 4.099 13.06 4.61L12 5.67L10.94 4.61C9.9083 3.57831 8.50903 2.99871 7.05 2.99871C5.59096 2.99871 4.19169 3.57831 3.16 4.61C2.1283 5.64169 1.54871 7.04097 1.54871 8.5C1.54871 9.95903 2.1283 11.3583 3.16 12.39L12 21.23L20.84 12.39C21.351 11.8792 21.7563 11.2728 22.0329 10.6054C22.3095 9.93789 22.4518 9.22249 22.4518 8.5C22.4518 7.77751 22.3095 7.06211 22.0329 6.39464C21.7563 5.72718 21.351 5.12075 20.84 4.61Z"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    />
                </svg>
            </twig:Button>
        {% else %}
            <twig:Button
                type="button"
                variant="ghost"
                size="icon"
                class="property-card__favorite"
                aria-label="Ajouter aux favoris"
            >
                <svg
                    width="28"
                    height="28"
                    viewBox="0 0 24 24"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                >
                    <path
                        d="M20.84 4.61C20.3292 4.099 19.7228 3.69365 19.0554 3.41708C18.3879 3.14052 17.6725 2.99817 16.95 2.99817C16.2275 2.99817 15.5121 3.14052 14.8446 3.41708C14.1772 3.69365 13.5708 4.099 13.06 4.61L12 5.67L10.94 4.61C9.9083 3.57831 8.50903 2.99871 7.05 2.99871C5.59096 2.99871 4.19169 3.57831 3.16 4.61C2.1283 5.64169 1.54871 7.04097 1.54871 8.5C1.54871 9.95903 2.1283 11.3583 3.16 12.39L12 21.23L20.84 12.39C21.351 11.8792 21.7563 11.2728 22.0329 10.6054C22.3095 9.93789 22.4518 9.22249 22.4518 8.5C22.4518 7.77751 22.3095 7.06211 22.0329 6.39464C21.7563 5.72718 21.351 5.12075 20.84 4.61Z"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    />
                </svg>
            </twig:Button>
        {% endif %}
    </twig:Card:Header>

    <twig:Card:Content class="property-card__content">
        <div class="property-card__price-row">
            <p class="property-card__price">
                {{ price }} <span>{{ period }}</span>
            </p>

            <span class="property-card__badge">
                {{ badge }}
            </span>
        </div>

        <twig:Card:Description class="property-card__description">
            {{ description }}
        </twig:Card:Description>

        <p class="property-card__details">
            {{ details }}
        </p>
    </twig:Card:Content>

    <twig:Card:Footer class="property-card__footer border-0 bg-white">
        {{ address }}
    </twig:Card:Footer>
</twig:Card>
