{#
 Template: templates/admin/property/import.html.twig
 Role: Page d'import CSV des biens immobiliers (back-office EasyAdmin).
       Étape 1 : téléversement ; étape 2 : mappage colonnes du fichier => champs attendus (FR/EN) ; puis rapport.
 Context: Rendue par App\Controller\Admin\PropertyCrudController::importCsv().
#}
{% extends '@EasyAdmin/layout.html.twig' %}

{% block content_title %}Importer des biens immobiliers (CSV){% endblock %}

{% block main %}
    <div class="row">
        <div class="col-12 {{ mapping is not null ? 'col-xxl-10' : 'col-xl-8' }}">

            <div class="mb-3">
                <a href="{{ back_to_index_url }}" class="btn btn-link ps-0">
                    <i class="fa fa-arrow-left"></i> Retour à la liste des biens
                </a>
            </div>

            {% if report is not null %}
                <div class="card mb-4">
                    <div class="card-header">Résultat de l’import</div>
                    <div class="card-body">
                        <p class="{{ report.created > 0 ? 'text-success' : 'text-body-secondary' }} fw-bold mb-3">
                            {{ report.summaryLine }}
                        </p>

                        {% if report.errors is not empty %}
                            <h3 class="h6 text-danger">Erreurs ({{ report.errors|length }})</h3>
                            <ul class="small text-danger">
                                {% for error in report.errors %}
                                    <li>{{ error }}</li>
                                {% endfor %}
                            </ul>
                        {% endif %}

                        {% if report.warnings is not empty %}
                            <h3 class="h6 text-warning-emphasis">Avertissements ({{ report.warnings|length }})</h3>
                            <ul class="small text-warning-emphasis">
                                {% for warning in report.warnings %}
                                    <li>{{ warning }}</li>
                                {% endfor %}
                            </ul>
                        {% endif %}

                        {% if report.created > 0 %}
                            <a href="{{ back_to_index_url }}" class="btn btn-primary mt-2">
                                Voir les {{ report.created }} bien(s) importé(s)
                            </a>
                        {% endif %}
                    </div>
                </div>
            {% endif %}

            {% if mapping is not null %}
                <div class="card mb-4">
                    <div class="card-header d-flex flex-wrap justify-content-between gap-2">
                        <span>Étape 2 — Associer les colonnes <span class="text-body-secondary">/ Map columns</span></span>
                        <span class="text-body-secondary small font-monospace">{{ mapping.file_name }}</span>
                    </div>
                    <div class="card-body">
                        <p class="small text-body-secondary">
                            Pour chaque colonne de votre fichier, choisissez le champ Boolts correspondant
                            (ou « Ignorer »). Les associations ont été proposées automatiquement à partir des
                            en-têtes, en français ou en anglais : vérifiez-les avant de lancer l’import.
                            Les champs marqués <strong>*</strong> sont obligatoires.
                            <br>
                            <em>For each column of your file, pick the matching Boolts field (or “Ignore”).
                            Suggestions are based on French or English headers — please review them.</em>
                        </p>

                        {% if mapping.errors is not empty %}
                            <div class="alert alert-danger small">
                                <ul class="mb-0">
                                    {% for error in mapping.errors %}
                                        <li>{{ error }}</li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endif %}

                        <div id="csv-mapping-duplicates" class="alert alert-warning small d-none">
                            Un même champ est associé à plusieurs colonnes. <em>The same field is mapped to several columns.</em>
                        </div>

                        <form method="post" action="{{ import_url }}" id="csv-mapping-form">
                            <input type="hidden" name="_token" value="{{ csrf_token('property_csv_import') }}">
                            <input type="hidden" name="step" value="import">
                            <input type="hidden" name="token" value="{{ mapping.token }}">
                            <input type="hidden" name="file_name" value="{{ mapping.file_name }}">

                            <div class="table-responsive">
                                <table class="table table-sm align-middle">
                                    <thead>
                                        <tr>
                                            <th style="width: 25%">Colonne du fichier <span class="fw-normal text-body-secondary">/ File column</span></th>
                                            <th>Aperçu <span class="fw-normal text-body-secondary">/ Preview</span></th>
                                            <th style="width: 35%">Champ Boolts <span class="fw-normal text-body-secondary">/ Boolts field</span></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for column in mapping.columns %}
                                            <tr>
                                                <td class="font-monospace small">
                                                    {{ column.header is not empty ? column.header : '(colonne ' ~ (column.index + 1) ~ ' sans en-tête)' }}
                                                </td>
                                                <td class="small text-body-secondary">
                                                    {% for sample in column.samples %}
                                                        <div class="text-truncate" style="max-width: 28rem" title="{{ sample }}">{{ sample }}</div>
                                                    {% else %}
                                                        <em>—</em>
                                                    {% endfor %}
                                                </td>
                                                <td>
                                                    <select name="mapping[{{ column.index }}]"
                                                            class="form-select form-select-sm csv-mapping-select {{ column.field is null ? 'text-body-secondary' }}">
                                                        <option value="">— Ignorer cette colonne / Ignore —</option>
                                                        {% for group in field_groups %}
                                                            <optgroup label="{{ group.label_fr }} / {{ group.label_en }}">
                                                                {% for field in group.fields %}
                                                                    <option value="{{ field.key }}" {{ column.field == field.key ? 'selected' }}>
                                                                        {{ field.label_fr }} · {{ field.label_en }}{{ field.required ? ' *' }}
                                                                    </option>
                                                                {% endfor %}
                                                            </optgroup>
                                                        {% endfor %}
                                                    </select>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>

                            <button type="submit" class="btn btn-primary">
                                <i class="fa fa-file-import"></i> Lancer l’import <span class="opacity-75">/ Import</span>
                            </button>
                            <a href="{{ import_url }}" class="btn btn-outline-secondary">
                                Changer de fichier <span class="opacity-75">/ Change file</span>
                            </a>
                        </form>
                    </div>
                </div>

                <script>
                    (() => {
                        const selects = document.querySelectorAll('.csv-mapping-select');
                        const warning = document.getElementById('csv-mapping-duplicates');

                        const refresh = () => {
                            const counts = {};
                            selects.forEach((select) => {
                                if (select.value) {
                                    counts[select.value] = (counts[select.value] || 0) + 1;
                                }
                            });

                            let hasDuplicate = false;
                            selects.forEach((select) => {
                                const duplicate = select.value !== '' && counts[select.value] > 1;
                                hasDuplicate ||= duplicate;
                                select.classList.toggle('is-invalid', duplicate);
                                select.classList.toggle('text-body-secondary', select.value === '');
                            });

                            warning.classList.toggle('d-none', !hasDuplicate);
                        };

                        selects.forEach((select) => select.addEventListener('change', refresh));
                        refresh();
                    })();
                </script>
            {% else %}
                <div class="card mb-4">
                    <div class="card-header">Étape 1 — Fichier à importer <span class="text-body-secondary">/ File to import</span></div>
                    <div class="card-body">
                        <form method="post" action="{{ import_url }}" enctype="multipart/form-data">
                            <input type="hidden" name="_token" value="{{ csrf_token('property_csv_import') }}">
                            <input type="hidden" name="step" value="upload">

                            <div class="mb-3">
                                <label for="csv_file" class="form-label">Fichier CSV</label>
                                <input type="file" id="csv_file" name="csv_file" accept=".csv,text/csv" class="form-control" required>
                                <div class="form-text">
                                    Séparateur <code>;</code> ou <code>,</code> — encodage UTF-8 — première ligne = en-têtes.
                                    Les en-têtes peuvent être libres (français ou anglais) : vous les associerez aux champs
                                    attendus à l’étape suivante.
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary">
                                <i class="fa fa-arrow-right"></i> Continuer vers le mappage
                            </button>
                            <a href="{{ template_url }}" class="btn btn-outline-secondary">
                                <i class="fa fa-download"></i> Télécharger le modèle CSV
                            </a>
                        </form>
                    </div>
                </div>
            {% endif %}

            <div class="card">
                <div class="card-header">Règles d’import</div>
                <div class="card-body small">
                    <ul>
                        <li>Le CSV ne contient <strong>aucun ID</strong>. Chaque ligne crée un nouveau bien.</li>
                        <li>
                            <strong>Mappage</strong> : après téléversement, chaque colonne du fichier est associée à un
                            champ attendu. Les en-têtes reconnus (ex. <code>Price</code>, <code>Prix de vente</code>,
                            <code>Bedrooms</code>, <code>Titre (anglais)</code>, <code>title_en</code>) sont pré-associés ;
                            les colonnes non associées sont ignorées.
                        </li>
                        <li>
                            Le modèle téléchargé contient <strong>10 biens d’exemple</strong> réels, directement
                            importables (créés en <code>brouillon</code>, rattachés à la première agence existante) :
                            remplacez-les par vos données ou importez-les tels quels pour tester.
                            Toute ligne commençant par <code>#</code> est ignorée.
                        </li>
                        <li>
                            <strong>Utilisateur</strong> : champ <code>agence_email</code> uniquement.
                            L’utilisateur doit exister avec cette adresse e-mail et avoir le rôle agence.
                        </li>
                        <li>
                            <strong>Type de bien / transaction / caractéristiques / statut</strong> : renseignés
                            par libellé ou slug, dans n’importe quelle langue. La valeur est rapprochée des
                            données existantes (insensible à la casse et aux accents). Une valeur inconnue pour le
                            type de bien ou la transaction fait échouer la ligne ; une caractéristique inconnue est
                            ignorée avec un avertissement.
                        </li>
                        <li>
                            <strong>Statut</strong> : valeur du champ <code>statut</code>
                            (ex. <code>brouillon</code>, <code>publiee</code>, <code>pending</code>…) ;
                            <code>brouillon</code> par défaut si la colonne est vide.
                        </li>
                        <li>
                            <strong>Multilingue</strong> : champs traduisibles par langue
                            (<code>titre_fr</code>, <code>titre_en</code>…). Si une langue manque pour un champ,
                            la valeur de la langue renseignée est utilisée par défaut.
                        </li>
                        <li>
                            <strong>Caractéristiques</strong> et <strong>images</strong> : plusieurs valeurs
                            séparées par <code>|</code>. Les images sont téléchargées depuis leur URL
                            (jusqu’à 20 par bien). Les collections d’historique <code>favoris</code> et
                            <code>propertyViews</code> ne sont pas importées.
                        </li>
                        <li>Montants : point ou virgule décimale acceptés. Dates : <code>AAAA-MM-JJ</code> ou <code>JJ/MM/AAAA</code>.</li>
                    </ul>

                    <details>
                        <summary class="fw-bold mb-2">Champs attendus / Expected fields</summary>
                        <div class="table-responsive">
                            <table class="table table-sm small mb-0">
                                <thead>
                                    <tr>
                                        <th>Colonne du modèle</th>
                                        <th>Français</th>
                                        <th>English</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for group in field_groups %}
                                        <tr class="table-light">
                                            <th colspan="3">{{ group.label_fr }} / {{ group.label_en }}</th>
                                        </tr>
                                        {% for field in group.fields %}
                                            <tr>
                                                <td class="font-monospace">{{ field.key }}{{ field.required ? ' *' }}</td>
                                                <td>{{ field.label_fr }}</td>
                                                <td>{{ field.label_en }}</td>
                                            </tr>
                                        {% endfor %}
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </details>
                </div>
            </div>

        </div>
    </div>
{% endblock %}
