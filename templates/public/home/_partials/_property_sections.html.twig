{#
 Template: templates/public/home/_partials/_property_sections.html.twig
 Role: Renders the public/home/_partials Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

            <section class="home-bt-listings">
                <div class="container-xl home-bt-container">
                    <div class="home-bt-search-header">
                        <h2 class="home-bt-search-title">
                            Explorez toutes les propriétés
                        </h2>

                        <div class="home-bt-main-tabs">
                            <button
                                type="button"
                                class="home-bt-main-tab active"
                                data-tab-button="location"
                            >
                                En location
                            </button>

                            <button
                                type="button"
                                class="home-bt-main-tab"
                                data-tab-button="vente"
                            >
                                En vente
                            </button>
                        </div>
                    </div>

                    {#
                    featured: true  -> section "À la Une" : bandeau lavande pleine largeur
                                       sur desktop, slider classique sur tablette/mobile.
                    highlight       -> partie du titre affichée en violet.
                    #}

                    {% set panels = [
                        {
                            key: 'location',
                            active: true,
                            sections: [
                            {
                                title: 'Logements à la',
                                highlight: 'Une',
                                featured: true,
                                emptyText: '',
                                items: aLaUneLocation|default([]),
                            },
                            {
                                title: 'Logements populaires à louer',
                                emptyText: 'Aucun logement populaire en location pour le moment.',
                                items: logementPopulaireLocation|default([]),
                            },
                            {
                                title: 'Logements récemment ajoutés à louer',
                                emptyText: 'Aucun logement récemment ajouté en location pour le moment.',
                                items: logementAjouterRecementLocation|default([]),
                            },
                        ],
                        },
                        {
                            key: 'vente',
                            active: false,
                            sections: [
                            {
                                title: 'Biens à la',
                                highlight: 'Une',
                                featured: true,
                                emptyText: '',
                                items: aLaUneVente|default([]),
                            },
                            {
                                title: 'Biens populaires à acheter',
                                emptyText: 'Aucun bien populaire à acheter pour le moment.',
                                items: logementPopulaireVente|default([]),
                            },
                            {
                                title: 'Biens récemment ajoutés à acheter',
                                emptyText: 'Aucun bien récemment ajouté à acheter pour le moment.',
                                items: logementAjouterRecementVente|default([]),
                            },
                        ],
                        },
                    ] %}

                    {% for panel in panels %}
                        <div
                            class="home-bt-tab-panel{{ panel.active ? ' active' : '' }}"
                            data-tab-panel="{{ panel.key }}"
                        >
                            {% for section in panel.sections %}
                                {% set isFeatured = section.featured|default(false) %}

                                {# La section "À la Une" est masquée si elle est vide #}
                                {% if not isFeatured or section.items|length > 0 %}
                                    <section
                                        class="agence-properties bt-related{{ isFeatured ? ' home-bt-une' : '' }}"
                                        data-controller="splide"
                                    >
                                        <div class="bt-related-head d-flex align-items-end justify-content-between gap-3">
                                            <h2 class="bt-section-title">
                                                {% if isFeatured %}
                                                    <span class="home-bt-flame" aria-hidden="true"></span>
                                                {% endif %}

                                                <span class="bt-section-title-text">
                                                    {{ section.title }}
                                                        {% if section.highlight is defined %}
                                                            <span class="bt-section-title-accent">
                                                            {{ section.highlight }}
                                                        </span>
                                                    {% endif %}
                                                </span>

                                                <i class="icon-chevron-right" aria-hidden="true"></i>
                                            </h2>

                                            {% if section.items|length > 0 %}
                                                <div class="d-flex align-items-center gap-2">
                                                    <button
                                                        class="bt-icon-btn bt-icon-btn--small bt-icon-btn--prev"
                                                        type="button"
                                                        aria-label="Précédent"
                                                        data-splide-target="previous"
                                                        data-action="click->splide#previous"
                                                    >
                                                        <i class="icon-circle-arrow-left"></i>
                                                    </button>

                                                    <button
                                                        class="bt-icon-btn bt-icon-btn--small"
                                                        type="button"
                                                        aria-label="Suivant"
                                                        data-splide-target="next"
                                                        data-action="click->splide#next"
                                                    >
                                                        <i class="icon-circle-arrow-right"></i>
                                                    </button>
                                                </div>
                                            {% endif %}
                                        </div>

                                        {% if section.items|length > 0 %}
                                            <div
                                                class="splide bt-related-slider"
                                                data-splide-target="slider"
                                                aria-label="{{ section.title }}"
                                            >
                                                <div class="splide__track">
                                                    <ul class="splide__list">
                                                        {% for bienImmobilier in section.items %}

                                                            {% set uploadedImage = null %}
                                                            {% set firstImage = bienImmobilier.propertyImages|first %}

                                                            {% if firstImage %}
                                                                {% set uploadedImage = vich_uploader_asset(firstImage, 'imageFile') %}
                                                            {% endif %}

                                                            {% set typeBienName = '' %}
                                                            {% set transactionName = '' %}
                                                            {% set transactionSlug = '' %}

                                                            {% if bienImmobilier.typeBien %}
                                                                {% set typeBienName = bienImmobilier.typeBien.name|default(bienImmobilier.typeBien.nom|default('')) %}
                                                            {% endif %}

                                                            {% if bienImmobilier.typeTransaction %}
                                                                {% set transactionName = bienImmobilier.typeTransaction.name|default(bienImmobilier.typeTransaction.nom|default('')) %}
                                                                {% set transactionSlug = bienImmobilier.typeTransaction.slug|default('') %}
                                                            {% endif %}

                                                            {% set isLocation = panel.key == 'location' %}

                                                            {% set transactionLabel = transactionName is not empty
                                                                ? transactionName|lower
                                                                : ''
                                                            %}

                                                            {% if typeBienName is not empty and transactionLabel is not empty %}
                                                                {% set propertyTitle = typeBienName ~ ' à ' ~ transactionLabel %}
                                                            {% elseif typeBienName is not empty %}
                                                                {% set propertyTitle = typeBienName %}
                                                            {% else %}
                                                                {% set propertyTitle = transactionLabel is not empty
                                                                    ? 'Bien à ' ~ transactionLabel
                                                                    : 'Bien immobilier'
                                                                %}
                                                            {% endif %}

                                                            {#
                                                            Prix :
                                                            - Vente    => prix seul
                                                            - Location => prix + charges
                                                            #}
                                                            {% set deviseSigne = bienImmobilier.user.devise.signe|default('€') %}

                                                            {# Vente : prix #}
                                                            {% set prixVente = bienImmobilier.prix|default('0')|replace({
                                                                ' ': '',
                                                                ',': '.',
                                                            }) + 0 %}

                                                            {# Location : loyer hors charges + charges #}
                                                            {% set loyerHorsCharge = bienImmobilier.montantLoyerHorsCharge|default('0')|replace({
                                                                ' ': '',
                                                                ',': '.',
                                                            }) + 0 %}

                                                            {% set montantCharges = bienImmobilier.montantDesCharges|default('0')|replace({
                                                                ' ': '',
                                                                ',': '.',
                                                            }) + 0 %}

                                                            {% set prixTotal = isLocation
                                                                ? loyerHorsCharge + montantCharges
                                                                : prixVente
                                                            %}

                                                            {% set propertyPrice = prixTotal > 0
                                                                ? prixTotal|number_format(0, ',', ' ') ~ ' ' ~ deviseSigne
                                                                : ''
                                                            %}

                                                            {% set propertyPeriod = isLocation ? '/mois' : '' %}
                                                            {% set propertyBadge = isLocation and montantCharges > 0 ? 'Charges comprises' : '' %}

                                                            {% set details = [] %}

                                                            {% if bienImmobilier.chambres is not empty %}
                                                                {% set details = details|merge([
                                                                    bienImmobilier.chambres ~ ' chambre' ~ (bienImmobilier.chambres > 1 ? 's' : ''),
                                                                ]) %}
                                                            {% endif %}

                                                            {% if bienImmobilier.salleDeBains is not empty and bienImmobilier.salleDeBains != '0' %}
                                                                {% set details = details|merge([
                                                                    bienImmobilier.salleDeBains ~ ' salle' ~ (bienImmobilier.salleDeBains > 1 ? 's' : '') ~ ' de bains',
                                                                ]) %}
                                                            {% endif %}

                                                            {% if bienImmobilier.surfaceTotal is not empty %}
                                                                {% set details = details|merge([
                                                                    bienImmobilier.surfaceTotal ~ 'm²',
                                                                ]) %}
                                                            {% endif %}

                                                            {% set addressParts = [] %}

                                                            {% if bienImmobilier.showAdresse|default(false) %}
                                                                {% if bienImmobilier.neighborhood is not empty %}
                                                                    {% set addressParts = addressParts|merge([bienImmobilier.neighborhood]) %}
                                                                {% endif %}

                                                                {% if bienImmobilier.codePostal is not empty or bienImmobilier.ville is not empty %}
                                                                    {% set addressParts = addressParts|merge([
                                                                        (bienImmobilier.codePostal ~ ' ' ~ bienImmobilier.ville)|trim,
                                                                    ]) %}
                                                                {% endif %}
                                                            {% endif %}

                                                            {% set propertyAddress = addressParts|join(', ') %}

                                                            {% set detailUrl = path('app_public_detail_bien', {
                                                                slug: bienImmobilier.slug,
                                                            }) %}

                                                            <li class="splide__slide">
                                                                <twig:Property:Card
                                                                    title="{{ propertyTitle }}"
                                                                    price="{{ propertyPrice }}"
                                                                    period="{{ propertyPeriod }}"
                                                                    badge="{{ propertyBadge }}"
                                                                    description="{{ bienImmobilier.descriptionLogement|default('')|striptags|u.truncate(80, '...') }}"
                                                                    details="{{ details|join(' ⸱ ') }}"
                                                                    address="{{ propertyAddress }}"
                                                                    image="{{ uploadedImage }}"
                                                                    url="{{ detailUrl }}"
                                                                    favoriteUrl="{{ path('app_favoris_property_toggle', {id: bienImmobilier.id}) }}"
                                                                    favoriteToken="{{ csrf_token('favorite_property_' ~ bienImmobilier.id) }}"
                                                                    :isFavorite="bienImmobilier.id in favoritePropertyIds|default([])"
                                                                />
                                                            </li>
                                                        {% endfor %}
                                                    </ul>
                                                </div>
                                            </div>
                                        {% else %}
                                            <p class="text-muted mb-0">
                                                {{ section.emptyText }}
                                            </p>
                                        {% endif %}
                                    </section>
                                {% endif %}
                            {% endfor %}
                        </div>
                    {% endfor %}
