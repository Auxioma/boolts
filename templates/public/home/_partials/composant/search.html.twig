{#
 Template: templates/public/home/_partials/composant/search.html.twig
 Role: Renders the public/home/_partials/composant Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

{# =========================
   TRANSACTION ACTIVE
   ========================= #}

{% set currentTransactionId = null %}

{% if form.transactionType.vars.value is defined and form.transactionType.vars.value is not empty %}
    {% set currentTransactionId = form.transactionType.vars.value %}
{% elseif form.vars.value.transactionType is defined and form.vars.value.transactionType %}
    {% set currentTransactionId = form.vars.value.transactionType.id %}
{% elseif transactions is defined and transactions|length > 0 %}
    {% set firstTransaction = transactions|first %}
    {% set currentTransactionId = firstTransaction.id %}
{% endif %}

<div class="home-bt-search-hero">

    <ul
        class="nav nav-tabs home-bt-search-tabs"
        role="tablist"
        aria-label="{{ 'search.tabs.label'|trans }}"
        style="--home-bt-tabs-count: 3;"
    >
{% for transaction in transactions %}
    <li class="nav-item" role="presentation">
        <button
            type="button"
            class="nav-link home-bt-search-tab {{ currentTransactionId ~ '' == transaction.id ~ '' ? 'active' : '' }}"
            data-home-bt-transaction-id="{{ transaction.id }}"
            data-home-bt-transaction-name="{{ transaction.name }}"
            data-home-bt-transaction-icone="{{ transaction.icone }}"
            role="tab"
            aria-selected="{{ currentTransactionId ~ '' == transaction.id ~ '' ? 'true' : 'false' }}"
        >
            {% if transaction.icone %}
                <i class="{{ transaction.icone }}" aria-hidden="true"></i>
            {% else %}
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M3 10.5L12 3l9 7.5"></path>
                    <path d="M5 10v10h14V10"></path>
                    <path d="M9 20v-6h6v6"></path>
                </svg>
            {% endif %}

            <span>{{ transaction.name }}</span>
        </button>
    </li>
{% endfor %}

{# Onglet statique #}
<li class="nav-item" role="presentation">
    <button
        type="button"
        class="nav-link home-bt-search-tab"
        data-home-bt-transaction-id="vendre"
        data-home-bt-transaction-name="Vendre"
        data-home-bt-transaction-icone="icon-pencil-line"
        role="tab"
        aria-selected="false"
    >
        <i class="icon-pencil-line" aria-hidden="true"></i>
        <span>Vendre</span>
    </button>
</li>
    </ul>

    {{ form_start(form, {
        attr: {
            class: 'home-bt-search-bar',
            'data-controller': 'home-bt-mapbox-search',
            'data-home-bt-mapbox-search-token-value': mapbox_public_token,
            'data-home-bt-mapbox-search-language-value': app.request.locale|default('fr'),
        },
    }) }}

        {#
            EntityType caché.

            Le select reçoit l'id.
            Symfony transforme ensuite automatiquement cet id
            en objet CategoryBienTransaction.
        #}
        {{ form_widget(form.transactionType, {
            attr: {
                class: 'd-none',
                'data-home-bt-transaction-input': '',
            },
        }) }}

        <div class="home-bt-search-bar__field">
            {{ form_widget(form.filter, {
                attr: {
                    autocomplete: 'off',
                    placeholder: 'search.location.placeholder'|trans,
                    'data-home-bt-mapbox-search-target': 'input',
                    'data-action': 'input->home-bt-mapbox-search#search focus->home-bt-mapbox-search#search keydown->home-bt-mapbox-search#handleKeydown',
                },
            }) }}

            <button type="submit" aria-label="{{ 'search.submit'|trans }}">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle cx="11" cy="11" r="7"></circle>
                    <path d="M20 20l-3.5-3.5"></path>
                </svg>
            </button>

            <ul
                class="home-bt-search-bar__results"
                data-home-bt-mapbox-search-target="results"
            ></ul>
        </div>

        {# =========================
           CHAMPS CACHÉS MAPBOX
           ========================= #}

        {{ form_widget(form.selectedValue, {
            attr: {
                'data-home-bt-mapbox-search-target': 'selectedValue',
            },
        }) }}

        {{ form_widget(form.selectedMapboxId, {
            attr: {
                'data-home-bt-mapbox-search-target': 'selectedMapboxId',
            },
        }) }}

        {{ form_widget(form.selectedFeatureType, {
            attr: {
                'data-home-bt-mapbox-search-target': 'selectedFeatureType',
            },
        }) }}

        {{ form_widget(form.selectedCountryName, {
            attr: {
                'data-home-bt-mapbox-search-target': 'selectedCountryName',
            },
        }) }}

        {{ form_widget(form.selectedCountryCode, {
            attr: {
                'data-home-bt-mapbox-search-target': 'selectedCountryCode',
            },
        }) }}

        {{ form_widget(form.selectedRegionName, {
            attr: {
                'data-home-bt-mapbox-search-target': 'selectedRegionName',
            },
        }) }}

        {{ form_widget(form.selectedCityName, {
            attr: {
                'data-home-bt-mapbox-search-target': 'selectedCityName',
            },
        }) }}

        {{ form_widget(form.selectedPostalCode, {
            attr: {
                'data-home-bt-mapbox-search-target': 'selectedPostalCode',
            },
        }) }}

        {{ form_widget(form.selectedLatitude, {
            attr: {
                'data-home-bt-mapbox-search-target': 'selectedLatitude',
            },
        }) }}

        {{ form_widget(form.selectedLongitude, {
            attr: {
                'data-home-bt-mapbox-search-target': 'selectedLongitude',
            },
        }) }}

        {{ form_widget(form.selectedFullAddress, {
            attr: {
                'data-home-bt-mapbox-search-target': 'selectedFullAddress',
            },
        }) }}

        {{ form_widget(form.selectedLocale, {
            value: app.request.locale|default('fr'),
            attr: {
                'data-home-bt-mapbox-search-target': 'selectedLocale',
            },
        }) }}

        {{ form_widget(form.selectedLocationJson, {
            attr: {
                'data-home-bt-mapbox-search-target': 'selectedLocationJson',
            },
        }) }}

    {{ form_end(form, {render_rest: false}) }}

</div>

<script>
(() => {
    const bindHomeBtSearchTabs = () => {
        const searchHeroes = document.querySelectorAll('.home-bt-search-hero');

        searchHeroes.forEach(function (hero) {
            if (hero.dataset.searchTabsBound === 'true') {
                return;
            }

            const tabs = hero.querySelectorAll('.home-bt-search-tab');
            const transactionInput = hero.querySelector('[data-home-bt-transaction-input]');

            if (!tabs.length || !transactionInput) {
                return;
            }

            hero.dataset.searchTabsBound = 'true';

            tabs.forEach(function (tab) {
                tab.addEventListener('click', function () {
                    tabs.forEach(function (item) {
                        item.classList.remove('active');
                        item.setAttribute('aria-selected', 'false');
                    });

                    tab.classList.add('active');
                    tab.setAttribute('aria-selected', 'true');

                    /*
                     * EntityType :
                     * On met l'id de CategoryBienTransaction dans le select caché.
                     * Symfony convertira cet id en vraie entité.
                     */
                    transactionInput.value = tab.dataset.homeBtTransactionId || '';

                    transactionInput.dispatchEvent(new Event('change', {
                        bubbles: true,
                    }));
                });
            });
        });
    };

    document.addEventListener('DOMContentLoaded', bindHomeBtSearchTabs);
    document.addEventListener('turbo:load', bindHomeBtSearchTabs);
})();
</script>
