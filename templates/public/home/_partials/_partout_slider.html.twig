{#
 Template: templates/public/home/_partials/_partout_slider.html.twig
 Role: Slider éditorial « Achetez. Louez. Partout. » de la page d'accueil.
 Context: Inclus par templates/public/home/index.html.twig.
 Maintenance: Les cartes sont des compositions fixes (maquette Figma 6634:20037) ;
              les positions internes sont en px sur la taille desktop et mises à
              l'échelle par `zoom` dans home.css.
#}

{% macro more_button() %}
    <a href="#" class="home-bt-partout-btn">
        <span>{{ 'home.partout.more'|trans }}</span>
        <img src="{{ asset('images/home/partout/chevron-right.svg') }}" width="24" height="24" alt="" aria-hidden="true">
    </a>
{% endmacro %}

{% import _self as partout %}

<section class="home-bt-partout" data-controller="home--partout-slider">
    <h2 class="home-bt-partout-title">{{ 'home.partout.title'|trans }}</h2>

    <div class="home-bt-partout-rows">
        {# ===== Rangée du haut : grandes cartes ===== #}
        <div class="splide home-bt-partout-row" data-home--partout-slider-target="top" aria-label="{{ 'home.partout.title'|trans }}">
            <div class="splide__track">
                <ul class="splide__list">

                    {# Crush immobilier #}
                    <li class="splide__slide">
                        <article class="home-bt-partout-card is-large is-crush">
                            <picture>
                                <source media="(max-width: 991px)" srcset="{{ asset('images/slider/8-m.jpg') }}">
                                <img class="home-bt-partout-cover" src="{{ asset('images/slider/8.jpg') }}" alt="" fetchpriority="high" decoding="async">
                            </picture>
                            {{ partout.more_button() }}
                        </article>
                    </li>

                    {# Portugal #}
                    <li class="splide__slide">
                        <article class="home-bt-partout-card is-large is-portugal">
                            <div class="home-bt-partout-photo is-portugal-photo">
                                <picture>
                                    <source media="(max-width: 991px)" srcset="{{ asset('images/slider/3-m.jpg') }}">
                                    <img src="{{ asset('images/slider/3.jpg') }}" alt="" loading="lazy" decoding="async">
                                </picture>
                            </div>
                            {{ partout.more_button() }}
                        </article>
                    </li>

                    {# Budapest #}
                    <li class="splide__slide">
                        <article class="home-bt-partout-card is-large is-budapest">
                            <div class="home-bt-partout-photo is-budapest-photo">
                                <picture>
                                    <source media="(max-width: 991px)" srcset="{{ asset('images/slider/4-m.jpg') }}">
                                    <img src="{{ asset('images/slider/4.jpg') }}" alt="" loading="lazy" decoding="async">
                                </picture>
                            </div>
                            {{ partout.more_button() }}
                        </article>
                    </li>

                    {# Biens à rénover #}
                    <li class="splide__slide">
                        <article class="home-bt-partout-card is-large is-renover">
                            <picture>
                                <source media="(max-width: 991px)" srcset="{{ asset('images/slider/9-m.jpg') }}">
                                <img class="home-bt-partout-cover" src="{{ asset('images/slider/9.jpg') }}" alt="" loading="lazy" decoding="async">
                            </picture>
                            {{ partout.more_button() }}
                        </article>
                    </li>

                </ul>
            </div>
        </div>

        {# ===== Rangée du bas : petites cartes ===== #}
        <div class="splide home-bt-partout-row" data-home--partout-slider-target="bottom" aria-label="{{ 'home.partout.title'|trans }}">
            <div class="splide__track">
                <ul class="splide__list">

                    {# Vivre à la mer #}
                    <li class="splide__slide">
                        <article class="home-bt-partout-card is-small is-mer">
                            <picture>
                                <source media="(max-width: 991px)" srcset="{{ asset('images/slider/5-m.jpg') }}">
                                <img class="home-bt-partout-cover" src="{{ asset('images/slider/5.jpg') }}" alt="" loading="lazy" decoding="async">
                            </picture>
                            {{ partout.more_button() }}
                        </article>
                    </li>

                    {# Propriétaire en Europe #}
                    <li class="splide__slide">
                        <article class="home-bt-partout-card is-small is-europe">
                            <picture>
                                <source media="(max-width: 991px)" srcset="{{ asset('images/slider/6-m.jpg') }}">
                                <img class="home-bt-partout-cover" src="{{ asset('images/slider/6.jpg') }}" alt="" loading="lazy" decoding="async">
                            </picture>
                            {{ partout.more_button() }}
                        </article>
                    </li>

                    {# Top 5 Italie #}
                    <li class="splide__slide">
                        <article class="home-bt-partout-card is-small is-italie">
                            <div class="home-bt-partout-italie-image">
                                <picture>
                                    <source media="(max-width: 991px)" srcset="{{ asset('images/slider/2-m.jpg') }}">
                                    <img src="{{ asset('images/slider/2.jpg') }}" alt="" loading="lazy" decoding="async">
                                </picture>
                            </div>
                            {{ partout.more_button() }}
                        </article>
                    </li>

                    {# Agences à Marrakech #}
                    <li class="splide__slide">
                        <article class="home-bt-partout-card is-small is-marrakech">
                            <picture>
                                <source media="(max-width: 991px)" srcset="{{ asset('images/slider/7-m.jpg') }}">
                                <img class="home-bt-partout-cover" src="{{ asset('images/slider/7.jpg') }}" alt="" loading="lazy" decoding="async">
                            </picture>
                            {{ partout.more_button() }}
                        </article>
                    </li>

                    {# Maisons à la campagne #}
                    <li class="splide__slide">
                        <article class="home-bt-partout-card is-small is-campagne">
                            <picture>
                                <source media="(max-width: 991px)" srcset="{{ asset('images/slider/1-m.jpg') }}">
                                <img class="home-bt-partout-campagne-image" src="{{ asset('images/slider/1.jpg') }}" alt="" loading="lazy" decoding="async">
                            </picture>
                            {{ partout.more_button() }}
                        </article>
                    </li>

                </ul>
            </div>
        </div>
    </div>

    <div class="home-bt-partout-pagination" data-home--partout-slider-target="pagination"></div>
</section>
