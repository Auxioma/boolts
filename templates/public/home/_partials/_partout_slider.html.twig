{#
 Template: templates/public/home/_partials/_partout_slider.html.twig
 Role: Slider éditorial « Achetez. Louez. Partout. » de la page d'accueil.
 Context: Inclus par templates/public/home/index.html.twig.
 Maintenance: Les cartes sont des compositions fixes (maquette Figma 6634:20037) ;
              les positions internes sont en px sur la taille desktop et mises à
              l'échelle par `zoom` dans home.css.
#}

{% macro more_button() %}
    <a href="#" class="home-bt-partout-btn">
        <span>{{ 'home.partout.more'|trans }}</span>
        <img src="{{ asset('images/home/partout/chevron-right.svg') }}" width="24" height="24" alt="" aria-hidden="true">
    </a>
{% endmacro %}

{% import _self as partout %}

{# Les images contiennent du texte : version anglaise préfixée par « en- », française par défaut. #}
{% set slider_prefix = app.request.locale == 'en' ? 'en-' : '' %}

<section class="home-bt-partout" data-controller="home--partout-slider">
    {# Chaque lettre est animée l'une après l'autre au scroll (voir home.css) ;
       les mots restent insécables pour ne pas couper une lettre en fin de ligne. #}
    {% set title = 'home.partout.title'|trans %}
    {% set char_index = 0 %}
    <h2 class="home-bt-partout-title" style="--char-count: {{ title|replace({' ': ''})|length }}" aria-label="{{ title }}">
        {%- for word in title|split(' ') -%}
            <span class="home-bt-partout-word" aria-hidden="true">
                {%- for char in word|split('') -%}
                    <span class="home-bt-partout-char" style="--char-index: {{ char_index }}">{{ char }}</span>
                    {%- set char_index = char_index + 1 -%}
                {%- endfor -%}
            </span>{{ not loop.last ? ' ' }}
        {%- endfor -%}
    </h2>

    <div class="home-bt-partout-rows">
        {# ===== Rangée du haut : grandes cartes ===== #}
        <div class="splide home-bt-partout-row" data-home--partout-slider-target="top" aria-label="{{ 'home.partout.title'|trans }}">
            <div class="splide__track">
                <ul class="splide__list">

                    {# Crush immobilier #}
                    <li class="splide__slide">
                        <article class="home-bt-partout-card is-large is-crush">
                            <picture>
                                <source media="(max-width: 991px)" srcset="{{ asset('images/slider/' ~ slider_prefix ~ '1-m.jpg') }}">
                                <img class="home-bt-partout-cover" src="{{ asset('images/slider/' ~ slider_prefix ~ '1.jpg') }}" alt="" fetchpriority="high" decoding="async">
                            </picture>
                            {{ partout.more_button() }}
                        </article>
                    </li>

                    {# Portugal #}
                    <li class="splide__slide">
                        <article class="home-bt-partout-card is-large is-portugal">
                            <div class="home-bt-partout-photo is-portugal-photo">
                                <picture>
                                    <source media="(max-width: 991px)" srcset="{{ asset('images/slider/' ~ slider_prefix ~ '2-m.jpg') }}">
                                    <img src="{{ asset('images/slider/' ~ slider_prefix ~ '2.jpg') }}" alt="" loading="lazy" decoding="async">
                                </picture>
                            </div>
                            {{ partout.more_button() }}
                        </article>
                    </li>

                    {# Budapest #}
                    <li class="splide__slide">
                        <article class="home-bt-partout-card is-large is-budapest">
                            <div class="home-bt-partout-photo is-budapest-photo">
                                <picture>
                                    <source media="(max-width: 991px)" srcset="{{ asset('images/slider/' ~ slider_prefix ~ '3-m.jpg') }}">
                                    <img src="{{ asset('images/slider/' ~ slider_prefix ~ '3.jpg') }}" alt="" loading="lazy" decoding="async">
                                </picture>
                            </div>
                            {{ partout.more_button() }}
                        </article>
                    </li>

                    {# Biens à rénover #}
                    <li class="splide__slide">
                        <article class="home-bt-partout-card is-large is-renover">
                            <picture>
                                <source media="(max-width: 991px)" srcset="{{ asset('images/slider/' ~ slider_prefix ~ '4-m.jpg') }}">
                                <img class="home-bt-partout-cover" src="{{ asset('images/slider/' ~ slider_prefix ~ '4.jpg') }}" alt="" loading="lazy" decoding="async">
                            </picture>
                            {{ partout.more_button() }}
                        </article>
                    </li>

                </ul>
            </div>
        </div>

        {# ===== Rangée du bas : petites cartes ===== #}
        <div class="splide home-bt-partout-row" data-home--partout-slider-target="bottom" aria-label="{{ 'home.partout.title'|trans }}">
            <div class="splide__track">
                <ul class="splide__list">

                    {# Vivre à la mer #}
                    <li class="splide__slide">
                        <article class="home-bt-partout-card is-small is-mer">
                            <picture>
                                <source media="(max-width: 991px)" srcset="{{ asset('images/slider/' ~ slider_prefix ~ '5-m.jpg') }}">
                                <img class="home-bt-partout-cover" src="{{ asset('images/slider/' ~ slider_prefix ~ '5.jpg') }}" alt="" loading="lazy" decoding="async">
                            </picture>
                            {{ partout.more_button() }}
                        </article>
                    </li>

                    {# Propriétaire en Europe #}
                    <li class="splide__slide">
                        <article class="home-bt-partout-card is-small is-europe">
                            <picture>
                                <source media="(max-width: 991px)" srcset="{{ asset('images/slider/' ~ slider_prefix ~ '6-m.jpg') }}">
                                <img class="home-bt-partout-cover" src="{{ asset('images/slider/' ~ slider_prefix ~ '6.jpg') }}" alt="" loading="lazy" decoding="async">
                            </picture>
                            {{ partout.more_button() }}
                        </article>
                    </li>

                    {# Top 5 Italie #}
                    <li class="splide__slide">
                        <article class="home-bt-partout-card is-small is-italie">
                            <div class="home-bt-partout-italie-image">
                                <picture>
                                    <source media="(max-width: 991px)" srcset="{{ asset('images/slider/' ~ slider_prefix ~ '7-m.jpg') }}">
                                    <img src="{{ asset('images/slider/' ~ slider_prefix ~ '7.jpg') }}" alt="" loading="lazy" decoding="async">
                                </picture>
                            </div>
                            {{ partout.more_button() }}
                        </article>
                    </li>

                    {# Agences à Marrakech #}
                    <li class="splide__slide">
                        <article class="home-bt-partout-card is-small is-marrakech">
                            <picture>
                                <source media="(max-width: 991px)" srcset="{{ asset('images/slider/' ~ slider_prefix ~ '8-m.jpg') }}">
                                <img class="home-bt-partout-cover" src="{{ asset('images/slider/' ~ slider_prefix ~ '8.jpg') }}" alt="" loading="lazy" decoding="async">
                            </picture>
                            {{ partout.more_button() }}
                        </article>
                    </li>

                    {# Maisons à la campagne #}
                    <li class="splide__slide">
                        <article class="home-bt-partout-card is-small is-campagne">
                            <picture>
                                <source media="(max-width: 991px)" srcset="{{ asset('images/slider/' ~ slider_prefix ~ '9-m.jpg') }}">
                                <img class="home-bt-partout-campagne-image" src="{{ asset('images/slider/' ~ slider_prefix ~ '9.jpg') }}" alt="" loading="lazy" decoding="async">
                            </picture>
                            {{ partout.more_button() }}
                        </article>
                    </li>

                </ul>
            </div>
        </div>
    </div>

    <div class="home-bt-partout-pagination" data-home--partout-slider-target="pagination"></div>
</section>
