{#
 Template: templates/public/home/index.html.twig
 Role: Renders the public/home Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

{% extends 'base.html.twig' %}

{% block title %}{{ 'home.meta.title'|trans }}{% endblock %}

{% block body %}
    <div class="home-bt-page">
        <main>
            <section class="home-bt-top">
                <div class="container-md px-0 px-md-3 home-bt-hero-shell">
{% set nombre = random(1, 28) %}
                    <div class="home-bt-hero mx-auto">
                        <video
                            id="videoBg"
                            autoplay
                            muted
                            loop
                            playsinline
                            webkit-playsinline
                            x-webkit-airplay="deny"
                            preload="auto"
                            poster="{{ asset('video/poster-' ~ nombre ~ '.jpg') }}"
                            data-controller="home--hero-video"
                        >
                            <source src="{{ asset('video/Boolts-' ~ nombre ~ '.mp4') }}" type="video/mp4">
                            <source src="{{ asset('video/Boolts-' ~ nombre ~ '.webm') }}" type="video/webm">
                            {{ 'home.video.unsupported'|trans }}
                        </video>
                        <div class="home-bt-hero-content">
                            <h1 class="text-white text-center">
                                {{ 'home.hero.title'|trans }}
                            </h1>

                            {{ include('public/home/_partials/composant/search.html.twig') }}
                        </div>
                    </div>
                </div>

                {% if lastSearchSession is not null %}
                    <div class="container-md home-bt-resume-shell">
                        <div class="home-bt-resume mx-auto">
                            <div class="d-flex align-items-center justify-content-between gap-3 h-100">
                                <div class="d-flex flex-column align-items-start gap-3">
                                    <h3 class="">
                                        {{ 'home.search.resume.title'|trans }}
                                        {{ lastSearchSession }}
                                    </h3>

                                    <div class="d-flex align-items-center gap-3 w-md-100">
                                        <a href="{{ path('app_public_search_resume') }}" class="btn-full-blue">
                                            {{ 'home.search.resume.submit'|trans }}
                                        </a>

                                        <a href="{{ path('app_public_search_forget') }}" class="btn-full-white">
                                            <span class="d-md-none">
                                                <i data-lucide="x" class="icon-x icone-absolute"></i>
                                            </span>

                                            {# À partir de md #}
                                            <span class="p-accent d-none d-md-inline-flex align-items-center justify-content-center">
                                                {{ 'home.search.resume.cancel'|trans }}
                                            </span>
                                        </a>
                                    </div>
                                </div>

                                <div class="home-bt-resume-stack d-none d-md-block">
                                    <span></span>
                                    <span></span>
                                    <span></span>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}
            </section>

            <div
                data-controller="home--geolocation-properties"
                data-home--geolocation-properties-url-value="{{ path('app_home_properties_by_city') }}"
            >
                <div data-home--geolocation-properties-target="content">
                    {{ include('public/home/_partials/_property_sections.html.twig') }}
                </div>
            </div>



            {{ include('public/home/_partials/_partout_slider.html.twig') }}

            <section class="home-bt-codes">
                <div class="container-md">
                    <h2 class="home-bt-codes-title">
                        {{ 'home.codes.title'|trans }}
                        <span>{{ 'home.codes.title.highlight'|trans }}</span>
                    </h2>

                    <div class="row g-4">
                        <div class="col-6 col-md-3">
                            <div class="home-bt-feature">
                                <div class="home-bt-feature-lottie" data-controller="lottie" data-lottie-path-value="{{ asset('images/footer/shield.json') }}" aria-hidden="true"></div>
                                <h3>{{ 'home.codes.transparency.title'|trans }}</h3>
                                <p>{{ 'home.codes.transparency.description'|trans }}</p>
                            </div>
                        </div>

                        <div class="col-6 col-md-3">
                            <div class="home-bt-feature">
                                <div class="home-bt-feature-lottie" data-controller="lottie" data-lottie-path-value="{{ asset('images/footer/globe.json') }}" aria-hidden="true"></div>
                                <h3>{{ 'home.codes.fluidity.title'|trans }}</h3>
                                <p>{{ 'home.codes.fluidity.description'|trans }}</p>
                            </div>
                        </div>

                        <div class="col-6 col-md-3">
                            <div class="home-bt-feature">
                                <div class="home-bt-feature-lottie" data-controller="lottie" data-lottie-path-value="{{ asset('images/footer/arrows.json') }}" aria-hidden="true"></div>
                                <h3>{{ 'home.codes.responsiveness.title'|trans }}</h3>
                                <p>{{ 'home.codes.responsiveness.description'|trans }}</p>
                            </div>
                        </div>

                        <div class="col-6 col-md-3">
                            <div class="home-bt-feature">
                                <div class="home-bt-feature-lottie" data-controller="lottie" data-lottie-path-value="{{ asset('images/footer/navigator.json') }}" aria-hidden="true"></div>
                                <h3>{{ 'home.codes.ecosystem.title'|trans }}</h3>
                                <p>{{ 'home.codes.ecosystem.description'|trans }}</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <style>
                /*
                     * Seulement le CSS spécifique au bloc application.
                     * On conserve les styles existants de :
                     * .home-bt-container
                     * .home-bt-content-section
                     * .home-bt-text-block
                     */

                .home-bt-app {
                    position: relative;
                    min-height: 408px;
                    padding: 0;
                    overflow: hidden;
                    border-radius: 24px;
                    background: #0b0f14
                }

                .home-bt-app > .row {
                    min-height: 408px;
                    margin: 0;
                }

                /* ==============================
                       PARTIE GAUCHE / MOCKUP
                       ============================== */

                .home-bt-app-visual {
                    position: relative;
                    min-height: 408px;
                }

                .home-bt-app-circle {
                    position: absolute;

                    top: -100px;
                    left: 134px;

                    width: 403px;
                    height: 395px;

                    border: 7px solid #fff;
                    border-radius: 50%;
                }

                .home-bt-app-circle::before,
                .home-bt-app-circle::after {
                    content: "";

                    position: absolute;

                    border: 3px solid #fff;
                    border-radius: 50%;
                }

                .home-bt-app-circle::before {
                    inset: 14px;
                }

                .home-bt-app-circle::after {
                    inset: 28px;
                }

                .home-bt-app-image {
position: absolute;
  top: -133px;
  left: -135px;
  width: 800px;
  height: 675px;
  object-fit: contain;
                }

                /* ==============================
                       TEXTE
                       ============================== */

                .home-bt-app .home-bt-text-block {
                    max-width: 398px;
                    color: #fff;
                }

                .home-bt-app .home-bt-text-block h2,
                .home-bt-app .home-bt-text-block p {
                    color: #fff;
                }

                .home-bt-app-button {
                    width: fit-content;
                    margin-top: 24px;
                    text-decoration: none;
                    z-index: 99;
  position: relative;
                }



                /* ==================================================
                       TABLETTE
                       ================================================== */
                @media (min-width: 768px) and (max-width: 991px) {
                    .home-bt-app-image {
                        top: -57px;
                        left: -158px;
                        width: 523px;
                        height: 522px;
                    }
                }
                @media (min-width: 991px) and (max-width: 1199.98px) {
                    .home-bt-app-image {
                        top: -57px;
                        left: -44px;
                        width: 505px;
                        height: 485px;
                    }
                }

                @media (min-width: 768px) and (max-width: 1199.98px) {
                    .home-bt-app-visual {
                        min-height: 408px;
                    }

                    .home-bt-app-circle {
                        top: 44px;
                        left: 107px;

                        width: 227px;
                        height: 221px;

                        border-width: 5px;
                    }

                    .home-bt-app-circle::before {
                        inset: 10px;
                    }

                    .home-bt-app-circle::after {
                        inset: 20px;
                    }

                    .home-bt-app .home-bt-text-block {
                        max-width: 366px;
                    }
                }

                /* ==================================================
                       MOBILE
                       ================================================== */

                @media (max-width: 767.98px) {
                    .home-bt-app {
                        min-height: 560px;
                    }

                    .home-bt-app > .row {
                        min-height: 542px;
                    }

                    .home-bt-app-content {
                        padding: 24px 24px 0;
                    }

                    .home-bt-app .home-bt-text-block {
                        width: 100%;
                        max-width: none;
                    }

                    .home-bt-app-visual {
                        min-height: 242px;
                    }

                    .home-bt-app-circle {
                        top: 10px;
                        left: 67px;

                        width: 261px;
                        height: 256px;
                    }

                    .home-bt-app-image {
top: -116px;
    left: -58px;
    width: 594px;
    height: 476px;
                    }
                }
                .home-mobile-reverse {
                    padding-bottom: inherit !important;
                }
            </style>

            <section class="home-bt-content">

                <div class="container-md home-bt-resume-shell">

                    <div class="home-bt-app">

                        <div class="home-bt-content-section row align-items-center home-mobile-reverse">

                            <!--
                    Image :
                    deuxième sur mobile
                    première dès MD
                -->
                            <div
                                class="col-12 col-md-6 col-lg-7
                           order-2 order-md-1
                           p-0"
                            >
                                <div class="home-bt-app-visual">

                                    <img
                                        src="{{ asset('images/home/cookies/06.png') }}"
                                        alt=""
                                        aria-hidden="true"
                                        class="home-bt-app-image"
                                    >

                                </div>
                            </div>

                            <!--
                    Texte :
                    premier sur mobile
                    deuxième dès MD
                -->
                            <div
                                class="col-12 col-md-6 col-lg-5
                           order-1 order-md-2
                           home-bt-app-content"
                            >

                                <div class="home-bt-text-block">

                                    <h2>
                                        {{ 'home.app.title'|trans }}
                                    </h2>

                                    <p>
                                        {{ 'home.app.description'|trans }} 
                                    </p>

                                    <a
                                        href="#"
                                        class="home-bt-app-button btn-full-blue"
                                    >
                                        {{ 'home.app.download'|trans }}
                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </section>

        </main>

    </div>
{% endblock %}
