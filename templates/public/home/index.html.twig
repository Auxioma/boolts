		.home-bt-tab-panel {
			display: none;
		}

		.home-bt-tab-panel.active {
			display: block;
		}

		.home-bt-main-tab {
			cursor: pointer;
		}
	</style>

	<div class="home-bt-page">
		<main>
			<section class="home-bt-top">
				<div class="container-xl home-bt-container home-bt-hero-shell">
					<div class="home-bt-hero mx-auto">
						<div class="home-bt-hero-content">
							<h1 class="home-bt-hero-title">
								L’immobilier,<br>
								réinventé.
							</h1>

							{% include 'public/home/_partials/composant/search.html.twig' %}
						</div>
					</div>
				</div>

				<div class="container-xl home-bt-container home-bt-resume-shell">
					<div class="home-bt-resume mx-auto">
						<div class="d-flex align-items-center justify-content-between gap-3 h-100">
							<div class="d-flex flex-column align-items-start gap-3">
								<h2 class="home-bt-resume-title">
									Continuez votre recherche pour “Appartement à louer” à Paris
								</h2>

								<div class="d-flex align-items-center gap-3">
									<a href="#" class="home-bt-button-primary">Reprendre la recherche</a>
									<a href="#" class="home-bt-button-outline">Annuler</a>
								</div>
							</div>

							<div class="home-bt-resume-stack">
								<span></span>
								<span></span>
