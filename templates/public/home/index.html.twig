{% extends 'base.html.twig' %}

{% block title %}Boolts - L’immobilier réinventé{% endblock %}

{% block body %}
    <div class="home-bt-page">
        <main>
            <section class="home-bt-top">
                <div class="container-xl home-bt-container home-bt-hero-shell">

                    <div class="home-bt-hero mx-auto">
                        <video
                            id="videoBg"
                            autoplay
                            muted
                            loop
                            playsinline
                            webkit-playsinline
                            x-webkit-airplay="deny"
                            preload="auto"
                        >
                            <source src="{{ asset('video/01.mp4') }}" type="video/mp4">
                            <source src="{{ asset('video/01.webm') }}" type="video/webm">
                            Votre navigateur ne supporte pas la lecture vidéo.
                        </video>
                        <div class="home-bt-hero-content">
                            <h1 class="home-bt-hero-title">
                                L’immobilier,<br>
                                réinventé.
                            </h1>

                            {{ include('public/home/_partials/composant/search.html.twig') }}
                        </div>
                    </div>
                </div>


