{% extends 'base.html.twig' %}

{% block title %}Boolts - L’immobilier réinventé{% endblock %}

{% block body %}

<div
    class="bt-home-page"
    data-controller="public-home"
>
    <header class="bt-home-header">
        <div class="container-xl h-100">
            <div class="d-flex align-items-center justify-content-between h-100">
                <a href="#" class="bt-home-logo">
                    boolts
                </a>

                <nav class="bt-home-nav d-none d-lg-flex align-items-center">
                    <a href="#" class="active">Acheter</a>
                    <a href="#">Louer</a>
                    <a href="#">Vendre</a>
                    <a href="#">Trouver un pro</a>
                </nav>

                <div class="d-flex align-items-center gap-3">
                    <a href="#" class="bt-home-header-btn d-none d-md-inline-flex">
                        Déposer une annonce
                    </a>

                    <button type="button" class="bt-home-icon-btn">
                        <i class="icon-user-round"></i>
                    </button>

                    <button type="button" class="bt-home-icon-btn d-lg-none">
                        <i class="icon-menu"></i>
                    </button>
                </div>
            </div>
        </div>
