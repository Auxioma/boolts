                    <div class="bt-home-hero-overlay"></div>

                    <div class="bt-home-hero-content">
                        <h1>
                            L’immobilier,<br>
                            réinventé.
                        </h1>

                        <div class="bt-home-search-card">
                            <div class="bt-home-search-tabs">
                                <button type="button" class="bt-home-search-tab active">
                                    <i class="icon-house"></i>
                                    Acheter
                                </button>

                                <button type="button" class="bt-home-search-tab">
                                    <i class="icon-key-round"></i>
                                    Louer
                                </button>

                                <button type="button" class="bt-home-search-tab">
                                    <i class="icon-pencil"></i>
                                    Vendre
                                </button>
                            </div>

                            <form class="bt-home-search-form">
                                <input type="search" placeholder="Saisir un lieu, un code postal...">

                                <button type="submit">
                                    <i class="icon-search"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="bt-home-resume">
                    <div class="row g-0 h-100">
                        <div class="col-4">
                            <div class="bt-home-resume-item">
                                <strong>12 500+</strong>
                                <span>biens disponibles</span>
                            </div>
                        </div>

                        <div class="col-4">
                            <div class="bt-home-resume-item">
                                <strong>4 200+</strong>
                                <span>agences partenaires</span>
                            </div>
                        </div>

                        <div class="col-4">
