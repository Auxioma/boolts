{#
 Template: templates/public/search/_pagination.html.twig
 Role: Renders the public/search Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

{% set currentView = currentView|default('list') %}
{% set mapBounds = mapBounds|default(null) %}

{#
On récupère modal_filter :
1. depuis la variable Twig modal_filter si elle existe
2. sinon depuis l'URL actuelle
#}
{% set requestQuery = app.request.query.all %}
{% set modalFilter = modal_filter|default(requestQuery.modal_filter|default({})) %}

{# Sécurité : modal_filter doit être un tableau #}
{% if modalFilter is not iterable %}
    {% set modalFilter = {} %}
{% endif %}

{% if search is defined and search is not null %}

    {% if currentView == 'map' %}

        {% set paginationData = search.paginationData %}

        <nav
            id="search-card-pagination"
            class="search-card-pagination"
            aria-label="Pagination des logements sur la carte"
        >

            {% if paginationData.pageCount is defined and paginationData.pageCount > 1 %}

                {% set commonParams = {
                    searchToken: searchToken,
                    page: 1,
                    view: 'map',
                    modal_filter: modalFilter,
                } %}

                {% if mapBounds is iterable %}
                    {% set commonParams = commonParams|merge({
                        north: mapBounds.north,
                        south: mapBounds.south,
                        east: mapBounds.east,
                        west: mapBounds.west,
                    }) %}
                {% endif %}

                <ul class="pagination justify-content-center flex-wrap gap-2 mb-0">

                    {% if paginationData.previous is defined %}
                        {% set previousParams = commonParams|merge({page: paginationData.previous}) %}

                        <li class="page-item">
                            <a class="page-link" href="{{ path('app_public_search_results', previousParams) }}" rel="prev">
                                Précédent
                            </a>
                        </li>
                    {% else %}
                        <li class="page-item disabled" aria-disabled="true">
                            <span class="page-link">Précédent</span>
                        </li>
                    {% endif %}

                    {% if paginationData.startPage is defined and paginationData.startPage > 1 %}
                        {% set firstParams = commonParams|merge({page: 1}) %}

                        <li class="page-item">
                            <a class="page-link" href="{{ path('app_public_search_results', firstParams) }}">1</a>
                        </li>

                        {% if paginationData.startPage > 2 %}
                            <li class="page-item disabled" aria-disabled="true">
                                <span class="page-link">…</span>
                            </li>
                        {% endif %}
                    {% endif %}

                    {% for page in paginationData.pagesInRange %}
                        {% set pageParams = commonParams|merge({page: page}) %}

                        <li class="page-item {{ page == paginationData.current ? 'active' : '' }}">
                            {% if page == paginationData.current %}
                                <span class="page-link">{{ page }}</span>
                            {% else %}
                                <a class="page-link" href="{{ path('app_public_search_results', pageParams) }}">{{ page }}</a>
                            {% endif %}
                        </li>
                    {% endfor %}

                    {% if paginationData.endPage is defined and paginationData.pageCount is defined and paginationData.endPage < paginationData.pageCount %}
                        {% if paginationData.endPage < paginationData.pageCount - 1 %}
                            <li class="page-item disabled" aria-disabled="true">
                                <span class="page-link">…</span>
                            </li>
                        {% endif %}

                        {% set lastParams = commonParams|merge({page: paginationData.pageCount}) %}

                        <li class="page-item">
                            <a class="page-link" href="{{ path('app_public_search_results', lastParams) }}">{{ paginationData.pageCount }}</a>
                        </li>
                    {% endif %}

                    {% if paginationData.next is defined %}
                        {% set nextParams = commonParams|merge({page: paginationData.next}) %}

                        <li class="page-item">
                            <a class="page-link" href="{{ path('app_public_search_results', nextParams) }}" rel="next">
                                Suivant
                            </a>
                        </li>
                    {% else %}
                        <li class="page-item disabled" aria-disabled="true">
                            <span class="page-link">Suivant</span>
                        </li>
                    {% endif %}

                </ul>

            {% endif %}

        </nav>

    {% else %}

        <nav
            id="bt-research-pagination"
            class="bt-research-pagination"
            aria-label="Pagination"
        >
            {{ knp_pagination_render(search, null, {
                modal_filter: modalFilter,
                view: currentView,
            }) }}
        </nav>

    {% endif %}

{% endif %}
