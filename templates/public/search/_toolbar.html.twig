{#
 Template: templates/public/search/_toolbar.html.twig
 Role: Renders the public/search Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

{% set currentView = currentView|default('list') %}
{% set mapbox_public_token = mapbox_public_token|default('') %}
{% set totalResults = search is defined and search is not null ? search.getTotalItemCount : 0 %}

{#
    ================================================================
    CSS MANQUANT UNIQUEMENT POUR LA VUE LISTE

    Tout le design search-card-* existe déjà dans :
    assets/styles/public/card.css

    Ici on corrige uniquement :
    - les variables CSS absentes de .bt-research-page
    - position fixed -> sticky pour la liste
    - position sous la navbar
    ================================================================
#}

<style>
    .bt-research-page .search-card-toolbar {
        --search-card-toolbar-height: 88px;
        --search-card-primary: #5d00ff;
        --search-card-primary-soft: #dfcbff;
        --search-card-text: #0b0f14;
        --search-card-muted: #858789;
        --search-card-border: #ebecec;
        --search-card-light: #f8f8f8;
        --search-card-white: #fff;

        position: sticky;

        /*
             * La topbar du projet est déjà sticky à top: 0.
             * On place donc la toolbar recherche juste dessous.
             */
        top: var(--topbar-height, 72px);

        /*
             * Navbar = 1030 dans layouts/topbar.css.
             * La toolbar reste volontairement en dessous.
             */
        z-index: 1020;
    }

    /*
         * La colonne recherche doit pouvoir se réduire correctement.
         */
    .bt-research-page .search-card-search-column {
        min-width: 0;
        flex: 1 1 0;
        min-width: 0;
    }

    /*
         * Le formulaire prend toute la largeur de sa colonne.
         */
    .bt-research-page .search-card-form {
        width: 100%;
    }

    /*
         * Les propositions Mapbox passent devant le contenu.
         */
    .bt-research-page .search-card-results {
        z-index: 1050;
    }

    /*
         * Tablette.
         */
    @media (max-width: 991.98px) {
        .bt-research-page .search-card-toolbar {
            --search-card-toolbar-height: 76px;

            top: var(--topbar-height, 72px);
        }

        .bt-research-page .search-card-search-column {
            flex: 1 1 0;
            min-width: 0;
        }
    }

    /*
         * Mobile.
         */
    @media (max-width: 767.98px) {
        .bt-research-page .search-card-toolbar {
            --search-card-toolbar-height: 64px;

            top: var(--topbar-height, 72px);
        }
    }
</style>


<section
    class="search-card-toolbar py-14"
    aria-label="{{ 'search.toolbar.aria_label'|trans }}"
>
    <div class="container-lg">

        <div class="row">

            {#
                ======================================================
                BOUTON RETOUR
                Même design que la partie MAP
                ======================================================
            #}

            <a
                href="{{ path('app_home') }}"
                class="search-card-back search-card-mobile-only"
                aria-label="{{ 'search.toolbar.back'|trans }}"
            >
                <i
                    class="icon-chevron-left"
                    aria-hidden="true"
                ></i>
            </a>


            {#
                ======================================================
                RECHERCHE
                ======================================================
            #}

            <div class="col search-card-search-column">

                {{ form_start(form, {
                    attr: {
                        class: 'search-card-form',
                        'data-controller': 'home-bt-mapbox-search',
                        'data-home-bt-mapbox-search-token-value': mapbox_public_token|default(''),
                        'data-home-bt-mapbox-search-language-value': app.request.locale|default('fr'),
                        'data-home-bt-mapbox-search-submit-on-select-value': 'true',
                    },
                }) }}


                {#
                    ==================================================
                    TYPE DE TRANSACTION
                    ==================================================
                #}

                {{ form_widget(form.transactionType, {
                    attr: {
                        class: 'd-none',
                        'data-home-bt-transaction-input': '',
                    },
                }) }}


                {#
                    ==================================================
                    CHAMP RECHERCHE
                    ==================================================
                #}

                <div class="search-card-field">

                    {{ form_widget(form.filter, {
                        attr: {
                            class: 'search-card-input',
                            autocomplete: 'off',
                            placeholder: 'search.location.placeholder'|trans,
                            'data-home-bt-mapbox-search-target': 'input',
                            'data-action': 'input->home-bt-mapbox-search#search focus->home-bt-mapbox-search#search keydown->home-bt-mapbox-search#handleKeydown',
                        },
                    }) }}


                    {#
                        ==============================================
                        BOUTON RECHERCHE
                        ==============================================
                    #}

                    <button
                        type="submit"
                        class="search-card-submit"
                        aria-label="{{ 'search.submit'|trans }}"
                    >
                        <svg
                            viewBox="0 0 24 24"
                            fill="none"
                            aria-hidden="true"
                            class="search-card-icon"
                        >
                            <circle
                                cx="11"
                                cy="11"
                                r="7"
                                stroke="currentColor"
                                stroke-width="2"
                            ></circle>

                            <path
                                d="M20 20l-3.5-3.5"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                            ></path>
                        </svg>
                    </button>


                    {#
                        ==============================================
                        RESULTATS MAPBOX
                        ==============================================
                    #}

                    <ul
                        class="search-card-results"
                        data-home-bt-mapbox-search-target="results"
                    ></ul>

                </div>


                {#
                    ==================================================
                    VALEURS CACHEES MAPBOX
                    ==================================================
                #}

                {{ form_widget(form.selectedValue, {
                    attr: {
                        'data-home-bt-mapbox-search-target': 'selectedValue',
                    },
                }) }}

                {{ form_widget(form.selectedMapboxId, {
                    attr: {
                        'data-home-bt-mapbox-search-target': 'selectedMapboxId',
                    },
                }) }}

                {{ form_widget(form.selectedFeatureType, {
                    attr: {
                        'data-home-bt-mapbox-search-target': 'selectedFeatureType',
                    },
                }) }}

                {{ form_widget(form.selectedCountryName, {
                    attr: {
                        'data-home-bt-mapbox-search-target': 'selectedCountryName',
                    },
                }) }}

                {{ form_widget(form.selectedCountryCode, {
                    attr: {
                        'data-home-bt-mapbox-search-target': 'selectedCountryCode',
                    },
                }) }}

                {{ form_widget(form.selectedRegionName, {
                    attr: {
                        'data-home-bt-mapbox-search-target': 'selectedRegionName',
                    },
                }) }}

                {{ form_widget(form.selectedCityName, {
                    attr: {
                        'data-home-bt-mapbox-search-target': 'selectedCityName',
                    },
                }) }}

                {{ form_widget(form.selectedPostalCode, {
                    attr: {
                        'data-home-bt-mapbox-search-target': 'selectedPostalCode',
                    },
                }) }}

                {{ form_widget(form.selectedLatitude, {
                    attr: {
                        'data-home-bt-mapbox-search-target': 'selectedLatitude',
                    },
                }) }}

                {{ form_widget(form.selectedLongitude, {
                    attr: {
                        'data-home-bt-mapbox-search-target': 'selectedLongitude',
                    },
                }) }}

                {{ form_widget(form.selectedFullAddress, {
                    attr: {
                        'data-home-bt-mapbox-search-target': 'selectedFullAddress',
                    },
                }) }}


                {#
                    ==================================================
                    LOCALE
                    ==================================================
                #}

                {% if form.selectedLocale is defined %}

                    {{ form_widget(form.selectedLocale, {
                        value: app.request.locale|default('fr'),
                        attr: {
                            'data-home-bt-mapbox-search-target': 'selectedLocale',
                        },
                    }) }}

                {% endif %}


                {#
                    ==================================================
                    LOCATION JSON
                    ==================================================
                #}

                {% if form.selectedLocationJson is defined %}

                    {{ form_widget(form.selectedLocationJson, {
                        attr: {
                            'data-home-bt-mapbox-search-target': 'selectedLocationJson',
                        },
                    }) }}

                {% endif %}


                {{ form_end(form, {
                    render_rest: false
                }) }}

            </div>


            {#
                ======================================================
                LISTE / CARTE / FILTRES
                ======================================================
            #}

            <div class="col-auto  d-flex justify-content-center">

                <div
                    class="search-card-actions d-flex align-items-center justify-content-center gap-2"
                >

                    {#
                        ==============================================
                        SWITCH LISTE / CARTE
                        ==============================================
                    #}

                    <div
                        class="search-card-switch search-card-desktop-only d-flex gap-1"
                        aria-label="{{ 'search.toolbar.view_switch'|trans }}"
                    >

                        {#
                            ==========================================
                            LISTE
                            ==========================================
                        #}

                        <a
                            href="{{ path('app_public_search_results', {
                                searchToken: searchToken,
                                view: 'list',
                                modal_filter: modal_filter,
                            }) }}"
                            class="search-card-switch-item {{ currentView == 'list' ? 'search-card-is-active' : '' }}"
                        >
                            <i
                                class="icon-list"
                                aria-hidden="true"
                            ></i>

                            <span class="p-accent">
                                {{ 'search.toolbar.list'|trans }}
                            </span>
                        </a>


                        {#
                            ==========================================
                            CARTE
                            ==========================================
                        #}

                        <a
                            href="{{ path('app_public_search_results', {
                                searchToken: searchToken,
                                view: 'map',
                                modal_filter: modal_filter,
                            }) }}"
                            class="search-card-switch-item {{ currentView == 'map' ? 'search-card-is-active' : '' }}"
                        >
                            <i
                                class="icon-map"
                                aria-hidden="true"
                            ></i>

                            <span class="p-accent">
                                {{ 'search.toolbar.map'|trans }}
                            </span>
                        </a>

                    </div>


                    {#
                        ==============================================
                        FILTRES
                        ==============================================
                    #}

                    <button
                        type="button"
                        class="search-card-filter"
                        data-bs-toggle="modal"
                        data-bs-target="#booltsFiltersModal"
                        data-controller="boolts-filter-badge"
                    >
                        <i
                            class="icon-sliders-horizontal"
                            aria-hidden="true"
                        ></i>

                        <span class="p-accent d-none d-lg-inline">
                            {{ 'search.toolbar.filters'|trans }}
                        </span>
                    </button>

                </div>

            </div>

        </div>

    </div>
</section>
