{% extends 'base.html.twig' %}

{% block title %}Boolts - Recherche{% endblock %}

{% block body %}
{% include 'composant/_search/_search.html.twig' %}

    {% set currentView = view|default('list') %}
    {% set totalResults = search is defined and search is not null ? search.getTotalItemCount : 0 %}

    <div class="{{ currentView == 'map' ? 'search-card-page' : 'bt-research-page' }}">

        {% include 'public/search/_toolbar.html.twig' with {
            form: form,
            search: search,
            criteria: criteria|default(null),
            searchToken: searchToken,
            currentView: currentView,
            mapbox_public_token: mapboxPublicToken|default('')
        } only %}

        <main class="{{ currentView == 'map' ? 'search-card-main' : 'bt-research-main' }}" id="results">

            {% if currentView == 'map' %}

                {% include 'public/search/_results_map.html.twig' with {
                    search: search,
                    totalResults: totalResults,
                    criteria: criteria|default(null),
                    favoritePropertyIds: favoritePropertyIds|default([]),
                    searchToken: searchToken,
                    currentView: currentView,
                    mapboxPublicToken: mapboxPublicToken|default(''),
                    mapboxPublicTokenCard: mapboxPublicTokenCard|default(''),
                    mapBounds: mapBounds|default(null)
                } only %}

            {% else %}

                {% include 'public/search/_results_list.html.twig' with {
                    search: search,
                    totalResults: totalResults,
                    criteria: criteria|default(null),
                    favoritePropertyIds: favoritePropertyIds|default([])
                } only %}

            {% endif %}

            {% include 'public/search/_pagination.html.twig' with {
                search: search,
                searchToken: searchToken,
                currentView: currentView,
                mapBounds: mapBounds|default(null)
            } only %}

        </main>

    </div>

{% endblock %}
