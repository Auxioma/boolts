{#
 Template: templates/public/search/_results_map.html.twig
 Role: Renders the public/search Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

{% set resultsCount = totalResults|default(
    search is defined and search is not null
    ? search.getTotalItemCount
    : 0,
) %}

{% set mapBoundsUrl = path('app_public_search_map_bounds', {
    searchToken: searchToken,
}) %}

{% if app.request.queryString is not empty %}
    {% set mapBoundsUrl = mapBoundsUrl ~ '?' ~ app.request.queryString %}
{% endif %}

<section
    class="search-card-map-results"
    data-controller="search-card-map"
    data-search-card-map-token-value="{{ mapboxPublicTokenCard|default(mapboxPublicToken|default(''))|e('html_attr') }}"
    data-search-card-map-bounds-url-value="{{ mapBoundsUrl|e('html_attr') }}"
    data-search-card-map-labels-value="{{ {
        resultsOne: 'search.results.count.one'|trans,
        resultsOther: 'search.results.count.other'|trans,
        bedroomsOne: 'search.card.bedrooms.one'|trans,
        bedroomsOther: 'search.card.bedrooms.other'|trans,
        bathroomsOne: 'search.card.bathrooms.one'|trans,
        bathroomsOther: 'search.card.bathrooms.other'|trans,
        reference: 'search.map.reference'|trans,
        type: 'search.map.type'|trans,
        markerView: 'search.map.marker.view'|trans,
        markerViewTitle: 'search.map.marker.view_title'|trans,
        markerViewDefault: 'search.map.marker.view_default'|trans,
        errorLoad: 'search.map.error.load'|trans,
        errorToken: 'search.map.error.token'|trans,
        errorInit: 'search.map.error.init'|trans,
        errorHttp: 'search.map.error.http'|trans,
        errorFetch: 'search.map.error.fetch'|trans,
    }|json_encode(constant('JSON_UNESCAPED_UNICODE'))|e('html_attr') }}"
>
    <div class="container-lg search-card-container">



        <div
            class="row g-4 align-items-start search-card-map-layout"
            data-search-card-map-target="layout"
        >
            <section
                class="col-12 col-lg-6 search-card-list-column"
                aria-label="{{ 'search.map.list_aria_label'|trans }}"
                data-search-card-map-target="listColumn"
            >        <h3
            class="my-32"
            id="search-card-total-results"
            data-search-card-map-target="title totalResults"
        >
            {{ (resultsCount > 1 ? 'search.results.count.other' : 'search.results.count.one')|trans({'%count%': resultsCount}) }}
        </h3>
                <div
                    class="row g-4 agence-properties"
                    id="search-card-results-grid"
                    data-search-card-map-target="resultsGrid"
                >
                    {{ include('public/search/_cards.html.twig', {
                        search: search,
                        favoritePropertyIds: favoritePropertyIds|default([]),
                    }, false) }}
                </div>
            </section>

            <aside
                class="col-12 col-lg-6 position-relative search-card-map-column"
                aria-label="{{ 'search.map.map_aria_label'|trans }}"
                data-search-card-map-target="mapColumn"
            >
                <div
                    class="search-card-map-panel"
                    data-search-card-map-target="mapPanel"
                >
                    <div
                        id="search-card-mapbox"
                        class="search-card-mapbox"
                        data-search-card-map-target="mapbox"
                    ></div>

                    <div
                        id="search-card-map-error"
                        class="search-card-map-error"
                        data-search-card-map-target="error"
                        hidden
                    ></div>

                    <button
                        type="button"
                        class="search-card-map-fit"
                        id="search-card-map-fit"
                        aria-label="{{ 'search.map.expand'|trans }}"
                        aria-expanded="false"
                        data-action="click->search-card-map#openMapModal"
                        data-search-card-map-target="expandButton"
                    >
                        <i
                            class="icon-maximize-2"
                            aria-hidden="true"
                            data-search-card-map-target="expandIcon"
                        ></i>

                        <span
                            class="search-card-map-fit-label"
                            data-search-card-map-target="expandLabel"
                        >

                        </span>
                    </button>

                    <article
                        id="search-card-map-preview"
                        class="search-card-map-preview"
                        data-search-card-map-target="preview"
                        hidden
                    >
                        <button
                            type="button"
                            class="search-card-map-preview-close"
                            aria-label="{{ 'search.map.close_preview'|trans }}"
                            data-action="click->search-card-map#hidePreview"
                        >
                            <i class="icon-x" aria-hidden="true"></i>
                        </button>

                        {# Reçoit un clone de la <twig:Property:Card> de la liste (même rendu, même CSS) #}
                        <div
                            class="agence-properties"
                            data-search-card-map-target="previewCard"
                        ></div>
                    </article>

                    {# Aperçu carte : on masque le titre du bien (description) et l'adresse de la card clonée (sans toucher au composant) #}
                    <style>
                        #search-card-map-preview .property-card__description,
                        #search-card-map-preview .property-card__footer {
                            display: none;
                        }

                        #search-card-map-preview .property-card__content {
                            padding-bottom: 12px;
                        }

                        /* Preview positionnée en JS à côté de son marqueur (>= 768px) */
                        #search-card-map-preview.is-floating:not([hidden]) {
                            animation: search-card-map-preview-in .18s ease-out;
                        }

                        @keyframes search-card-map-preview-in {
                            from { opacity: 0; transform: translateY(4px) scale(.98); }
                            to { opacity: 1; transform: none; }
                        }

                        /* Mobile (< 768px) : card horizontale ancrée en bas de la carte, façon Airbnb */
                        @media (max-width: 767.98px) {
                            /* 8px au-dessus du bloc Liste/Carte (.search-card-switch : fixed, bottom 18px, hauteur 44px) */
                            #search-card-map-preview {
                                position: fixed;
                                left: 16px;
                                right: 16px;
                                bottom: calc(18px + 44px + 8px);
                                top: auto;
                                width: auto;
                                border: 0;
                                border-radius: 20px;
                                background: transparent;
                                overflow: visible;
                                box-shadow: 0 6px 20px rgba(11, 15, 20, .2);
                            }

                            #search-card-map-preview:not([hidden]) {
                                animation: search-card-map-preview-up .22s ease-out;
                            }

                            #search-card-map-preview .property-card-link {
                                display: block;
                                color: inherit;
                                text-decoration: none;
                            }

                            #search-card-map-preview .property-card {
                                display: grid;
                                grid-template-columns: 38% minmax(0, 1fr);
                                grid-template-rows: auto 1fr;
                                height: auto;
                                min-height: 124px;
                                border-radius: 20px;
                            }

                            #search-card-map-preview .property-card__media {
                                grid-column: 1;
                                grid-row: 1 / -1;
                                position: relative;
                                border-bottom: 0;
                                border-right: 2px solid var(--color-gray-light);
                            }

                            #search-card-map-preview .property-card__picture,
                            #search-card-map-preview .property-card__image {
                                position: absolute;
                                inset: 0;
                                display: block;
                                width: 100%;
                                height: 100%;
                                aspect-ratio: auto;
                            }

                            #search-card-map-preview .property-card__header {
                                grid-column: 2;
                                grid-row: 1;
                                gap: 8px;
                                padding: 12px 12px 0;
                            }

                            #search-card-map-preview .property-card__title {
                                white-space: nowrap;
                            }

                            #search-card-map-preview .property-card__favorite {
                                font-size: 20px;
                            }

                            #search-card-map-preview .property-card__content {
                                grid-column: 2;
                                grid-row: 2;
                                padding: 8px 12px 12px;
                            }

                            #search-card-map-preview .property-card__price-row {
                                flex-wrap: wrap;
                                gap: 4px 8px;
                            }

                            #search-card-map-preview .property-card__badge {
                                margin-left: 0;
                            }

                            #search-card-map-preview .property-card__details {
                                display: -webkit-box;
                                margin-top: 8px;
                                overflow: hidden;
                                -webkit-line-clamp: 2;
                                -webkit-box-orient: vertical;
                            }

                            #search-card-map-preview .search-card-map-preview-close {
                                top: 8px;
                                left: 8px;
                                width: 28px;
                                height: 28px;
                                font-size: 16px;
                                box-shadow: 0 2px 6px rgba(11, 15, 20, .18);
                            }
                        }

                        @keyframes search-card-map-preview-up {
                            from { opacity: 0; transform: translateY(16px); }
                            to { opacity: 1; transform: none; }
                        }
                    </style>
                </div>
            </aside>
        </div>
    </div>
</section>
