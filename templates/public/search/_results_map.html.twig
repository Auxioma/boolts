{% set resultsCount = totalResults|default(search is defined and search is not null ? search.getTotalItemCount : 0) %}

<section
    class="search-card-map-results"
    data-controller="search-card-map"
    data-search-card-map-token-value="{{ mapboxPublicTokenCard|default(mapboxPublicToken|default(''))|e('html_attr') }}"
    data-search-card-map-bounds-url-value="{{ path('app_public_search_map_bounds', { searchToken: searchToken }) }}"
>
    <div class="container-xxl search-card-container">

        <h1
            class="search-card-title"
            id="search-card-total-results"
            data-search-card-map-target="totalResults"
        >
            {{ resultsCount }}
            logement{{ resultsCount > 1 ? 's' : '' }}
            trouvé{{ resultsCount > 1 ? 's' : '' }}
        </h1>

        <div class="row g-4 align-items-start">

            <section class="col-12 col-lg-6" aria-label="Liste des logements">
                <div
                    class="row g-4"
                    id="search-card-results-grid"
                    data-search-card-map-target="resultsGrid"
                >
                    {% include 'public/search/_cards.html.twig' with {
                        search: search,
                        favoritePropertyIds: favoritePropertyIds|default([])
                    } only %}
                </div>
            </section>

            <aside class="col-12 col-lg-6" aria-label="Carte des logements">
                <div class="search-card-map-panel">

                    <div
                        id="search-card-mapbox"
                        class="search-card-mapbox"
                        data-search-card-map-target="mapbox"
                    ></div>

                    <div
                        id="search-card-map-error"
                        class="search-card-map-error"
                        data-search-card-map-target="error"
                        hidden
                    ></div>

                    <button
                        type="button"
                        class="search-card-map-fit"
                        id="search-card-map-fit"
                        aria-label="Recentrer la carte"
                        data-action="click->search-card-map#fitMap"
                    >
                        Recentrer
                    </button>

                    <article
                        id="search-card-map-preview"
                        class="search-card-map-preview search-card-desktop-only"
                        data-search-card-map-target="preview"
                        hidden
                    >
                        <a
                            href="#"
                            class="search-card-map-preview-link"
                            id="search-card-map-preview-link"
                            data-search-card-map-target="previewLink"
                        >
                            <div
                                class="search-card-map-preview-media"
                                id="search-card-map-preview-media"
                                data-search-card-map-target="previewMedia"
                            ></div>

                            <div class="search-card-map-preview-body">
                                <h2
                                    id="search-card-map-preview-title"
                                    data-search-card-map-target="previewTitle"
                                ></h2>

                                <div class="search-card-map-preview-price">
                                    <strong
                                        id="search-card-map-preview-price"
                                        data-search-card-map-target="previewPrice"
                                    ></strong>

                                    <span
                                        id="search-card-map-preview-period"
                                        data-search-card-map-target="previewPeriod"
                                    ></span>

                                    <em
                                        id="search-card-map-preview-badge"
                                        data-search-card-map-target="previewBadge"
                                    ></em>
                                </div>

                                <p
                                    id="search-card-map-preview-description"
                                    data-search-card-map-target="previewDescription"
                                ></p>

                                <p
                                    id="search-card-map-preview-details"
                                    data-search-card-map-target="previewDetails"
                                ></p>

                                <p
                                    id="search-card-map-preview-address"
                                    data-search-card-map-target="previewAddress"
                                ></p>

                                <p
                                    id="search-card-map-preview-reference"
                                    class="search-card-map-preview-reference"
                                    data-search-card-map-target="previewReference"
                                ></p>

                                <p
                                    id="search-card-map-preview-mapbox"
                                    class="search-card-map-preview-mapbox"
                                    data-search-card-map-target="previewMapbox"
                                ></p>

                                <p
                                    id="search-card-map-preview-energy"
                                    class="search-card-map-preview-energy"
                                    data-search-card-map-target="previewEnergy"
                                ></p>
                            </div>
                        </a>
                    </article>

                </div>
            </aside>

        </div>

    </div>
</section>