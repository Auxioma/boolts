<script>
(function () {
    const MAPBOX_CSS_URLS = [
        'https://api.mapbox.com/mapbox-gl-js/v3.25.0/mapbox-gl.css',
        'https://cdn.jsdelivr.net/npm/mapbox-gl@3.25.0/dist/mapbox-gl.css'
    ];

    const MAPBOX_JS_URLS = [
        'https://api.mapbox.com/mapbox-gl-js/v3.25.0/mapbox-gl.js',
        'https://cdn.jsdelivr.net/npm/mapbox-gl@3.25.0/dist/mapbox-gl.js'
    ];

    function showMapError(message) {
        const errorElement = document.getElementById('search-card-map-error');

        if (!errorElement) {
            console.error(message);
            return;
        }

        errorElement.hidden = false;
        errorElement.textContent = message;
    }

    function loadCssOnce(url) {
        const existing = document.querySelector('link[data-mapbox-gl-css="true"]');

        if (existing) {
            return;
        }

        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = url;
        link.dataset.mapboxGlCss = 'true';

        document.head.appendChild(link);
    }

    function loadScriptWithFallback(urls, index = 0) {
        return new Promise(function (resolve, reject) {
            if (window.mapboxgl) {
                resolve(window.mapboxgl);
                return;
            }

            if (!urls[index]) {
                reject(new Error('Mapbox GL JS ne charge pas.'));
                return;
            }

            const script = document.createElement('script');
            script.src = urls[index];
            script.async = false;
            script.dataset.mapboxGlJs = 'true';

            script.onload = function () {
                if (window.mapboxgl) {
                    resolve(window.mapboxgl);
                    return;
                }

                loadScriptWithFallback(urls, index + 1)
                    .then(resolve)
                    .catch(reject);
            };

            script.onerror = function () {
                script.remove();

                loadScriptWithFallback(urls, index + 1)
                    .then(resolve)
                    .catch(reject);
            };

            document.head.appendChild(script);
        });
    }

    function parseMapProperty(card) {
        const rawValue = card.dataset.mapProperty || '';

        if (!rawValue) {
            return null;
        }

        try {
            const property = JSON.parse(rawValue);

            return {
                ...property,
                id: String(property.id),
                lat: property.lat !== null && property.lat !== '' ? Number(property.lat) : null,
                lng: property.lng !== null && property.lng !== '' ? Number(property.lng) : null,
                card: card
            };
        } catch (error) {
            console.error('[Mapbox] JSON invalide sur la card :', card, error);
            return null;
        }
    }

    function getPropertiesFromCards() {
        const cards = document.querySelectorAll('.search-card-item[data-map-property]');
        const properties = [];

        cards.forEach(function (card) {
            const property = parseMapProperty(card);

            if (property) {
                properties.push(property);
            }
        });

        return properties;
    }

    function isValidMarkerProperty(property) {
        return property
            && Number.isFinite(property.lat)
            && Number.isFinite(property.lng);
    }

    function initSearchMap() {
        const mapElement = document.getElementById('search-card-mapbox');

        if (!mapElement) {
            return;
        }

        const token = mapElement.dataset.mapboxToken || '';

        if (!token || !token.startsWith('pk.')) {
            showMapError('Token Mapbox manquant ou invalide. Il doit commencer par pk.');
            return;
        }

        if (!window.mapboxgl) {
            showMapError('Mapbox GL JS ne charge pas. Vérifie le CDN ou la Content-Security-Policy.');
            return;
        }

        const allProperties = getPropertiesFromCards();
        const markerProperties = allProperties.filter(isValidMarkerProperty);

        console.info('[Mapbox] biens trouvés dans la boucle Twig :', allProperties.length);
        console.info('[Mapbox] biens affichables sur la carte :', markerProperties.length);

        allProperties.forEach(function (property) {
            if (!isValidMarkerProperty(property)) {
                console.warn('[Mapbox] bien ignoré, latitude/longitude invalide ou vide :', property);
            }
        });

        window.mapboxgl.accessToken = token;

        const center = markerProperties.length > 0
            ? [markerProperties[0].lng, markerProperties[0].lat]
            : [2.3522, 48.8566];

        let map;

        try {
            map = new window.mapboxgl.Map({
                container: mapElement,
                style: 'mapbox://styles/mapbox/streets-v12',
                center: center,
                zoom: markerProperties.length > 0 ? 11 : 5
            });
        } catch (error) {
            showMapError('Erreur pendant l’initialisation de Mapbox : ' + error.message);
            return;
        }

        map.addControl(
            new window.mapboxgl.NavigationControl({
                showCompass: false
            }),
            'top-right'
        );

        if (markerProperties.length === 0) {
            showMapError('Aucun logement avec latitude / longitude valide pour afficher la carte.');
            return;
        }

        const bounds = new window.mapboxgl.LngLatBounds();
        const markerElements = new Map();

        const preview = document.getElementById('search-card-map-preview');
        const previewLink = document.getElementById('search-card-map-preview-link');
        const previewMedia = document.getElementById('search-card-map-preview-media');
        const previewTitle = document.getElementById('search-card-map-preview-title');
        const previewPrice = document.getElementById('search-card-map-preview-price');
        const previewPeriod = document.getElementById('search-card-map-preview-period');
        const previewBadge = document.getElementById('search-card-map-preview-badge');
        const previewDescription = document.getElementById('search-card-map-preview-description');
        const previewDetails = document.getElementById('search-card-map-preview-details');
        const previewAddress = document.getElementById('search-card-map-preview-address');
        const previewReference = document.getElementById('search-card-map-preview-reference');
        const previewMapbox = document.getElementById('search-card-map-preview-mapbox');
        const previewEnergy = document.getElementById('search-card-map-preview-energy');

        function clearActiveState() {
            markerElements.forEach(function (element) {
                element.classList.remove('is-active');
            });

            document.querySelectorAll('.search-card-item.is-map-active').forEach(function (card) {
                card.classList.remove('is-map-active');
            });
        }

        function showPreview(property) {
            if (!preview) {
                return;
            }

            preview.hidden = false;

            if (previewLink) {
                previewLink.href = property.url || '#';
            }

            if (previewTitle) {
                previewTitle.textContent = property.title || '';
            }

            if (previewPrice) {
                previewPrice.textContent = property.price || '';
            }

            if (previewPeriod) {
                previewPeriod.textContent = property.period || '';
            }

            if (previewBadge) {
                previewBadge.textContent = property.badge || '';
            }

            if (previewDescription) {
                previewDescription.textContent = property.description || '';
            }

            if (previewDetails) {
                previewDetails.textContent = property.details || '';
            }

            if (previewAddress) {
                previewAddress.textContent = property.address || '';
            }

            if (previewReference) {
                previewReference.textContent = property.referenceInterne
                    ? `Référence : ${property.referenceInterne}`
                    : '';
            }

            if (previewMapbox) {
                const parts = [];

                if (property.mapboxId) {
                    parts.push(`Mapbox : ${property.mapboxId}`);
                }

                if (property.featureType) {
                    parts.push(`Type : ${property.featureType}`);
                }

                if (property.codePostal || property.ville) {
                    parts.push(`${property.codePostal || ''} ${property.ville || ''}`.trim());
                }

                previewMapbox.textContent = parts.join(' · ');
            }

            if (previewEnergy) {
                const parts = [];

                if (property.surfaceTotal) {
                    parts.push(`${property.surfaceTotal}m²`);
                }

                if (property.chambres) {
                    parts.push(`${property.chambres} chambre${Number(property.chambres) > 1 ? 's' : ''}`);
                }

                if (property.salleDeBains) {
                    parts.push(`${property.salleDeBains} salle${Number(property.salleDeBains) > 1 ? 's' : ''} de bains`);
                }

                if (property.dpeLettre) {
                    parts.push(`DPE ${property.dpeLettre}`);
                }

                if (property.gesLettre) {
                    parts.push(`GES ${property.gesLettre}`);
                }

                previewEnergy.textContent = parts.join(' · ');
            }

            if (previewMedia) {
                previewMedia.style.backgroundImage = property.image ? `url("${property.image}")` : '';
            }
        }

        function activateProperty(property, fly = true) {
            clearActiveState();

            const markerElement = markerElements.get(property.id);

            if (markerElement) {
                markerElement.classList.add('is-active');
            }

            if (property.card) {
                property.card.classList.add('is-map-active');
            }

            showPreview(property);

            if (fly) {
                map.flyTo({
                    center: [property.lng, property.lat],
                    zoom: 13.5,
                    speed: 0.9,
                    curve: 1.2,
                    essential: true
                });
            }
        }

        markerProperties.forEach(function (property) {
            const markerElement = document.createElement('button');
            markerElement.type = 'button';
            markerElement.className = 'search-card-mapbox-marker';
            markerElement.textContent = property.price || 'Voir';
            markerElement.setAttribute('aria-label', property.title || 'Voir le logement');

            markerElement.addEventListener('click', function () {
                activateProperty(property, true);
            });

            new window.mapboxgl.Marker({
                element: markerElement,
                anchor: 'bottom'
            })
                .setLngLat([property.lng, property.lat])
                .addTo(map);

            markerElements.set(property.id, markerElement);
            bounds.extend([property.lng, property.lat]);
        });

        map.on('load', function () {
            map.resize();

            if (markerProperties.length > 1) {
                map.fitBounds(bounds, {
                    padding: 80,
                    maxZoom: 13,
                    duration: 900
                });
            }

            activateProperty(markerProperties[0], false);
        });

        map.on('error', function (event) {
            if (event && event.error && event.error.message) {
                console.error(event.error.message);
            }
        });

        document.getElementById('search-card-map-fit')?.addEventListener('click', function () {
            if (markerProperties.length > 1) {
                map.fitBounds(bounds, {
                    padding: 80,
                    maxZoom: 13,
                    duration: 700
                });
            }
        });

        allProperties.forEach(function (property) {
            if (!property.card || !isValidMarkerProperty(property)) {
                return;
            }

            property.card.addEventListener('mouseenter', function () {
                activateProperty(property, false);
            });
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        loadCssOnce(MAPBOX_CSS_URLS[0]);

        loadScriptWithFallback(MAPBOX_JS_URLS)
            .then(initSearchMap)
            .catch(function (error) {
                console.error(error);
                showMapError('Mapbox GL JS ne charge pas. Si le CDN est bloqué, installe Mapbox en local dans public/vendor/mapbox.');
            });
    });
})();
</script>
