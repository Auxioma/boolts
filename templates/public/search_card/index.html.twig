{% extends 'base.html.twig' %}

{% block title %}Boolts - Recherche{% endblock %}

{% block body %}

    {% set totalResults = search is defined ? search.getTotalItemCount : 287 %}
    {% set searchAction = form is defined and form.vars.action is not empty ? form.vars.action : path('app_public_search') %}
    {% set searchMethod = form is defined and form.vars.method is not empty ? form.vars.method|lower : 'post' %}

    <div class="search-card-page">

        <section class="search-card-toolbar" aria-label="Recherche et filtres">
            <div class="search-card-toolbar-inner">

                <button type="button" class="search-card-back search-card-mobile-only" aria-label="Retour">
                    <svg class="search-card-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>

                <form
                    class="search-card-form"
                    action="{{ searchAction }}"
                    method="{{ searchMethod }}"
                    data-controller="home-bt-mapbox-search"
                    data-home-bt-mapbox-search-token-value="{{ mapbox_public_token|default('') }}"
                    data-home-bt-mapbox-search-language-value="{{ app.request.locale|default('fr') }}"
                >

                    {% if form is defined and form.transactionType is defined %}
                        <input
                            type="hidden"
                            name="{{ form.transactionType.vars.full_name }}"
                            id="{{ form.transactionType.vars.id }}"
                            value="{{ form.transactionType.vars.value|default('') }}"
                            data-home-bt-transaction-input
                        >
                    {% endif %}

                    <div class="search-card-field">
                        {% if form is defined and form.filter is defined %}
                            <input
                                type="search"
                                name="{{ form.filter.vars.full_name }}"
                                id="{{ form.filter.vars.id }}"
                                value="{{ form.filter.vars.value|default('Rouen (76)') }}"
                                class="search-card-input"
                                autocomplete="off"
                                placeholder="Rouen (76)"
                                data-home-bt-mapbox-search-target="input"
                                data-action="input->home-bt-mapbox-search#search focus->home-bt-mapbox-search#search keydown->home-bt-mapbox-search#handleKeydown"
                            >
                        {% else %}
                            <input
                                type="search"
                                name="filter"
                                value="Rouen (76)"
                                class="search-card-input"
                                autocomplete="off"
                                placeholder="Rouen (76)"
                                data-home-bt-mapbox-search-target="input"
                                data-action="input->home-bt-mapbox-search#search focus->home-bt-mapbox-search#search keydown->home-bt-mapbox-search#handleKeydown"
                            >
                        {% endif %}

                        <button type="submit" class="search-card-submit" aria-label="Rechercher">
                            <svg class="search-card-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/>
                                <path d="M20 20L16.5 16.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            </svg>
                        </button>

                        <ul
                            class="search-card-results"
                            data-home-bt-mapbox-search-target="results"
                        ></ul>
                    </div>

                    {% if form is defined %}
                        {% set hiddenFields = {
                            selectedValue: 'selectedValue',
                            selectedMapboxId: 'selectedMapboxId',
                            selectedFeatureType: 'selectedFeatureType',
                            selectedCountryName: 'selectedCountryName',
                            selectedCountryCode: 'selectedCountryCode',
                            selectedRegionName: 'selectedRegionName',
                            selectedCityName: 'selectedCityName',
                            selectedPostalCode: 'selectedPostalCode',
                            selectedLatitude: 'selectedLatitude',
                            selectedLongitude: 'selectedLongitude',
                            selectedFullAddress: 'selectedFullAddress',
                            selectedLocale: 'selectedLocale',
                            selectedLocationJson: 'selectedLocationJson',
                        } %}

                        {% for fieldName, targetName in hiddenFields %}
                            {% if attribute(form, fieldName) is defined %}
                                {% set currentField = attribute(form, fieldName) %}

                                <input
                                    type="hidden"
                                    name="{{ currentField.vars.full_name }}"
                                    id="{{ currentField.vars.id }}"
                                    value="{{ fieldName == 'selectedLocale' ? app.request.locale|default('fr') : currentField.vars.value|default('') }}"
                                    data-home-bt-mapbox-search-target="{{ targetName }}"
                                >
                            {% endif %}
                        {% endfor %}

                        {% if form._token is defined %}
                            <input
                                type="hidden"
                                name="{{ form._token.vars.full_name }}"
                                id="{{ form._token.vars.id }}"
                                value="{{ form._token.vars.value }}"
                            >
                        {% endif %}
                    {% endif %}

                </form>

                <div class="search-card-actions">

                    <div class="search-card-switch search-card-desktop-only" aria-label="Choisir l'affichage">
                        <a href="#" class="search-card-switch-item">
                            <svg class="search-card-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M8 6H21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                <path d="M8 12H21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                <path d="M8 18H21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                <path d="M3 6H3.01" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
                                <path d="M3 12H3.01" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
                                <path d="M3 18H3.01" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
                            </svg>
                            <span>Liste</span>
                        </a>

                        <a href="#" class="search-card-switch-item search-card-is-active">
                            <svg class="search-card-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M3 6L9 3L15 6L21 3V18L15 21L9 18L3 21V6Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M9 3V18" stroke="currentColor" stroke-width="2"/>
                                <path d="M15 6V21" stroke="currentColor" stroke-width="2"/>
                            </svg>
                            <span>Carte</span>
                        </a>
                    </div>

                    <button
                        type="button"
                        class="search-card-filter"
                        data-bs-toggle="modal"
                        data-bs-target="#booltsFiltersModal"
                    >
                        <svg class="search-card-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M4 21V14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            <path d="M4 10V3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            <path d="M12 21V12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            <path d="M12 8V3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            <path d="M20 21V16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            <path d="M20 12V3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            <path d="M2 14H6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            <path d="M10 8H14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            <path d="M18 16H22" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                        <span class="search-card-filter-text">Filtres</span>
                    </button>

                </div>
            </div>
        </section>

        <main class="search-card-main" id="results">
            <div class="search-card-container">

                <h1 class="search-card-title">
                    {{ totalResults }} logements trouvés
                </h1>

                <div class="search-card-layout">

                    <section class="search-card-list-col" aria-label="Liste des logements">

                        <div class="search-card-grid">

                            {% if search is defined and search|length > 0 %}

                                {% for bienImmobilier in search %}

                                    {% set uploadedImage = null %}
                                    {% set firstImage = bienImmobilier.propertyImages|first %}

                                    {% if firstImage %}
                                        {% set uploadedImage = vich_uploader_asset(firstImage, 'imageFile') %}
                                    {% endif %}

                                    {% set transactionName = '' %}
                                    {% set transactionSlug = '' %}

                                    {% if bienImmobilier.typeTransaction %}
                                        {% set transactionName = bienImmobilier.typeTransaction.name|default(bienImmobilier.typeTransaction.nom|default('')) %}
                                        {% set transactionSlug = bienImmobilier.typeTransaction.slug|default('') %}
                                    {% endif %}

                                    {% set isLocation = transactionSlug == 'location'
                                        or transactionSlug == 'louer'
                                        or transactionName|lower == 'location'
                                    %}

                                    {% set propertyTitle = bienImmobilier.typeBien and bienImmobilier.typeTransaction
                                        ? bienImmobilier.typeBien.name ~ ' à ' ~ bienImmobilier.typeTransaction.name
                                        : 'Appartement à louer'
                                    %}

                                    {% set propertyPrice = bienImmobilier.prix is not empty
                                        ? bienImmobilier.prix|number_format(0, ',', ' ') ~ '€'
                                        : 'Prix sur demande'
                                    %}

                                    {% set propertyPeriod = isLocation ? '/mois' : '' %}
                                    {% set propertyBadge = isLocation ? 'Charges comprises' : transactionName|capitalize %}

                                    {% set details = [] %}

                                    {% if bienImmobilier.typeBien %}
                                        {% set typeBienName = bienImmobilier.typeBien.name|default(bienImmobilier.typeBien.nom|default('')) %}

                                        {% if typeBienName is not empty %}
                                            {% set details = details|merge([typeBienName]) %}
                                        {% endif %}
                                    {% endif %}

                                    {% if bienImmobilier.chambres is not empty %}
                                        {% set details = details|merge([
                                            bienImmobilier.chambres ~ ' chambre' ~ (bienImmobilier.chambres > 1 ? 's' : ''),
                                        ]) %}
                                    {% endif %}

                                    {% if bienImmobilier.surfaceTotal is not empty %}
                                        {% set details = details|merge([
                                            bienImmobilier.surfaceTotal ~ 'm²',
                                        ]) %}
                                    {% endif %}

                                    {% set addressParts = [] %}

                                    {% if bienImmobilier.adresse is not empty %}
                                        {% set addressParts = addressParts|merge([bienImmobilier.adresse]) %}
                                    {% endif %}

                                    {% if bienImmobilier.codePostal is not empty or bienImmobilier.ville is not empty %}
                                        {% set addressParts = addressParts|merge([
                                            (bienImmobilier.codePostal ~ ' ' ~ bienImmobilier.ville)|trim,
                                        ]) %}
                                    {% endif %}

                                    {% set detailUrl = bienImmobilier.slug is not empty
                                        ? path('app_public_detail_bien', { slug: bienImmobilier.slug })
                                        : '#'
                                    %}

                                    <article class="search-card-item">

                                        <a href="{{ detailUrl }}" class="search-card-link">

                                            <div class="search-card-media">
                                                {% if uploadedImage %}
                                                    <img
                                                        src="{{ uploadedImage }}"
                                                        alt="{{ propertyTitle }}"
                                                        class="search-card-image"
                                                        loading="lazy"
                                                        decoding="async"
                                                    >
                                                {% else %}
                                                    <div class="search-card-image-placeholder"></div>
                                                {% endif %}
                                            </div>

                                            <div class="search-card-body">

                                                <div class="search-card-header">
                                                    <h2 class="search-card-card-title">
                                                        {{ propertyTitle }}
                                                    </h2>
                                                </div>

                                                <div class="search-card-price-row">
                                                    <p class="search-card-price">
                                                        {{ propertyPrice }}
                                                        <span class="search-card-price-period">{{ propertyPeriod }}</span>
                                                    </p>

                                                    {% if propertyBadge is not empty %}
                                                        <span class="search-card-badge">
                                                            {{ propertyBadge }}
                                                        </span>
                                                    {% endif %}
                                                </div>

                                                <p class="search-card-description">
                                                    {{ bienImmobilier.descriptionLogement|default('Appartement très spacieux et lumineux.')|striptags|u.truncate(80, '...') }}
                                                </p>

                                                <p class="search-card-details">
                                                    {{ details|join(' ⸱ ') }}
                                                </p>

                                                <p class="search-card-address">
                                                    {{ addressParts|join(', ') }}
                                                </p>

                                            </div>
                                        </a>

                                        {% if not is_granted('ROLE_AGENCE') %}
                                            <button
                                                type="button"
                                                class="search-card-favorite {{ bienImmobilier.id in favoritePropertyIds|default([]) ? 'search-card-is-favorite' : '' }}"
                                                aria-label="{{ bienImmobilier.id in favoritePropertyIds|default([]) ? 'Retirer des favoris' : 'Ajouter aux favoris' }}"
                                                aria-pressed="{{ bienImmobilier.id in favoritePropertyIds|default([]) ? 'true' : 'false' }}"
                                                data-controller="favorite"
                                                data-action="click->favorite#toggle"
                                                data-favorite-url-value="{{ path('app_favoris_property_toggle', { id: bienImmobilier.id }) }}"
                                                data-favorite-token-value="{{ csrf_token('favorite_property_' ~ bienImmobilier.id) }}"
                                            >
                                                <svg class="search-card-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                                    <path d="M2 9.5C2 8.39 2.34 7.3 2.97 6.38C3.6 5.47 4.49 4.76 5.53 4.36C6.57 3.97 7.71 3.89 8.79 4.15C9.87 4.41 10.85 5 11.59 5.82C11.64 5.88 11.71 5.92 11.78 5.96C11.85 5.99 11.92 6 12 6C12.08 6 12.15 5.99 12.22 5.96C12.29 5.92 12.36 5.88 12.41 5.82C13.15 4.99 14.13 4.4 15.21 4.14C16.3 3.88 17.43 3.95 18.47 4.35C19.52 4.75 20.41 5.45 21.04 6.37C21.67 7.29 22 8.38 22 9.5C22 11.79 20.5 13.5 19 15L13.51 20.31C13.32 20.53 13.09 20.7 12.83 20.82C12.58 20.94 12.3 21 12.01 21C11.73 21 11.45 20.94 11.19 20.83C10.93 20.71 10.7 20.54 10.51 20.33L5 15C3.5 13.5 2 11.8 2 9.5Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                                </svg>
                                            </button>
                                        {% endif %}

                                    </article>

                                {% endfor %}

                            {% else %}

                                {% for i in 1..8 %}
                                    <article class="search-card-item">

                                        <a href="#" class="search-card-link">

                                            <div class="search-card-media">
                                                <div class="search-card-image-placeholder"></div>
                                            </div>

                                            <div class="search-card-body">

                                                <div class="search-card-header">
                                                    <h2 class="search-card-card-title">
                                                        Appartement à louer
                                                    </h2>
                                                </div>

                                                <div class="search-card-price-row">
                                                    <p class="search-card-price">
                                                        765€
                                                        <span class="search-card-price-period">/mois</span>
                                                    </p>

                                                    <span class="search-card-badge">
                                                        Charges comprises
                                                    </span>
                                                </div>

                                                <p class="search-card-description">
                                                    Appartement très spacieux et lumineux.
                                                </p>

                                                <p class="search-card-details">
                                                    2 pièces ⸱ 1 chambre ⸱ 50m²
                                                </p>

                                                <p class="search-card-address">
                                                    Rue de Courteneneuve, 76510 Saint Nicolas d’Aliermont
                                                </p>

                                            </div>
                                        </a>

                                        <button type="button" class="search-card-favorite" aria-label="Ajouter aux favoris">
                                            <svg class="search-card-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                                <path d="M2 9.5C2 8.39 2.34 7.3 2.97 6.38C3.6 5.47 4.49 4.76 5.53 4.36C6.57 3.97 7.71 3.89 8.79 4.15C9.87 4.41 10.85 5 11.59 5.82C11.64 5.88 11.71 5.92 11.78 5.96C11.85 5.99 11.92 6 12 6C12.08 6 12.15 5.99 12.22 5.96C12.29 5.92 12.36 5.88 12.41 5.82C13.15 4.99 14.13 4.4 15.21 4.14C16.3 3.88 17.43 3.95 18.47 4.35C19.52 4.75 20.41 5.45 21.04 6.37C21.67 7.29 22 8.38 22 9.5C22 11.79 20.5 13.5 19 15L13.51 20.31C13.32 20.53 13.09 20.7 12.83 20.82C12.58 20.94 12.3 21 12.01 21C11.73 21 11.45 20.94 11.19 20.83C10.93 20.71 10.7 20.54 10.51 20.33L5 15C3.5 13.5 2 11.8 2 9.5Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                        </button>

                                    </article>
                                {% endfor %}

                            {% endif %}

                        </div>
                    </section>

                    <aside class="search-card-map-col" aria-label="Carte des logements">
                        <div class="search-card-map-panel">

                            <div class="search-card-map-visual" aria-hidden="true"></div>

                            {% set mapMarkers = [
                                { price: '590€', x: 33, y: 36 },
                                { price: '853€', x: 39, y: 45 },
                                { price: '400€', x: 61, y: 33 },
                                { price: '639€', x: 66, y: 50 },
                                { price: '400€', x: 31, y: 62 },
                                { price: '639€', x: 18, y: 65 },
                                { price: '853€', x: 48, y: 70 },
                            ] %}

                            {% for marker in mapMarkers %}
                                <span
                                    class="search-card-marker"
                                    style="left: {{ marker.x }}%; top: {{ marker.y }}%;"
                                >
                                    {{ marker.price }}
                                </span>
                            {% endfor %}

                            <div class="search-card-map-controls">
                                <button type="button" class="search-card-map-button" aria-label="Recentrer la carte">
                                    <svg class="search-card-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                        <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/>
                                        <path d="M12 2V5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                        <path d="M12 19V22" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                        <path d="M2 12H5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                        <path d="M19 12H22" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                    </svg>
                                </button>

                                <div class="search-card-map-zoom">
                                    <button type="button" class="search-card-map-button" aria-label="Zoomer">
                                        <svg class="search-card-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                            <path d="M12 5V19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                            <path d="M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                        </svg>
                                    </button>

                                    <button type="button" class="search-card-map-button" aria-label="Dézoomer">
                                        <svg class="search-card-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                            <path d="M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                        </svg>
                                    </button>
                                </div>
                            </div>

                            <article class="search-card-map-preview search-card-desktop-only">

                                <div class="search-card-map-preview-media"></div>

                                <div class="search-card-map-preview-body">
                                    <div class="search-card-map-preview-header">
                                        <h2>Appartement à louer</h2>

                                        <button type="button" class="search-card-map-preview-favorite" aria-label="Ajouter aux favoris">
                                            <svg class="search-card-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                                <path d="M2 9.5C2 8.39 2.34 7.3 2.97 6.38C3.6 5.47 4.49 4.76 5.53 4.36C6.57 3.97 7.71 3.89 8.79 4.15C9.87 4.41 10.85 5 11.59 5.82C11.64 5.88 11.71 5.92 11.78 5.96C11.85 5.99 11.92 6 12 6C12.08 6 12.15 5.99 12.22 5.96C12.29 5.92 12.36 5.88 12.41 5.82C13.15 4.99 14.13 4.4 15.21 4.14C16.3 3.88 17.43 3.95 18.47 4.35C19.52 4.75 20.41 5.45 21.04 6.37C21.67 7.29 22 8.38 22 9.5C22 11.79 20.5 13.5 19 15L13.51 20.31C13.32 20.53 13.09 20.7 12.83 20.82C12.58 20.94 12.3 21 12.01 21C11.73 21 11.45 20.94 11.19 20.83C10.93 20.71 10.7 20.54 10.51 20.33L5 15C3.5 13.5 2 11.8 2 9.5Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                        </button>
                                    </div>

                                    <div class="search-card-map-preview-price">
                                        <strong>765€</strong>
                                        <span class="search-card-map-preview-period">/mois</span>
                                        <em class="search-card-map-preview-badge">Charges comprises</em>
                                    </div>

                                    <p class="search-card-map-preview-text">Appartement très spacieux et lumineux...</p>
                                    <p class="search-card-map-preview-details">2 pièces ⸱ 1 chambre ⸱ 50m²</p>
                                    <p class="search-card-map-preview-text">Rue de Courteneneuve, 76510 Saint Nicolas...</p>
                                </div>
                            </article>

                        </div>
                    </aside>
                </div>

                <nav class="search-card-pagination" aria-label="Pagination">
                    <a href="#" class="search-card-is-disabled" aria-label="Page précédente">
                        <svg class="search-card-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </a>

                    <a href="#" class="search-card-is-active">1</a>
                    <a href="#">2</a>
                    <a href="#">3</a>
                    <a href="#">4</a>
                    <span>...</span>
                    <a href="#">32</a>

                    <a href="#" aria-label="Page suivante">
                        <svg class="search-card-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </a>
                </nav>

            </div>
        </main>

        <nav class="search-card-mobile-tabbar search-card-mobile-only" aria-label="Navigation mobile">
            <a href="#" class="search-card-mobile-tabbar-link search-card-is-active">
                <svg class="search-card-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/>
                    <path d="M20 20L16.5 16.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                <span>Explorer</span>
            </a>

            <a href="#" class="search-card-mobile-tabbar-link">
                <svg class="search-card-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M2 9.5C2 8.39 2.34 7.3 2.97 6.38C3.6 5.47 4.49 4.76 5.53 4.36C6.57 3.97 7.71 3.89 8.79 4.15C9.87 4.41 10.85 5 11.59 5.82C11.64 5.88 11.71 5.92 11.78 5.96C11.85 5.99 11.92 6 12 6C12.08 6 12.15 5.99 12.22 5.96C12.29 5.92 12.36 5.88 12.41 5.82C13.15 4.99 14.13 4.4 15.21 4.14C16.3 3.88 17.43 3.95 18.47 4.35C19.52 4.75 20.41 5.45 21.04 6.37C21.67 7.29 22 8.38 22 9.5C22 11.79 20.5 13.5 19 15L13.51 20.31C13.32 20.53 13.09 20.7 12.83 20.82C12.58 20.94 12.3 21 12.01 21C11.73 21 11.45 20.94 11.19 20.83C10.93 20.71 10.7 20.54 10.51 20.33L5 15C3.5 13.5 2 11.8 2 9.5Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>Favoris</span>
            </a>

