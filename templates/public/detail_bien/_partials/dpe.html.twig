{#
 Template: templates/public/detail_bien/_partials/dpe.html.twig
 Role: Renders the public/detail_bien/_partials Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

{% if property.dpeLettre or property.gesLettre %}
    <section class="bt-info-section bt-info-section--border-bottom">
        <h3 class="mb-0">Performance énergétique</h3>

        <div class="row gy-4 mt-0">
            <div class="col-12 mt-16">
                <div class="bt-feature d-flex align-items-center gap-2 bt-energy-perf-wrapper pb-0">
                    <div class="container-fluid px-0">
                        <div class="row">

                            {% if property.dpeLettre %}
                            <div class="col-12 col-lg-6">
                                <p class="p-accent bt-energy-perf-title">
                                    Diagnostic de performance énergétique (DPE)
                                </p>
                                {% if property.dpe is not empty %}
                                    <p class="bt-energy-perf-diagnostic-title">
                                        {{ property.dpe }} kWhEP/m²/an
                                    </p>
                                {% endif %}

                                {% set dpeLettre = property.dpeLettre|default('')|trim|lower %}
                                {% set dpeLetters = ['a', 'b', 'c', 'd', 'e', 'f', 'g'] %}

                                {% if dpeLettre in dpeLetters %}
                                    <div class="bt-energy-perf-scale mb-4">
                                        {% for letter in dpeLetters %}
                                            {% if dpeLettre == letter %}
                                                <span class="bt-energy-perf-badge bt-energy-perf-dpe-{{ letter }}">
                                                                                {{ letter|upper }}
                                                                            </span>
                                            {% else %}
                                                <span class="bt-energy-perf-step bt-energy-perf-dpe-{{ letter }}"></span>
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                {% endif %}
                                {% endif %}
                                {% if property.anneeConstruction %}
                                    <div>
                                        <div class="p-accent bt-energy-perf-label">
                                            Année de construction
                                        </div>

                                        <p class="bt-energy-perf-value mb-0">
                                            {{ property.anneeConstruction }}
                                        </p>
                                    </div>
                                {% endif %}
                            </div>

                            {% if property.gesLettre %}
                                <div class="col-12 col-lg-6">
                                    <p class="p-accent bt-energy-perf-title">
                                        Indice d’émission de gaz à effet de serre (GES)
                                    </p>
                                    {% if property.ges is not empty %}
                                        <p class="bt-energy-perf-diagnostic-title">
                                            {{ property.ges }} kgCO2/m²/an
                                        </p>
                                    {% endif %}

                                    {% set gesLettre = property.gesLettre|default('')|trim|lower %}
                                    {% set energyLetters = ['a', 'b', 'c', 'd', 'e', 'f', 'g'] %}

                                    {% if gesLettre in energyLetters %}
                                        <div class="bt-energy-perf-scale mb-4">
                                            {% for letter in energyLetters %}
                                                {% if gesLettre == letter %}
                                                    <span class="bt-energy-perf-badge bt-energy-perf-ges-{{ letter }}">
                                                                                    {{ letter|upper }}
                                                                                </span>
                                                {% else %}
                                                    <span class="bt-energy-perf-step bt-energy-perf-ges-{{ letter }}"></span>
                                                {% endif %}
                                            {% endfor %}
                                        </div>
                                    {% endif %}

                                    {% if property.dateIndexationEnergie %}
                                        <div>
                                            <div class="p-accent bt-energy-perf-label">
                                                Date du diagnostic
                                            </div>

                                            <p class="bt-energy-perf-value mb-0">
                                                {{ property.dateIndexationEnergie|date('d M Y') }}
                                            </p>
                                        </div>
                                    {% endif %}
                                </div>
                            {% endif %}

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endif %}
