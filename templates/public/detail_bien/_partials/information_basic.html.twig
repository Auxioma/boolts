<section class="bt-property-head">
    <h3 class="mb-0">
        {{ property.typeBien.name }} à {{ property.typeTransaction.name }}, {{ property.district }},  {{ property.pays }}
    </h3>
    <p class="bt-property-head__subtitle mb-0 p-accent">
        {{ property.chambres }} chambres - {{ property.salleDeBains }} salle de bain
        {%- if property.surfaceTotal is not empty %} - {{ (property.surfaceTotal + 0)|number_format(property.surfaceTotal + 0 == (property.surfaceTotal + 0)|round ? 0 : 2, ',', ' ') }} m²{% endif %}
    </p>
    <p class="bt-property-head__subtitle__date">
        Annonce publiée le  {{ property.updatedAt|date('d M Y') }}
    </p>
</section>
