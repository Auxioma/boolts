{% for i in 1..7 %}
    <div class="item">
        <div class="bt-property-card">
            <div class="bt-property-card__image">
                <img
                    src="{{ asset('images/default-property.jpg') }}"
                    class="js-bt-img"
                    alt="Bien similaire {{ i }}"
                >
            </div>

            <div class="bt-property-card__body">
                <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
                    <h3 class="bt-property-card__title">
                        Appartement à louer
                    </h3>

                    <i class="bi bi-heart"></i>
                </div>

                <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
                    <div class="bt-property-card__price">
                        765€ <small>/mois</small>
                    </div>

                    <span class="bt-property-card__badge">
                                                                    Charges comprises
                                                                </span>
                </div>

                <p class="bt-property-card__text mb-3">
                    Appartement très spacieux et lumineux...
                </p>

                <p class="bt-property-card__meta mb-1">
                    2 pièces · 1 chambre · 50m2
                </p>

                <p class="bt-property-card__address">
                    Rue de Courteneneuve, 76510 Saint Nicolas...
                </p>
            </div>
        </div>
    </div>
{% endfor %}
