{#
 Template: templates/public/detail_bien/_partials/slider.html.twig
 Role: Renders the public/detail_bien/_partials Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

<section class="agence-properties rond-slider-detail bt-info-section" data-controller="splide">
    <div class="d-flex align-items-start justify-content-between gap-3 mb-3">
        <h3 class="bt-section-title mb-0">
            {{ 'detail_bien.similar.title'|trans({'%city%': property.ville}) }}
        </h3>

        <div class="rond-slider-detail-nav d-flex align-items-center gap-2">
            <button
                class="rond-slider-detail-btn rond-slider-detail-btn--prev"
                type="button"
                aria-label="{{ 'detail_bien.similar.previous'|trans }}"
                data-splide-target="previous"
                data-action="click->splide#previous"
            >
                <i class="icon-circle-arrow-left"></i>
            </button>

            <button
                class="rond-slider-detail-btn rond-slider-detail-btn--next"
                type="button"
                aria-label="{{ 'detail_bien.similar.next'|trans }}"
                data-splide-target="next"
                data-action="click->splide#next"
            >
                <i class="icon-circle-arrow-right"></i>
            </button>
        </div>
    </div>

    <div
        class="splide bt-related-slider"
        data-splide-target="slider"
        aria-label="{{ 'detail_bien.similar.aria_label'|trans }}"
    >
        <div class="splide__track">
            <ul class="splide__list">
                {% for bienImmobilier in properties %}

                                                        {% set firstImage = bienImmobilier.propertyImages|first %}

                                        {% set uploadedImage = null %}

                                        {% if firstImage %}
                                            {% set uploadedImage = vich_uploader_asset(firstImage, 'imageFile') %}
                                        {% endif %}

                                        {% set transactionName = '' %}
                                        {% set transactionSlug = '' %}

                                        {% if bienImmobilier.typeTransaction %}
                                            {% set transactionName = bienImmobilier.typeTransaction.name|default(bienImmobilier.typeTransaction.nom|default('')) %}
                                            {% set transactionSlug = bienImmobilier.typeTransaction.slug|default('') %}
                                        {% endif %}

                                        {% set isLocation = transactionSlug == 'location' or transactionSlug == 'louer' or transactionName|lower == 'location' %}

                                        {% set propertyTitle = 'detail_bien.similar.card.title'|trans({'%type%': bienImmobilier.typeBien.name, '%transaction%': bienImmobilier.typeTransaction.name}) %}
                                        {% set propertyPrice = bienImmobilier.prix is not empty ? bienImmobilier.prix|number_format(0, ',', ' ') ~ ' ' ~ bienImmobilier.user.devise.signe : ' ' %}
                                        {% set propertyPeriod = isLocation ? 'detail_bien.similar.card.per_month'|trans : '' %}
                                        {% set propertyBadge = isLocation ? 'detail_bien.similar.card.charges_included'|trans : transactionName|capitalize %}

                                        {% set details = [] %}

                                        {% if bienImmobilier.typeBien %}
                                            {% set typeBienName = bienImmobilier.typeBien.name|default(bienImmobilier.typeBien.nom|default('')) %}

                                            {% if typeBienName is not empty %}
                                                {% set details = details|merge([typeBienName]) %}
                                            {% endif %}
                                        {% endif %}

                                        {% if bienImmobilier.chambres is not empty %}
                                            {% set details = details|merge([
                                            (bienImmobilier.chambres > 1 ? 'detail_bien.similar.card.bedrooms.other' : 'detail_bien.similar.card.bedrooms.one')|trans({'%count%': bienImmobilier.chambres}),
                                        ]) %}
                                        {% endif %}

                                        {% if bienImmobilier.salleDeBains is not empty and bienImmobilier.salleDeBains != '0' %}
                                            {% set details = details|merge([
                                            (bienImmobilier.salleDeBains > 1 ? 'detail_bien.similar.card.bathrooms.other' : 'detail_bien.similar.card.bathrooms.one')|trans({'%count%': bienImmobilier.salleDeBains}),
                                        ]) %}
                                        {% endif %}

                                        {% if bienImmobilier.surfaceTotal is not empty %}
                                            {% set details = details|merge([
                                            bienImmobilier.surfaceTotal ~ 'm²',
                                        ]) %}
                                        {% endif %}

                                        {% set addressParts = [] %}

                                        {% if bienImmobilier.showAdresse and bienImmobilier.adresse is not empty %}
                                            {% set addressParts = addressParts|merge([bienImmobilier.adresse]) %}
                                        {% elseif bienImmobilier.neighborhood is not empty %}
                                            {% set addressParts = addressParts|merge([bienImmobilier.neighborhood]) %}
                                        {% endif %}

                                        {% if bienImmobilier.codePostal is not empty or bienImmobilier.ville is not empty %}
                                            {% set addressParts = addressParts|merge([
                                            (bienImmobilier.codePostal ~ ' ' ~ bienImmobilier.ville)|trim,
                                        ]) %}
                                        {% endif %}

                                        {% if bienImmobilier.pays is not empty %}
                                            {% set addressParts = addressParts|merge([bienImmobilier.pays]) %}
                                        {% endif %}

                                        {% set detailUrl = path('app_public_detail_bien', {
                                            slug: bienImmobilier.slug,
                                        }) %}

                    <li class="splide__slide">
                        <twig:Property:Card
                                                title="{{ propertyTitle }}"
                                                price="{{ propertyPrice }}"
                                                period="{{ propertyPeriod }}"
                                                badge="{{ propertyBadge }}"
                                                description="{{ bienImmobilier.descriptionLogement|default('')|striptags|u.truncate(80, '...') }}"
                                                details="{{ details|join(' ⸱ ') }}"
                                                address="{{ addressParts|join(', ') }}"
                                                image="{{ uploadedImage }}"
                                                url="{{ detailUrl }}"
                                                favoriteUrl="{{ path('app_favoris_property_toggle', {id: bienImmobilier.id}) }}"
                                                favoriteToken="{{ csrf_token('favorite_property_' ~ bienImmobilier.id) }}"
                                                :isFavorite="bienImmobilier.id in favoritePropertyIds|default([])"
                        />
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
</section>
