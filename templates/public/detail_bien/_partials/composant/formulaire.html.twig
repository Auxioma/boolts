{#
 Template: templates/public/detail_bien/_partials/composant/formulaire.html.twig
 Role: Renders the public/detail_bien/_partials/composant Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

{{ form_start(form, {
    attr: {
        id: 'agency_contact_form',
        class: 'agence-contact-form d-none flex-column',
        'data-agence-contact-form-target': 'form',
    },
}) }}
<div class="agence-field">
    <label for="contact_lastname">{{ 'detail_bien.form.lastname.label'|trans }}</label>
    {{ form_widget(form.nom, {
        attr: {
            id: 'contact_lastname',
            placeholder: 'detail_bien.form.lastname.placeholder'|trans,
            'data-agence-contact-form-target': 'firstField',
        },
    }) }}
</div>

<div class="agence-field">
    <label for="contact_firstname">{{ 'detail_bien.form.firstname.label'|trans }}</label>
    {{ form_widget(form.prenom, {
        id: 'contact_firstname',
        attr: {
            placeholder: 'detail_bien.form.firstname.placeholder'|trans,
            class: 'contact_firstname',
        },
    }) }}
</div>

<div class="agence-field">
    <label for="contact_email">{{ 'detail_bien.form.email.label'|trans }}</label>
    {{ form_widget(form.email, {
        id: 'contact_email',
        attr: {
            placeholder: 'detail_bien.form.email.placeholder'|trans,
        },
    }) }}
</div>

<div class="agence-field">
    <label for="contact_message">{{ 'detail_bien.form.message.label'|trans }}</label>
    {{ form_widget(form.message, {
        id: 'contact_message',
        attr: {
            placeholder: 'detail_bien.form.message.placeholder'|trans,
            rows: 6,
        },
    }) }}
</div>

<button type="submit" class="agence-btn agence-btn-primary w-100">
    <i class="icon-mail"></i>
    {{ 'detail_bien.form.submit'|trans }}
</button>
{{ form_end(form) }}
