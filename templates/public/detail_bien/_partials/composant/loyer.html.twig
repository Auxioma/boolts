{#
 Template: templates/public/detail_bien/_partials/composant/loyer.html.twig
 Role: Renders the public/detail_bien/_partials/composant Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

<div class="d-flex align-items-center justify-content-between gap-3 my-3">

    {% set prixVente = propertyAmounts.prix %}
    {% set loyerHorsCharge = propertyAmounts.loyer %}
    {% set charges = propertyAmounts.charges ?? 0 %}

    {% set hasPrixVente = prixVente is not null %}
    {% set hasLoyerAside = loyerHorsCharge is not null %}

    {% if hasPrixVente or hasLoyerAside %}
        {% if hasPrixVente %}
            <div class="bt-price">
                {{ prixVente|number_format(0, ',', ' ') }} {{ devise }}
            </div>
        {% elseif hasLoyerAside %}
            {% set location = loyerHorsCharge + charges %}

            <div class="bt-price">
                {{ location|number_format(0, ',', ' ') }} {{ devise }}
            </div>

            <div class="bt-charge-badge">
                {{ 'detail_bien.price.charges_included'|trans }}
            </div>
        {% endif %}
    {% endif %}
</div>
