<section class="bt-info-section">
    <h3 class="mb-0">{{ 'detail_bien.costs.title'|trans }}</h3>

    <div class="d-flex flex-column gap-3 bt-cost-detail-card">

        {% if hasLoyer %}
            <div class="d-flex justify-content-between align-items-start gap-3">
                <p class="bt-cost-detail-label mb-0 p-accent">
                    {{ 'detail_bien.costs.rent_charges_included'|trans }}
                </p>

                <p class="bt-cost-detail-price mb-0  p-accent">
                    {% set total = property.montantLoyerHorsCharge + (property.montantDesCharges ?? 0) %}
                    {{ total|number_format(0, ',', ' ') }} {{ property.user.devise.signe }}
                </p>
            </div>
        {% endif %}

        {% if hasCharges %}
            <div class="d-flex justify-content-between align-items-start gap-3">
                <p class="bt-cost-detail-muted mb-0">
                    {{ 'detail_bien.costs.including_charges'|trans }}
                </p>

                <p class="bt-cost-detail-muted mb-0">
                    {{ property.montantDesCharges|number_format(0, ',', ' ') }} {{ property.user.devise.signe }}
                </p>
            </div>
        {% endif %}

        {% if hasDepot %}
            <div class="d-flex justify-content-between align-items-start gap-3">
                <p class="bt-cost-detail-label mb-0 p-accent">
                    {{ 'detail_bien.costs.deposit'|trans }}
                </p>

                <p class="bt-cost-detail-price mb-0 p-accent">
                    {{ property.montantDepotDeGarantie|number_format(0, ',', ' ') }} {{ property.user.devise.signe }}
                </p>
            </div>
        {% endif %}

    </div>
</section>
