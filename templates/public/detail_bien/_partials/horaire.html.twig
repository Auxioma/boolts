{% set horairesRenseignes = property.user.horaireOuvertures|filter(horaire =>
                                    horaire.open
                                    and (
                                    (horaire.ouvertureMatin and horaire.fermetureMatin)
                                    or
                                    (horaire.ouvertureApresMidi and horaire.fermetureApresMidi)
                                    ),
                                    ) %}

{% if horairesRenseignes|length > 0 %}

    {{ include('public/detail_bien/_partials/composant/simple_horaire.html.twig') }}
    {{ include('public/detail_bien/_partials/composant/tous_les_horaires.html.twig') }}

{% endif %}
