{#
 Template: templates/public/detail_bien/_partials/image/cinq_image.html.twig
 Role: Renders the public/detail_bien/_partials/image Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

{% if totalPictures > 0 and firstPicture %}
    <div class="cinq-image">
        <div class="cinq-image-gallery">
            <button
                class="cinq-image-main"
                type="button"
                data-open-gallery
                aria-label="Ouvrir la galerie photos"
            >
                <img
                    src="{{ vich_uploader_asset(firstPicture, 'imageFile') }}"
                    class="cinq-image-img"
                    alt="Photo principale de l'appartement"
                    loading="lazy"
                >
            </button>

            {% set sidePictures = pictures|slice(1, 4) %}

            {% if sidePictures is not empty %}
                <div class="cinq-image-side">
                    {% for row in sidePictures|batch(2) %}
                        {% set rowIndex = loop.index0 %}
                        <div class="cinq-image-row">
                            {% for picture in row %}
                                {% set imageIndex = rowIndex * 2 + loop.index %}
                                <button
                                    class="cinq-image-thumb{% if imageIndex == 2 %} cinq-image-thumb--top-right{% endif %}{% if imageIndex == 4 %} cinq-image-thumb--bottom-right{% endif %}"
                                    type="button"
                                    data-open-gallery
                                    aria-label="Ouvrir la galerie photos"
                                >
                                    <img
                                        src="{{ vich_uploader_asset(picture, 'imageFile') }}"
                                        class="cinq-image-img"
                                        alt="Photo {{ imageIndex + 1 }}"
                                        loading="lazy"
                                    >
                                </button>
                            {% endfor %}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
{% endif %}
