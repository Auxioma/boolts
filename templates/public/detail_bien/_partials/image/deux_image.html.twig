{#
 Template: templates/public/detail_bien/_partials/image/deux_image.html.twig
 Role: Renders the public/detail_bien/_partials/image Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

{% set pictures = property.propertyImages|default([]) %}

{% if pictures|length == 2 %}
    <div class="deux-image">
        <div class="deux-image-gallery">
            {% for picture in pictures %}
                <button
                    class="deux-image-item{% if loop.first %} deux-image-item--first{% endif %}{% if loop.last %} deux-image-item--last{% endif %}"
                    type="button"
                    data-open-gallery
                    aria-label="{{ 'detail_bien.gallery.open'|trans }}"
                >
                    <img
                        src="{{ vich_uploader_asset(picture, 'imageFile') }}"
                        class="deux-image-img"
                        alt="{{ 'detail_bien.photo.number_alt'|trans({'%index%': loop.index}) }}"
                        loading="lazy"
                    >
                </button>
            {% endfor %}
        </div>
    </div>
{% endif %}
