{#
 Template: templates/public/detail_bien/_partials/image/cinq_image.html.twig
 Role: Renders the public/detail_bien/_partials/image Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

{% if totalPictures > 0 and firstPicture %}
    <div class="col-12">
        <div class="row">
            <div class="col-8 pe-2">
                <div
                    class="bt-gallery__main"
                    role="button"
                    tabindex="0"
                    data-open-slider="0"
                    aria-label="Ouvrir la photo principale"
                    style="--bt-hero-bg: url('{{ vich_uploader_asset(firstPicture, 'imageFile') }}');"
                >
                    <img
                        src="{{ vich_uploader_asset(firstPicture, 'imageFile') }}"
                        class="js-bt-img"
                        alt="Photo principale de l'appartement"
                        loading="lazy"
                    >
                </div></div>

            {% set sidePictures = pictures|slice(1, 2) %}

            {% if sidePictures is not empty %}
                <div class="col-4 ps-2">
                    <div class="row">

                        {% for picture in sidePictures %}
                            {% set imageIndex = loop.index %}

                            <div
                                class="bt-gallery__thumb col-12
                            {% if loop.first %} bt-gallery__thumb--top-right pb-3{% endif %}
                            {% if loop.last %} bt-gallery__thumb--bottom-right bt-gallery__thumb--overlay{% endif %}"
                                role="button"
                                tabindex="0"
                                data-open-slider="{{ imageIndex }}"
                                aria-label="Ouvrir la photo {{ imageIndex + 1 }}"
                            >
                                <img
                                    src="{{ vich_uploader_asset(picture, 'imageFile') }}"
                                    class="js-bt-img-tv"
                                    alt="Photo {{ imageIndex + 1 }}"
                                    loading="lazy"
                                >

                            </div>
                        {% endfor %}

                    </div>
                </div>
            {% endif %}
        </div></div>
{% endif %}
