{#
 Template: templates/public/detail_bien/_partials/image/plus_cinq_image.html.twig
 Role: Renders the public/detail_bien/_partials/image Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

{% if totalPictures > 0 and firstPicture %}
    <div class="plus-cinq-images">
        <div class="plus-cinq-images-gallery">
            <div
                class="plus-cinq-images-main"
                role="button"
                tabindex="0"
                data-open-gallery
                aria-label="{{ 'detail_bien.gallery.open'|trans }}"
            >
                <img
                    src="{{ vich_uploader_asset(firstPicture, 'imageFile') }}"
                    class="plus-cinq-images-img"
                    alt="{{ 'detail_bien.photo.main_alt'|trans }}"
                    loading="lazy"
                >
            </div>

            {% set sidePictures = pictures|slice(1, 4) %}

            {% if sidePictures is not empty %}
                <div class="plus-cinq-images-side">
                    {% for row in sidePictures|batch(2) %}
                        {% set rowIndex = loop.index0 %}
                        {% set isLastRow = loop.last %}
                        <div class="plus-cinq-images-row">
                            {% for picture in row %}
                                {% set imageIndex = rowIndex * 2 + loop.index %}
                                {% set isLastThumb = isLastRow and loop.last %}
                                <div
                                    class="plus-cinq-images-thumb{% if imageIndex == 2 %} plus-cinq-images-thumb--top-right{% endif %}{% if imageIndex == 4 %} plus-cinq-images-thumb--bottom-right{% endif %}{% if isLastThumb %} plus-cinq-images-thumb--overlay{% endif %}"
                                    role="button"
                                    tabindex="0"
                                    data-open-gallery
                                    aria-label="{{ 'detail_bien.gallery.open'|trans }}"
                                >
                                    <img
                                        src="{{ vich_uploader_asset(picture, 'imageFile') }}"
                                        class="plus-cinq-images-img"
                                        alt="{{ 'detail_bien.photo.number_alt'|trans({'%index%': imageIndex + 1}) }}"
                                        loading="lazy"
                                    >
                                    {% if isLastThumb %}
                                        <button class="plus-cinq-images-open" type="button" data-open-gallery>
                                            {{ 'detail_bien.gallery.see_all'|trans({'%count%': totalPictures}) }}
                                        </button>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
{% endif %}
