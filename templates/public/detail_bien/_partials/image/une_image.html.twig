 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

{% set pictures = property.propertyImages|default([]) %}
{% set firstPicture = pictures|first %}

{% if pictures|length == 1 and firstPicture %}
    <div class="une-image">
        <div class="une-image-gallery">
            <button
                class="une-image-item"
                type="button"
                data-open-slider="0"
                aria-label="Ouvrir la photo 1"
            >
                <img
                    src="{{ vich_uploader_asset(firstPicture, 'imageFile') }}"
                    class="une-image-img"
                    alt="Photo 1"
                    loading="lazy"
                >
            </button>
        </div>
    </div>
{% endif %}
