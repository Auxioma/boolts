            flex: 0 0 auto;
        }

        .bt-energy-perf-label {
            font-size: 15px;
            font-weight: 700;
            color: #222;
            margin-bottom: 6px;
        }

        .bt-energy-perf-value {
            font-size: 15px;
            color: #8a8a8a;
        }

        .bt-energy-perf-dpe-a {
            background: #009c3b;
        }
        .bt-energy-perf-dpe-b {
            background: #48b600;
        }
        .bt-energy-perf-dpe-c {
            background: #d6db00;
        }
        .bt-energy-perf-dpe-d {
            background: #ffef00;
        }
        .bt-energy-perf-dpe-e {
            background: #f7a600;
        }
        .bt-energy-perf-dpe-f {
            background: #f76b00;
        }
        .bt-energy-perf-dpe-g {
            background: #ed2500;
        }

        .bt-energy-perf-ges-a {
            background: #5fd2e8;
        }
        .bt-energy-perf-ges-b {
            background: #60bfdb;
        }
        .bt-energy-perf-ges-c {
            background: #65a9cf;
        }
        .bt-energy-perf-ges-d {
            background: #4d789e;
        }
        .bt-energy-perf-ges-e {
            background: #3f577e;
        }
        .bt-energy-perf-ges-f {
            background: #303b61;
        }
        .bt-energy-perf-ges-g {
            background: #25113f;
        }

        .bt-cost-detail-card {
            width: 100%;
            background: #f5f5f5;
            border-radius: 20px;
            padding: 28px 24px;
        }

        .bt-cost-detail-title {
            font-size: 20px;
            font-weight: 800;
            color: #151515;
            margin-bottom: 22px;
        }

        .bt-cost-detail-label {
            font-size: 16px;
            font-weight: 700;
            color: #151515;
            line-height: 1.35;
        }

        .bt-cost-detail-price {
            font-size: 16px;
            font-weight: 800;
            color: #151515;
            line-height: 1.35;
            white-space: nowrap;
        }

        .bt-cost-detail-muted {
            font-size: 15px;
            font-weight: 500;
            color: #8b8b8b;
            line-height: 1.35;
            white-space: nowrap;
        }

        @media (max-width: 768px) {
            .bt-slider-stage__image {
                width: 100%;
                height: 65vh;
            }

            .bt-slider-stage__arrow {
                width: 40px;
                height: 40px;
                min-width: 40px;
            }

            .bt-media-modal__body {
                padding-inline: 12px;
            }
        }

        @media (max-width: 576px) {
            .bt-energy-perf-scale {
                gap: 4px;
            }

            .bt-energy-perf-step,
            .bt-energy-perf-badge {
                width: 32px;
            }

            .bt-energy-perf-badge {
                height: 28px;
                font-size: 13px;
            }

            .bt-cost-detail-card {
                border-radius: 18px;
                padding: 24px 18px;
            }

            .bt-cost-detail-title {
                font-size: 19px;
                margin-bottom: 20px;
            }

            .bt-cost-detail-label,
            .bt-cost-detail-price {
                font-size: 15px;
            }

            .bt-cost-detail-muted {
                font-size: 14px;
            }
        }

        @media (min-width: 992px) {
            .bt-contact-sticky-wrapper {
                align-self: stretch;
            }

            .bt-contact-sticky {
                position: sticky;
                top: 90px;
                max-height: calc(100vh - 110px);
                overflow-y: auto;
            }
        }

        @media (max-width: 991.98px) {
            .bt-contact-sticky {
                position: static;
                top: auto;
                max-height: none;
                overflow: visible;
            }
        }
    </style>

    {# ========================= #}
    {# JAVASCRIPT GALERIE #}
    {# ========================= #}

    {% set btPhotos = [] %}

    {% for picture in property.propertyImages %}
        {% set imageSrc = vich_uploader_asset(picture, 'imageFile') %}

        {% if imageSrc %}
            {% set btPhotos = btPhotos|merge([
                {
                    src: imageSrc,
                    alt: 'Photo ' ~ loop.index ~ ' de l’annonce',
                },
            ]) %}
        {% endif %}
    {% endfor %}

    <script>
        const btPhotos = {{ btPhotos|json_encode|raw }};

        const btBody = document.body;
        const btGridModal = document.getElementById("btMediaGridModal");
        const btSliderModal = document.getElementById("btSliderModal");
        const btMediaGrid = document.getElementById("btMediaGrid");
        const btSliderImage = document.getElementById("btSliderImage");
        const btSliderCounter = document.getElementById("btSliderCounter");

        let btCurrentIndex = 0;
        let btTouchStartX = 0;

        function btHasPhotos() {
            return Array.isArray(btPhotos) && btPhotos.length > 0;
        }

        function btLoadOrientation(photo) {
            return new Promise(function (resolve) {
                const image = new Image();

                image.onload = function () {
                    resolve(image.naturalWidth >= image.naturalHeight ? "landscape" : "portrait");
                };
                image.onerror = function () {
                    resolve("landscape");
                };
                image.src = photo.src;
            });
        }

        function btCreateGridItem(index, orientation, modifier) {
            const photo = btPhotos[index];
            const modifierClass = modifier ? ` detail-bien-modal-mensouri-item--${modifier}` : "";

            return `
                <button
                    type="button"
                    class="detail-bien-modal-mensouri-item detail-bien-modal-mensouri-item--${orientation}${modifierClass}"
                    data-open-slider="${index}"
                    aria-label="Ouvrir ${photo.alt}"
                >
                    <img src="${photo.src}" alt="${photo.alt}" loading="lazy">
                </button>
            `;
        }

        function btCreateGridRow(type, items) {
            return `<div class="detail-bien-modal-mensouri-row detail-bien-modal-mensouri-row--${type}">${items.join("")}</div>`;
        }

        // Paysages : alternance pleine largeur / paire côte à côte (1, 2, 1, 2…) ;
        // une image restante seule passe en pleine largeur.
        // 2 → 1 + 1, 3 → 1 + 2, 4 → 1 + 2 + 1, 6 → 1 + 2 + 1 + 2.
        function btRenderLandscapeSequence(indexes) {
            const rows = [];
            let cursor = 0;

            while (cursor < indexes.length) {
                rows.push(btCreateGridRow("one", [btCreateGridItem(indexes[cursor++], "landscape")]));

                if (cursor < indexes.length) {
                    const pair = indexes.slice(cursor, cursor + 2);
                    cursor += pair.length;

                    rows.push(btCreateGridRow(pair.length === 2 ? "two" : "one", pair.map(function (index) {
                        return btCreateGridItem(index, "landscape");
                    })));
                }
            }

            return rows;
        }

        // Portraits : groupes de trois (un grand à gauche, deux empilés à droite), reste de 1 ou 2 sur une rangée.
        function btRenderPortraitSequence(indexes) {
            const rows = [];
            let cursor = 0;

            for (; cursor + 3 <= indexes.length; cursor += 3) {
                rows.push(btCreateGridRow("trio", [
                    btCreateGridItem(indexes[cursor], "portrait", "big"),
                    btCreateGridItem(indexes[cursor + 1], "portrait", "stacked"),
                    btCreateGridItem(indexes[cursor + 2], "portrait", "stacked"),
                ]));
            }

            const rest = indexes.slice(cursor);

            if (rest.length > 0) {
                rows.push(btCreateGridRow(
                    rest.length === 2 ? "two" : "one",
                    rest.map(function (index) {
                        return btCreateGridItem(index, "portrait");
                    })
                ));
            }

            return rows;
        }

        async function btRenderMediaGrid() {
            if (!btHasPhotos() || !btMediaGrid) {
                return;
            }

            const orientations = await Promise.all(btPhotos.map(btLoadOrientation));
            const sequences = [];

            orientations.forEach(function (orientation, index) {
                const current = sequences[sequences.length - 1];

                if (current && current.orientation === orientation) {
                    current.indexes.push(index);
                } else {
                    sequences.push({ orientation: orientation, indexes: [index] });
                }
            });

            const rows = sequences.flatMap(function (sequence) {
                return sequence.orientation === "landscape"
                    ? btRenderLandscapeSequence(sequence.indexes)
                    : btRenderPortraitSequence(sequence.indexes);
            });

            btMediaGrid.innerHTML = rows.join("");
        }

        function btOpenModal(modal) {
            if (!modal) {
                return;
            }

            modal.classList.add("is-open");
            modal.setAttribute("aria-hidden", "false");
            btBody.classList.add("bt-modal-open");
        }

        function btCloseModal(modal) {
            if (!modal) {
                return;
            }

            modal.classList.remove("is-open");
            modal.setAttribute("aria-hidden", "true");

            const isGridOpen = btGridModal && btGridModal.classList.contains("is-open");
            const isSliderOpen = btSliderModal && btSliderModal.classList.contains("is-open");

            if (!isGridOpen && !isSliderOpen) {
                btBody.classList.remove("bt-modal-open");
            }
        }

        function btOpenGrid() {
            if (!btHasPhotos()) {
                return;
            }

            btOpenModal(btGridModal);

            if (btGridModal) {
                btGridModal.scrollTop = 0;
            }
        }

        function btOpenSlider(index) {
            if (!btHasPhotos()) {
                return;
            }

            btCurrentIndex = Number(index) || 0;

            if (btCurrentIndex < 0) {
                btCurrentIndex = 0;
            }

            if (btCurrentIndex >= btPhotos.length) {
                btCurrentIndex = btPhotos.length - 1;
            }

            btUpdateSlider();
            btCloseModal(btGridModal);
            btOpenModal(btSliderModal);
        }

        function btUpdateSlider() {
            if (!btHasPhotos() || !btSliderImage || !btSliderCounter) {
                return;
            }

            const photo = btPhotos[btCurrentIndex];

            btSliderImage.src = photo.src;
            btSliderImage.alt = photo.alt;
            btSliderCounter.textContent = (btCurrentIndex + 1) + "/" + btPhotos.length;
        }

        function btNextSlide() {
            if (!btHasPhotos()) {
                return;
            }

            btCurrentIndex = (btCurrentIndex + 1) % btPhotos.length;
            btUpdateSlider();
        }

        function btPrevSlide() {
            if (!btHasPhotos()) {
                return;
            }

            btCurrentIndex = (btCurrentIndex - 1 + btPhotos.length) % btPhotos.length;
            btUpdateSlider();
        }

        document.addEventListener("click", function (event) {
            const openGalleryBtn = event.target.closest("[data-open-gallery]");
            const openSliderBtn = event.target.closest("[data-open-slider]");

            if (openGalleryBtn) {
                event.preventDefault();
                event.stopPropagation();
                btOpenGrid();
                return;
            }

            if (openSliderBtn) {
                event.preventDefault();
                btOpenSlider(openSliderBtn.dataset.openSlider);
                return;
            }

            if (event.target.closest("[data-close-grid]")) {
                event.preventDefault();
                btCloseModal(btGridModal);
                return;
            }

            if (event.target.closest("[data-close-slider]")) {
                event.preventDefault();
                btCloseModal(btSliderModal);
                return;
            }

            if (event.target.closest("[data-next-slide]")) {
                event.preventDefault();
                btNextSlide();
                return;
            }

            if (event.target.closest("[data-prev-slide]")) {
                event.preventDefault();
                btPrevSlide();
            }
        });

        document.addEventListener("keydown", function (event) {
            const activeElement = document.activeElement;

            if (
                activeElement &&
                activeElement.matches("[data-open-gallery], [data-open-slider]") &&
                (event.key === "Enter" || event.key === " ")
            ) {
                event.preventDefault();

                if (activeElement.hasAttribute("data-open-gallery")) {
                    btOpenGrid();
                    return;
                }

                if (activeElement.hasAttribute("data-open-slider")) {
                    btOpenSlider(activeElement.dataset.openSlider);
                    return;
                }
            }

            if (event.key === "Escape") {
                btCloseModal(btGridModal);
                btCloseModal(btSliderModal);
            }

            if (btSliderModal && btSliderModal.classList.contains("is-open")) {
                if (event.key === "ArrowRight") {
                    btNextSlide();
                }

                if (event.key === "ArrowLeft") {
                    btPrevSlide();
                }
            }
        });

        if (btSliderModal) {
            btSliderModal.addEventListener("touchstart", function (event) {
                btTouchStartX = event.changedTouches[0].clientX;
            }, { passive: true });

            btSliderModal.addEventListener("touchend", function (event) {
                const touchEndX = event.changedTouches[0].clientX;
                const diff = touchEndX - btTouchStartX;

                if (Math.abs(diff) > 50) {
                    diff < 0 ? btNextSlide() : btPrevSlide();
                }
            }, { passive: true });
        }

        btRenderMediaGrid();
        btUpdateSlider();
    </script>
{% endblock %}
