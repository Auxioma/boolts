<script>
    const btImages = [
        "https://www.figma.com/api/mcp/asset/03846a91-5be7-44ca-81a4-b134f0843eff",
        "https://www.figma.com/api/mcp/asset/cf5063fd-6286-4277-b239-7beb1b83b9e0",
        "https://www.figma.com/api/mcp/asset/b662b00a-0892-4733-ae64-27d28034dbc4",
        "https://www.figma.com/api/mcp/asset/2f3606f6-dff3-407e-b0ed-c5654d433e53",
        "https://www.figma.com/api/mcp/asset/512470f2-5680-4c6d-8035-19426ae7bed2",
        "https://www.figma.com/api/mcp/asset/8e4c3d5b-ad48-405f-8397-7c78f1397675",
        "https://www.figma.com/api/mcp/asset/03846a91-5be7-44ca-81a4-b134f0843eff",
        "https://www.figma.com/api/mcp/asset/cf5063fd-6286-4277-b239-7beb1b83b9e0"
    ];

    const btPhotos = Array.from({ length: 32 }, function (_, index) {
        return {
            src: btImages[index % btImages.length],
            alt: "Photo " + (index + 1) + " de l'annonce"
        };
    });

    const btBody = document.body;
    const btGridModal = document.getElementById("btMediaGridModal");
    const btSliderModal = document.getElementById("btSliderModal");
    const btMediaGrid = document.getElementById("btMediaGrid");
    const btSliderImage = document.getElementById("btSliderImage");
    const btSliderCounter = document.getElementById("btSliderCounter");

    let btCurrentIndex = 0;
    let btTouchStartX = 0;

    function btInitImages() {
        document.documentElement.style.setProperty("--bt-gallery-image", "url('" + btPhotos[0].src + "')");

        document.querySelectorAll(".js-bt-img").forEach(function (img, index) {
            img.src = btPhotos[index % btPhotos.length].src;
            img.loading = "lazy";
        });
    }

    function btCreateGridItem(index, className, label) {
        const photo = btPhotos[index % btPhotos.length];

        return `
            <button
                type="button"
                class="bt-media-grid__item ${className}"
                data-open-slider="${index % btPhotos.length}"
                data-label="${label}"
                aria-label="Ouvrir ${photo.alt}">
                <img src="${photo.src}" alt="${photo.alt}" loading="lazy">
            </button>
        `;
    }

    function btRenderMediaGrid() {
        const parts = [];
        let index = 0;

        while (index < btPhotos.length) {
            parts.push(btCreateGridItem(index++, "bt-media-grid__wide", "4:3\n(768x576px)"));

            if (index < btPhotos.length) {
                parts.push(`
                    <div class="d-flex gap-3 gap-md-4">
                        ${btCreateGridItem(index++, "bt-media-grid__half flex-fill", "4:3\n(374x281px)")}
                        ${btCreateGridItem(index++, "bt-media-grid__half flex-fill", "4:3\n(374x281px)")}
                    </div>
                `);
            }

            if (index < btPhotos.length) {
                parts.push(btCreateGridItem(index++, "bt-media-grid__wide", "4:3\n(768x576px)"));
            }

            if (index < btPhotos.length) {
                parts.push(`
                    <div class="bt-media-grid__portrait-row d-flex gap-3 gap-md-4">
                        ${btCreateGridItem(index++, "bt-media-grid__portrait-big", "3:4\n(502x669px)")}
                        <div class="bt-media-grid__portrait-small d-flex flex-column gap-3 gap-md-4">
                            ${btCreateGridItem(index++, "flex-fill", "3:4\n(246x324px)")}
                            ${btCreateGridItem(index++, "flex-fill", "3:4\n(246x324px)")}
                        </div>
                    </div>
                `);
            }
        }

        btMediaGrid.innerHTML = parts.join("");
    }

    function btOpenModal(modal) {
        modal.classList.add("is-open");
        modal.setAttribute("aria-hidden", "false");
        btBody.classList.add("bt-modal-open");
    }

    function btCloseModal(modal) {
        modal.classList.remove("is-open");
        modal.setAttribute("aria-hidden", "true");

        if (!btGridModal.classList.contains("is-open") && !btSliderModal.classList.contains("is-open")) {
            btBody.classList.remove("bt-modal-open");
        }
    }

    function btOpenGrid() {
        btOpenModal(btGridModal);
        btGridModal.scrollTop = 0;
    }

    function btOpenSlider(index) {
        btCurrentIndex = Number(index) || 0;
        btUpdateSlider();
        btCloseModal(btGridModal);
        btOpenModal(btSliderModal);
    }

    function btUpdateSlider() {
        const photo = btPhotos[btCurrentIndex];

        btSliderImage.src = photo.src;
        btSliderImage.alt = photo.alt;
        btSliderCounter.textContent = (btCurrentIndex + 1) + "/" + btPhotos.length;
    }

    function btNextSlide() {
        btCurrentIndex = (btCurrentIndex + 1) % btPhotos.length;
        btUpdateSlider();
    }

    function btPrevSlide() {
        btCurrentIndex = (btCurrentIndex - 1 + btPhotos.length) % btPhotos.length;
        btUpdateSlider();
    }

    document.addEventListener("click", function (event) {
        const openGalleryBtn = event.target.closest("[data-open-gallery]");
        const openSliderBtn = event.target.closest("[data-open-slider]");

        if (openGalleryBtn) {
            event.preventDefault();
            event.stopPropagation();
            btOpenGrid();
            return;
        }

        if (openSliderBtn) {
            event.preventDefault();
            btOpenSlider(openSliderBtn.dataset.openSlider);
            return;
        }

        if (event.target.closest("[data-close-grid]")) {
            btCloseModal(btGridModal);
            return;
        }

        if (event.target.closest("[data-close-slider]")) {
            btCloseModal(btSliderModal);
            return;
        }

        if (event.target.closest("[data-next-slide]")) {
            btNextSlide();
            return;
        }

        if (event.target.closest("[data-prev-slide]")) {
            btPrevSlide();
        }
    });

    document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") {
            btCloseModal(btGridModal);
            btCloseModal(btSliderModal);
        }

        if (btSliderModal.classList.contains("is-open")) {
            if (event.key === "ArrowRight") {
                btNextSlide();
            }

            if (event.key === "ArrowLeft") {
                btPrevSlide();
            }
        }
    });

    btSliderModal.addEventListener("touchstart", function (event) {
        btTouchStartX = event.changedTouches[0].clientX;
    }, { passive: true });

    btSliderModal.addEventListener("touchend", function (event) {
        const touchEndX = event.changedTouches[0].clientX;
        const diff = touchEndX - btTouchStartX;

        if (Math.abs(diff) > 50) {
            diff < 0 ? btNextSlide() : btPrevSlide();
        }
    }, { passive: true });

    btInitImages();
    btRenderMediaGrid();
    btUpdateSlider();
</script>
{% endblock %}
