{% extends 'base.html.twig' %}

{% block title %}Détail du bien{% endblock %}

{% block body %}
    {% set totalPictures = property.propertyImages|length %}
    {% set pictures = property.propertyImages|slice(0, 5) %}
    {% set firstPicture = pictures|first %}

    <div class="bt-page">

        <div class="bt-mobile-topbar align-items-center justify-content-center">
            <button class="bt-icon-btn bt-icon-btn--small position-absolute start-0 ms-2" type="button" aria-label="Retour">
                <i class="bi bi-chevron-left"></i>
            </button>

            <button class="bt-icon-btn bt-icon-btn--small position-absolute end-0 me-2" type="button" aria-label="Favori">
                <i class="bi bi-heart"></i>
            </button>
        </div>

        <main>

            {% if totalPictures > 0 and firstPicture %}
                <section
                    class="bt-hero-responsive position-relative overflow-hidden"
                    data-open-slider="0"
                    style="--bt-hero-bg: url('{{ vich_uploader_asset(firstPicture, 'imageFile') }}');"
                >
                    <img
                        src="{{ vich_uploader_asset(firstPicture, 'imageFile') }}"
                        class="bt-hero-responsive__image js-bt-img"
                        alt="Photo principale de l'annonce"
                        loading="lazy"
                    >

                    <div class="bt-hero-responsive__actions d-flex align-items-center gap-3">
                        <button class="bt-btn bt-btn--glass" type="button" data-open-slider="0">
                            1/{{ totalPictures }}
                        </button>
                    </div>
                </section>
            {% endif %}
<style>
    /* Background flouté */
    .bt-hero-responsive::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 0;
        background-image: var(--bt-hero-bg);
        background-repeat: no-repeat;
        background-position: center center;
        background-size: cover;
        filter: blur(18px);
        transform: scale(1.08);
    }

    /* Image nette au centre */
    .bt-hero-responsive__image {
        position: relative;
        z-index: 1;
        display: block;
        width: auto;
        height: 100%;
        margin: 0 auto;
        object-fit: cover;
        object-position: center center;
    }

    /* Actions au-dessus */
    .bt-hero-responsive__actions {
        position: absolute;
        right: 24px;
        bottom: 24px;
        z-index: 2;
    }
</style>
            <section class="bt-annonce">
                <div class="container bt-annonce__container">

                    {% if property.titreDuLogement|trim is not empty %}
                        <h1 class="bt-annonce__title">
                            {{ property.titreDuLogement }}
                        </h1>
                    {% endif %}

                    {% if totalPictures > 5 %} +5 {{ totalPictures }}
                        {{ include('public/detail_bien/_partials/image/plus_cinq_image.html.twig') }}
                    {% elseif totalPictures == 5 %}5 / {{ totalPictures }}
                        {{ include('public/detail_bien/_partials/image/cinq_image.html.twig') }}
                    {% elseif totalPictures == 4 %} 4 / {{ totalPictures }}
                        {{ include('public/detail_bien/_partials/image/quatre_image.html.twig') }}
                    {% elseif totalPictures == 3 %}3/ {{ totalPictures }}
                        {{ include('public/detail_bien/_partials/image/trois_image.html.twig') }}
                    {% elseif totalPictures == 2 %}2/ {{ totalPictures }}
                        {{ include('public/detail_bien/_partials/image/deux_image.html.twig') }}
                    {% elseif totalPictures == 1 %}1/ {{ totalPictures }}
                        {{ include('public/detail_bien/_partials/image/une_image.html.twig') }}
                    {% endif %}

                    <div class="row g-4 align-items-start">
                        <div class="col-lg-8">
                            {{ include('public/detail_bien/_partials/information_basic.html.twig') }}
                            {{ include('public/detail_bien/_partials/description.html.twig') }}

                            {{ include('public/detail_bien/_partials/caracteristique.html.twig') }}
                            {{ include('public/detail_bien/_partials/dpe.html.twig') }}

                            {% set hasLoyer = property.montantLoyerHorsCharge is not null %}
                            {% set hasCharges = property.montantDesCharges is not null %}
                            {% set hasDepot = property.montantDepotDeGarantie is not null %}

                            {% if hasLoyer or hasCharges or hasDepot %}
                                {{ include('public/detail_bien/_partials/loyer.html.twig') }}
                            {% endif %}

                           {{ include('public/detail_bien/_partials/slider.html.twig') }}

                        </div>

                        <div class="col-lg-4 bt-contact-sticky-wrapper">
                            <aside class="bt-contact-sticky">
                                <div class="bt-contact-card" data-controller="agence-contact-form">

                                    <div class="d-flex align-items-start gap-4 mb-4">
                                        <div class="bt-contact-card__avatar">
                                            {{ include('public/detail_bien/_partials/composant/image_entreprise.html.twig') }}
                                        </div>
                                        <div class="min-w-0">
                                            <p class="bt-contact-card__name">
                                                {{ property.user.entreprise }}
                                                <a href="{{ path('app_public_detail_agence', { 
                                                    slug: property.user.slug }) }}" 
                                                    class="bt-contact-card__link"
                                                >
                                                <i class="icon-chevron-right ms-1"></i>
                                                </a>
                                            </p>
                                            <p class="bt-contact-card__address">
                                                Agence immobilière -
                                                {{ property.user.adresseContact }}
                                                {{ property.user.codePostalContact }}
                                                {{ property.user.villeContact }}
                                                {{ property.user.paysContact }}
                                            </p>
                                            <div class="d-flex flex-column align-items-start gap-1 mt-3">
                                                <button type="button" class="bt-btn bt-btn--outline-primary"
                                                        type="button"
                                                        class="agence-btn agence-btn-outline agence-contact-number"
                                                        data-action="click->agence-contact-form#showPhoneNumber"
                                                        data-agence-contact-form-target="phoneButton">
                                                    Afficher le numéro
                                                </button>
                                                <a
                                                    href="tel:{{ property.user.numeroContact }}"
                                                    class="agence-contact-phone d-none"
                                                    data-agence-contact-form-target="phoneNumber"
                                                >
                                                    {{ property.user.numeroContact }}
                                                </a>
                                                <a href="mailto:agence@agence.agence" class="bt-contact-card__email">
                                                    agence@agence.agence
                                                </a>
                                            </div>
                                        </div>
                                    </div>

                                    {{ include('public/detail_bien/_partials/horaire.html.twig') }}

                                    {{ include('public/detail_bien/_partials/composant/loyer.html.twig') }}

                                    <div class="d-grid gap-3">
                                        {% if property.user.whatsApp is not empty %}
                                            <a href="https://wa.me/{{ property.user.whatsApp }}" class="agence-btn agence-btn-whatsapp">
                                                Contacter via Whatsapp
                                            </a>
                                        {% endif %}

                                        {% if property.user.numeroContact is not empty %}
                                            <a href="tel:{{ property.user.numeroContact }}" class="agence-btn agence-btn-primary">
                                                <i class="icon-phone"></i>
                                                Appeler l’agence
                                            </a>
                                        {% endif %}

                                        <button type="button" class="bt-btn bt-btn--outline-primary w-100"
                                                type="button"
                                                class="agence-btn agence-btn-outline"
                                                data-action="click->agence-contact-form#open"
                                                data-agence-contact-form-target="button"
                                                aria-controls="agency_contact_form"
                                                aria-expanded="false">
                                            <i class="bi bi-envelope"></i>
                                            Contacter par email
                                        </button>
                                    </div>
                                    {{ include('public/detail_bien/_partials/composant/formulaire.html.twig') }}
                                </div>
                            </aside>
                        </div>
                    </div>
                </div>
            </section>
        </main>

        <nav class="bt-mobile-tabbar" aria-label="Navigation mobile">
            <div class="bt-mobile-tabbar__nav d-flex align-items-center justify-content-center">
                <a href="#" class="bt-mobile-tabbar__item is-active d-flex flex-column align-items-center justify-content-between">
                    <i class="bi bi-search fs-5"></i>
                    Explorer
                </a>

                <a href="#" class="bt-mobile-tabbar__item d-flex flex-column align-items-center justify-content-between">
                    <i class="bi bi-heart fs-5"></i>
                    Favoris
                </a>

                <a href="#" class="bt-mobile-tabbar__item d-flex flex-column align-items-center justify-content-between">
                    <i class="bi bi-chat-square fs-5"></i>
                    Messagerie
                </a>

                <a href="#" class="bt-mobile-tabbar__item d-flex flex-column align-items-center justify-content-between">
                    <i class="bi bi-person-circle fs-5"></i>
                    Compte
                </a>
            </div>

            <div class="bt-mobile-tabbar__safe"></div>
        </nav>
    </div>

    {# ========================= #}
    {# MODALE 1 : GRILLE PHOTOS #}
    {# ========================= #}

    {% if totalPictures > 0 %}
        <section class="bt-media-modal" id="btMediaGridModal" aria-hidden="true">

            <div class="bt-media-modal__body position-relative">
                <button
                    class="bt-modal-round bt-media-modal__back"
                    type="button"
                    data-close-grid
                    aria-label="Retour"
                >
                    <i class="bi bi-arrow-left"></i>
                </button>

                <div class="bt-media-grid d-flex flex-column gap-3 gap-md-4" id="btMediaGrid"></div>
            </div>
        </section>

        {# ========================= #}
        {# MODALE 2 : SLIDER IMAGE #}
        {# ========================= #}

        <section class="bt-media-modal" id="btSliderModal" aria-hidden="true">
            <div class="bt-media-modal__body position-relative">
                <button
                    class="bt-modal-round bt-media-modal__back"
                    type="button"
                    data-close-slider
                    aria-label="Fermer"
                >
                    <i class="bi bi-x-lg"></i>
                </button>

                <div class="bt-slider-stage">
                    <div class="bt-slider-stage__counter" id="btSliderCounter">
                        1/{{ totalPictures }}
                    </div>

                    <div class="d-flex align-items-center justify-content-center gap-4">
                        <button
                            class="bt-slider-stage__arrow d-flex align-items-center justify-content-center"
                            type="button"
                            data-prev-slide
                            aria-label="Image précédente"
                        >
                            <i class="bi bi-arrow-left"></i>
                        </button>

                        <div class="bt-slider-stage__image">
                            <img id="btSliderImage" alt="Photo de l'annonce">
                        </div>

                        <button
                            class="bt-slider-stage__arrow d-flex align-items-center justify-content-center"
                            type="button"
                            data-next-slide
                            aria-label="Image suivante"
                        >
                            <i class="bi bi-arrow-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </section>
    {% endif %}

    {# ========================= #}
    {# CSS #}
    {# ========================= #}

    <style>
        .bt-media-modal {
            position: fixed;
            inset: 0;
            z-index: 9999;
            background: #ffffff;
            overflow-y: auto;
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transform: translateY(10px);
            transition: opacity .2s ease, transform .2s ease, visibility .2s ease;
        }

        .bt-media-modal.is-open {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
            transform: translateY(0);
        }

        body.bt-modal-open {
            overflow: hidden;
        }

        .bt-media-modal__body {
            min-height: calc(100vh - 90px);
            padding: 40px 16px 80px;
        }

        .bt-media-modal__back {
            position: sticky;
            top: 24px;
            left: 24px;
            z-index: 20;
        }

        .bt-media-grid {
            max-width: 768px;
            margin: 0 auto;
        }

        .bt-media-grid__item {
            width: 100%;
            border: 0;
            padding: 0;
            background: transparent;
            cursor: pointer;
            overflow: hidden;
            border-radius: 18px;
        }

        .bt-media-grid__item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform .25s ease;
        }

        .bt-media-grid__item:hover img {
            transform: scale(1.03);
        }

        .bt-media-grid__wide {
            aspect-ratio: 4 / 3;
        }

        .bt-media-grid__half {
            aspect-ratio: 4 / 3;
        }

        .bt-media-grid__portrait-row {
            width: 100%;
        }

        .bt-media-grid__portrait-big {
            width: 66%;
            aspect-ratio: 3 / 4;
        }

        .bt-media-grid__portrait-small {
            width: 34%;
        }

        .bt-slider-stage {
            min-height: calc(100vh - 140px);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 32px 16px;
        }

        .bt-slider-stage__counter {
            font-size: 15px;
            font-weight: 700;
            color: #151515;
            margin-bottom: 24px;
        }

        .bt-slider-stage__image {
            width: min(900px, 75vw);
            height: min(620px, 70vh);
            border-radius: 22px;
            overflow: hidden;
            background: #f5f5f5;
        }

        .bt-slider-stage__image img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            display: block;
        }

        .bt-slider-stage__arrow {
            width: 46px;
            height: 46px;
            min-width: 46px;
            border-radius: 50%;
            border: 1px solid #e5e5e5;
            background: #ffffff;
            color: #151515;
            font-size: 18px;
            cursor: pointer;
            transition: background .2s ease, transform .2s ease;
        }

        .bt-slider-stage__arrow:hover {
            background: #f5f5f5;
            transform: scale(1.05);
        }

        .bt-gallery__open {
            cursor: pointer;
            user-select: none;
        }

        .bt-energy-perf-wrapper {
            max-width: 900px;
            width: 100%;
        }

        .bt-energy-perf-title {
            font-size: 15px;
            font-weight: 600;
            color: #151515;
            margin-bottom: 12px;
        }

        .bt-energy-perf-scale {
            display: flex;
            align-items: center;
            gap: 5px;
            min-height: 34px;
        }

        .bt-energy-perf-step {
            width: 38px;
            height: 7px;
            border-radius: 2px;
            display: block;
            flex: 0 0 auto;
        }

        .bt-energy-perf-badge {
            width: 38px;
            height: 30px;
            border-radius: 6px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            font-weight: 700;
            color: #111;
            line-height: 1;
            flex: 0 0 auto;
        }

        .bt-energy-perf-label {
            font-size: 15px;
            font-weight: 700;
            color: #222;
            margin-bottom: 6px;
        }

        .bt-energy-perf-value {
            font-size: 15px;
            color: #8a8a8a;
        }

        .bt-energy-perf-dpe-a { background: #009c3b; }
        .bt-energy-perf-dpe-b { background: #48b600; }
        .bt-energy-perf-dpe-c { background: #d6db00; }
        .bt-energy-perf-dpe-d { background: #ffef00; }
        .bt-energy-perf-dpe-e { background: #f7a600; }
        .bt-energy-perf-dpe-f { background: #f76b00; }
        .bt-energy-perf-dpe-g { background: #ed2500; }

        .bt-energy-perf-ges-a { background: #5fd2e8; }
        .bt-energy-perf-ges-b { background: #60bfdb; }
        .bt-energy-perf-ges-c { background: #65a9cf; }
        .bt-energy-perf-ges-d { background: #4d789e; }
        .bt-energy-perf-ges-e { background: #3f577e; }
        .bt-energy-perf-ges-f { background: #303b61; }
        .bt-energy-perf-ges-g { background: #25113f; }

        .bt-cost-detail-card {
            width: 100%;
            background: #f5f5f5;
            border-radius: 20px;
            padding: 28px 24px;
        }

        .bt-cost-detail-title {
            font-size: 20px;
            font-weight: 800;
            color: #151515;
            margin-bottom: 22px;
        }

        .bt-cost-detail-label {
            font-size: 16px;
            font-weight: 700;
            color: #151515;
            line-height: 1.35;
        }

        .bt-cost-detail-price {
            font-size: 16px;
            font-weight: 800;
            color: #151515;
            line-height: 1.35;
            white-space: nowrap;
        }

        .bt-cost-detail-muted {
            font-size: 15px;
            font-weight: 500;
            color: #8b8b8b;
            line-height: 1.35;
            white-space: nowrap;
        }

        @media (max-width: 768px) {
            .bt-slider-stage__image {
                width: 100%;
                height: 65vh;
            }

            .bt-slider-stage__arrow {
                width: 40px;
                height: 40px;
                min-width: 40px;
            }

            .bt-media-modal__body {
                padding-inline: 12px;
            }
        }

        @media (max-width: 576px) {
            .bt-energy-perf-scale {
                gap: 4px;
            }

            .bt-energy-perf-step,
            .bt-energy-perf-badge {
                width: 32px;
            }

            .bt-energy-perf-badge {
                height: 28px;
                font-size: 13px;
            }

            .bt-cost-detail-card {
                border-radius: 18px;
                padding: 24px 18px;
            }

            .bt-cost-detail-title {
                font-size: 19px;
                margin-bottom: 20px;
            }

            .bt-cost-detail-label,
            .bt-cost-detail-price {
                font-size: 15px;
            }

            .bt-cost-detail-muted {
                font-size: 14px;
            }
        }

        @media (min-width: 992px) {
            .bt-contact-sticky-wrapper {
                align-self: stretch;
            }

            .bt-contact-sticky {
                position: sticky;
                top: 90px;
                max-height: calc(100vh - 110px);
                overflow-y: auto;
            }
        }

        @media (max-width: 991.98px) {
            .bt-contact-sticky {
                position: static;
                top: auto;
                max-height: none;
                overflow: visible;
            }
        }

    </style>

    {# ========================= #}
    {# JAVASCRIPT GALERIE #}
    {# ========================= #}

    {% set btPhotos = [] %}

    {% for picture in property.propertyImages %}
        {% set imageSrc = vich_uploader_asset(picture, 'imageFile') %}

        {% if imageSrc %}
            {% set btPhotos = btPhotos|merge([
                {
                    src: imageSrc,
                    alt: 'Photo ' ~ loop.index ~ ' de l’annonce',
                },
            ]) %}
        {% endif %}
    {% endfor %}

    <script>
        const btPhotos = {{ btPhotos|json_encode|raw }};

        const btBody = document.body;
        const btGridModal = document.getElementById("btMediaGridModal");
        const btSliderModal = document.getElementById("btSliderModal");
        const btMediaGrid = document.getElementById("btMediaGrid");
        const btSliderImage = document.getElementById("btSliderImage");
        const btSliderCounter = document.getElementById("btSliderCounter");

        let btCurrentIndex = 0;
        let btTouchStartX = 0;

        function btHasPhotos() {
            return Array.isArray(btPhotos) && btPhotos.length > 0;
        }

        function btCreateGridItem(index, className) {
            const photo = btPhotos[index];

            return `
                <button
                    type="button"
                    class="bt-media-grid__item ${className}"
                    data-open-slider="${index}"
                    aria-label="Ouvrir ${photo.alt}"
                >
                    <img src="${photo.src}" alt="${photo.alt}" loading="lazy">
                </button>
            `;
        }

        function btRenderMediaGrid() {
            if (!btHasPhotos() || !btMediaGrid) {
                return;
            }

            const parts = [];
            let index = 0;

            while (index < btPhotos.length) {
                parts.push(btCreateGridItem(index++, "bt-media-grid__wide"));

                if (index < btPhotos.length) {
                    const firstHalf = btCreateGridItem(index++, "bt-media-grid__half flex-fill");
                    const secondHalf = index < btPhotos.length
                        ? btCreateGridItem(index++, "bt-media-grid__half flex-fill")
                        : "";

                    parts.push(`
                        <div class="d-flex gap-3 gap-md-4">
                            ${firstHalf}
                            ${secondHalf}
                        </div>
                    `);
                }

                if (index < btPhotos.length) {
                    parts.push(btCreateGridItem(index++, "bt-media-grid__wide"));
                }

                if (index < btPhotos.length) {
                    const bigPortrait = btCreateGridItem(index++, "bt-media-grid__portrait-big");
                    const smallPortraitOne = index < btPhotos.length
                        ? btCreateGridItem(index++, "flex-fill")
                        : "";
                    const smallPortraitTwo = index < btPhotos.length
                        ? btCreateGridItem(index++, "flex-fill")
                        : "";

                    parts.push(`
                        <div class="bt-media-grid__portrait-row d-flex gap-3 gap-md-4">
                            ${bigPortrait}

                            <div class="bt-media-grid__portrait-small d-flex flex-column gap-3 gap-md-4">
                                ${smallPortraitOne}
                                ${smallPortraitTwo}
                            </div>
                        </div>
                    `);
                }
            }

            btMediaGrid.innerHTML = parts.join("");
        }

        function btOpenModal(modal) {
            if (!modal) {
                return;
            }

            modal.classList.add("is-open");
            modal.setAttribute("aria-hidden", "false");
            btBody.classList.add("bt-modal-open");
        }

        function btCloseModal(modal) {
            if (!modal) {
                return;
            }

            modal.classList.remove("is-open");
            modal.setAttribute("aria-hidden", "true");

            const isGridOpen = btGridModal && btGridModal.classList.contains("is-open");
            const isSliderOpen = btSliderModal && btSliderModal.classList.contains("is-open");

            if (!isGridOpen && !isSliderOpen) {
                btBody.classList.remove("bt-modal-open");
            }
        }

        function btOpenGrid() {
            if (!btHasPhotos()) {
                return;
            }

            btOpenModal(btGridModal);

            if (btGridModal) {
                btGridModal.scrollTop = 0;
            }
        }

        function btOpenSlider(index) {
            if (!btHasPhotos()) {
                return;
            }

            btCurrentIndex = Number(index) || 0;

            if (btCurrentIndex < 0) {
                btCurrentIndex = 0;
            }

            if (btCurrentIndex >= btPhotos.length) {
                btCurrentIndex = btPhotos.length - 1;
            }

            btUpdateSlider();
            btCloseModal(btGridModal);
            btOpenModal(btSliderModal);
        }

        function btUpdateSlider() {
            if (!btHasPhotos() || !btSliderImage || !btSliderCounter) {
                return;
            }

            const photo = btPhotos[btCurrentIndex];

            btSliderImage.src = photo.src;
            btSliderImage.alt = photo.alt;
            btSliderCounter.textContent = (btCurrentIndex + 1) + "/" + btPhotos.length;
        }

        function btNextSlide() {
            if (!btHasPhotos()) {
                return;
            }

            btCurrentIndex = (btCurrentIndex + 1) % btPhotos.length;
            btUpdateSlider();
        }

        function btPrevSlide() {
            if (!btHasPhotos()) {
                return;
            }

            btCurrentIndex = (btCurrentIndex - 1 + btPhotos.length) % btPhotos.length;
            btUpdateSlider();
        }

        document.addEventListener("click", function (event) {
            const openGalleryBtn = event.target.closest("[data-open-gallery]");
            const openSliderBtn = event.target.closest("[data-open-slider]");

            if (openGalleryBtn) {
                event.preventDefault();
                event.stopPropagation();
                btOpenGrid();
                return;
            }

            if (openSliderBtn) {
                event.preventDefault();
                btOpenSlider(openSliderBtn.dataset.openSlider);
                return;
            }

            if (event.target.closest("[data-close-grid]")) {
                event.preventDefault();
                btCloseModal(btGridModal);
                return;
            }

            if (event.target.closest("[data-close-slider]")) {
                event.preventDefault();
                btCloseModal(btSliderModal);
                return;
            }

            if (event.target.closest("[data-next-slide]")) {
                event.preventDefault();
                btNextSlide();
                return;
            }

            if (event.target.closest("[data-prev-slide]")) {
                event.preventDefault();
                btPrevSlide();
            }
        });

        document.addEventListener("keydown", function (event) {
            const activeElement = document.activeElement;

            if (
                activeElement &&
                activeElement.matches("[data-open-gallery], [data-open-slider]") &&
                (event.key === "Enter" || event.key === " ")
            ) {
                event.preventDefault();

                if (activeElement.hasAttribute("data-open-gallery")) {
                    btOpenGrid();
                    return;
                }

                if (activeElement.hasAttribute("data-open-slider")) {
                    btOpenSlider(activeElement.dataset.openSlider);
                    return;
                }
            }

            if (event.key === "Escape") {
                btCloseModal(btGridModal);
                btCloseModal(btSliderModal);
            }

            if (btSliderModal && btSliderModal.classList.contains("is-open")) {
                if (event.key === "ArrowRight") {
                    btNextSlide();
                }

                if (event.key === "ArrowLeft") {
                    btPrevSlide();
                }
            }
        });

        if (btSliderModal) {
            btSliderModal.addEventListener("touchstart", function (event) {
                btTouchStartX = event.changedTouches[0].clientX;
            }, { passive: true });

            btSliderModal.addEventListener("touchend", function (event) {
                const touchEndX = event.changedTouches[0].clientX;
                const diff = touchEndX - btTouchStartX;

                if (Math.abs(diff) > 50) {
                    diff < 0 ? btNextSlide() : btPrevSlide();
                }
            }, { passive: true });
        }

        btRenderMediaGrid();
        btUpdateSlider();
    </script>
{% endblock %}
