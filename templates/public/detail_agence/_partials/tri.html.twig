{#
 Template: templates/public/detail_agence/_partials/tri.html.twig
 Role: Renders the public/detail_agence/_partials Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

{% set routeName = app.request.attributes.get('_route') %}
                                    {% set routeParams = app.request.attributes.get('_route_params') %}
                                    {% set queryParams = app.request.query.all %}
                                    {% set baseParams = routeParams|merge(queryParams)|merge({page: 1}) %}

                                    {% set currentSort = app.request.query.get('sort', 'p.createdAt') %}
                                    {% set currentDirection = app.request.query.get('direction', 'desc') %}

                                    {% set currentLabel = 'detail_agence.sort.current.newest'|trans %}

                                    {% if currentSort == 'p.createdAt' and currentDirection == 'asc' %}
                                        {% set currentLabel = 'detail_agence.sort.current.oldest'|trans %}
                                    {% elseif currentSort == 'p.views' and currentDirection == 'desc' %}
                                        {% set currentLabel = 'detail_agence.sort.current.views_desc'|trans %}
                                    {% elseif currentSort == 'p.views' and currentDirection == 'asc' %}
                                        {% set currentLabel = 'detail_agence.sort.current.views_asc'|trans %}
                                    {% elseif currentSort == 'favorisCount' and currentDirection == 'desc' %}
                                        {% set currentLabel = 'detail_agence.sort.current.favorites_desc'|trans %}
                                    {% elseif currentSort == 'favorisCount' and currentDirection == 'asc' %}
                                        {% set currentLabel = 'detail_agence.sort.current.favorites_asc'|trans %}
                                    {% endif %}
<div class="agence-filter-sort" data-controller="agence-sort">
    <button
        type="button"
        class="agence-filter-btn rounded-pill p-accent"
        data-action="click->agence-sort#toggle"
        data-agence-sort-target="button"
        aria-expanded="false"
    >
        <i class="icon-arrow-down-up"></i>
        {{ 'detail_agence.sort.button'|trans({'%label%': currentLabel}) }}
    </button>

    <div
        class="agence-filter-sort__dropdown d-none"
        data-agence-sort-target="menu"
        role="menu"
        aria-label="{{ 'detail_agence.sort.aria_label'|trans }}"
    >
        <a
            href="{{ path(routeName, baseParams|merge({sort: 'p.createdAt', direction: 'desc'})) }}"
            class="agence-filter-sort__item {{ currentSort == 'p.createdAt' and currentDirection == 'desc' ? 'agence-filter-sort__item--active' : '' }}"
            role="menuitem"
        >
            {{ 'detail_agence.sort.option.date_desc'|trans }}
        </a>

        <a
            href="{{ path(routeName, baseParams|merge({sort: 'p.createdAt', direction: 'asc'})) }}"
            class="agence-filter-sort__item {{ currentSort == 'p.createdAt' and currentDirection == 'asc' ? 'agence-filter-sort__item--active' : '' }}"
            role="menuitem"
        >
            {{ 'detail_agence.sort.option.date_asc'|trans }}
        </a>

        <a
            href="{{ path(routeName, baseParams|merge({sort: 'p.views', direction: 'desc'})) }}"
            class="agence-filter-sort__item {{ currentSort == 'p.views' and currentDirection == 'desc' ? 'agence-filter-sort__item--active' : '' }}"
            role="menuitem"
        >
            {{ 'detail_agence.sort.option.views_desc'|trans }}
        </a>

        <a
            href="{{ path(routeName, baseParams|merge({sort: 'p.views', direction: 'asc'})) }}"
            class="agence-filter-sort__item {{ currentSort == 'p.views' and currentDirection == 'asc' ? 'agence-filter-sort__item--active' : '' }}"
            role="menuitem"
        >
            {{ 'detail_agence.sort.option.views_asc'|trans }}
        </a>

        <a
            href="{{ path(routeName, baseParams|merge({sort: 'favorisCount', direction: 'desc'})) }}"
            class="agence-filter-sort__item {{ currentSort == 'favorisCount' and currentDirection == 'desc' ? 'agence-filter-sort__item--active' : '' }}"
            role="menuitem"
        >
            {{ 'detail_agence.sort.option.favorites_desc'|trans }}
        </a>

        <a
            href="{{ path(routeName, baseParams|merge({sort: 'favorisCount', direction: 'asc'})) }}"
            class="agence-filter-sort__item {{ currentSort == 'favorisCount' and currentDirection == 'asc' ? 'agence-filter-sort__item--active' : '' }}"
            role="menuitem"
        >
            {{ 'detail_agence.sort.option.favorites_asc'|trans }}
        </a>
    </div>
</div>
