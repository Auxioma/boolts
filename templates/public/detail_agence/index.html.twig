{% extends 'base.html.twig' %}

{% block title %}Axa Immobilier
{% endblock %}

{% block body %}

	{% set avatar = user.imageName ? vich_uploader_asset(user, 'imageFile') : null %}
	{% set firstLetter = user.prenom ? user.prenom|first|upper : null %}

	{% set logo = 'https://placehold.co/600x400/000000/FFFFFF/png' %}
	{% set agencyAvatar = 'https://placehold.co/600x400/000000/FFFFFF/png' %}
	{% set propertyImageFallback = 'https://placehold.co/600x400/000000/FFFFFF/png' %}

	<div
		class="agence-page">
		{# Barre retour mobile #}
		<div class="agence-mobile-topbar d-flex d-md-none align-items-center">
			<button type="button" class="agence-icon-btn">
				<i class="icon-chevron-left"></i>
			</button>
		</div>

        {% if app.user and is_granted('ROLE_AGENCE') %}
            {# Barre violette desktop uniquement #}
            <div class="agence-preview-bar d-none d-lg-flex align-items-center justify-content-center">
                <span>Voici comment votre agence est présentée aux particuliers.</span>
                <a href="{{ path('agence_immobiliere_parametres') }}" class="agence-preview-btn">Modifier</a>
            </div>
        {% endif %}

		<main class="agence-main">
			<div class="container-fluid px-3 px-md-5 px-xl-0">
				<div class="container-xl px-0">

					<div class="row g-4 align-items-start">

						<div
							class="col-12 col-lg-8">

							{# Profil agence #}
							<section class="agence-profile d-flex align-items-center">
								{% if avatar %}
									<img src="{{ avatar }}" alt="{{ user.entreprise }}" class="agence-profile-avatar">
								{% else %}
									<img src="{{ asset('images/svg/' ~ firstLetter ~ '.svg') }}" alt="{{ user.entreprise }}" class="agence-profile-avatar">
								{% endif %}
								<div class="agence-profile-content">
									<h1>{{ user.entreprise }}</h1>

									<p class="agence-profile-description d-none d-lg-block">
										{{ user.description|default('')|striptags|u.truncate(240, '...') }}
									</p>

									<div class="agence-profile-infos">
										<p>Agence immobilière -
											{{ user.adresseContact }}
											{{ user.codePostalContact }}
											{{ user.villeContact }}</p>
										<p class="d-md-none d-lg-none">+1 202 XXX XXXX</p>
										<p>{{ user.emailContact }}</p>
									</div>
								</div>
							</section>

							{# Recherche #}
							<section class="agence-search-section">
								<form class="agence-search">
									<input type="search" placeholder="Rechercher un bien, une référence">

									<button type="submit">
										<i class="icon-search"></i>
									</button>
								</form>

								<div class="d-flex flex-wrap gap-2">
									<button type="button" class="agence-filter-btn">
										<i class="icon-sliders-horizontal"></i>
										Filtres
									</button>

                                    {% set routeName = app.request.attributes.get('_route') %}
                                    {% set routeParams = app.request.attributes.get('_route_params') %}
                                    {% set queryParams = app.request.query.all %}
                                    {% set baseParams = routeParams|merge(queryParams)|merge({ page: 1 }) %}

                                    {% set currentSort = app.request.query.get('sort', 'p.createdAt') %}
                                    {% set currentDirection = app.request.query.get('direction', 'desc') %}

                                    {% set currentLabel = 'Plus récentes' %}

                                    {% if currentSort == 'p.createdAt' and currentDirection == 'asc' %}
                                        {% set currentLabel = 'Plus anciennes' %}
                                    {% elseif currentSort == 'p.views' and currentDirection == 'desc' %}
                                        {% set currentLabel = 'Vues : plus → moins' %}
                                    {% elseif currentSort == 'p.views' and currentDirection == 'asc' %}
                                        {% set currentLabel = 'Vues : moins → plus' %}
                                    {% elseif currentSort == 'favorisCount' and currentDirection == 'desc' %}
                                        {% set currentLabel = 'Favoris : plus → moins' %}
                                    {% elseif currentSort == 'favorisCount' and currentDirection == 'asc' %}
                                        {% set currentLabel = 'Favoris : moins → plus' %}
                                    {% endif %}

                                    <div class="agence-filter-sort" data-controller="agence-sort">
                                        <button
                                            type="button"
                                            class="agence-filter-btn"
                                            data-action="click->agence-sort#toggle"
                                            data-agence-sort-target="button"
                                            aria-expanded="false"
                                        >
                                            <i class="icon-arrow-down-up"></i>
                                            Tri : {{ currentLabel }}
                                        </button>

                                        <div
                                            class="agence-filter-sort__dropdown d-none"
                                            data-agence-sort-target="menu"
                                            role="menu"
                                            aria-label="Trier les annonces"
                                        >
                                            <a
                                                href="{{ path(routeName, baseParams|merge({ sort: 'p.createdAt', direction: 'desc' })) }}"
                                                class="agence-filter-sort__item {{ currentSort == 'p.createdAt' and currentDirection == 'desc' ? 'agence-filter-sort__item--active' : '' }}"
                                                role="menuitem"
                                            >
                                                Date d'ajout (récent → ancien)
                                            </a>

                                            <a
                                                href="{{ path(routeName, baseParams|merge({ sort: 'p.createdAt', direction: 'asc' })) }}"
                                                class="agence-filter-sort__item {{ currentSort == 'p.createdAt' and currentDirection == 'asc' ? 'agence-filter-sort__item--active' : '' }}"
                                                role="menuitem"
                                            >
                                                Date d'ajout (ancien → récent)
                                            </a>

                                            <a
                                                href="{{ path(routeName, baseParams|merge({ sort: 'p.views', direction: 'desc' })) }}"
                                                class="agence-filter-sort__item {{ currentSort == 'p.views' and currentDirection == 'desc' ? 'agence-filter-sort__item--active' : '' }}"
                                                role="menuitem"
                                            >
                                                Vues (plus → moins)
                                            </a>

                                            <a
                                                href="{{ path(routeName, baseParams|merge({ sort: 'p.views', direction: 'asc' })) }}"
                                                class="agence-filter-sort__item {{ currentSort == 'p.views' and currentDirection == 'asc' ? 'agence-filter-sort__item--active' : '' }}"
                                                role="menuitem"
                                            >
                                                Vues (moins → plus)
                                            </a>

                                            <a
                                                href="{{ path(routeName, baseParams|merge({ sort: 'favorisCount', direction: 'desc' })) }}"
                                                class="agence-filter-sort__item {{ currentSort == 'favorisCount' and currentDirection == 'desc' ? 'agence-filter-sort__item--active' : '' }}"
                                                role="menuitem"
                                            >
                                                Favoris (plus → moins)
                                            </a>

                                            <a
                                                href="{{ path(routeName, baseParams|merge({ sort: 'favorisCount', direction: 'asc' })) }}"
                                                class="agence-filter-sort__item {{ currentSort == 'favorisCount' and currentDirection == 'asc' ? 'agence-filter-sort__item--active' : '' }}"
                                                role="menuitem"
                                            >
                                                Favoris (moins → plus)
                                            </a>
                                        </div>
                                    </div>
								</div>
							</section>
<style>
    .agence-filter-sort {
        position: relative;
        display: inline-flex;
    }

    .agence-filter-sort__dropdown {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        z-index: 100;

        width: 229px;

        display: flex;
        flex-direction: column;

        background: #ffffff;
        border: 1px solid #ebecec;
        border-radius: 8px;
        box-shadow: 0 4px 24.1px rgba(0, 0, 0, 0.05);
        overflow: hidden;

        font-family: "Eudoxus Sans", sans-serif;
    }

    .agence-filter-sort__item {
        width: 100%;
        min-height: 36px;
        padding: 8px 16px;

        display: flex;
        align-items: center;

        color: #0b0f14;
        background: #ffffff;

        font-family: "Eudoxus Sans", sans-serif;
        font-size: 14px;
        font-weight: 500;
        line-height: 20px;
        text-decoration: none;
        white-space: nowrap;
    }

    .agence-filter-sort__item:hover {
        background: #f8f8f8;
        color: #0b0f14;
    }

    .agence-filter-sort__item--active {
        background: #5d00ff;
        color: #ffffff;
    }

    .agence-filter-sort__item--active:hover {
        background: #5d00ff;
        color: #ffffff;
    }
</style>
							{# Liste des biens immobiliers #}
							<section class="agence-properties">
								<h2>Biens de l’agence récemment ajoutés</h2>

								<div class="row g-3 g-lg-4">

									{% for bienImmobilier in properties %}

										{% set firstImage = bienImmobilier.propertyImages|first %}

										{% if firstImage %}
											{% set uploadedImage = vich_uploader_asset(firstImage, 'imageFile') %}
										{% endif %}

										{% set transactionName = '' %}
										{% set transactionSlug = '' %}

										{% if bienImmobilier.typeTransaction %}
											{% set transactionName = bienImmobilier.typeTransaction.name|default(bienImmobilier.typeTransaction.nom|default('')) %}
											{% set transactionSlug = bienImmobilier.typeTransaction.slug|default('') %}
										{% endif %}

										{% set isLocation = transactionSlug == 'location' or transactionSlug == 'louer' or transactionName|lower == 'location' %}

										{% set propertyTitle = bienImmobilier.typeBien.name ~ ' à ' ~ bienImmobilier.typeTransaction.name %}
										{% set propertyPrice = bienImmobilier.prix is not empty ? bienImmobilier.prix|number_format(0, ',', ' ') ~ '€' : 'Prix sur demande' %}
										{% set propertyPeriod = isLocation ? '/mois' : '' %}
										{% set propertyBadge = isLocation ? 'Charges comprises' : transactionName|capitalize %}

										{% set details = [] %}

										{% if bienImmobilier.typeBien %}
											{% set typeBienName = bienImmobilier.typeBien.name|default(bienImmobilier.typeBien.nom|default('')) %}

											{% if typeBienName is not empty %}
												{% set details = details|merge([typeBienName]) %}
											{% endif %}
										{% endif %}

										{% if bienImmobilier.chambres is not empty %}
											{% set details = details|merge([
                                            bienImmobilier.chambres ~ ' chambre' ~ (bienImmobilier.chambres > 1 ? 's' : ''),
                                        ]) %}
										{% endif %}

										{% if bienImmobilier.salleDeBains is not empty and bienImmobilier.salleDeBains != '0' %}
											{% set details = details|merge([
                                            bienImmobilier.salleDeBains ~ ' salle' ~ (bienImmobilier.salleDeBains > 1 ? 's' : '') ~ ' de bains',
                                        ]) %}
										{% endif %}

										{% if bienImmobilier.surfaceTotal is not empty %}
											{% set details = details|merge([
                                            bienImmobilier.surfaceTotal ~ 'm²',
                                        ]) %}
										{% endif %}

										{% set addressParts = [] %}

										{% if bienImmobilier.adresse is not empty %}
											{% set addressParts = addressParts|merge([bienImmobilier.adresse]) %}
										{% endif %}

										{% if bienImmobilier.codePostal is not empty or bienImmobilier.ville is not empty %}
											{% set addressParts = addressParts|merge([
                                            (bienImmobilier.codePostal ~ ' ' ~ bienImmobilier.ville)|trim,
                                        ]) %}
										{% endif %}

										<div class="col-12 col-md-6">
											<twig:Property:Card
                                            title="{{ propertyTitle }}"
                                            price="{{ propertyPrice }}"
                                            period="{{ propertyPeriod }}"
                                            badge="{{ propertyBadge }}"
                                            description="{{ bienImmobilier.descriptionLogement|default('')|striptags|u.truncate(80, '...') }}"
                                            details="{{ details|join(' ⸱ ') }}"
                                            address="{{ addressParts|join(', ') }}"
                                            image="{{ uploadedImage }}"
                                            favoriteurl="#"/>
										</div>

									{% else %}

										<div class="col-12">
											<div class="agence-empty-state">
												Aucun bien n’est disponible pour le moment.
											</div>
										</div>

									{% endfor %}

								</div>
							</section>

							{# Pagination #}
							{{ knp_pagination_render(properties, 'pagination/agence_pagination.html.twig') }}

						</div>

						{# Contact desktop #}
						<aside class="col-12 col-lg-4">
							<div class="agence-contact-card" data-controller="agence-contact-form">
								<div class="agence-contact-head d-flex gap-4">
									{% if avatar %}
										<img src="{{ avatar }}" alt="{{ user.entreprise }}">
									{% else %}
										<img src="{{ asset('images/svg/' ~ firstLetter ~ '.svg') }}" alt="{{ user.entreprise }}">
									{% endif %}

									<div>
										<h3>{{ user.entreprise }}</h3>

										<p>
											Agence immobilière -
											{{ user.adresseContact }}
											{{ user.codePostalContact }}
											{{ user.villeContact }}
										</p>

                                        {% if user.numeroContact is not empty %}
                                            <button
                                                type="button"
                                                class="agence-btn agence-btn-outline agence-contact-number"
                                                data-action="click->agence-contact-form#showPhoneNumber"
                                                data-agence-contact-form-target="phoneButton"
                                            >
                                                Afficher le numéro
                                            </button>

                                            <a
                                                href="tel:{{ user.numeroContact }}"
                                                class="agence-contact-phone d-none"
                                                data-agence-contact-form-target="phoneNumber"
                                            >
                                                {{ user.numeroContact }}
                                            </a>
                                        {% endif %}

										<a href="mailto:{{ user.emailContact }}" class="agence-contact-email d-lg-none">
											{{ user.emailContact }}
										</a>
									</div>
								</div>

                                {# début horaire simple #}
                                {% set jours = {
                                    1: 'lundi',
                                    2: 'mardi',
                                    3: 'mercredi',
                                    4: 'jeudi',
                                    5: 'vendredi',
                                    6: 'samedi',
                                    7: 'dimanche'
                                } %}

                                {% set jourActuel = jours["now"|date("N")] %}

                                {% set horaireDuJour = null %}

                                {% for horaire in user.horaireOuvertures %}
                                    {% if horaire.jour|lower|trim == jourActuel %}
                                        {% set horaireDuJour = horaire %}
                                    {% endif %}
                                {% endfor %}

                                <div class="agence-availability">

                                    <div class="d-flex align-items-center justify-content-between w-100">
                                        <span>
                                            {% if horaireDuJour and horaireDuJour.open %}
                                                Ouvert
                                            {% else %}
                                                Fermé
                                            {% endif %}
                                        </span>

                                        {% if horaireDuJour and horaireDuJour.open %}
                                            <strong>
                                                {% if horaireDuJour.ouvertureMatin and horaireDuJour.fermetureMatin %}
                                                    {{ horaireDuJour.ouvertureMatin|date('H:i') }}–{{ horaireDuJour.fermetureMatin|date('H:i') }}
                                                {% endif %}

                                                {% if horaireDuJour.ouvertureApresMidi and horaireDuJour.fermetureApresMidi %}
                                                    / {{ horaireDuJour.ouvertureApresMidi|date('H:i') }}–{{ horaireDuJour.fermetureApresMidi|date('H:i') }}
                                                {% endif %}
                                            </strong>
                                        {% else %}
                                            <strong>Fermé</strong>
                                        {% endif %}

                                        <i class="icon-chevron-down"></i>
                                    </div>

                                </div>

                                {# fin petit module horaire simple #}

                                <div class="agence-availability w-100 h-auto d-table">

                                    <!-- Ligne 1 : Ouvert à gauche / chevron à droite -->
                                    <div class="d-flex justify-content-between align-items-center w-100">
                                        <span>Ouvert</span>

                                        <i class="icon-chevron-down"></i>
                                    </div>

                                    <!-- Horaires dessous -->
                                    {% set jours = {
                                        1: 'lundi',
                                        2: 'mardi',
                                        3: 'mercredi',
                                        4: 'jeudi',
                                        5: 'vendredi',
                                        6: 'samedi',
                                        7: 'dimanche'
                                    } %}

                                    {% set jourNumeroActuel = "now"|date("N", "Europe/Paris") + 0 %}

                                    <div class="d-flex flex-column gap-1 mt-2 w-100">

                                        {% for i in 0..6 %}
                                            {% set numeroJour = ((jourNumeroActuel - 1 + i) % 7) + 1 %}
                                            {% set nomJour = jours[numeroJour] %}

                                            {% set horaireDuJour = user.horaireOuvertures|filter(horaire =>
                                                horaire.jour|lower|trim == nomJour
                                            )|first %}

                                            <div class="d-flex justify-content-between align-items-center w-100">
                                                <div>
                                                    {{ nomJour|capitalize }}
                                                </div>

                                                <strong>
                                                    {% if horaireDuJour and horaireDuJour.open %}

                                                        {% if horaireDuJour.ouvertureMatin and horaireDuJour.fermetureMatin %}
                                                            {{ horaireDuJour.ouvertureMatin|date('H:i') }}–{{ horaireDuJour.fermetureMatin|date('H:i') }}
                                                        {% endif %}

                                                        {% if horaireDuJour.ouvertureApresMidi and horaireDuJour.fermetureApresMidi %}
                                                            / {{ horaireDuJour.ouvertureApresMidi|date('H:i') }}–{{ horaireDuJour.fermetureApresMidi|date('H:i') }}
                                                        {% endif %}

                                                    {% else %}
                                                        Fermé
                                                    {% endif %}
                                                </strong>
                                            </div>
                                        {% endfor %}

                                    </div>

                                </div>


								<div class="agence-contact-actions">
									{% if user.whatsApp is not empty %}
										<a href="#" class="agence-btn agence-btn-whatsapp">
											Contacter via Whatsapp
										</a>
									{% endif %}
									{% if user.numeroContact is not empty %}
										<a href="tel:{{ user.numeroContact }}" class="agence-btn agence-btn-primary">
											<i class="icon-phone"></i>
											Appeler l’agence
										</a>
									{% endif %}

									<button type="button" class="agence-btn agence-btn-outline" data-action="click->agence-contact-form#open" data-agence-contact-form-target="button" aria-controls="agency_contact_form" aria-expanded="false">
										<i class="icon-mail"></i>
										Contacter par email
									</button>
								</div>
                                {{ form_start(form, {
                                    attr: {
                                        id: 'agency_contact_form',
                                        class: 'agence-contact-form d-none flex-column',
                                        'data-agence-contact-form-target': 'form'
                                    }
                                }) }}
									<div class="agence-field">
										<label for="contact_lastname">Votre nom*</label>
                                        {{ form_widget(form.nom, {
                                            attr: {
                                                id: 'contact_lastname',
                                                placeholder: 'Veuillez saisir votre nom',
                                                'data-agence-contact-form-target': 'firstField'
                                            }
                                        }) }}
									</div>

									<div class="agence-field">
										<label for="contact_firstname">Votre prénom*</label>
                                        {{ form_widget(form.prenom, {
                                            id: 'contact_firstname',
                                            attr: {
                                                placeholder: 'Veuillez saisir votre prénom',
                                                class: 'contact_firstname'
                                            }
                                        }) }}
									</div>

									<div class="agence-field">
										<label for="contact_email">Votre e-mail*</label>
                                        {{ form_widget(form.email, {
                                            id: 'contact_email',
                                            attr: {
                                                placeholder: 'Veuillez saisir votre e-mail'
                                            }
                                        }) }}
									</div>

									<div class="agence-field">
										<label for="contact_message">Votre message*</label>
                                        {{ form_widget(form.message, {
                                            id: 'contact_message',
                                            attr: {
                                                placeholder: 'Veuillez saisir votre message',
                                                rows: 6
                                            }
                                        }) }}
									</div>

									<button type="submit" class="agence-btn agence-btn-primary w-100">
										<i class="icon-mail"></i>
										Envoyer le mail
									</button>
                                {{ form_end(form) }}
							</div>
						</aside>

					</div>

				</div>
			</div>
		</main>

		{# Tab bar mobile #}
		{% if app.user and is_granted('ROLE_AGENCE') %}
		<nav class="agence-mobile-tabbar d-flex d-md-none">
			<a href="#" class="active">
				<i class="icon-search"></i>
				Explorer
			</a>

			<a href="#">
				<i class="icon-heart"></i>
				Favoris
			</a>

			<a href="#">
				<i class="icon-message-circle"></i>
				Messagerie
			</a>

			<a href="#">
				<i class="icon-user-round"></i>
				Compte
			</a>
		</nav>
		{% endif %}

	</div>

{% endblock %}
