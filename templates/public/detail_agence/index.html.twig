{#
 Template: templates/public/detail_agence/index.html.twig
 Role: Renders the public/detail_agence Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

{% extends 'base.html.twig' %}

{% block title %}Axa Immobilier
{% endblock %}

{% block mobile_tabbar %}{% endblock %}

{% block body %}

    {% set avatar = user.imageName ? vich_uploader_asset(user, 'imageFile') : null %}
    {% set firstLetter = user.prenom ? user.prenom|first|upper : null %}

    {% set logo = 'https://placehold.co/600x400/000000/FFFFFF/png' %}
    {% set agencyAvatar = 'https://placehold.co/600x400/000000/FFFFFF/png' %}
    {% set propertyImageFallback = 'https://placehold.co/600x400/000000/FFFFFF/png' %}

    <div
        class="agence-page"
    >
        {# Barre retour mobile #}
        <div class="bt-mobile-topbar align-items-center justify-content-center">
            <a href="javascript:history.go(-1)" class="bt-icon-btn bt-icon-btn--small position-absolute start-0 ms-2" type="button" aria-label="{{ 'detail_bien.topbar.back'|trans }}">
                <i class="icon-chevron-left"></i>
            </a>
        </div>

        {% if app.user and is_granted('ROLE_AGENCE') %}
            {# Barre violette desktop uniquement #}
            <div class="agence-preview-bar d-none d-lg-flex align-items-center justify-content-center">
                <span>Voici comment votre agence est présentée aux particuliers.</span>
                <a href="{{ path('agence_immobiliere_parametres') }}" class="agence-preview-btn p-accent rounded-pill">Modifier</a>
            </div>
        {% endif %}

        <main class="agence-main">
            <div class="container-fluid px-3 px-md-5 px-xl-0">
                <div class="container-md">

                    <div class="row align-items-start">

                        <div
                            class="col-12 col-lg-7 mt-0"
                        >

                            {# Profil agence #}
                            <section class="agence-profile d-flex ">
                                {% if avatar %}
                                    <img src="{{ avatar }}" alt="{{ user.entreprise }}" class="agence-profile-avatar">
                                {% else %}
                                    <img src="{{ asset('images/svg/' ~ firstLetter ~ '.svg') }}" alt="{{ user.entreprise }}" class="agence-profile-avatar">
                                {% endif %}
                                <div class="agence-profile-content">
                                    <h2 class="mb-0">{{ user.entreprise }}</h2>

                                    <p class="agence-profile-infos">
                                        {{ user.description|default('')|striptags|u.truncate(240, '...') }}
                                    </p>

                                    <div class="agence-profile-infos">
                                         <p class="mb-0" style="color:#5d00ff">{{ user.emailContact }}</p>  
                                         <p class="mt-2 mb-0" style="color:#0b0f14">Agence immobilière -
                                            {{ user.adresseContact }}
                                            {{ user.codePostalContact }}
                                            {{ user.villeContact }}
                                            {{ user.paysContact is not empty ? ', ' ~ user.paysContact : '' }}    
                                        </p>
                                     
                                    </div>

                                    {# Liste des langue parlé #}
                                    <div class="agence-profile-infos country-flag-agency">
                                        <ul class="d-flex flex-wrap gap-2 list-unstyled mb-0">
                                            {% for langueParler in user.langueParlers %}
                                                <li>{{ langueParler.labelWithFlag }}</li>
                                            {% endfor %}
                                        </ul>
                                    </div>
                                </div>
                            </section>

                            {# Recherche #}
                            <section class="agence-search-section">
                                {#
                                <form class="agence-search">
                                    <input type="search" placeholder="Rechercher un bien, une référence">

                                    <button type="submit">
                                        <i class="icon-search"></i>
                                    </button>
                                </form>
                                #}

                                <div class="d-flex mb-3 gap-2">

                                     <h3 class="mb-0">Biens de l’agence récemment ajoutés</h3>
                                </div>
                                <div class="d-flex flex-wrap gap-2">

                                   

                                    <button
                                        type="button"
                                        class="agence-filter-btn rounded-pill p-accent"
                                        data-bs-toggle="modal"
                                        data-bs-target="#booltsFiltersModal"
                                        data-controller="boolts-filter-badge"
                                        aria-controls="booltsFiltersModal"
                                    >
                                        <i class="icon-sliders-horizontal"></i>
                                        Filtres
                                    </button>

                                    {{ include('public/detail_agence/_partials/tri.html.twig') }}
                                </div>
                            </section>

                            {# Liste des biens immobiliers #}
                            <section class="agence-properties">
                                

                                <div class="row g-3 g-lg-4">

                                    {% for bienImmobilier in properties %}

                                        {% set firstImage = bienImmobilier.propertyImages|first %}

                                        {% if firstImage %}
                                            {% set uploadedImage = vich_uploader_asset(firstImage, 'imageFile') %}
                                        {% endif %}

                                        {% set transactionName = '' %}
                                        {% set transactionSlug = '' %}

                                        {% if bienImmobilier.typeTransaction %}
                                            {% set transactionName = bienImmobilier.typeTransaction.name|default(bienImmobilier.typeTransaction.nom|default('')) %}
                                            {% set transactionSlug = bienImmobilier.typeTransaction.slug|default('') %}
                                        {% endif %}

                                        {% set isLocation = transactionSlug|lower in ['location', 'louer', 'rent'] or transactionName|lower in ['location', 'louer', 'rent'] %}

                                        {% set propertyTitle = bienImmobilier.typeBien.name ~ ' à ' ~ bienImmobilier.typeTransaction.name %}
                                        {% set devise = bienImmobilier.user and bienImmobilier.user.devise ? bienImmobilier.user.devise.signe|default('€') : '€' %}
                                        {% set chargesNumber = bienImmobilier.montantDesCharges is not empty ? bienImmobilier.montantDesCharges + 0 : 0 %}

                                        {% if isLocation and bienImmobilier.montantLoyerHorsCharge is not empty %}
                                            {% set propertyPrice = (bienImmobilier.montantLoyerHorsCharge + chargesNumber)|number_format(0, ',', ' ') ~ ' ' ~ devise %}
                                            {% set propertyPeriod = 'search.card.per_month'|trans %}
                                            {% set propertyBadge = chargesNumber > 0 ? 'search.card.charges_included'|trans : 'search.card.charges_excluded'|trans %}
                                        {% elseif bienImmobilier.prix is not empty %}
                                            {% set propertyPrice = bienImmobilier.prix|number_format(0, ',', ' ') ~ ' ' ~ devise %}
                                            {% set propertyPeriod = '' %}
                                            {% set propertyBadge = transactionName is not empty ? transactionName|capitalize : 'search.card.sale'|trans %}
                                        {% else %}
                                            {% set propertyPrice = 'search.card.price_on_request'|trans %}
                                            {% set propertyPeriod = '' %}
                                            {% set propertyBadge = transactionName|capitalize %}
                                        {% endif %}

                                        {% set details = [] %}

                                        {% if bienImmobilier.typeBien %}
                                            {% set typeBienName = bienImmobilier.typeBien.name|default(bienImmobilier.typeBien.nom|default('')) %}

                                            {% if typeBienName is not empty %}
                                                {% set details = details|merge([typeBienName]) %}
                                            {% endif %}
                                        {% endif %}

                                        {% if bienImmobilier.chambres is not empty %}
                                            {% set details = details|merge([
                                            bienImmobilier.chambres ~ ' chambre' ~ (bienImmobilier.chambres > 1 ? 's' : ''),
                                        ]) %}
                                        {% endif %}

                                        {% if bienImmobilier.salleDeBains is not empty and bienImmobilier.salleDeBains != '0' %}
                                            {% set details = details|merge([
                                            bienImmobilier.salleDeBains ~ ' salle' ~ (bienImmobilier.salleDeBains > 1 ? 's' : '') ~ ' de bains',
                                        ]) %}
                                        {% endif %}

                                        {% if bienImmobilier.surfaceTotal is not empty %}
                                            {% set details = details|merge([
                                            bienImmobilier.surfaceTotal ~ 'm²',
                                        ]) %}
                                        {% endif %}

                                        {% set addressParts = [] %}

                                        {% if bienImmobilier.showAdresse and bienImmobilier.adresse is not empty %}
                                            {% set addressParts = addressParts|merge([bienImmobilier.adresse]) %}
                                        {% elseif bienImmobilier.neighborhood is not empty %}
                                            {% set addressParts = addressParts|merge([bienImmobilier.neighborhood]) %}
                                        {% endif %}

                                        {% if bienImmobilier.codePostal is not empty or bienImmobilier.ville is not empty %}
                                            {% set addressParts = addressParts|merge([
                                            (bienImmobilier.codePostal ~ ' ' ~ bienImmobilier.ville)|trim,
                                        ]) %}
                                        {% endif %}

                                        {% if bienImmobilier.pays is not empty %}
                                            {% set addressParts = addressParts|merge([bienImmobilier.pays]) %}
                                        {% endif %}

                                        {% set detailUrl = path('app_public_detail_bien', {
                                            slug: bienImmobilier.slug,
                                        }) %}

                                        <div class="col-12 col-md-6">
                                            <twig:Property:Card
                                                title="{{ propertyTitle }}"
                                                price="{{ propertyPrice }}"
                                                period="{{ propertyPeriod }}"
                                                badge="{{ propertyBadge }}"
                                                description="{{ bienImmobilier.descriptionLogement|default('')|striptags|u.truncate(80, '...') }}"
                                                details="{{ details|join(' ⸱ ') }}"
                                                address="{{ addressParts|join(', ') }}"
                                                image="{{ uploadedImage }}"
                                                url="{{ detailUrl }}"
                                                favoriteUrl="{{ path('app_favoris_property_toggle', {id: bienImmobilier.id}) }}"
                                                favoriteToken="{{ csrf_token('favorite_property_' ~ bienImmobilier.id) }}"
                                                :isFavorite="bienImmobilier.id in favoritePropertyIds|default([])"
                                            />
                                        </div>

                                    {% else %}

                                        <div class="col-12">
                                            <div class="agence-empty-state">
                                                Aucun bien n’est disponible pour le moment.
                                            </div>
                                        </div>

                                    {% endfor %}

                                </div>
                            </section>

                            {# Pagination #}
                            {{ knp_pagination_render(properties, 'pagination/agence_pagination.html.twig') }}

                        </div>

                        {# Contact (même carte sticky que la fiche bien) #}
                        {% set property = {user: user} %}
                        <div class="col-12 col-lg-5 mt-0 bt-contact-sticky-wrapper">
                            <aside class="bt-contact-sticky m-24-991">
                                <div class="bt-contact-card" data-controller="agence-contact-form">

                                    <div class="d-flex align-items-start gap-4 mb-3">
                                        <div class="bt-contact-card__avatar">
                                            {{ include('public/detail_bien/_partials/composant/image_entreprise.html.twig') }}
                                        </div>
                                        <div class="min-w-0">
                                            <p class="p-accent mb-0">{{ user.entreprise }}</p>
                                            <p class="bt-contact-card__address">
                                                {{ 'detail_bien.contact.agency_type'|trans }} -
                                                {{ user.adresseContact }}
                                                {{ user.codePostalContact }}
                                                {{ user.villeContact }}
                                                {{ user.paysContact }}
                                            </p>
                                            <div class="d-flex flex-column align-items-start gap-1 mt-3">
                                                {% if user.numeroContact is not empty %}
                                                    <button
                                                        type="button"
                                                        class="btn-full-white w-auto ms-0 p-accent"
                                                        data-action="click->agence-contact-form#showPhoneNumber"
                                                        data-agence-contact-form-target="phoneButton"
                                                    >
                                                        {{ 'detail_bien.contact.show_number'|trans }}
                                                    </button>
                                                    <a
                                                        href="tel:{{ user.numeroContact }}"
                                                        class="bt-contact-card__email d-none"
                                                        data-agence-contact-form-target="phoneNumber"
                                                    >
                                                        {{ user.numeroContact }}
                                                    </a>
                                                {% endif %}
                                                {% if user.emailContact is not empty %}
                                                    <a href="mailto:{{ user.emailContact }}" class="bt-contact-card__email paragraphe">
                                                        {{ user.emailContact }}
                                                    </a>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>

                                    {{ include('public/detail_bien/_partials/horaire.html.twig') }}

                                    <div class="d-grid gap-2 mt-3">
                                        {% if user.whatsApp is not empty %}
                                            <a href="https://wa.me/{{ user.whatsApp }}" class="agence-btn agence-btn-whatsapp p-accent">
                                                {{ 'detail_bien.contact.whatsapp'|trans }}
                                            </a>
                                        {% endif %}

                                        {% if user.numeroContact is not empty %}
                                            <a href="tel:{{ user.numeroContact }}" class="agence-btn agence-btn-primary p-accent">
                                                <i class="icon-phone"></i>
                                                {{ 'detail_bien.contact.call'|trans }}
                                            </a>
                                        {% endif %}

                                        <button
                                            type="button"
                                            class="bt-btn bt-btn--outline-primary w-100 p-accent"
                                            data-action="click->agence-contact-form#open"
                                            data-agence-contact-form-target="button"
                                            aria-controls="agency_contact_form"
                                            aria-expanded="false"
                                        >
                                            <i class="bi bi-envelope"></i>
                                            {{ 'detail_bien.contact.email'|trans }}
                                        </button>
                                    </div>
                                    {{ include('public/detail_bien/_partials/composant/formulaire.html.twig') }}
                                </div>
                            </aside>
                        </div>

                    </div>

                </div>
            </div>
        </main>

        {# Modale de filtres (même composant que la recherche et « Mes biens »), limitée aux biens publiés de l'agence #}
        {{ include('composant/_search/_search.html.twig', {
            formModal: filterForm,
            totalResults: properties.getTotalItemCount,
            filterCountUrl: path('app_public_detail_agence_filters_count', {slug: user.slug}),
            locationCountryUrl: path('app_public_detail_agence_filter_countries', {slug: user.slug}),
            locationCityUrl: path('app_public_detail_agence_filter_cities', {slug: user.slug}),
            locationDistrictUrl: path('app_public_detail_agence_filter_districts', {slug: user.slug}),
            filterExtraParameters: app.request.query.has('sort') ? {
                sort: app.request.query.get('sort'),
                direction: app.request.query.get('direction', 'desc'),
            } : {},
        }) }}


    </div>

{% endblock %}
