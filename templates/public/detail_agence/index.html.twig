] %}

<div class="agence-page">

    {# Header mobile #}
    <header class="agence-mobile-header d-flex d-md-none align-items-center justify-content-between">
        <a href="#" class="agence-logo">
            <img src="{{ logo }}" alt="Boolts">
        </a>

        <button type="button" class="agence-icon-btn">
            <i class="icon-menu"></i>
        </button>
    </header>

    {# Barre retour mobile #}
    <div class="agence-mobile-topbar d-flex d-md-none align-items-center">
        <button type="button" class="agence-icon-btn">
            <i class="icon-chevron-left"></i>
        </button>
    </div>

    {# Barre violette desktop uniquement #}
    <div class="agence-preview-bar d-none d-lg-flex align-items-center justify-content-center">
        <span>Voici comment votre agence est présentée aux particuliers.</span>
        <a href="#" class="agence-preview-btn">Modifier</a>
    </div>

    <main class="agence-main">
        <div class="container-fluid px-3 px-md-5 px-xl-0">
            <div class="container-xl px-0">

                <div class="row g-4 align-items-start">

                    <div class="col-12 col-lg-8">

                        {# Profil agence #}
                        <section class="agence-profile d-flex align-items-center">
                            <img src="{{ agencyAvatar }}" alt="Axa Immobilier" class="agence-profile-avatar">

                            <div class="agence-profile-content">
                                <h1>Axa Immobilier</h1>

                                <p class="agence-profile-description d-none d-lg-block">
                                    Agence immobilière spécialisée dans l’achat, la vente et la location de biens.
                                    Nous accompagnons chaque client avec transparence, réactivité et expertise pour
                                    concrétiser tous les projets immobiliers, du premier contact jusqu’à signature.
                                </p>

                                <div class="agence-profile-infos">
                                    <p>Agence immobilière - 94 quai Charles de Gaulle , 69006 Lyon Cedex</p>
                                    <p class="d-md-none d-lg-none">+1 202 XXX XXXX</p>
                                    <p>agence@agence.agence</p>
                                </div>
                            </div>
                        </section>

                        {# Recherche #}
                        <section class="agence-search-section">
                            <form class="agence-search">
                                <input type="search" placeholder="Rechercher un bien, une référence">
                                <button type="submit">
                                    <i class="icon-search"></i>
                                </button>
                            </form>

                            <div class="d-flex flex-wrap gap-2">
                                <button type="button" class="agence-filter-btn">
                                    <i class="icon-sliders-horizontal"></i>
                                    Filtres
                                </button>

                                <button type="button" class="agence-filter-btn">
                                    <i class="icon-arrow-down-up"></i>
                                    Tri : Plus récentes
                                </button>
                            </div>
                        </section>

                        {# Liste des biens #}
                        <section class="agence-properties">
                            <h2>Biens de l’agence récemment ajoutés</h2>

                            <div class="row g-3 g-lg-4">
                                {% for property in properties %}
                                    <div class="col-12 col-md-6">
                                        <article class="agence-property-card">
                                            <div class="agence-property-image">
                                                <img src="{{ property.image }}" alt="{{ property.title }}">
                                            </div>

                                            <div class="agence-property-body">
                                                <div class="d-flex align-items-center justify-content-between gap-2">
                                                    <h3>{{ property.title }}</h3>

                                                    <button type="button" class="agence-favorite-btn">
                                                        <i class="icon-heart"></i>
                                                    </button>
                                                </div>

                                                <div class="agence-property-price">
                                                    <strong>{{ property.price }}</strong>
                                                    <span>{{ property.period }}</span>

                                                    <small>{{ property.charges }}</small>
                                                </div>

                                                <p class="agence-property-description">
                                                    {{ property.description }}
                                                </p>

                                                <div class="agence-property-details">
                                                    <p>{{ property.details }}</p>
                                                    <p>{{ property.address }}</p>
                                                </div>
                                            </div>
                                        </article>
                                    </div>
                                {% endfor %}
                            </div>
                        </section>

                        {# Pagination #}
                        <nav class="agence-pagination" aria-label="Pagination">
                            <a href="#" class="disabled">
                                <i class="icon-chevron-left"></i>
                            </a>

                            <a href="#" class="active">1</a>
                            <a href="#">2</a>
                            <a href="#">3</a>
                            <a href="#">4</a>
                            <span>...</span>
                            <a href="#">32</a>

                            <a href="#">
                                <i class="icon-chevron-right"></i>
                            </a>
                        </nav>

                    </div>

                    {# Contact desktop #}
                    <aside class="col-12 col-lg-4">
                        <div class="agence-contact-card">
                            <div class="agence-contact-head d-flex gap-4">
                                <img src="{{ agencyAvatar }}" alt="Axa Immobilier">

                                <div>
                                    <h3>Axa Immobilier</h3>
                                    <p>Agence immobilière - 94 quai Charles de Gaulle , 69006 Lyon Cedex</p>

                                    <button type="button" class="agence-btn agence-btn-outline agence-contact-number">
                                        Afficher le numéro
                                    </button>

                                    <a href="mailto:agence@agence.agence" class="agence-contact-email d-lg-none">
                                        agence@agence.agence
                                    </a>
                                </div>
                            </div>

                            <div class="agence-availability">
                                <span>Ouvert</span>
                                <strong>09:00–12:00</strong>
                                <i class="icon-chevron-down"></i>
                            </div>

                            <div class="agence-contact-actions">
                                <a href="#" class="agence-btn agence-btn-whatsapp">
                                    Contacter via Whatsapp
                                </a>

                                <a href="tel:+12020000000" class="agence-btn agence-btn-primary">
                                    <i class="icon-phone"></i>
                                    Appeler l’agence
                                </a>

                                <a href="mailto:agence@agence.agence" class="agence-btn agence-btn-outline">
                                    <i class="icon-mail"></i>
                                    Contacter par email
                                </a>
                            </div>

                            <form class="agence-contact-form d-none d-lg-flex flex-column">
                                <div class="agence-field">
                                    <label for="contact_lastname">Votre nom*</label>
                                    <input id="contact_lastname" type="text" placeholder="Veuillez saisir votre nom">
                                </div>

                                <div class="agence-field">
                                    <label for="contact_firstname">Votre prénom*</label>
                                    <input id="contact_firstname" type="text" placeholder="Veuillez saisir votre prénom">
                                </div>

                                <div class="agence-field">
                                    <label for="contact_email">Votre e-mail*</label>
                                    <input id="contact_email" type="email" placeholder="Veuillez saisir votre e-mail">
                                </div>

                                <div class="agence-field">
                                    <label for="contact_phone">Votre numéro de téléphone*</label>
                                    <input id="contact_phone" type="tel" placeholder="Veuillez saisir votre numéro">
                                </div>

                                <div class="agence-field">
                                    <label for="contact_message">Votre message*</label>
                                    <textarea id="contact_message" placeholder="Veuillez saisir votre message"></textarea>
                                </div>

                                <button type="submit" class="agence-btn agence-btn-primary w-100">
                                    <i class="icon-mail"></i>
                                    Envoyer le mail
                                </button>
                            </form>
                        </div>
                    </aside>

                </div>

            </div>
        </div>
    </main>

    <footer class="agence-footer">
        <div class="container-fluid px-3 px-md-5 px-xl-0">
            <div class="container-xl px-0">

                <div class="row gy-4">
                    {% for i in 1..3 %}
                        <div class="col-12 col-md-3">
                            <div class="agence-footer-column">
                                <h3>Lorem ipsum</h3>
                                <a href="#">Lorem ipsum</a>
                                <a href="#">Lorem ipsum</a>
                                <a href="#">Lorem ipsum</a>
                            </div>
                        </div>
                    {% endfor %}

                    <div class="col-12 col-md-3">
                        <div class="agence-footer-column">
                            <h3>App mobile</h3>
                            <p>Découvrez l’application</p>

                            <div class="agence-store-badge">App Store</div>
                            <div class="agence-store-badge">Google Play</div>
                        </div>
                    </div>
                </div>

                <hr>

                <div class="agence-footer-bottom d-flex flex-column flex-lg-row justify-content-between gap-3">
                    <p>
                        © 2026 Boolts, Inc. Confidentialité - Conditions générales -
                        Fonctionnement du site - Infos sur l’entreprise
                    </p>

                    <div class="d-flex align-items-center gap-4">
                        <div class="d-flex align-items-center gap-3">
                            <span><i class="icon-globe"></i> Français</span>
                            <span><i class="icon-euro"></i> EUR</span>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <a href="#"><i class="icon-facebook"></i></a>
                            <a href="#"><i class="icon-instagram"></i></a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </footer>

    {# Tab bar mobile #}
    <nav class="agence-mobile-tabbar d-flex d-md-none">
        <a href="#" class="active">
            <i class="icon-search"></i>
            Explorer
        </a>

        <a href="#">
            <i class="icon-heart"></i>
            Favoris
        </a>

        <a href="#">
            <i class="icon-message-circle"></i>
            Messagerie
        </a>

        <a href="#">
            <i class="icon-user-round"></i>
            Compte
        </a>
    </nav>

</div>

{% endblock %}