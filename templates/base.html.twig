{#
 Template: templates/base.html.twig
 Role: Renders the base.html.twig Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=0">
        <meta name="frontend-error-endpoint" content="{{ path('app_frontend_error') }}">
        <meta name="frontend-error-csrf-token" content="{{ csrf_token('frontend_error') }}">
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">

        {% block stylesheets %}{% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
        {% block js %}{% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>

        {{ include('composant/__header/_navbar.html.twig') }}
        {% block body %}{% endblock %}
        {{ include('composant/_footer/_footer.html.twig') }}

        {% if app.user %}
            <div
                data-controller="browser-preferences"
                data-browser-preferences-url-value="{{ path('app_user_browser_preferences') }}"
                data-browser-preferences-token-value="{{ csrf_token('browser_preferences') }}"
            ></div>
        {% endif %}

        {% if app.environment == 'dev' %}
            {# DEBUG (tests) : localisation déduite de l'IP du visiteur (Cloudflare + MaxMind + ip-api). À retirer avant la prod. #}
            {{ render(controller('App\\Controller\\DebugIpLocationController::panel')) }}

            {# DEBUG (tests) : affiche toutes les données de localisation exposées par le navigateur. À retirer avant la prod. #}
            <div id="debug-browser-locale" style="position:fixed;bottom:12px;left:12px;z-index:99999;max-width:420px;max-height:60vh;overflow:auto;background:#101418;color:#e6edf3;font:12px/1.5 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;border:1px solid #30363d;border-radius:8px;box-shadow:0 8px 24px rgba(0,0,0,.4)">
                <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 12px;background:#161b22;border-bottom:1px solid #30363d">
                    <strong>🌍 Localisation navigateur (debug)</strong>
                    <button type="button" onclick="this.closest('#debug-browser-locale').remove()" style="background:none;border:none;color:#e6edf3;cursor:pointer;font-size:14px">✕</button>
                </div>
                <table style="border-collapse:collapse;width:100%">
                    <tbody id="debug-browser-locale-body"></tbody>
                </table>
            </div>
            <script>
                (function () {
                    var rows = [];
                    function push(key, value) {
                        rows.push([key, value]);
                    }
                    function safe(fn) {
                        try { return fn(); } catch (e) { return '⚠ ' + e.message; }
                    }

                    // navigator
                    push('navigator.language', navigator.language);
                    push('navigator.languages', (navigator.languages || []).join(', '));
                    push('navigator.userAgent', navigator.userAgent);
                    push('navigator.platform', navigator.platform);

                    // Intl.DateTimeFormat
                    var dtf = safe(function () { return Intl.DateTimeFormat().resolvedOptions(); });
                    if (dtf && typeof dtf === 'object') {
                        push('DateTimeFormat.locale', dtf.locale);
                        push('DateTimeFormat.timeZone', dtf.timeZone);
                        push('DateTimeFormat.calendar', dtf.calendar);
                        push('DateTimeFormat.numberingSystem', dtf.numberingSystem);
                        push('DateTimeFormat.hourCycle', dtf.hourCycle);
                    } else {
                        push('DateTimeFormat', dtf);
                    }

                    // Intl.NumberFormat
                    var nf = safe(function () { return Intl.NumberFormat().resolvedOptions(); });
                    if (nf && typeof nf === 'object') {
                        push('NumberFormat.locale', nf.locale);
                        push('NumberFormat.numberingSystem', nf.numberingSystem);
                        push('NumberFormat.currency', nf.currency || '(aucune)');
                    } else {
                        push('NumberFormat', nf);
                    }

                    // Intl.Collator
                    var col = safe(function () { return Intl.Collator().resolvedOptions(); });
                    push('Collator.locale', col && col.locale ? col.locale : col);

                    // Intl.Locale (décomposition de navigator.language)
                    var loc = safe(function () { return new Intl.Locale(navigator.language); });
                    if (loc && typeof loc === 'object') {
                        push('Locale.language', loc.language);
                        push('Locale.script', loc.script || '(aucun)');
                        push('Locale.region', loc.region || '(aucune)');
                        push('Locale.baseName', loc.baseName);
                    } else {
                        push('Intl.Locale', loc);
                    }

                    // Fuseau horaire
                    push('Date.getTimezoneOffset()', new Date().getTimezoneOffset() + ' min');
                    push('Date (locale string)', new Date().toString());

                    // Valeurs dérivées (identiques à browser_preferences_controller.js)
                    var derivedLocale = navigator.language || (navigator.languages && navigator.languages[0]) || 'fr-FR';
                    push('→ derived locale', derivedLocale);
                    push('→ derived language', (derivedLocale.split('-')[0] || '').toLowerCase() || null);
                    push('→ derived country', (derivedLocale.split('-')[1] || '').toUpperCase() || null);
                    push('→ derived timeZone', (dtf && dtf.timeZone) || null);

                    // Géolocalisation navigateur (asynchrone, demande l'autorisation à l'utilisateur)
                    push('geolocation.latitude', '⏳ en attente d’autorisation…');
                    push('geolocation.longitude', '⏳ en attente d’autorisation…');

                    var body = document.getElementById('debug-browser-locale-body');
                    function render() {
                        var html = '';
                        rows.forEach(function (r) {
                            html += '<tr>'
                                + '<td style="padding:4px 12px;border-bottom:1px solid #21262d;color:#7d8590;white-space:nowrap;vertical-align:top">' + r[0] + '</td>'
                                + '<td style="padding:4px 12px;border-bottom:1px solid #21262d;word-break:break-all">' + (r[1] === null || r[1] === undefined ? '<em style="color:#7d8590">null</em>' : String(r[1])) + '</td>'
                                + '</tr>';
                        });
                        body.innerHTML = html;
                        console.table(rows.reduce(function (acc, r) { acc[r[0]] = r[1]; return acc; }, {}));
                    }
                    function set(key, value) {
                        for (var i = 0; i < rows.length; i++) {
                            if (rows[i][0] === key) { rows[i][1] = value; return; }
                        }
                        push(key, value);
                    }
                    render();

                    if ('geolocation' in navigator) {
                        navigator.geolocation.getCurrentPosition(
                            function (pos) {
                                var c = pos.coords;
                                set('geolocation.latitude', c.latitude);
                                set('geolocation.longitude', c.longitude);
                                set('geolocation.accuracy', c.accuracy + ' m');
                                set('geolocation.altitude', c.altitude === null ? null : c.altitude + ' m');
                                set('geolocation.altitudeAccuracy', c.altitudeAccuracy === null ? null : c.altitudeAccuracy + ' m');
                                set('geolocation.heading', c.heading);
                                set('geolocation.speed', c.speed);
                                set('geolocation.timestamp', new Date(pos.timestamp).toString());
                                render();
                            },
                            function (err) {
                                set('geolocation.latitude', '⚠ ' + err.message + ' (code ' + err.code + ')');
                                set('geolocation.longitude', '⚠ ' + err.message + ' (code ' + err.code + ')');
                                render();
                            },
                            { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
                        );
                    } else {
                        set('geolocation.latitude', 'API geolocation indisponible');
                        set('geolocation.longitude', 'API geolocation indisponible');
                        render();
                    }
                })();
            </script>
        {% endif %}
    </body>
</html>
