{#
 Template: templates/base.html.twig
 Role: Renders the base.html.twig Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

<!DOCTYPE html>
<html lang="{{ app.request.locale starts with 'fr' ? 'fr' : 'en' }}" data-controller="desktop-viewport" data-desktop-viewport-width-value="1440">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}{{ 'common.meta.default_title'|trans }}{% endblock %}</title>
        <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0, user-scalable=no"
>
        {# SEO multilingue : canonical de la page + versions FR / EN du même pays (hreflang "fr-FR", x-default = anglais) #}
        {% block seo_locale %}
            {% set canonicalUrl = locale_canonical_url() %}
            {% if canonicalUrl %}
                <link rel="canonical" href="{{ canonicalUrl }}">
            {% endif %}
            {% for hreflang, alternateUrl in locale_alternate_urls() %}
                <link rel="alternate" hreflang="{{ hreflang }}" href="{{ alternateUrl }}">
                {% if hreflang == 'en' or hreflang starts with 'en-' %}
                    <link rel="alternate" hreflang="x-default" href="{{ alternateUrl }}">
                {% endif %}
            {% endfor %}
        {% endblock %}
        <meta name="frontend-error-endpoint" content="{{ path('app_frontend_error') }}">
        <meta name="frontend-error-csrf-token" content="{{ csrf_token('frontend_error') }}">
        <link rel="icon" href="{{ asset('images/favicon.ico') }}">

        {% block stylesheets %}{% endblock %}

        {{ include('composant/_js_translations.html.twig') }}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
        {% block js %}{% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}

    </head>
    <body data-controller="dashboard-layout" class="  {% block body_class %}{% endblock %}">

        {{ include('composant/__header/_navbar.html.twig') }}
        {% block body %}{% endblock %}
        {{ include('composant/_footer/_footer.html.twig') }}
        {# Pas de tabbar publique sur le dashboard agence : il a sa propre barre (.dashboard-bottom-bar) #}
        {% block mobile_tabbar %}
            {% set tabbarRoute = app.request.attributes.get('_canonical_route', app.request.attributes.get('_route'))|default('') %}
            {# Pas de tabbar publique non plus sur les pages du dashboard visiteur #}
            {% set tabbarHiddenRoutes = [
                'app_visiteur_dashboard',
                'app_dashboard_visiteur_favoris_bien',
                'app_dashboard_visiteur_notifications',
                'app_dashboard_visiteur_messagerie',
                'app_dashboard_visiteur_parametres',
                'app_dashboard_visiteur_aides',
            ] %}
            {% if not (tabbarRoute starts with 'agence_immobiliere') and tabbarRoute not in tabbarHiddenRoutes %}
                {{ include('composant/_footer/navbar_footer.html.twig') }}
            {% endif %}
        {% endblock %}

    

        {% if app.user %}
            <div
                data-controller="browser-preferences"
                data-browser-preferences-url-value="{{ path('app_user_browser_preferences') }}"
                data-browser-preferences-token-value="{{ csrf_token('browser_preferences') }}"
            ></div>
        {% endif %}
    </body>
</html>
