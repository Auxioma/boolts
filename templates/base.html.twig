{#
 Template: templates/base.html.twig
 Role: Renders the base.html.twig Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0, user-scalable=no"
>
        <meta name="frontend-error-endpoint" content="{{ path('app_frontend_error') }}">
        <meta name="frontend-error-csrf-token" content="{{ csrf_token('frontend_error') }}">
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">

        {% block stylesheets %}{% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
        {% block js %}{% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}

<style>
/* =========================================================
   DEBUG BOOTSTRAP
   .CONTAINER (max-width par breakpoint)
   PADDING CONTAINER + 12 COLONNES + GOUTTIÈRES
========================================================= */

:root {
    /* Bootstrap 5 : gutter standard 1.5rem = 24px */
    --debug-gutter: 24px;

    /* Largeur max du .container (100% sous 576px) */
    --debug-container: 100%;
}

@media (min-width: 576px)  { :root { --debug-container: 540px; } }
@media (min-width: 768px)  { :root { --debug-container: 720px; } }
@media (min-width: 992px)  { :root { --debug-container: 960px; } }
@media (min-width: 1200px) { :root { --debug-container: 1140px; } }
@media (min-width: 1400px) { :root { --debug-container: 1320px; } }

/* Variante container-fluid : ajouter la classe debug-grid--fluid */
.debug-grid--fluid { --debug-container: 100%; }

/* Overlay = un .container centré */
.debug-grid::before {
    content: "";

    position: fixed;
    top: 0;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);

    box-sizing: border-box;
    width: 100%;
    max-width: var(--debug-container);

    /* Padding du container : gutter / 2 de chaque côté */
    padding: 0 calc(var(--debug-gutter) / 2);

    z-index: 999999;

    pointer-events: none;

    /*
     * BLEU   = padding du container
     * ROUGE  = contenu de la colonne
     * JAUNE  = gouttière entre colonnes (2 × padding .col)
     */
    background-image:
        repeating-linear-gradient(
            to right,

            /* COLONNE */
            rgba(255, 0, 0, 0.10) 0,
            rgba(255, 0, 0, 0.10)
                calc((100% - 11 * var(--debug-gutter)) / 12),

            /* GOUTTIÈRE */
            rgba(255, 200, 0, 0.30)
                calc((100% - 11 * var(--debug-gutter)) / 12),
            rgba(255, 200, 0, 0.30)
                calc((100% - 11 * var(--debug-gutter)) / 12 + var(--debug-gutter))
        ),
        linear-gradient(rgba(0, 120, 255, 0.25), rgba(0, 120, 255, 0.25));

    background-origin: content-box, border-box;
    background-clip: content-box, border-box;
}
</style>

    </head>
    <body data-controller="dashboard-layout" class=" debug-grid {% block body_class %}{% endblock %}">

        {{ include('composant/__header/_navbar.html.twig') }}
        {% block body %}{% endblock %}
        {{ include('composant/_footer/_footer.html.twig') }}
        {{ include('composant/_footer/navbar_footer.html.twig') }}

    

        {% if app.user %}
            <div
                data-controller="browser-preferences"
                data-browser-preferences-url-value="{{ path('app_user_browser_preferences') }}"
                data-browser-preferences-token-value="{{ csrf_token('browser_preferences') }}"
            ></div>
        {% endif %}
    </body>
</html>
