{% if pageCount > 1 %}
    {% set performanceQuery = query|filter((value, key) => key not in ['sort', 'direction']) %}

    <nav class="dashboard-pagination" aria-label="Pagination des annonces">
        {% if previous is defined %}
            <a
                href="{{ path(route, performanceQuery|merge({(pageParameterName): previous})) }}"
                class="pagination-arrow"
                aria-label="Page précédente"
                data-turbo-frame="dashboard-property-performance"
            >‹</a>
        {% endif %}

        {% for page in pagesInRange %}
            {% if page == current %}
                <span class="pagination-number active">{{ page }}</span>
            {% else %}
                <a
                    href="{{ path(route, performanceQuery|merge({(pageParameterName): page})) }}"
                    class="pagination-number"
                    data-turbo-frame="dashboard-property-performance"
                >{{ page }}</a>
            {% endif %}
        {% endfor %}

        {% if next is defined %}
            <a
                href="{{ path(route, performanceQuery|merge({(pageParameterName): next})) }}"
                class="pagination-arrow"
                aria-label="Page suivante"
                data-turbo-frame="dashboard-property-performance"
            >›</a>
        {% endif %}
    </nav>
{% endif %}
