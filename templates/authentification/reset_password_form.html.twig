{#
 Template: templates/authentification/reset_password_form.html.twig
 Role: Shared new-password form for individual and professional accounts.
#}

{% extends 'base.html.twig' %}

{% block title %}{{ resetPasswordMetaTitle|trans }}{% endblock %}

{% block stylesheets %}
    <style>
        body.reset-password-form-page {
            background: #fff !important;
            overflow-x: hidden;
        }

        body.reset-password-form-page .topbar-logo {
            width: 112px;
            height: 36px;
        }

        body.reset-password-form-page .topbar-menu .nav-link {
            font-weight: 700;
        }

        .shared-reset-password-form {
            display: flex;
            justify-content: center;
            min-height: 697px;
            padding: 48px 24px;
            background: #fff;
        }

        .shared-reset-password-form__inner {
            width: 100%;
            max-width: 456px;
        }

        .shared-reset-password-form__title {
            margin: 0 0 32px;
            color: #0b0f14;
            font-family: "Eudoxus Sans", sans-serif;
            font-size: 30px;
            font-weight: 700;
            line-height: 34px;
        }

        .shared-reset-password-form__fields {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .shared-reset-password-form__field {
            width: 100%;
        }

        .shared-reset-password-form__field label {
            display: block;
            margin-bottom: 16px;
            color: #0b0f14;
            font-family: "Eudoxus Sans", sans-serif;
            font-size: 16px;
            font-weight: 700;
            line-height: 20px;
        }

        .shared-reset-password-form__field input {
            width: 100%;
            height: 44px;
            padding: 12px 14px;
            border: 2px solid #ebecec;
            border-radius: 8px;
            color: #0b0f14;
            font-family: "Eudoxus Sans", sans-serif;
            font-size: 14px;
            line-height: 20px;
        }

        .shared-reset-password-form__field input:focus {
            border-color: #5d00ff;
            box-shadow: none;
            outline: 0;
        }

        .shared-reset-password-form__field input::placeholder {
            color: #858789;
            opacity: 1;
        }

        .shared-reset-password-form__errors {
            display: flex;
            flex-direction: column;
            gap: 32px;
            margin-top: 32px;
            color: #dc3545;
            font-family: Inter, sans-serif;
            font-size: 14px;
            font-weight: 600;
            line-height: 20px;
        }

        .shared-reset-password-form__errors p {
            margin: 0;
        }

        .shared-reset-password-form__submit {
            width: 100%;
            height: 44px;
            margin-top: 32px;
            padding: 10px 16px;
            border: 0;
            border-radius: 50px;
            background: #5d00ff;
            color: #fff;
            font-family: "Eudoxus Sans", sans-serif;
            font-size: 16px;
            font-weight: 700;
            line-height: 20px;
        }

        .shared-reset-password-form__submit:hover,
        .shared-reset-password-form__submit:focus-visible {
            background: #4d00d2;
        }

        @media (max-width: 767.98px) {
            .shared-reset-password-form {
                min-height: auto;
                padding: 48px 24px 56px;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <main class="shared-reset-password-form">
        <div class="shared-reset-password-form__inner">
            <h1 class="shared-reset-password-form__title">{{ resetPasswordTitle|trans }}</h1>

            {{ form_start(resetForm, {
                attr: {
                    'data-turbo': 'false',
                },
            }) }}
                <div class="shared-reset-password-form__fields">
                    <div class="shared-reset-password-form__field">
                        <label for="{{ resetForm.plainPassword.first.vars.id }}">
                            {{ resetPasswordPasswordLabel|trans }}
                        </label>
                        {{ form_widget(resetForm.plainPassword.first, {
                            attr: {
                                placeholder: resetPasswordPasswordPlaceholder|trans,
                            },
                        }) }}
                    </div>

                    <div class="shared-reset-password-form__field">
                        <label for="{{ resetForm.plainPassword.second.vars.id }}">
                            {{ resetPasswordPasswordConfirmLabel|trans }}
                        </label>
                        {{ form_widget(resetForm.plainPassword.second, {
                            attr: {
                                placeholder: resetPasswordPasswordConfirmPlaceholder|trans,
                            },
                        }) }}
                    </div>
                </div>

                <div class="shared-reset-password-form__errors">
                    {% for label, messages in app.flashes %}
                        {% if label in ['danger', 'error', 'warning'] %}
                            {% for message in messages %}
                                <p>{{ message|trans }}</p>
                            {% endfor %}
                        {% endif %}
                    {% endfor %}

                    {% for error in resetForm.vars.errors %}
                        <p>{{ error.message|trans }}</p>
                    {% endfor %}

                    {% for error in resetForm.plainPassword.vars.errors %}
                        <p>{{ error.message|trans }}</p>
                    {% endfor %}

                    {% for error in resetForm.plainPassword.first.vars.errors %}
                        <p>{{ error.message|trans }}</p>
                    {% endfor %}

                    {% for error in resetForm.plainPassword.second.vars.errors %}
                        <p>{{ error.message|trans }}</p>
                    {% endfor %}
                </div>

                <button class="shared-reset-password-form__submit" type="submit" data-turbo="false">
                    {{ resetPasswordSubmit|trans }}
                </button>
            {{ form_end(resetForm) }}
        </div>
    </main>
{% endblock %}

{% block body_class %}reset-password-form-page{% endblock %}
