{#
 Template: templates/authentification/reset_password_form.html.twig
 Role: Shared new-password form for individual and professional accounts.
#}

{% extends 'base.html.twig' %}

{% block title %}{{ resetPasswordMetaTitle|trans }}{% endblock %}

{% block stylesheets %}
    <style>
        body.reset-password-form-page {
            background: #fff !important;
            overflow-x: hidden;
        }

        body.reset-password-form-page .topbar-logo {
            width: 112px;
            height: 36px;
        }

        body.reset-password-form-page .topbar-menu .nav-link {
            font-weight: 700;
        }

        .shared-reset-password-form {
            min-height: calc(100vh - 72px);
            background: #fff;
        }

        .shared-reset-password-form__content {
            display: flex;
            align-items: center;
            width: 50.7%;
            min-height: calc(100vh - 72px);
            padding: 40px clamp(32px, 9.86vw, 142px) 40px clamp(32px, 9.17vw, 132px);
        }

        .shared-reset-password-form__inner {
            width: 100%;
            max-width: 456px;
        }

        .shared-reset-password-form__title {
            margin: 0 0 32px;
            color: #0b0f14;
            font-family: "Eudoxus Sans", sans-serif;
        }

        .shared-reset-password-form__fields {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .shared-reset-password-form__field {
            width: 100%;
        }

        .shared-reset-password-form__field label {
            display: block;
            margin-bottom: 16px;
        }

        .shared-reset-password-form__password {
            position: relative;
        }

        .shared-reset-password-form__password input {
            padding-right: 48px;
        }

        .shared-reset-password-form__password input::-ms-reveal {
            display: none;
        }

        .shared-reset-password-form__password-toggle {
            position: absolute;
            top: 50%;
            right: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 24px;
            height: 24px;
            padding: 0;
            border: 0;
            background: transparent;
            color: #858789;
            font-size: 20px;
            line-height: 1;
            cursor: pointer;
            transform: translateY(-50%);
        }

        .shared-reset-password-form__password-toggle:hover,
        .shared-reset-password-form__password-toggle:focus-visible {
            color: #0b0f14;
        }

        .shared-reset-password-form__errors {
            display: flex;
            flex-direction: column;
            gap: 32px;
            margin-top: 32px;
            color: #dc3545;
            font-family: Inter, sans-serif;
            font-size: 14px;
            font-weight: 600;
            line-height: 20px;
        }

        .shared-reset-password-form__errors p {
            margin: 0;
        }

        .shared-reset-password-form__submit {
            width: 100%;
            margin-top: 32px;
        }

        /* --- Password strength stepper --- */
        .password-strength__track {
            display: flex;
            gap: 4px;
        }
        .password-strength__segment {
            flex: 1 1 0;
            height: 6px;
            border-radius: 999px;
            background-color: #e5e7eb;
            transition: background-color .15s ease;
        }
        .password-strength__segment.is-filled[data-level="0"] {
            background-color: #ef4444;
        }
        .password-strength__segment.is-filled[data-level="1"] {
            background-color: #f59e0b;
        }
        .password-strength__segment.is-filled[data-level="2"] {
            background-color: #22c55e;
        }
        .password-strength__label {
            display: block;
            margin-top: 6px;
            font-size: 12px;
            color: #6b7280;
        }
        .password-strength__label[data-level="2"] {
            color: #16a34a;
        }
        .shared-reset-password-form__submit:disabled,
        .shared-reset-password-form__submit.is-disabled {
            opacity: .5;
            cursor: not-allowed;
        }

        .shared-reset-password-form__visual {
            width: 49.3%;
            min-height: calc(100vh - 72px);
            background-color: #fff;
            background-image: url("{{ asset('images/authentification/test.png') }}");
            background-position: right center;
            background-repeat: no-repeat;
            background-size: 200% auto;
        }

        @media (max-width: 1199.98px) {
            .shared-reset-password-form__content {
                width: 55%;
                padding-right: 64px;
                padding-left: 64px;
            }

            .shared-reset-password-form__visual {
                width: 45%;
            }
        }

        @media (max-width: 767.98px) {
            .shared-reset-password-form {
                min-height: auto;
            }

            .shared-reset-password-form__inner {
                max-width: 100%;
            }

            .shared-reset-password-form__content {
                align-items: flex-start;
                width: 100%;
                min-height: auto;
                padding: 48px 24px 56px;
            }

            .shared-reset-password-form__title {
                font-size: 26px;
                line-height: 32px;
            }

            .shared-reset-password-form__visual {
                display: none;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <main class="shared-reset-password-form d-flex">
        <section class="shared-reset-password-form__content">
        <div class="shared-reset-password-form__inner">
            <h2 class="shared-reset-password-form__title">{{ resetPasswordTitle|trans }}</h2>

            {% set _pwd_locale_en = app.request.locale starts with 'en' %}
            {{ form_start(resetForm, {
                attr: {
                    'data-turbo': 'false',
                    'data-controller': 'password-strength',
                    'data-password-strength-min-value': '12',
                    'data-password-strength-label-progress-value': _pwd_locale_en ? '{count} / {min} characters' : '{count} / {min} caractères',
                    'data-password-strength-label-valid-value': _pwd_locale_en ? 'Minimum length reached' : 'Longueur minimale atteinte',
                },
            }) }}
                <div class="shared-reset-password-form__fields">
                    <div class="shared-reset-password-form__field">
                        <label class="p-accent" for="{{ resetForm.plainPassword.first.vars.id }}">
                            {{ resetPasswordPasswordLabel|trans }}
                        </label>
                        <div class="shared-reset-password-form__password" data-controller="password-visibility">
                            {{ form_widget(resetForm.plainPassword.first, {
                                attr: {
                                    class: 'form-control input',
                                    placeholder: resetPasswordPasswordPlaceholder|trans,
                                    'data-password-visibility-target': 'input',
                                    'data-password-strength-target': 'input',
                                    'data-action': 'input->password-strength#check',
                                },
                            }) }}
                            <button
                                type="button"
                                class="shared-reset-password-form__password-toggle"
                                aria-label="Afficher le mot de passe"
                                data-password-visibility-target="button"
                                data-action="password-visibility#toggle"
                            >
                                <i class="icon-eye" aria-hidden="true" data-password-visibility-target="icon"></i>
                            </button>
                        </div>
                        <div data-password-strength-target="meter" class="mt-8 mb-16"></div>

                    </div>

                    <div class="shared-reset-password-form__field">
                        <label class="p-accent" for="{{ resetForm.plainPassword.second.vars.id }}">
                            {{ resetPasswordPasswordConfirmLabel|trans }}
                        </label>
                        <div class="shared-reset-password-form__password" data-controller="password-visibility">
                            {{ form_widget(resetForm.plainPassword.second, {
                                attr: {
                                    class: 'form-control input',
                                    placeholder: resetPasswordPasswordConfirmPlaceholder|trans,
                                    'data-password-visibility-target': 'input',
                                },
                            }) }}
                            <button
                                type="button"
                                class="shared-reset-password-form__password-toggle"
                                aria-label="Afficher le mot de passe"
                                data-password-visibility-target="button"
                                data-action="password-visibility#toggle"
                            >
                                <i class="icon-eye" aria-hidden="true" data-password-visibility-target="icon"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="shared-reset-password-form__errors">
                    {% for label, messages in app.flashes %}
                        {% if label in ['danger', 'error', 'warning'] %}
                            {% for message in messages %}
                                <p>{{ message|trans }}</p>
                            {% endfor %}
                        {% endif %}
                    {% endfor %}

                    {% for error in resetForm.vars.errors %}
                        <p>{{ error.message|trans }}</p>
                    {% endfor %}

                    {% for error in resetForm.plainPassword.vars.errors %}
                        <p>{{ error.message|trans }}</p>
                    {% endfor %}

                    {% for error in resetForm.plainPassword.first.vars.errors %}
                        <p>{{ error.message|trans }}</p>
                    {% endfor %}

                    {% for error in resetForm.plainPassword.second.vars.errors %}
                        <p>{{ error.message|trans }}</p>
                    {% endfor %}
                </div>

                <button class="shared-reset-password-form__submit btn-full-blue" type="submit" data-turbo="false"
                        data-password-strength-target="submit">
                    {{ resetPasswordSubmit|trans }}
                </button>
            {{ form_end(resetForm) }}
        </div>
        </section>

        <div class="shared-reset-password-form__visual" role="img" aria-label="Vue d'une propriété au bord de la mer"></div>
    </main>
{% endblock %}

{% block body_class %}reset-password-form-page{% endblock %}
