{#
 Template: templates/authentification/reset_password_request.html.twig
 Role: Shared password-reset request screen for individual and professional accounts.
#}

{% extends 'base.html.twig' %}

{% block title %}{{ resetPasswordMetaTitle|trans }}{% endblock %}

{% block stylesheets %}
    <style>
        body.reset-password-page {
            background: #fff !important;
            overflow-x: hidden;
        }

        body.reset-password-page .topbar-logo {
            width: 112px;
            height: 36px;
        }

        body.reset-password-page .topbar-menu .nav-link {
            font-weight: 700;
        }

        .shared-reset-password {
            display: flex;
            justify-content: center;
            min-height: 520px;
            padding: 80px 24px 96px;
            background: #fff;
        }

        .shared-reset-password__inner {
            width: 100%;
            max-width: 456px;
        }

        .shared-reset-password__title {
            margin: 0 0 32px;
            color: #0b0f14;
            font-family: "Eudoxus Sans", sans-serif;
            font-size: 30px;
            font-weight: 700;
            line-height: 34px;
        }

        .shared-reset-password__field {
            margin-bottom: 16px;
        }

        .shared-reset-password__field label {
            display: block;
            margin-bottom: 16px;
            color: #0b0f14;
            font-family: "Eudoxus Sans", sans-serif;
            font-size: 16px;
            font-weight: 700;
            line-height: 20px;
        }

        .shared-reset-password__field input {
            width: 100%;
            height: 44px;
            padding: 12px 14px;
            border: 2px solid #ebecec;
            border-radius: 8px;
            color: #0b0f14;
            font-family: "Eudoxus Sans", sans-serif;
            font-size: 14px;
            line-height: 20px;
        }

        .shared-reset-password__field input:focus {
            border-color: #5d00ff;
            box-shadow: none;
            outline: 0;
        }

        .shared-reset-password__field input::placeholder {
            color: #858789;
            opacity: 1;
        }

        .shared-reset-password__error {
            display: block;
            margin-top: 24px;
            color: #dc3545;
            font-family: "Eudoxus Sans", sans-serif;
            font-size: 14px;
            font-weight: 700;
            line-height: 20px;
        }

        .shared-reset-password__submit {
            width: 100%;
            height: 44px;
            margin-top: 32px;
            padding: 10px 16px;
            border: 0;
            border-radius: 50px;
            background: #5d00ff;
            color: #fff;
            font-family: "Eudoxus Sans", sans-serif;
            font-size: 16px;
            font-weight: 700;
            line-height: 20px;
        }

        .shared-reset-password__submit:hover,
        .shared-reset-password__submit:focus-visible {
            background: #4d00d2;
        }

        @media (max-width: 767.98px) {
            .shared-reset-password {
                min-height: auto;
                padding: 48px 24px 56px;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <main class="shared-reset-password">
        <div class="shared-reset-password__inner">
            <h1 class="shared-reset-password__title">{{ resetPasswordTitle|trans }}</h1>

            {{ form_start(requestForm, {
                attr: {
                    'data-turbo': 'false',
                },
            }) }}
                <div class="shared-reset-password__field">
                    <label for="{{ requestForm.email.vars.id }}">{{ resetPasswordEmailLabel|trans }}</label>
                    {{ form_widget(requestForm.email, {
                        attr: {
                            placeholder: 'visiteur.forgot_password.email.placeholder'|trans,
                        },
                    }) }}
                </div>

                {% for label, messages in app.flashes %}
                    {% if label in ['danger', 'error', 'warning', 'success'] %}
                        {% for message in messages %}
                            <span class="shared-reset-password__error">{{ message|trans }}</span>
                        {% endfor %}
                    {% endif %}
                {% endfor %}

                {% if requestForm.email.vars.errors|length > 0 %}
                    {% for error in requestForm.email.vars.errors %}
                        <span class="shared-reset-password__error">{{ error.message|trans }}</span>
                    {% endfor %}
                {% endif %}

                <button class="shared-reset-password__submit" type="submit">
                    {{ resetPasswordSubmit|trans }}
                </button>
            {{ form_end(requestForm) }}
        </div>
    </main>
{% endblock %}

{% block body_class %}reset-password-page{% endblock %}
