{#
 Template: templates/authentification/registration.html.twig
 Role: Shared first registration step for individuals and professionals.
#}

{% extends 'base.html.twig' %}

{% block title %}Inscription | Boolts{% endblock %}

{% block stylesheets %}
    <style>
        body.registration-page {
            background: #fff !important;
            overflow-x: hidden;
        }

        body.registration-page .topbar-logo {
            width: 112px;
            height: 36px;
        }

        body.registration-page .topbar-menu .nav-link {
            font-weight: 700;
        }

        body.registration-page .topbar-menu .nav-item:nth-child(4) .nav-link {
            color: #5d00ff;
            background: #dfcbff;
        }

        .registration {
            min-height: calc(100vh - 72px);
            background: #fff;
        }

        .registration__content {
            display: flex;
            align-items: flex-start;
            width: 50.7%;
            min-height: calc(100vh - 72px);
            padding: 48px clamp(32px, 9.86vw, 142px) 48px clamp(32px, 9.17vw, 132px);
        }

        .registration__inner {
            width: 100%;
        }

        .registration__title {
            margin: 0 0 32px;
            color: #0b0f14;
            font-family: "Eudoxus Sans", sans-serif;
        }

        .registration__socials {
            display: flex;
            gap: 16px;
            margin-bottom: 32px;
        }

        .registration__social {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            width: 50%;
            height: 44px;
            padding: 10px 16px;
            border: 2px solid #ebecec;
            border-radius: 50px;
            color: #9d9fa1;
            font-family: "Eudoxus Sans", sans-serif;
            font-size: 16px;
            font-weight: 700;
            line-height: 20px;
            text-decoration: none;
        }

        .registration__social:hover,
        .registration__social:focus-visible {
            color: #0b0f14;
        }

        .registration__social--apple {
            border-color: #0b0f14;
            background: #0b0f14;
            color: #fff;
        }

        .registration__social--apple:hover,
        .registration__social--apple:focus-visible {
            color: #fff;
        }

        .registration__apple-icon {
            font-size: 20px;
            line-height: 1;
        }

        .registration__google-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 24px;
            height: 24px;
            background: conic-gradient(from -45deg, #4285f4 0 25%, #34a853 0 50%, #fbbc05 0 75%, #ea4335 0);
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
            font-family: Arial, sans-serif;
            font-size: 20px;
            font-weight: 700;
            line-height: 24px;
        }

        .registration__divider {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 32px;
            color: #858789;
            font-family: "Eudoxus Sans", sans-serif;
            font-size: 16px;
            font-weight: 700;
            line-height: 20px;
        }

        .registration__divider::before,
        .registration__divider::after {
            flex: 1;
            height: 1px;
            background: #bfc0c1;
            content: "";
        }

        .registration__field {
            margin-bottom: 32px;
        }

        .registration__field label {
            display: block;
            margin-bottom: 16px;
            color: #0b0f14;
            font-family: "Eudoxus Sans", sans-serif;
        }

        .registration__field .form-control {
            color: #0b0f14;
            font-family: "Eudoxus Sans", sans-serif;
        }

        .registration__field .form-control:focus {
            border-color: #5d00ff;
            box-shadow: none;
        }

        .registration__field .form-control::placeholder {
            color: #858789;
            opacity: 1;
        }

        .registration__field .invalid-feedback,
        .registration__flash {
            display: block;
            margin-top: 24px;
            color: #dc3545;
            font-family: "Eudoxus Sans", sans-serif;
            font-size: 14px;
            font-weight: 700;
            line-height: 20px;
        }

        .registration__flash + .registration__flash {
            margin-top: 8px;
        }

        .registration__submit {
            width: 100%;
            font-family: "Eudoxus Sans", sans-serif;
        }

        .registration__visual {
            width: 49.3%;
            min-height: calc(100vh - 72px);
            background-color: #fff;
            background-image: url("{{ asset('images/authentification/test.png') }}");
            background-position: right center;
            background-repeat: no-repeat;
            background-size: 200% auto;
        }

        @media (max-width: 1199.98px) {
            .registration__content {
                width: 55%;
                padding-right: 64px;
                padding-left: 64px;
            }

            .registration__visual {
                width: 45%;
            }
        }

        @media (max-width: 767.98px) {
            .registration {
                min-height: auto;
            }

            .registration__content {
                width: 100%;
                min-height: calc(100vh - 72px);
                padding: 48px 24px 56px;
            }

            .registration__socials {
                flex-direction: column;
            }

            .registration__social {
                width: 100%;
            }

            .registration__visual {
                display: none;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <main class="registration d-flex">
        <section class="registration__content">
            <div class="registration__inner">
                <h2 class="registration__title">{{ registrationType == 'professionnel' ? 'Créer un compte professionnel' : 'Créer un compte particulier' }}</h2>

                <div class="registration__socials">
                    <a href="#" class="registration__social registration__social--apple" data-turbo="false">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="20" viewBox="0 0 16 20" fill="none" aria-hidden="true">
                            <g clip-path="url(#clip0_6467_32228)">
                                <path d="M15.4909 6.818C15.3769 6.908 13.3641 8.062 13.3641 10.628C13.3641 13.596 15.9253 14.646 16.002 14.672C15.9902 14.736 15.5951 16.11 14.6516 17.51C13.8103 18.742 12.9317 19.972 11.5951 19.972C10.2585 19.972 9.9145 19.182 8.3715 19.182C6.86781 19.182 6.33317 19.998 5.11057 19.998C3.88796 19.998 3.03489 18.858 2.05405 17.458C0.917936 15.814 0 13.26 0 10.836C0 6.948 2.48452 4.886 4.92973 4.886C6.22899 4.886 7.31204 5.754 8.12776 5.754C8.90418 5.754 10.115 4.834 11.5931 4.834C12.1533 4.834 14.1661 4.886 15.4909 6.818ZM10.8914 3.188C11.5027 2.45 11.9351 1.426 11.9351 0.402C11.9351 0.26 11.9233 0.116 11.8978 0C10.9032 0.038 9.7199 0.674 9.00639 1.516C8.44619 2.164 7.92334 3.188 7.92334 4.226C7.92334 4.382 7.94889 4.538 7.96069 4.588C8.02359 4.6 8.1258 4.614 8.22801 4.614C9.12039 4.614 10.2428 4.006 10.8914 3.188Z" fill="white"/>
                            </g>
                            <defs>
                                <clipPath id="clip0_6467_32228">
                                    <rect width="16" height="20" fill="white"/>
                                </clipPath>
                            </defs>
                        </svg>
                        <span>Apple</span>
                    </a>

                    <a
                        href="{{ path('app_google_connect', {type: registrationType}) }}"
                        class="registration__social"
                        data-turbo="false"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M22.56 12.25C22.56 11.47 22.49 10.72 22.36 10H12V14.26H17.92C17.66 15.63 16.88 16.79 15.71 17.57V20.34H19.28C21.36 18.42 22.56 15.6 22.56 12.25Z" fill="#4285F4"/>
                            <path d="M12.0002 22.9996C14.9702 22.9996 17.4602 22.0196 19.2802 20.3396L15.7102 17.5696C14.7302 18.2296 13.4802 18.6296 12.0002 18.6296C9.14018 18.6296 6.71018 16.6996 5.84018 14.0996H2.18018V16.9396C3.99018 20.5296 7.70018 22.9996 12.0002 22.9996Z" fill="#34A853"/>
                            <path d="M5.84 14.0903C5.62 13.4303 5.49 12.7303 5.49 12.0003C5.49 11.2703 5.62 10.5703 5.84 9.91031V7.07031H2.18C1.43 8.55031 1 10.2203 1 12.0003C1 13.7803 1.43 15.4503 2.18 16.9303L5.03 14.7103L5.84 14.0903Z" fill="#FBBC05"/>
                            <path d="M12.0002 5.38C13.6202 5.38 15.0602 5.94 16.2102 7.02L19.3602 3.87C17.4502 2.09 14.9702 1 12.0002 1C7.70018 1 3.99018 3.47 2.18018 7.07L5.84018 9.91C6.71018 7.31 9.14018 5.38 12.0002 5.38Z" fill="#EA4335"/>
                        </svg>
                        <span>Google</span>
                    </a>
                </div>

                <div class="registration__divider"><span>OU</span></div>

                {{ form_start(emailForm, {
                    attr: {
                        class: 'registration__form',
                        'data-turbo': 'false',
                    },
                }) }}
                    <div class="registration__field">
                        {{ form_label(emailForm.email, 'Inscription via adresse e-mail*', {label_attr: {class: 'p-accent'}}) }}
                        {{ form_widget(emailForm.email, {
                            attr: {
                                class: 'form-control input' ~ (emailForm.email.vars.errors|length > 0 ? ' is-invalid' : ''),
                                placeholder: 'Veuillez entrer votre adresse e-mail',
                            },
                        }) }}

                        {{ form_errors(emailForm.email) }}

                        {% for label, messages in app.flashes %}
                            {% if label in ['danger', 'error', 'warning'] %}
                                {% for message in messages %}
                                    <span class="registration__flash">{{ message|trans }}</span>
                                {% endfor %}
                            {% endif %}
                        {% endfor %}
                    </div>

                    <button class="registration__submit btn-full-blue" type="submit">Continuer</button>
                {{ form_end(emailForm) }}
            </div>
        </section>

        <div class="registration__visual" role="img" aria-label="Vue d'une propriété au bord de la mer"></div>
    </main>
{% endblock %}

{% block body_class %}registration-page{% endblock %}
