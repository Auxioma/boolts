{% extends 'base.html.twig' %}

{% block title %}{{ 'professionnel.forgot_password.meta.title'|trans }}{% endblock %}

{% block body %}
<div class="bg-white d-flex flex-column" style="min-height: 100vh;">
    <div class="d-flex align-items-center justify-content-between flex-shrink-0 w-100" style="padding: 48px 132px;">
        <!-- Sidebar -->
        <div class="flex-shrink-0 position-relative" style="width: 359px; display: flex; flex-direction: column; gap: 74px;">
            <!-- Decorative vertical line -->
            <div style="position: absolute; left: 20px; top: 0; width: 3px; height: 360px; background-color: #5D00FF; z-index: 0;"></div>

            <!-- Step 1 -->
            <div class="d-flex align-items-center position-relative" style="gap: 16px; z-index: 1;">
                <div class="d-flex align-items-center justify-content-center flex-shrink-0 fw-bold text-white" style="width: 44px; height: 44px; background-color: #5D00FF; border-radius: 50%; font-size: 20px;">
                    <i class="fas fa-check"></i>
                </div>
                <p class="mb-0 fw-bold" style="color: #0B0F14; font-size: 16px; line-height: 20px;">Informations générales</p>
            </div>

            <!-- Step 2 -->
            <div class="d-flex align-items-center position-relative" style="gap: 16px; z-index: 1;">
                <div class="d-flex align-items-center justify-content-center flex-shrink-0 fw-bold text-white" style="width: 44px; height: 44px; background-color: #5D00FF; border-radius: 50%; font-size: 20px;">
                    <i class="fas fa-check"></i>
                </div>
                <p class="mb-0 fw-bold" style="color: #0B0F14; font-size: 16px; line-height: 20px;">Informations légales</p>
            </div>

            <!-- Step 3 -->
            <div class="d-flex align-items-center position-relative" style="gap: 16px; z-index: 1;">
                <div class="d-flex align-items-center justify-content-center flex-shrink-0 fw-bold text-white" style="width: 44px; height: 44px; background-color: #5D00FF; border-radius: 50%; font-size: 20px;">
                    <i class="fas fa-check"></i>
                </div>
                <p class="mb-0 fw-bold" style="color: #0B0F14; font-size: 16px; line-height: 20px;">Détails de l'agence 1/2</p>
            </div>

            <!-- Step 4 -->
            <div class="d-flex align-items-center position-relative" style="gap: 16px; z-index: 1;">
                <div class="d-flex align-items-center justify-content-center flex-shrink-0 fw-bold text-white" style="width: 44px; height: 44px; background-color: #5D00FF; border-radius: 50%; font-size: 20px;">
                    <i class="fas fa-check"></i>
                </div>
                <p class="mb-0 fw-bold" style="color: #0B0F14; font-size: 16px; line-height: 20px;">Détails de l'agence 2/2</p>
            </div>
        </div>

        <!-- Form Container -->
        <div class="bg-white flex-grow-1" style="display: flex; flex-direction: column; gap: 48px; padding-bottom: 32px; border-radius: 24px;">
            <h1 class="fw-bold" style="font-size: 30px; line-height: 34px; color: #0B0F14; margin: 0;">Remplissez les<br>derniers détails...</h1>

            <div class="d-flex flex-column" style="gap: 32px;">
                <!-- Horaires Section -->
                <div class="d-flex flex-column" style="gap: 16px;">
                    <label class="fw-bold" style="font-size: 16px; line-height: 20px; color: #0B0F14; margin: 0;">Horaires de l'agence (facultatif)</label>
                    
                    <div style="border-bottom: 2px solid #EBECEC; padding-bottom: 16px; display: flex; flex-direction: column; gap: 12px;">
                        <!-- Lundi -->
                        <div class="d-flex align-items-center" style="gap: 24px;">
                            <div class="d-flex align-items-center" style="gap: 12px; min-width: 140px;">
                                <p class="mb-0 fw-medium" style="font-size: 14px; color: #0B0F14;">Lundi</p>
                                <input type="checkbox" checked style="width: 24px; height: 24px; cursor: pointer; accent-color: #5D00FF;">
                                <p class="mb-0 fw-medium" style="font-size: 14px; color: #0B0F14;">Ouvert</p>
                            </div>
                            <div class="d-flex align-items-center" style="gap: 12px;">
                                <input type="text" value="9:00 - 18:00" style="height: 44px; border: 2px solid #EBECEC; border-radius: 8px; padding: 12px 14px; font-size: 14px; width: 140px;">
                                <button type="button" class="btn fw-bold" style="width: 24px; height: 24px; padding: 0; background-color: #5D00FF; border: none; border-radius: 50%; color: white; display: flex; align-items: center; justify-content: center; font-size: 12px;">
                                    <i class="fas fa-plus"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Mardi -->
                        <div class="d-flex align-items-center" style="gap: 24px;">
                            <div class="d-flex align-items-center" style="gap: 12px; min-width: 140px;">
                                <p class="mb-0 fw-medium" style="font-size: 14px; color: #0B0F14;">Mardi</p>
                                <input type="checkbox" checked style="width: 24px; height: 24px; cursor: pointer; accent-color: #5D00FF;">
                                <p class="mb-0 fw-medium" style="font-size: 14px; color: #0B0F14;">Ouvert</p>
                            </div>
                            <div class="d-flex align-items-center" style="gap: 12px;">
                                <input type="text" value="9:00 - 12:00" style="height: 44px; border: 2px solid #EBECEC; border-radius: 8px; padding: 12px 14px; font-size: 14px; width: 140px;">
                                <input type="text" value="14:00 - 18:00" style="height: 44px; border: 2px solid #EBECEC; border-radius: 8px; padding: 12px 14px; font-size: 14px; width: 140px;">
                                <button type="button" class="btn fw-bold" style="width: 24px; height: 24px; padding: 0; background-color: #dc3545; border: none; border-radius: 50%; color: white; display: flex; align-items: center; justify-content: center; font-size: 12px;">
                                    <i class="fas fa-minus"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Mercredi -->
                        <div class="d-flex align-items-center" style="gap: 24px; height: 44px;">
                            <div class="d-flex align-items-center" style="gap: 12px; min-width: 140px;">
                                <p class="mb-0 fw-medium" style="font-size: 14px; color: #858789;">Mercredi</p>
                                <input type="checkbox" style="width: 24px; height: 24px; cursor: pointer; accent-color: #5D00FF;">
                                <p class="mb-0 fw-medium" style="font-size: 14px; color: #858789;">Fermé</p>
                            </div>
                        </div>

                        <!-- Jeudi -->
                        <div class="d-flex align-items-center" style="gap: 24px;">
                            <div class="d-flex align-items-center" style="gap: 12px; min-width: 140px;">
                                <p class="mb-0 fw-medium" style="font-size: 14px; color: #0B0F14;">Jeudi</p>
                                <input type="checkbox" checked style="width: 24px; height: 24px; cursor: pointer; accent-color: #5D00FF;">
                                <p class="mb-0 fw-medium" style="font-size: 14px; color: #0B0F14;">Ouvert</p>
                            </div>
                            <div class="d-flex align-items-center" style="gap: 12px;">
                                <input type="text" value="9:00 - 12:00" style="height: 44px; border: 2px solid #EBECEC; border-radius: 8px; padding: 12px 14px; font-size: 14px; width: 140px;">
                                <input type="text" value="14:00 - 18:00" style="height: 44px; border: 2px solid #EBECEC; border-radius: 8px; padding: 12px 14px; font-size: 14px; width: 140px;">
                                <button type="button" class="btn fw-bold" style="width: 24px; height: 24px; padding: 0; background-color: #dc3545; border: none; border-radius: 50%; color: white; display: flex; align-items: center; justify-content: center; font-size: 12px;">
                                    <i class="fas fa-minus"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Vendredi -->
                        <div class="d-flex align-items-center" style="gap: 24px;">
                            <div class="d-flex align-items-center" style="gap: 12px; min-width: 140px;">
                                <p class="mb-0 fw-medium" style="font-size: 14px; color: #0B0F14;">Vendredi</p>
                                <input type="checkbox" checked style="width: 24px; height: 24px; cursor: pointer; accent-color: #5D00FF;">
                                <p class="mb-0 fw-medium" style="font-size: 14px; color: #0B0F14;">Ouvert</p>
                            </div>
                            <div class="d-flex align-items-center" style="gap: 12px;">
                                <input type="text" value="9:00 - 12:00" style="height: 44px; border: 2px solid #EBECEC; border-radius: 8px; padding: 12px 14px; font-size: 14px; width: 140px;">
                                <input type="text" value="14:00 - 18:00" style="height: 44px; border: 2px solid #EBECEC; border-radius: 8px; padding: 12px 14px; font-size: 14px; width: 140px;">
                                <button type="button" class="btn fw-bold" style="width: 24px; height: 24px; padding: 0; background-color: #dc3545; border: none; border-radius: 50%; color: white; display: flex; align-items: center; justify-content: center; font-size: 12px;">
                                    <i class="fas fa-minus"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Samedi -->
                        <div class="d-flex align-items-center" style="gap: 24px; height: 44px;">
                            <div class="d-flex align-items-center" style="gap: 12px; min-width: 140px;">
                                <p class="mb-0 fw-medium" style="font-size: 14px; color: #858789;">Samedi</p>
                                <input type="checkbox" style="width: 24px; height: 24px; cursor: pointer; accent-color: #5D00FF;">
                                <p class="mb-0 fw-medium" style="font-size: 14px; color: #858789;">Fermé</p>
                            </div>
                        </div>

                        <!-- Dimanche -->
                        <div class="d-flex align-items-center" style="gap: 24px; height: 44px;">
                            <div class="d-flex align-items-center" style="gap: 12px; min-width: 140px;">
                                <p class="mb-0 fw-medium" style="font-size: 14px; color: #858789;">Dimanche</p>
                                <input type="checkbox" style="width: 24px; height: 24px; cursor: pointer; accent-color: #5D00FF;">
                                <p class="mb-0 fw-medium" style="font-size: 14px; color: #858789;">Fermé</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Checkbox Acceptation -->
                <div class="d-flex align-items-start" style="gap: 12px;">
                    <input type="checkbox" style="width: 24px; height: 24px; cursor: pointer; accent-color: #5D00FF; flex-shrink: 0; margin-top: 2px;">
                    <p class="mb-0 fw-medium" style="font-size: 14px; color: #858789;">J'accepte les conditions d'utilisation de Boolts.*</p>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn btn-primary fw-bold" style="height: 44px; background-color: #5D00FF; border: none; border-radius: 50px; font-size: 16px; line-height: 20px; padding: 10px 16px; color: white;">S'inscrire</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block stylesheets %}
    <link href="https://fonts.googleapis.com/css2?family=Eudoxus+Sans:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

    <style>
        * {
            font-family: 'Eudoxus Sans', sans-serif;
        }

        .fw-medium {
            font-weight: 500;
        }

        input[type="text"],
        input[type="email"],
        textarea {
            font-family: 'Eudoxus Sans', sans-serif;
        }

        input[type="text"]:focus,
        input[type="email"]:focus,
        textarea:focus {
            border-color: #5D00FF;
            box-shadow: none;
            outline: none;
        }

        input[type="checkbox"] {
            accent-color: #5D00FF;
        }

        .btn-primary {
            background-color: #5D00FF;
            border-color: #5D00FF;
        }

        .btn-primary:hover {
            background-color: #4a00cc;
            border-color: #4a00cc;
        }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}
