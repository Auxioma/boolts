{#
 Template: templates/authentification/agence_immobiliere/rest_password.html.twig
 Role: Renders the authentification/agence_immobiliere Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

{% extends 'base.html.twig' %}

{% block title %}{{ 'professionnel.forgot_password.meta.title'|trans }}{% endblock %}

{% block body %}
    <main class="registration d-flex">
        <section class="registration__content">
            <div class="registration__inner">
                <h2 class="registration__title">Quelques informations à propos de votre entreprise</h2>

                {{ form_start(form, {
                    attr: {
                        class: 'registration__form',
                    },
                }) }}
                    <div class="registration__field">
                        <label for="{{ form.entreprise.vars.id }}" class="p-accent">Nom légal de votre entreprise*</label>
                        {{ form_widget(form.entreprise) }}
                        {{ form_errors(form.entreprise) }}
                    </div>

                    <div
                        data-controller="mes-biens--adresse-autocomplete"
                        data-mes-biens--adresse-autocomplete-provider-value="photon"
                        data-mes-biens--adresse-autocomplete-language-value="{{ app.request.locale|default('fr') }}"
                        data-mes-biens--adresse-autocomplete-limit-value="8"
                    >
                        <div class="registration__field position-relative">
                            <label for="{{ form.adresse.vars.id }}" class="p-accent">Adresse légale de votre entreprise*</label>
                            {{ form_widget(form.adresse, {
                                attr: {
                                    autocomplete: 'off',
                                    'data-mes-biens--adresse-autocomplete-target': 'adresse',
                                    'data-action': 'input->mes-biens--adresse-autocomplete#search keydown->mes-biens--adresse-autocomplete#onKeydown blur->mes-biens--adresse-autocomplete#onBlur',
                                },
                            }) }}
                            {{ form_errors(form.adresse) }}
                            <div
                                class="mapbox-autocomplete-results list-group shadow"
                                style="position: absolute; top: 100%; left: 0; right: 0; z-index: 20; margin-top: 4px; max-height: 240px; overflow-y: auto;"
                                data-mes-biens--adresse-autocomplete-target="results"
                                hidden
                            ></div>
                        </div>

                        <div class="registration__field">
                            <label for="{{ form.adresseComplement.vars.id }}" class="p-accent">Adresse 2 (facultatif)</label>
                            {{ form_widget(form.adresseComplement) }}
                            {{ form_errors(form.adresseComplement) }}
                        </div>

                        <div class="registration__names">
                            <div class="registration__field">
                                <label for="{{ form.codePostal.vars.id }}" class="p-accent">Code postal*</label>
                                {{ form_widget(form.codePostal, {
                                    attr: {
                                        autocomplete: 'off',
                                        'data-mes-biens--adresse-autocomplete-target': 'codePostal',
                                    },
                                }) }}
                                {{ form_errors(form.codePostal) }}
                            </div>

                            <div class="registration__field">
                                <label for="{{ form.ville.vars.id }}" class="p-accent">Ville*</label>
                                {{ form_widget(form.ville, {
                                    attr: {
                                        autocomplete: 'off',
                                        'data-mes-biens--adresse-autocomplete-target': 'ville',
                                    },
                                }) }}
                                {{ form_errors(form.ville) }}
                            </div>
                        </div>

                        <div class="registration__field">
                            <label for="{{ form.pays.vars.id }}" class="p-accent">Pays*</label>
                            {{ form_widget(form.pays, {
                                attr: {
                                    autocomplete: 'off',
                                    'data-mes-biens--adresse-autocomplete-target': 'pays',
                                },
                            }) }}
                            {{ form_errors(form.pays) }}
                        </div>
                    </div>

                    <p class="registration__info">*Informations telles qu'affichées sur vos documents officiels</p>

                    <button class="registration__submit btn-full-blue" type="submit">Suivant</button>
                {{ form_end(form) }}
            </div>
        </section>

        <div class="registration__visual" role="img" aria-label="Vue d'une propriété au bord de la mer"></div>
    </main>
{% endblock %}

{% block stylesheets %}
    <style>
        body.registration-page {
            background: #fff !important;
            overflow-x: hidden;
        }

        body.registration-page .topbar-logo {
            width: 112px;
            height: 36px;
        }

        body.registration-page .topbar-menu .nav-link {
            font-weight: 700;
        }

        body.registration-page .topbar-menu .nav-item:nth-child(4) .nav-link {
            color: #5d00ff;
            background: #dfcbff;
        }

        .registration {
            min-height: calc(100vh - 72px);
            background: #fff;
        }

        .registration__content {
            display: flex;
            align-items: flex-start;
            width: 50.7%;
            min-height: calc(100vh - 72px);
            padding: 48px clamp(32px, 9.86vw, 142px) 48px clamp(32px, 9.17vw, 132px);
        }

        .registration__inner {
            width: 100%;
        }

        .registration__title {
            margin: 0 0 32px;
            color: #0b0f14;
            font-family: "Eudoxus Sans", sans-serif;
        }

        .registration__names {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 16px;
        }

        .registration__field {
            margin-bottom: 32px;
        }

        .registration__field label {
            display: block;
            margin-bottom: 16px;
            color: #0b0f14;
            font-family: "Eudoxus Sans", sans-serif;
        }

        .registration__field .form-control {
            color: #0b0f14;
            font-family: "Eudoxus Sans", sans-serif;
        }

        .registration__field .form-control:focus {
            border-color: #5d00ff;
            box-shadow: none;
        }

        .registration__field .form-control::placeholder {
            color: #858789;
            opacity: 1;
        }

        .registration__field .invalid-feedback {
            display: block;
            margin-top: 24px;
            color: #dc3545;
            font-family: "Eudoxus Sans", sans-serif;
            font-size: 14px;
            font-weight: 700;
            line-height: 20px;
        }

        .registration__info {
            margin: 0 0 32px;
            color: #858789;
            font-family: "Eudoxus Sans", sans-serif;
        }

        .registration__submit {
            width: 100%;
            font-family: "Eudoxus Sans", sans-serif;
        }

        .registration__visual {
            width: 49.3%;
            min-height: calc(100vh - 72px);
            background-color: #fff;
            background-image: url("{{ asset('images/authentification/test.png') }}");
            background-position: right center;
            background-repeat: no-repeat;
            background-size: 200% auto;
        }

        @media (max-width: 1199.98px) {
            .registration__content {
                width: 55%;
                padding-right: 64px;
                padding-left: 64px;
            }

            .registration__visual {
                width: 45%;
            }
        }

        @media (max-width: 767.98px) {
            .registration {
                min-height: auto;
            }

            .registration__content {
                width: 100%;
                min-height: calc(100vh - 72px);
                padding: 48px 24px 56px;
            }

            .registration__visual {
                display: none;
            }
        }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}

{% block body_class %}registration-page{% endblock %}
