{#
 Template: templates/authentification/agence_immobiliere/profile.html.twig
 Role: Renders the authentification/agence_immobiliere Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

{% extends 'base.html.twig' %}

{% block title %}{{ 'professionnel.register.agency.meta.title'|trans }}{% endblock %}

{% block body %}
     <main>
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="row">
                        <div class="col-12">
                            <div class="row">
                                <div class="col-md-11 col-md-10 col-lg-6 mx-auto">
                                    <div class="login my-48 px-48 py-48 bg-white rounded-24">
                                        <h1 class="mb-0 text-center">
                                            {{ 'professionnel.register.agency.title'|trans }}
                                        </h1>

                                        <div class="formulaire mt-32">
                                            {% set _pwd_locale_en = app.request.locale starts with 'en' %}
                                            {{ form_start(form, {'attr': {
                                                'data-controller': 'password-strength',
                                                'data-password-strength-min-value': '12',
                                                'data-password-strength-label-progress-value': _pwd_locale_en ? '{count} / {min} characters' : '{count} / {min} caractères',
                                                'data-password-strength-label-valid-value': _pwd_locale_en ? 'Minimum length reached' : 'Longueur minimale atteinte',
                                            }}) }}
                                            <div class="">
                                                <label for="email" class="form-label mb-16">
                                                    {{ 'professionnel.register.agency.lastname.label'|trans }}
                                                </label>
                                                {{ form_widget(form.nom) }}

                                                <label for="pwd" class="form-label mb-16">
                                                    {{ 'professionnel.register.agency.firstname.label'|trans }}
                                                </label>
                                                {{ form_widget(form.prenom) }}

                                                <label for="pwd" class="form-label mb-16">
                                                    {{ 'professionnel.register.agency.password.label'|trans }}
                                                </label>
                                                {{ form_widget(form.plainPassword.first) }}
                                                <div data-password-strength-target="meter" class="mt-8 mb-16"></div>
                                                <small class="d-block mb-16">
                                                    {{ 'visiteur.register.profile.password.help'|trans }}
                                                </small>

                                                <label for="pwd" class="form-label mb-16">
                                                    {{ 'professionnel.register.agency.password_confirm.label'|trans }}
                                                </label>
                                                {{ form_widget(form.plainPassword.second) }}

                                                {% for label, messages in app.flashes %}
                                                    {% if label in ['danger', 'error', 'warning'] %}
                                                        {% for message in messages %}
                                                            <span class="
                                                                    flash-message mt-32 d-block
                                                                    {% if label in ['danger', 'error'] %}flash-message-error{% endif %}
                                                                    {% if label == 'warning' %}flash-message-error{% endif %}
                                                                ">
                                                                    {{ message|trans }}
                                                                </span>
                                                        {% endfor %}
                                                    {% endif %}
                                                {% endfor %}

                                                <button class=" btn-submit w-100 text-white" type="submit"
                                                        data-password-strength-target="submit">
                                                    {{ 'professionnel.register.agency.submit'|trans }}
                                                </button>
                                            </div>
                                            {{ form_end(form) }}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
{% endblock %}
{% block stylesheets %}
    <style>
        body {
            background: url("{{ asset('images/authentification/real-estate.webp') }}") no-repeat center center fixed;
            background-size: cover;
            min-height: 100vh;
        }
        main {
            min-height: 100vh;
        }

        /* --- Password strength stepper --- */
        .password-strength__track {
            display: flex;
            gap: 4px;
        }
        .password-strength__segment {
            flex: 1 1 0;
            height: 6px;
            border-radius: 999px;
            background-color: #e5e7eb;
            transition: background-color .15s ease;
        }
        .password-strength__segment.is-filled[data-level="0"] {
            background-color: #ef4444;
        }
        .password-strength__segment.is-filled[data-level="1"] {
            background-color: #f59e0b;
        }
        .password-strength__segment.is-filled[data-level="2"] {
            background-color: #22c55e;
        }
        .password-strength__label {
            display: block;
            margin-top: 6px;
            font-size: 12px;
            color: #6b7280;
        }
        .password-strength__label[data-level="2"] {
            color: #16a34a;
        }
        .btn-submit:disabled,
        .btn-submit.is-disabled {
            opacity: .5;
            cursor: not-allowed;
        }
    </style>
{% endblock %}
