{#
 Template: templates/authentification/agence_immobiliere/rest_password.html.twig
 Role: Renders the authentification/agence_immobiliere Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

{% extends 'base.html.twig' %}

{% block title %}{{ 'professionnel.forgot_password.meta.title'|trans }}{% endblock %}

{% block body %}
    <main class="registration d-flex">
        <section class="registration__content">
            <div class="registration__inner">
                <h2 class="registration__title">Remplissez les informations de votre compte</h2>

                {% set _pwd_locale_en = app.request.locale starts with 'en' %}
                {{ form_start(form, {
                    attr: {
                        class: 'registration__form',
                        'data-controller': 'phone password-strength',
                        'data-action': 'submit->phone#prepareSubmit submit->password-strength#validate',
                        'data-password-strength-min-value': '12',
                        'data-password-strength-label-progress-value': _pwd_locale_en ? '{count} / {min} characters' : '{count} / {min} caractères',
                        'data-password-strength-label-valid-value': _pwd_locale_en ? 'Minimum length reached' : 'Longueur minimale atteinte',
                        'data-password-strength-label-mismatch-value': _pwd_locale_en ? 'Passwords do not match.' : 'Les mots de passe ne correspondent pas.',
                    },
                }) }}
                    <div class="registration__names">
                        <div class="registration__field">
                            <label for="{{ form.nom.vars.id }}" class="p-accent">
                                {{ 'professionnel.register.agency.lastname.label'|trans }}
                            </label>
                            {{ form_widget(form.nom, {attr: {class: 'form-control input'}}) }}
                        </div>

                        <div class="registration__field">
                            <label for="{{ form.prenom.vars.id }}" class="p-accent">
                                {{ 'professionnel.register.agency.firstname.label'|trans }}
                            </label>
                            {{ form_widget(form.prenom, {attr: {class: 'form-control input'}}) }}
                        </div>
                    </div>

                    <div class="registration__field">
                        <label for="{{ form.telephone.vars.id }}" class="p-accent">
                            Numéro de téléphone
                        </label>
                        {{ form_widget(form.telephone, {attr: {class: 'form-control input'}}) }}
                        {{ form_errors(form.telephone) }}
                    </div>

                    <div class="registration__field">
                        <label for="{{ form.plainPassword.first.vars.id }}" class="p-accent">
                            {{ 'professionnel.register.agency.password.label'|trans }}
                        </label>
                        {{ form_widget(form.plainPassword.first, {attr: {class: 'form-control input password-input'}}) }}
                        <div data-password-strength-target="meter" class="mt-8 mb-16"></div>
                    </div>

                    <div class="registration__field">
                        <label for="{{ form.plainPassword.second.vars.id }}" class="p-accent">
                            {{ 'professionnel.register.agency.password_confirm.label'|trans }}
                        </label>
                        {{ form_widget(form.plainPassword.second, {attr: {class: 'form-control input password-input'}}) }}
                        <span data-password-strength-target="confirmError" class="registration__flash" hidden></span>

                        {% for label, messages in app.flashes %}
                            {% if label in ['danger', 'error', 'warning'] %}
                                {% for message in messages %}
                                    <span class="registration__flash">{{ message|trans }}</span>
                                {% endfor %}
                            {% endif %}
                        {% endfor %}
                    </div>

                    <button
                        class="registration__submit btn-full-blue"
                        type="submit"
                        data-password-strength-target="submit"
                    >
                        {{ 'professionnel.register.agency.submit'|trans }}
                    </button>
                {{ form_end(form) }}
            </div>
        </section>

        <div class="registration__visual" role="img" aria-label="Vue d'une propriété au bord de la mer"></div>
    </main>
{% endblock %}

{% block stylesheets %}
    <style>
        body.registration-page {
            background: #fff !important;
            overflow-x: hidden;
        }

        body.registration-page .topbar-logo {
            width: 112px;
            height: 36px;
        }

        body.registration-page .topbar-menu .nav-link {
            font-weight: 700;
        }

        body.registration-page .topbar-menu .nav-item:nth-child(4) .nav-link {
            color: #5d00ff;
            background: #dfcbff;
        }

        .registration {
            min-height: calc(100vh - 72px);
            background: #fff;
        }

        .registration__content {
            display: flex;
            align-items: flex-start;
            width: 50.7%;
            min-height: calc(100vh - 72px);
            padding: 48px clamp(32px, 9.86vw, 142px) 48px clamp(32px, 9.17vw, 132px);
        }

        .registration__inner {
            width: 100%;
        }

        .registration__title {
            margin: 0 0 32px;
            color: #0b0f14;
            font-family: "Eudoxus Sans", sans-serif;
        }

        .registration__names {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 16px;
        }

        .registration__field {
            margin-bottom: 32px;
        }

        .registration__field label {
            display: block;
            margin-bottom: 16px;
            color: #0b0f14;
            font-family: "Eudoxus Sans", sans-serif;
        }

        .registration__field .form-control {
            color: #0b0f14;
            font-family: "Eudoxus Sans", sans-serif;
        }

        .registration__field .form-control:focus {
            border-color: #5d00ff;
            box-shadow: none;
        }

        .registration__field .form-control::placeholder {
            color: #858789;
            opacity: 1;
        }

        .registration__field .iti {
            width: 100%;
        }

        .registration__field .invalid-feedback,
        .registration__flash {
            display: block;
            margin-top: 24px;
            color: #dc3545;
            font-family: "Eudoxus Sans", sans-serif;
            font-size: 14px;
            font-weight: 700;
            line-height: 20px;
        }

        .registration__flash[hidden] {
            display: none;
        }

        .registration__flash + .registration__flash {
            margin-top: 8px;
        }

        .registration__submit {
            width: 100%;
            font-family: "Eudoxus Sans", sans-serif;
        }

        .registration__visual {
            width: 49.3%;
            min-height: calc(100vh - 72px);
            background-color: #fff;
            background-image: url("{{ asset('images/authentification/test.png') }}");
            background-position: right center;
            background-repeat: no-repeat;
            background-size: 200% auto;
        }

        @media (max-width: 1199.98px) {
            .registration__content {
                width: 55%;
                padding-right: 64px;
                padding-left: 64px;
            }

            .registration__visual {
                width: 45%;
            }
        }

        @media (max-width: 767.98px) {
            .registration {
                min-height: auto;
            }

            .registration__content {
                width: 100%;
                min-height: calc(100vh - 72px);
                padding: 48px 24px 56px;
            }

            .registration__visual {
                display: none;
            }
        }

        /* --- Password strength stepper --- */
        .password-strength__track {
            display: flex;
            gap: 4px;
        }
        .password-strength__segment {
            flex: 1 1 0;
            height: 6px;
            border-radius: 999px;
            background-color: #e5e7eb;
            transition: background-color 0.15s ease;
        }
        .password-strength__segment.is-filled[data-level="0"] {
            background-color: #ef4444;
        }
        .password-strength__segment.is-filled[data-level="1"] {
            background-color: #f59e0b;
        }
        .password-strength__segment.is-filled[data-level="2"] {
            background-color: #22c55e;
        }
        .password-strength__label {
            display: block;
            margin-top: 6px;
            font-size: 12px;
            color: #858789;
        }
        .password-strength__label[data-level="2"] {
            color: #16a34a;
        }
        .btn-full-blue:disabled,
        .btn-full-blue.is-disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}

{% block body_class %}registration-page{% endblock %}
