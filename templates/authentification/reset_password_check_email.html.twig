{#
 Template: templates/authentification/reset_password_check_email.html.twig
 Role: Shared password-reset confirmation screen for individual and professional accounts.
#}

{% extends 'base.html.twig' %}

{% block title %}{{ resetPasswordCheckMetaTitle|trans }}{% endblock %}

{% block stylesheets %}
    <style>
        body.reset-password-check-email-page {
            background: #fff !important;
            overflow-x: hidden;
        }

        body.reset-password-check-email-page .topbar-logo {
            width: 112px;
            height: 36px;
        }

        body.reset-password-check-email-page .topbar-menu .nav-link {
            font-weight: 700;
        }

        .shared-reset-password-check-email {
            display: flex;
            align-items: center;
            min-height: 591px;
            padding: 48px 24px;
            background: #fff;
        }

        .shared-reset-password-check-email__inner {
            display: flex;
            flex-direction: column;
            gap: 32px;
            width: 100%;
            max-width: 456px;
            margin: 0 auto;
        }

        .shared-reset-password-check-email__title {
            margin: 0;
            color: #0b0f14;
            font-family: "Eudoxus Sans", sans-serif;
            font-size: 30px;
            font-weight: 700;
            line-height: 34px;
        }

        .shared-reset-password-check-email__link {
            display: inline-flex;
            align-items: center;
            min-height: 44px;
            padding: 10px 0;
            border-radius: 50px;
            color: #5d00ff;
            font-family: "Eudoxus Sans", sans-serif;
            font-size: 16px;
            font-weight: 700;
            line-height: 20px;
            text-decoration: none;
        }

        .shared-reset-password-check-email__link:hover,
        .shared-reset-password-check-email__link:focus-visible {
            color: #4d00d2;
            text-decoration: underline;
        }

        @media (max-width: 767.98px) {
            .shared-reset-password-check-email {
                min-height: auto;
                padding: 48px 24px 56px;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <main class="shared-reset-password-check-email">
        <div class="shared-reset-password-check-email__inner">
            <h1 class="shared-reset-password-check-email__title">
                {{ resetPasswordCheckTitle|trans }}
            </h1>

            <a
                href="{{ path(resetPasswordResendRoute) }}"
                class="shared-reset-password-check-email__link"
                data-turbo="false"
            >
                {{ resetPasswordResendLink|trans }}
            </a>
        </div>
    </main>
{% endblock %}

{% block body_class %}reset-password-check-email-page{% endblock %}
