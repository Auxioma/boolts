{#
 Template: templates/debug/_ip_location_panel.html.twig
 Role: DEBUG (tests) — affiche la localisation déduite de l'IP du visiteur.
 Contexte: rendu par App\Controller\DebugIpLocationController::panel, inclus dans
           base.html.twig uniquement en environnement de dev. À retirer avant la prod.
#}
{% set sources = {
    'Cloudflare (en-têtes CF)': cloudflare,
    'GeoIP MaxMind (var/geoip/GeoLite2-City.mmdb)': geoip,
    'ip-api.com (API externe)': ip_api,
} %}

<div id="debug-ip-location"
     style="position:fixed;bottom:12px;right:12px;z-index:99999;max-width:440px;max-height:70vh;overflow:auto;background:#101418;color:#e6edf3;font:12px/1.5 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;border:1px solid #30363d;border-radius:8px;box-shadow:0 8px 24px rgba(0,0,0,.4)">
    <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;padding:8px 12px;background:#161b22;border-bottom:1px solid #30363d;position:sticky;top:0">
        <strong>📍 Localisation IP (debug)</strong>
        <button type="button"
                onclick="this.closest('#debug-ip-location').remove()"
                style="background:none;border:none;color:#e6edf3;cursor:pointer;font-size:14px">✕</button>
    </div>

    <div style="padding:8px 12px;border-bottom:1px solid #30363d">
        <div><span style="color:#7d8590">IP utilisée&nbsp;:</span> <strong>{{ ip|default('null') }}</strong></div>
        <div><span style="color:#7d8590">getClientIp()&nbsp;:</span> {{ client_ip|default('null') }}</div>
        {% if is_private_or_local %}
            <div style="color:#e3b341;margin-top:4px">
                ⚠ IP privée / locale — GeoIP et ip-api ne renverront rien.
                Teste derrière un domaine public / Cloudflare pour des données réelles.
            </div>
        {% endif %}
    </div>

    <table style="border-collapse:collapse;width:100%">
        <tbody>
            <tr><td colspan="2" style="padding:6px 12px;background:#161b22;color:#7d8590;text-transform:uppercase;letter-spacing:.05em">En-têtes reçus</td></tr>
            {% for name, value in headers %}
                <tr>
                    <td style="padding:4px 12px;border-bottom:1px solid #21262d;color:#7d8590;white-space:nowrap;vertical-align:top">{{ name }}</td>
                    <td style="padding:4px 12px;border-bottom:1px solid #21262d;word-break:break-all">
                        {{ value is null ? '—' : value }}
                    </td>
                </tr>
            {% endfor %}

            {% for label, data in sources %}
                <tr><td colspan="2" style="padding:6px 12px;background:#161b22;color:#7d8590;text-transform:uppercase;letter-spacing:.05em">{{ label }}</td></tr>
                {% if data is null %}
                    <tr><td colspan="2" style="padding:4px 12px;border-bottom:1px solid #21262d;color:#e3b341">Aucune donnée (null)</td></tr>
                {% else %}
                    {% for key, value in data %}
                        <tr>
                            <td style="padding:4px 12px;border-bottom:1px solid #21262d;color:#7d8590;white-space:nowrap;vertical-align:top">{{ key }}</td>
                            <td style="padding:4px 12px;border-bottom:1px solid #21262d;word-break:break-all">
                                {% if value is null %}
                                    <em style="color:#7d8590">null</em>
                                {% elseif value is same as(true) %}
                                    <span style="color:#3fb950">true</span>
                                {% elseif value is same as(false) %}
                                    <span style="color:#f85149">false</span>
                                {% else %}
                                    {{ value }}
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                {% endif %}
            {% endfor %}
        </tbody>
    </table>
</div>
