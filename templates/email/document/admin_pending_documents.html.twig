{#
 Template: templates/email/document/admin_pending_documents.html.twig
 Role: Renders the administrator email sent after an agency document upload.
 Context: Provided by App\Service\Document\AdminDocumentNotificationMailer.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

<!DOCTYPE html>
<html lang="{{ app.request.locale|default('fr') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ 'email.document.admin.subject'|trans }}</title>
</head>
<body style="font-family: Arial, sans-serif; color: #202124; line-height: 1.5;">
    <h1>{{ 'email.document.admin.subject'|trans }}</h1>

    <p>{{ 'email.common.hello_name'|trans({'%name%': admin_name|default('Admin')}) }}</p>

    <p>{{ 'email.document.admin.text'|trans }}</p>
    <p>{{ 'email.document.admin.attached'|trans }}</p>

    <table role="presentation" cellpadding="6" cellspacing="0" border="0">
        <tr>
            <td><strong>{{ 'email.document.admin.agency'|trans }}</strong></td>
            <td>{{ agency.entreprise|default(agency.email|default('email.document.admin.unknown_agency'|trans)) }}</td>
        </tr>
        <tr>
            <td><strong>{{ 'email.document.admin.agency_email'|trans }}</strong></td>
            <td>{{ agency.email|default('email.common.not_provided'|trans) }}</td>
        </tr>
    </table>

    <h2>{{ 'email.document.admin.to_validate'|trans }}</h2>

    <table role="presentation" cellpadding="6" cellspacing="0" border="0">
        <thead>
            <tr>
                <th align="left">{{ 'email.document.admin.document'|trans }}</th>
                <th align="left">{{ 'email.document.admin.file'|trans }}</th>
                <th align="left">{{ 'email.document.admin.submitted_at'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% for submission in submissions %}
                {% set documentRequest = submission.documentRequest %}
                {% set requiredDocument = documentRequest ? documentRequest.requiredDocument : null %}
                <tr>
                    <td>{{ requiredDocument.name|default('email.document.admin.unknown_document'|trans) }}</td>
                    <td>{{ submission.originalFileName }}</td>
                    <td>{{ submission.submittedAt|date('d/m/Y H:i') }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <p>{{ 'email.document.admin.check'|trans }}</p>
</body>
</html>
