{#
 Template: templates/email/booster/pack_purchase_confirmation.html.twig
 Role: Renders the agency email sent once a booster pack purchase has been confirmed.
 Context: Provided by App\Service\Booster\BoosterPackPurchaseMailer.
 Maintenance: Preserve context keys used by the mailer. Le contenu s'adapte au pack acheté.
#}

<!DOCTYPE html>
<html lang="{{ app.request.locale|default('fr') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ 'email.booster.subject'|trans({'%name%': packName}) }}</title>
</head>
<body style="font-family: Arial, sans-serif; color: #202124; line-height: 1.5;">
    <h1>{{ 'email.booster.title'|trans }}</h1>

    <p>{{ 'email.common.hello_name'|trans({'%name%': agencyName|default('')}) }}</p>

    <p>
        {{ 'email.booster.intro'|trans({'%name%': packName|e})|raw }}
        {% if boostQuantity == 1 %}
            {{ 'email.booster.added.one'|trans|raw }}
        {% else %}
            {{ 'email.booster.added.other'|trans({'%count%': boostQuantity})|raw }}
        {% endif %}
    </p>

    {% if packDescription is not empty %}
        <p>{{ packDescription }}</p>
    {% endif %}

    <table role="presentation" cellpadding="6" cellspacing="0" border="0">
        <tr>
            <td><strong>{{ 'email.booster.label.pack'|trans }}</strong></td>
            <td>{{ packName }}</td>
        </tr>
        <tr>
            <td><strong>{{ 'email.booster.label.credits'|trans }}</strong></td>
            <td>{{ boostQuantity }}</td>
        </tr>
        <tr>
            <td><strong>{{ 'email.booster.label.duration'|trans }}</strong></td>
            <td>{{ (boostDurationDays > 1 ? 'email.booster.days.other' : 'email.booster.days.one')|trans({'%count%': boostDurationDays}) }}</td>
        </tr>
        <tr>
            <td><strong>{{ 'email.booster.label.amount'|trans }}</strong></td>
            <td>{{ amountMinor|minor_amount(currencyName) }} {{ currencySign }}</td>
        </tr>
        <tr>
            <td><strong>{{ 'email.booster.label.reference'|trans }}</strong></td>
            <td>{{ paymentReference }}</td>
        </tr>
        <tr>
            <td><strong>{{ 'email.booster.label.date'|trans }}</strong></td>
            <td>{{ purchasedAt|date('d/m/Y') }}</td>
        </tr>
        {% if creditsExpireAt is not null %}
        <tr>
            <td><strong>{{ 'email.booster.label.expires'|trans }}</strong></td>
            <td>{{ creditsExpireAt|date('d/m/Y') }}</td>
        </tr>
        {% endif %}
    </table>

    <p>
        {{ (boostQuantity == 1 ? 'email.booster.use.one' : 'email.booster.use.other')|trans }}
        <a href="{{ mesBiensUrl }}">{{ 'email.property.view_listings'|trans }}</a>
    </p>

    <p>
        {{ 'email.booster.options'|trans }} <a href="{{ optionsUrl }}">{{ 'email.booster.options_link'|trans }}</a>
    </p>

    <p>{{ 'email.common.signature'|trans|raw }}</p>
</body>
</html>
