{#
 Template: templates/email/property/deleted.html.twig
 Role: Renders the agency email sent once a property has been deleted.
 Context: Provided by App\Service\Property\AgencyPropertySubmissionMailer.
 Maintenance: Preserve context keys used by the mailer.
#}

<!DOCTYPE html>
<html lang="{{ app.request.locale|default('fr') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ 'email.property.deleted.subject'|trans }}</title>
</head>
<body style="font-family: Arial, sans-serif; color: #202124; line-height: 1.5;">
    <h1>{{ 'email.property.deleted.subject'|trans }}</h1>

    <p>{{ 'email.common.hello_name'|trans({'%name%': agencyName|default('')}) }}</p>

    <p>
        {{ 'email.property.deleted.text'|trans({'%title%': propertyTitle}) }}
    </p>

    <table role="presentation" cellpadding="6" cellspacing="0" border="0">
        <tr>
            <td><strong>{{ 'email.property.label.transaction'|trans }}</strong></td>
            <td>{{ property.typeTransaction.name|default('email.common.not_provided'|trans) }}</td>
        </tr>
        <tr>
            <td><strong>{{ 'email.property.label.type'|trans }}</strong></td>
            <td>{{ property.typeBien.name|default('email.common.not_provided'|trans) }}</td>
        </tr>
        <tr>
            <td><strong>{{ 'email.property.label.city'|trans }}</strong></td>
            <td>{{ property.ville|default('email.common.not_provided_f'|trans) }}</td>
        </tr>
    </table>

    <p>
        {{ 'email.property.deleted.not_intended'|trans }}
        {{ 'email.property.deleted.manage'|trans }}
        <a href="{{ mesBiensUrl }}">{{ 'email.property.view_listings'|trans }}</a>
    </p>

    <p>{{ 'email.common.signature'|trans|raw }}</p>
</body>
</html>
