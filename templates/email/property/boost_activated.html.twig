{#
 Template: templates/email/property/boost_activated.html.twig
 Role: Renders the agency email sent once a boost has been activated on a property.
 Context: Provided by App\Service\Property\AgencyPropertySubmissionMailer.
 Maintenance: Preserve context keys used by the mailer.
#}

<!DOCTYPE html>
<html lang="{{ app.request.locale|default('fr') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ 'email.property.boost_activated.subject'|trans }}</title>
</head>
<body style="font-family: Arial, sans-serif; color: #202124; line-height: 1.5;">
    <h1>{{ 'email.property.boost_activated.title'|trans }}</h1>

    <p>{{ 'email.common.hello_name'|trans({'%name%': agencyName|default('')}) }}</p>

    <p>
        {% if boostEndsAt is defined and boostEndsAt is not null %}
            {{ 'email.property.boost_activated.text_until'|trans({'%title%': propertyTitle, '%date%': boostEndsAt|date('d/m/Y')}) }}
        {% else %}
            {{ 'email.property.boost_activated.text'|trans({'%title%': propertyTitle}) }}
        {% endif %}
    </p>

    <table role="presentation" cellpadding="6" cellspacing="0" border="0">
        <tr>
            <td><strong>{{ 'email.property.label.status'|trans }}</strong></td>
            <td>{{ property.statut.translationKey|trans }}</td>
        </tr>
        {% if boostEndsAt is defined and boostEndsAt is not null %}
        <tr>
            <td><strong>{{ 'email.property.label.boost_until'|trans }}</strong></td>
            <td>{{ boostEndsAt|date('d/m/Y') }}</td>
        </tr>
        {% endif %}
        <tr>
            <td><strong>{{ 'email.property.label.city'|trans }}</strong></td>
            <td>{{ property.ville|default('email.common.not_provided_f'|trans) }}</td>
        </tr>
    </table>

    {% if publicUrl is defined and publicUrl is not null %}
        <p>
            {{ 'email.property.view_online'|trans }}
            <a href="{{ publicUrl }}">{{ publicUrl }}</a>
        </p>
    {% endif %}

    <p>
        {{ 'email.property.manage'|trans }}
        <a href="{{ mesBiensUrl }}">{{ 'email.property.view_listings'|trans }}</a>
    </p>

    <p>{{ 'email.common.signature'|trans|raw }}</p>
</body>
</html>
