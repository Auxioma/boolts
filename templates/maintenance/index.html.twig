<!doctype html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow, noarchive">
    <title>{{ maintenance.title }}</title>
    <style>
        :root {
            color-scheme: dark;
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        * {
            box-sizing: border-box;
        }

        body {
            display: grid;
            min-height: 100vh;
            margin: 0;
            padding: 2rem;
            place-items: center;
            color: #f8fafc;
            background:
                radial-gradient(circle at top, rgb(29 78 216 / 35%), transparent 42rem),
                #080d18;
        }

        main {
            width: min(100%, 44rem);
            padding: clamp(2rem, 6vw, 4rem);
            text-align: center;
            background: rgb(15 23 42 / 82%);
            border: 1px solid rgb(148 163 184 / 18%);
            border-radius: 1.5rem;
            box-shadow: 0 1.5rem 5rem rgb(0 0 0 / 35%);
            backdrop-filter: blur(1rem);
        }

        .brand {
            margin: 0 0 2.5rem;
            font-size: 1.4rem;
            font-weight: 800;
            letter-spacing: .22em;
        }

        .status {
            display: inline-block;
            margin-bottom: 1.25rem;
            padding: .45rem .8rem;
            color: #93c5fd;
            font-size: .78rem;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
            background: rgb(37 99 235 / 18%);
            border: 1px solid rgb(96 165 250 / 25%);
            border-radius: 999px;
        }

        h1 {
            margin: 0;
            font-size: clamp(2rem, 7vw, 3.5rem);
            line-height: 1.08;
        }

        .message {
            margin: 1.5rem auto 0;
            color: #cbd5e1;
            font-size: clamp(1rem, 3vw, 1.15rem);
            line-height: 1.7;
        }

        .end {
            margin: 2rem 0 0;
            color: #94a3b8;
            font-size: .9rem;
        }
    </style>
</head>
<body>
<main>
    <p class="brand">BOOLTS</p>
    <span class="status">Maintenance en cours</span>
    <h1>{{ maintenance.title }}</h1>
    <div class="message">{{ maintenance.message|nl2br }}</div>

    {% if maintenance.endsAt %}
        <p class="end">
            Retour prévu le {{ maintenance.endsAt|format_datetime('long', 'short', locale='fr') }}.
        </p>
    {% endif %}
</main>
</body>
</html>