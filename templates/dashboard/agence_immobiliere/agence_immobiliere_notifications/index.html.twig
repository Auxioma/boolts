 Role: Renders the dashboard/agence_immobiliere/agence_immobiliere_notifications Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

{% extends 'base.html.twig' %}

{% block title %}Notifications{% endblock %}

{% block body %}
    {% set notifications = notifications|default([]) %}
    {% set unreadCount = unreadCount|default(0) %}

    <main id="dashboard" class="dashboard">
        <div class="container-fluid dashboard-container">
            <div class="row">

                {# Sidebar existante #}
                {{ include('composant/__agence_immobiliere/_tableau_de_bord.html.twig') }}

                {# Contenu principal #}
                <div class="col-md-9 col-lg-10 col-12 dashboard-main bg-white">
                    <div class="row">
                        <div class="col-12 col-md-10 mx-auto">
                        <section id="agence-notifications" class="js-agence-notifications" data-controller="agence-notifications"
                                 data-agence-notifications-csrf-token-value="{{ csrf_token('agency_notification_read') }}">
                            <h2 class="notifications-page__title">Notifications</h2>

                            <div class="notifications-page__body">
                                <div class="notifications-filter" role="tablist">
                                    <button type="button" class="p-accent notifications-filter__button active" data-filter="all"
                                            data-agence-notifications-target="filterButton"
                                            data-action="agence-notifications#filter">
                                        Toutes
                                    </button>

                                    <button type="button" class="p-accent notifications-filter__button" data-filter="unread"
                                            data-agence-notifications-target="filterButton"
                                            data-action="agence-notifications#filter">
                                        Non lues
                                        <span class="notifications-filter__count" data-agence-notifications-target="unreadCount">{{ unreadCount }}</span>
                                    </button>
                                </div>

                                <div class="notifications-feed">
                                    {% for notification in notifications %}
                                        {# Ces notifications renvoient vers la section de dépôt de documents du dashboard. #}
                                        {% set is_documents_rejected = notification.nom starts with 'Un ou plusieurs de vos documents' or notification.nom starts with 'Votre compte est en attente de validation' %}
                                        <article class="notification-card{{ notification.read ? ' notification-card--read' }}"
                                                 data-read="{{ notification.read ? 'true' : 'false' }}"
                                                 data-agence-notifications-target="card"
                                                 data-action="mouseenter->agence-notifications#markRead"
                                                 data-mark-read-url="{{ path('agence_immobiliere_notifications_mark_read', {id: notification.id}) }}">
                                            {% if not notification.read %}
                                                <span class="notification-card__dot js-notification-dot" aria-hidden="true"></span>
                                            {% endif %}

                                            {% if is_documents_rejected %}
                                                <a class="notification-card__text notification-card__link paragraphe"
                                                   href="{{ path('agence_immobiliere_dashboard', {documents: 1}) }}#documents">{{ notification.nom }}</a>
                                            {% else %}
                                                <p class="notification-card__text paragraphe">{{ notification.nom }}</p>
                                            {% endif %}

                                            <p class="notification-card__date paragraphe">{{ notification.date|date('d/m/Y') }}</p>
                                        </article>
                                    {% else %}
                                        <p class="notification-card__text paragraphe">Vous n'avez aucune notification.</p>
                                    {% endfor %}
                                </div>
                            </div>
                        </section>
                    </div></div>
                </div>

            </div>
        </div>
    </main>

{% endblock %}
