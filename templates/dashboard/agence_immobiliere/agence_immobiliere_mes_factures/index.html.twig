 Template: templates/dashboard/agence_immobiliere/agence_immobiliere_mes_factures/index.html.twig
 Role: Renders the dashboard/agence_immobiliere/agence_immobiliere_mes_factures Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

{% extends 'base.html.twig' %}

{% block title %}{{ 'agency.invoices.title'|trans }}{% endblock %}

{% block mobile_tabbar %}{% endblock %}

{% block body %}
    <main id="dashboard" class="dashboard">
        <div class="container-fluid dashboard-container">
            <div class="row">

                {# Sidebar existante #}
                {{ include('composant/__agence_immobiliere/_tableau_de_bord.html.twig') }}
                {# Topbar mobile — Figma « TopBar » 6934:17370 #}
                {{ include('composant/__agence_immobiliere/_topbar_contenu.html.twig', {title: 'agency.invoices.title'|trans}) }}

                {# Contenu principal #}
                <div class="col-md-9 col-lg-10 col-12 dashboard-main">

                    <div class="col-12 col-md-10 mx-auto">
                        <section>
                            <h2 class="mb-32 invoices-title d-none d-md-block">{{ 'agency.invoices.title'|trans }}</h2>

                            <form class="invoices-search mb-32" method="get" role="search">
                                <input
                                    type="search"
                                    name="q"
                                    class="invoices-search__input"
                                    placeholder="{{ 'agency.invoices.search'|trans }}"
                                    value="{{ search|default('') }}"
                                >

                                <button type="submit" class="invoices-search__button" aria-label="{{ 'search.submit'|trans }}">
                                    <i class="icon-search" aria-hidden="true"></i>
                                </button>
                            </form>

                            <div class="invoices-card">
                                <div class="invoices-list">
                                    {% for invoice in invoices %}
                                        {% set issued_at = invoice.issuedAt ?? invoice.createdAt %}
                                        <div class="invoice-row">
                                            <div class="invoice-row__info">
                                                <p class="invoice-row__reference__invoice p-accent mb-0">{{ invoice.number }}</p>

                                                <p class="invoice-row__date paragraphe">
                                                    {{ 'agency.invoices.created_at'|trans({'%date%': issued_at|format_datetime('long', 'none', locale: app.request.locale|default('fr'))}) }}
                                                    
                                                </p>
                                            </div>

                                            <div class="invoice-row__actions">
                                                <a
                                                    href="{{ path('agence_immobiliere_facture_show', {id: invoice.id}) }}"
                                                    class="invoice-action p-accent"
                                                    target="_blank"
                                                    rel="noopener"
                                                >
                                                    <i class="icon-eye" aria-hidden="true"></i>
                                                    {{ 'settings.payments.view'|trans }}
                                                </a>

                                                <a
                                                    href="{{ path('agence_immobiliere_facture_download', {id: invoice.id}) }}"
                                                    class="invoice-action p-accent"
                                                >
                                                    <i class="icon-arrow-down-to-line" aria-hidden="true"></i>
                                                    {{ 'settings.payments.download'|trans }}
                                                </a>
                                            </div>
                                        </div>
                                    {% else %}
                                        <div class="invoice-row">
                                            <p class="invoice-row__date">{{ 'agency.invoices.empty'|trans }}</p>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        </section>
                    </div>
                </div>

            </div>
        </div>
    </main>
{% endblock %}
