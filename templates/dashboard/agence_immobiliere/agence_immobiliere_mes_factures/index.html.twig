 Role: Renders the dashboard/agence_immobiliere/agence_immobiliere_mes_factures Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

{% extends 'base.html.twig' %}

{% block title %}Mes factures{% endblock %}

{% block body %}
    <main id="dashboard" class="dashboard">
        <div class="container-fluid dashboard-container">
            <div class="row g-0">

                {# Sidebar existante #}
                {{ include('composant/__agence_immobiliere/_tableau_de_bord.html.twig') }}

                {# Contenu principal #}
                <div class="col-10 dashboard-main">
                    <div class="dashboard-content">
                        <section class="invoices-page">
                            <h1 class="invoices-page__title">Mes factures</h1>

                            <form class="invoices-search" method="get" role="search">
                                <input
                                    type="search"
                                    name="q"
                                    class="invoices-search__input"
                                    placeholder="Recherchez un numéro de facture"
                                    value="{{ search|default('') }}"
                                >

                                <button type="submit" class="invoices-search__button" aria-label="Rechercher">
                                    <i class="icon-search" aria-hidden="true"></i>
                                </button>
                            </form>

                            <div class="invoices-card">
                                <div class="invoices-list">
                                    {% for invoice in invoices %}
                                        {% set issued_at = invoice.issuedAt ?? invoice.createdAt %}
                                        <div class="invoice-row">
                                            <div class="invoice-row__info">
                                                <p class="invoice-row__reference">{{ invoice.number }}</p>

                                                <p class="invoice-row__date">
                                                    Créé le {{ issued_at|format_datetime('long', 'none', locale='fr') }}
                                                    · {{ (invoice.totalMinor / 100)|number_format(2, ',', ' ') }}
                                                    {{ invoice.currency.signe|default('€') }}
                                                </p>
                                            </div>

                                            <div class="invoice-row__actions">
                                                <a
                                                    href="{{ path('agence_immobiliere_facture_show', { id: invoice.id }) }}"
                                                    class="invoice-action"
                                                    target="_blank"
                                                    rel="noopener"
                                                >
                                                    <i class="icon-eye" aria-hidden="true"></i>
                                                    Voir
                                                </a>

                                                <a
                                                    href="{{ path('agence_immobiliere_facture_download', { id: invoice.id }) }}"
                                                    class="invoice-action"
                                                >
                                                    <i class="icon-download" aria-hidden="true"></i>
                                                    Télécharger
                                                </a>
                                            </div>
                                        </div>
                                    {% else %}
                                        <div class="invoice-row">
                                            <p class="invoice-row__date">Vous n'avez aucune facture pour le moment.</p>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        </section>
                    </div>
                </div>

            </div>
        </div>
    </main>
{% endblock %}
