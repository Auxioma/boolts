{# Onglet : informations personnelles #}
<div class="js-tab-content d-none px-48 pb-92 contenue-des-page-des-parametres" id="cat2">

    <div class="row">
        <div class="col-10 mx-auto">

            <h2 class="mb-0">Informations personnelles</h2>

            <div
                class="card-information-public-profile my-32 py-18 px-24"
                data-controller="field-save"
                data-field-save-url-value="{{ path('api_profile_agence_immobiliere') }}"
                data-field-save-csrf-value="{{ csrf_token('profile_edit') }}"
            >

                <div class="connexion-securite">

                    {# Prénom #}
                    <div class="d-flex justify-content-between align-items-start pb-20 ligne-border-bottom">
                        <div>
                            <h3 class="mb-0">Prénom</h3>
                            <p class="mt-12 mb-0" id="prenom-value">
                                {{ app.user.prenom ?? '***' }}
                            </p>
                        </div>

                        <button
                            class="btn btn-link p-0 text-decoration-none btn-buttom-agence my-auto"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapseFirstName"
                        >
                            Modifier
                        </button>
                    </div>

                    <div class="collapse mt-12" id="collapseFirstName">
                        <div class="collapse-password-content">
                            <div class="d-flex justify-content-between align-items-start">

                                <button
                                    type="button"
                                    class="btn-confirm-password"
                                    data-action="click->field-save#save"
                                    data-field-save-field-param="prenom"
                                    data-field-save-input-param="#{{ form.prenom.vars.id }}"
                                    data-field-save-output-param="#prenom-value"
                                >
                                    Confirmer
                                </button>
                            </div>

                            <div class="password-fields mt-8">


                            </div>
                        </div>
                    </div>








                    <div class="d-flex justify-content-between align-items-start pb-20 ligne-border-bottom js-editable-field">

                        <div class="w-100">
                            <h3 class="mb-0">Prénom</h3>

                            {# Valeur affichée #}
                            <p class="mt-12 mb-0 js-field-value">
                                {{ app.user.prenom ?? '***' }}
                            </p>

                            {# Input Symfony caché au départ #}
                            <div class="mt-12 d-none js-field-input">
                                {{ form_widget(form.prenom, {
                                    attr: {
                                        class: 'form-control'
                                    }
                                }) }}
                            </div>
                        </div>

                        <button
                            class="btn btn-link p-0 text-decoration-none btn-buttom-agence my-auto js-edit-button"
                            type="button"
                        >
                            Modifier
                        </button>
                    </div>

                    <script>
                        document.querySelectorAll('.js-editable-field').forEach((field) => {

                            const button = field.querySelector('.js-edit-button');
                            const value = field.querySelector('.js-field-value');
                            const inputWrapper = field.querySelector('.js-field-input');
                            const input = inputWrapper.querySelector('input, textarea, select');

                            // Valeur initiale
                            const initialValue = input.value;

                            button.addEventListener('click', () => {

                                const isEditing = field.dataset.editing === 'true';

                                // OUVERTURE
                                if (!isEditing) {

                                    value.classList.add('d-none');
                                    inputWrapper.classList.remove('d-none');

                                    button.textContent = 'Fermer';

                                    field.dataset.editing = 'true';

                                    input.focus();

                                    return;
                                }

                                // SI MODIFIÉ → submit
                                if (input.value !== initialValue) {
                                    button.closest('form').submit();
                                    return;
                                }

                                // FERMETURE
                                value.classList.remove('d-none');
                                inputWrapper.classList.add('d-none');

                                button.textContent = 'Modifier';

                                field.dataset.editing = 'false';
                            });

                            // Détection modification
                            input.addEventListener('input', () => {

                                if (input.value !== initialValue) {
                                    button.textContent = 'Enregistrer';
                                } else {
                                    button.textContent = 'Fermer';
                                }
                            });
                        });
                    </script>





                    <div class="alert alert-success d-none mt-3" data-field-save-target="success">
                        Modification enregistrée.
                    </div>

                    <div class="alert alert-danger d-none mt-3" data-field-save-target="error">
                        Une erreur est survenue.
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
