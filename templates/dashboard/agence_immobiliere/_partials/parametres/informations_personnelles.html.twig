{# Onglet : informations personnelles #}
<div class="js-tab-content d-none px-48 pb-92 contenue-des-page-des-parametres" id="cat2">

    <div class="row">
        <div class="col-10 mx-auto">

            <h2 class="mb-0">Informations personnelles</h2>

            <div
                class="card-information-public-profile my-32 py-18 px-24"
                data-controller="field-save"
                data-field-save-url-value="{{ path('api_profile_agence_immobiliere') }}"
                data-field-save-csrf-value="{{ csrf_token('profile_edit') }}"
            >

                <div class="connexion-securite">

                    {# Prénom #}
                    <div class="js-editable-field formulaire">
                        <div class="d-flex justify-content-between align-items-start pb-20 ligne-border-bottom">
                            <div class="w-100">
                                <h3 class="mb-0">Prénom*</h3>
                                <p class="mt-12 mb-0 js-field-value" id="prenom-value">
                                    {{ app.user.prenom ?? '***' }}
                                </p>
                                <div class="mt-12 d-none js-field-input">

                                    {{ form_widget(form.prenom, {
                                        attr: {
                                            class: 'form-control w-75'
                                        }
                                    }) }}
                                </div>
                            </div>
                            <button
                                type="button"
                                class="btn btn-link p-0 text-decoration-none btn-buttom-agence my-auto js-edit-button"
                                data-action="click->field-save#handle"
                                data-field-save-field-param="prenom"
                                data-field-save-input-param="#{{ form.prenom.vars.id }}"
                                data-field-save-output-param="#prenom-value"
                            >
                                Modifier
                            </button>
                        </div>
                    </div>

                    {# Nom #}
                    <div class="js-editable-field formulaire my-20">
                        <div class="d-flex justify-content-between align-items-start pb-20 ligne-border-bottom">
                            <div class="w-100">
                                <h3 class="mb-0">nom*</h3>
                                <p class="mt-12 mb-0 js-field-value" id="nom-value">
                                    {{ app.user.nom ?? '***' }}
                                </p>
                                <div class="mt-12 d-none js-field-input">

                                    {{ form_widget(form.nom, {
                                        attr: {
                                            class: 'form-control w-75'
                                        }
                                    }) }}
                                </div>
                            </div>
                            <button
                                type="button"
                                class="btn btn-link p-0 text-decoration-none btn-buttom-agence my-auto js-edit-button"
                                data-action="click->field-save#handle"
                                data-field-save-field-param="nom"
                                data-field-save-input-param="#{{ form.nom.vars.id }}"
                                data-field-save-output-param="#nom-value"
                            >
                                Modifier
                            </button>
                        </div>
                    </div>

                    {# E-mail* #}
                    <div class="js-editable-field formulaire my-20">
                        <div class="d-flex justify-content-between align-items-start pb-20 ligne-border-bottom">
                            <div class="w-100">
                                <h3 class="mb-0">E-mail*</h3>
                                <p class="mt-12 mb-0 js-field-value" id="email-value">
                                    {{ app.user.email ?? '***' }}
                                </p>
                                <div class="mt-12 d-none js-field-input">

                                    {{ form_widget(form.email, {
                                        attr: {
                                            class: 'form-control w-75'
                                        }
                                    }) }}
                                </div>
                            </div>
                            <button
                                type="button"
                                class="btn btn-link p-0 text-decoration-none btn-buttom-agence my-auto js-edit-button"
                                data-action="click->field-save#handle"
                                data-field-save-field-param="email"
                                data-field-save-input-param="#{{ form.email.vars.id }}"
                                data-field-save-output-param="#email-value"
                            >
                                Modifier
                            </button>
                        </div>
                    </div>

                    {# Telephone #}
                    <div
                        class="js-editable-field formulaire my-20"
                        data-controller="phone"
                    >
                        <div class="d-flex justify-content-between align-items-start pb-20 ligne-border-bottom">
                            <div class="w-100">
                                <h3 class="mb-0">Numéro de téléphone*</h3>

                                <p class="mt-12 mb-0 js-field-value" id="telephone-value">
                                    {{ app.user.telephone ?? '***' }}
                                </p>

                                <div class="mt-12 d-none js-field-input">
                                    {{ form_widget(form.telephone, {
                                        attr: {
                                            class: 'form-control w-75',
                                            'data-phone-target': 'input'
                                        }
                                    }) }}
                                </div>
                            </div>

                            <button
                                type="button"
                                class="btn btn-link p-0 text-decoration-none btn-buttom-agence my-auto js-edit-button"
                                data-action="click->phone#sync click->field-save#handle"
                                data-field-save-field-param="telephone"
                                data-field-save-input-param="#{{ form.telephone.vars.id }}"
                                data-field-save-output-param="#telephone-value"
                            >
                                Modifier
                            </button>
                        </div>
                    </div>

                    {# Adresse #}
                    <div class="js-editable-field formulaire my-20">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="w-100">
                                <h3 class="mb-0">Adresse*</h3>

                                <p class="mt-12 mb-0 js-field-value" id="adresse-value">
                                    {% if app.user and app.user.adresse %}
                                        {{ app.user.adresse }}

                                        {% if app.user.adresseComplement %}
                                            {{ app.user.adresseComplement }}
                                        {% endif %}

                                        {% if app.user.codePostal or app.user.ville %}
                                            , {{ app.user.codePostal }} {{ app.user.ville }}
                                        {% endif %}

                                        {% if app.user.pays %}
                                            , {{ app.user.pays.nom }}
                                        {% endif %}
                                    {% else %}
                                        ***
                                    {% endif %}
                                </p>

                                <div class="mt-12 d-none js-field-input w-75">
                                    <div class="mb-16">
                                        {{ form_widget(form.adresse, {
                                            attr: {
                                                class: 'form-control js-address-input',
                                                placeholder: 'Entrez un numéro et un nom de rue',
                                                'data-name': 'adresse'
                                            }
                                        }) }}
                                    </div>

                                    <div class="mb-16">
                                        <label class="form-label mb-16">
                                            Adresse 2 (optionnel)
                                        </label>

                                        {{ form_widget(form.adresseComplement, {
                                            attr: {
                                                class: 'form-control js-address-input',
                                                placeholder: 'Entrez un complément d’adresse',
                                                'data-name': 'adresseComplement'
                                            }
                                        }) }}
                                    </div>

                                    <div class="row">
                                        <div class="col-6">
                                            <div class="mb-16">
                                                <label class="form-label mb-16">
                                                    Code postal
                                                </label>

                                                {{ form_widget(form.codePostal, {
                                                    attr: {
                                                        class: 'form-control js-address-input',
                                                        placeholder: 'Entrez un code postal',
                                                        'data-name': 'codePostal'
                                                    }
                                                }) }}
                                            </div>
                                        </div>

                                        <div class="col-6">
                                            <label class="form-label mb-16">
                                                Ville
                                            </label>

                                            {{ form_widget(form.ville, {
                                                attr: {
                                                    class: 'form-control js-address-input',
                                                    placeholder: 'Choisissez une ville',
                                                    'data-name': 'ville'
                                                }
                                            }) }}
                                        </div>
                                    </div>

                                    <div>
                                        <label class="form-label mb-16">
                                            Pays*
                                        </label>

                                        {{ form_widget(form.pays, {
                                            attr: {
                                                class: 'form-control js-address-input',
                                                placeholder: 'France',
                                                'data-name': 'pays'
                                            }
                                        }) }}
                                    </div>
                                </div>
                            </div>

                            <button
                                type="button"
                                class="btn btn-link p-0 text-decoration-none btn-buttom-agence my-auto js-edit-button"
                                data-action="click->field-save#handle"
                                data-field-save-field-param="adresse"
                                data-field-save-multiple-param="true"
                                data-field-save-output-param="#adresse-value"
                            >
                                Modifier
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    document.addEventListener('DOMContentLoaded', () => {

        const adresseInput = document.getElementById('{{ form.adresse.vars.id }}');
        const villeInput = document.getElementById('{{ form.ville.vars.id }}');
        const codePostalInput = document.getElementById('{{ form.codePostal.vars.id }}');

        // Container autocomplete
        const results = document.createElement('div');

        results.className = 'list-group position-absolute w-75 shadow';
        results.style.zIndex = '1000';
        results.style.maxHeight = '300px';
        results.style.overflowY = 'auto';

        adresseInput.parentNode.style.position = 'relative';
        adresseInput.parentNode.appendChild(results);

        let timeout = null;

        adresseInput.addEventListener('input', () => {

            clearTimeout(timeout);

            const query = adresseInput.value.trim();

            if (query.length < 3) {
                results.innerHTML = '';
                return;
            }

            timeout = setTimeout(async () => {

                try {

                    const response = await fetch(
                        `https://photon.komoot.io/api/?q=${encodeURIComponent(query)}&limit=5&lang=fr`
                    );

                    const data = await response.json();

                    results.innerHTML = '';

                    if (!data.features || data.features.length === 0) {
                        return;
                    }

                    data.features.forEach((feature) => {

                        const props = feature.properties;

                        // Rue complète
                        const rue = [
                            props.housenumber,
                            props.street || props.name
                        ]
                            .filter(Boolean)
                            .join(' ');

                        // Label affiché
                        const label = [
                            rue,
                            props.postcode,
                            props.city
                        ]
                            .filter(Boolean)
                            .join(', ');

                        const item = document.createElement('button');

                        item.type = 'button';
                        item.className = 'list-group-item list-group-item-action text-start';
                        item.innerText = label;

                        item.addEventListener('click', () => {

                            adresseInput.value = rue;

                            villeInput.value = props.city || '';
                            codePostalInput.value = props.postcode || '';

                            results.innerHTML = '';
                        });

                        results.appendChild(item);
                    });

                } catch (error) {
                    console.error('Erreur autocomplete adresse :', error);
                }

            }, 300);
        });

        // Fermer suggestions quand clic extérieur
        document.addEventListener('click', (e) => {

            if (
                !results.contains(e.target) &&
                e.target !== adresseInput
            ) {
                results.innerHTML = '';
            }
        });
    });
</script>
