{# Onglet : informations personnelles #}
<div class="js-tab-content d-none px-48 pb-92 contenue-des-page-des-parametres" id="cat2">

    <div class="row">
        <div class="col-10 mx-auto">

            <h2 class="mb-0">Informations personnelles</h2>

<div
    class="card-information-public-profile my-32 py-18 px-24"
    data-controller="field-save"
    data-field-save-url-value="{{ path('api_profile_agence_immobiliere') }}"
    data-field-save-csrf-value="{{ csrf_token('profile_edit') }}"
>

    <div class="connexion-securite">

        {# Prénom #}
        <div class="js-editable-field">

            <div class="d-flex justify-content-between align-items-start pb-20 ligne-border-bottom">

                <div class="w-100">

                    <h3 class="mb-0">Prénom</h3>

                    {# Valeur affichée #}
                    <p class="mt-12 mb-0 js-field-value" id="prenom-value">
                        {{ app.user.prenom ?? '***' }}
                    </p>

                    {# Input Symfony caché #}
                    <div class="mt-12 d-none js-field-input">

                        {{ form_widget(form.prenom, {
                            attr: {
                                class: 'form-control'
                            }
                        }) }}

                    </div>

                </div>

                <button
                    type="button"
                    class="btn btn-link p-0 text-decoration-none btn-buttom-agence my-auto js-edit-button"

                    data-action="click->field-save#handle"

                    data-field-save-field-param="prenom"
                    data-field-save-input-param="#{{ form.prenom.vars.id }}"
                    data-field-save-output-param="#prenom-value"
                >
                    Modifier
                </button>

            </div>

        </div>

    </div>
</div>

                </div>
            </div>
        </div>
    </div>
</div>
