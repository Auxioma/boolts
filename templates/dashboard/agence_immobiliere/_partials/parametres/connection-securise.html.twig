<div class="js-tab-content d-none px-48 pb-92 contenue-des-page-des-parametres" id="cat3">

    <div class="row">
        <div class="col-10 mx-auto">

            <h2 class="mb-0">Connexion</h2>

            <div
                class="card-information-public-profile my-32 py-18 px-24"
                data-controller="field-save"
                data-field-save-url-value="{{ path('api_profile_agence_immobiliere') }}"
                data-field-save-csrf-value="{{ csrf_token('profile_edit') }}"
            >

                <div class="connexion-securite">

                    {# Password #}
                    <div class="js-editable-field formulaire">
                        <div class="d-flex justify-content-between align-items-start pb-20 ligne-border-bottom">
                            <div class="w-100">
                                <h3 class="mb-0">Mot de passe</h3>

                                <p class="mt-12 mb-0 js-field-value" id="password-value">
                                    *****************
                                </p>

                                <div class="mt-12 d-none js-field-input w-75">
                                    {{ form_widget(form.plainPassword.first, {
                                        attr: {
                                            id: 'plain-password-first',
                                            class: 'form-control mb-12',
                                            'data-name': 'password'
                                        }
                                    }) }}

                                    {{ form_widget(form.plainPassword.second, {
                                        attr: {
                                            id: 'plain-password-second',
                                            class: 'form-control',
                                            'data-name': 'passwordConfirm'
                                        }
                                    }) }}

                                    <span class="flash-message flash-message-error d-none js-field-error"></span>
                                </div>
                            </div>

                            <button
                                type="button"
                                class="btn btn-link p-0 text-decoration-none btn-buttom-agence mt-15 js-edit-button"
                                data-action="click->field-save#handle"
                                data-field-save-field-param="plainPassword"
                                data-field-save-multiple-param="true"
                                data-field-save-output-param="#password-value"
                            >
                                Modifier
                            </button>
                        </div>
                    </div>

                    {# Authentification à deux facteurs #}
                    <div class="formulaire pt-20">

                        <div class="d-flex justify-content-between align-items-center pb-20">
                            <h3 class="mb-0">A finir en fonction des fonctionnalité a faire + coté authentification</h3>

                            <div class="form-check form-switch m-0">
                                <input
                                    type="checkbox"
                                    class="form-check-input js-two-factor-switch"
                                    role="switch"
                                    id="two-factor-switch"

                                >
                            </div>
                        </div>

                        <div class="d-none js-two-factor-content">

                            <div class="d-flex justify-content-between align-items-start py-20">

                                <div>
                                    <h3 class="mb-0">Code secret</h3>

                                    <p class="mt-12 mb-0 js-code-secret-date">
                                        Dernière mise à jour il y a 4 ans
                                    </p>

                                    <input
                                        type="text"
                                        class="form-control mt-12 d-none js-code-secret-input"
                                        placeholder="Entrez votre code secret"
                                    >
                                </div>

                                <button
                                    type="button"
                                    class="btn btn-link p-0 text-decoration-none btn-buttom-agence js-code-secret-button"
                                >
                                    Modifier
                                </button>

                            </div>

                            <div class="d-flex justify-content-between align-items-start py-20">

                                <div>
                                    <h3 class="mb-0">Question de sécurité</h3>

                                    <p class="mt-12 mb-0 js-security-question-date">
                                        Dernière mise à jour il y a 4 ans
                                    </p>

                                    <input
                                        type="text"
                                        class="form-control mt-12 d-none js-security-question-input"
                                        placeholder="Entrez votre question de sécurité"
                                    >
                                </div>

                                <button
                                    type="button"
                                    class="btn btn-link p-0 text-decoration-none btn-buttom-agence js-security-question-button"
                                >
                                    Modifier
                                </button>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>
    </div>
</div>

<script>
    const twoFactorSwitch = document.querySelector('.js-two-factor-switch');
    const twoFactorContent = document.querySelector('.js-two-factor-content');

    twoFactorSwitch.addEventListener('change', function () {
        twoFactorContent.classList.toggle('d-none', !this.checked);
    });

    const codeSecretButton = document.querySelector('.js-code-secret-button');
    const codeSecretDate = document.querySelector('.js-code-secret-date');
    const codeSecretInput = document.querySelector('.js-code-secret-input');

    codeSecretButton.addEventListener('click', function () {
        codeSecretDate.classList.add('d-none');
        codeSecretInput.classList.remove('d-none');
        codeSecretInput.focus();
    });

    const securityQuestionButton = document.querySelector('.js-security-question-button');
    const securityQuestionDate = document.querySelector('.js-security-question-date');
    const securityQuestionInput = document.querySelector('.js-security-question-input');

    securityQuestionButton.addEventListener('click', function () {
        securityQuestionDate.classList.add('d-none');
        securityQuestionInput.classList.remove('d-none');
        securityQuestionInput.focus();
    });
</script>
