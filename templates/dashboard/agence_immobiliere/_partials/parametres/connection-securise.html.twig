{#
 Template: templates/dashboard/agence_immobiliere/_partials/parametres/connection-securise.html.twig
 Role: Renders the dashboard/agence_immobiliere/_partials/parametres Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

<div class="js-tab-content d-none px-48 pb-92 contenue-des-page-des-parametres" id="cat3">

    <div class="row">
        <div class="col-10 mx-auto">

            <h2 class="mb-0">Connexion</h2>

            <div
                class="card-information-public-profile my-32 py-18 px-24"
                data-controller="field-save"
                data-field-save-url-value="{{ path('api_profile_agence_immobiliere') }}"
                data-field-save-csrf-value="{{ csrf_token('profile_edit') }}"
            >

                <div class="connexion-securite">

                    {# Password #}
                    <div class="js-editable-field formulaire">

                        <div class="d-flex justify-content-between align-items-start pb-20 ligne-border-bottom">

                            <div class="w-100">

                                <h3 class="mb-0">
                                    Mot de passe
                                </h3>

                                <p class="mt-12 mb-0 js-field-value" id="password-value">
                                    *****************
                                </p>

                                <div class="mt-12 d-none js-field-input w-75">

                                    {{ form_widget(form.plainPassword.first, {
                                        attr: {
                                            id: 'plain-password-first',
                                            class: 'form-control mb-12',
                                            'data-name': 'password',
                                        },
                                    }) }}

                                    {{ form_widget(form.plainPassword.second, {
                                        attr: {
                                            id: 'plain-password-second',
                                            class: 'form-control',
                                            'data-name': 'passwordConfirm',
                                        },
                                    }) }}

                                    <span class="flash-message flash-message-error d-none js-field-error"></span>

                                </div>

                            </div>

                            <button
                                type="button"
                                class="btn btn-link p-0 text-decoration-none btn-buttom-agence mt-15 js-edit-button"
                                data-action="click->field-save#handle"
                                data-field-save-field-param="plainPassword"
                                data-field-save-multiple-param="true"
                                data-field-save-output-param="#password-value"
                            >
                                Modifier
                            </button>

                        </div>

                    </div>

                    {# DoubleAuthentification #}
                    <div
                        class="formulaire js-2fa-wrapper"
                        data-controller="parametre--two-factor"
                        data-parametre--two-factor-status-url-value="{{ path('account_2fa_status') }}"
                        data-parametre--two-factor-toggle-url-value="{{ path('account_2fa_toggle') }}"
                    >

                        <div class="d-flex justify-content-between align-items-center pt-32">

                            <h3 class="mb-0">
                                Authentification à deux facteurs
                            </h3>

                            <div class="form-check form-switch m-0">

                                <label class="contenue-des-page-des-parametres-switch">

                                    <input
                                        type="checkbox"
                                        id="two-factor-switch"
                                        class="js-two-factor-switch"
                                        autocomplete="off"
                                    >

                                    <span class="contenue-des-page-des-parametres-switch-slider"></span>

                                </label>

                            </div>

                        </div>

                        <div class="d-none js-two-factor-content">

                            {# Code secret #}
                            <div class="d-flex justify-content-between align-items-start pt-32">
                                <div class="w-100">
                                    <h3 class="mb-0">
                                        Adresse e-mail
                                    </h3>
                                    <p class="mt-12 mb-0 js-code-secret-date">
                                        {{ app.user.email }}
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </div>

</div>
