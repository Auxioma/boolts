<div class="js-tab-content d-none px-48 pb-92 contenue-des-page-des-parametres" id="cat5">

    <div class="row">
        <div class="col-10 mx-auto">

            <h2 class="mb-0">Langue et devise</h2>

            <div
                class="card-information-public-profile my-32 py-18 px-24 formulaire"
                data-controller="field-save"
                data-field-save-url-value="{{ path('api_profile_agence_immobiliere') }}"
                data-field-save-csrf-value="{{ csrf_token('profile_edit') }}"
            >

                <div class="connexion-securite">

                    {# langue préféré #}
                    <div class="js-editable-field formulaire">
                        <div class="d-flex justify-content-between align-items-start pb-20 ligne-border-bottom">
                            <div class="w-100">
                                <h3 class="mb-0">Langue préférée</h3>

                                <p class="mt-12 mb-0 js-field-value" id="langue-value">
                                    {{ app.user.langues ? app.user.langues.name : '***' }}
                                </p>

                                <div class="mt-12 d-none js-field-input w-75">
                                    {{ form_widget(form.langues, {
                                        attr: {
                                            class: 'form-control',
                                            'data-name': 'langues'
                                        }
                                    }) }}
                                </div>
                            </div>

                            <button
                                type="button"
                                class="btn btn-link p-0 text-decoration-none btn-buttom-agence mt-15 js-edit-button"
                                data-action="click->field-save#handle"
                                data-field-save-field-param="langues"
                                data-field-save-multiple-param="false"
                                data-field-save-output-param="#langue-value"
                            >
                                Modifier
                            </button>
                        </div>

                        <span class="flash-message flash-message-error js-field-error d-none"></span>
                    </div>

                    {# devise #}<div class="js-editable-field formulaire my-20">
                        <div class="d-flex justify-content-between align-items-start pb-20 ligne-border-bottom">
                            <div class="w-100">
                                <h3 class="mb-0">Devise préférée</h3>

                                <p class="mt-12 mb-0 js-field-value" id="devise-value">
                                    {{ app.user.devise ? app.user.devise.nom : '***' }}
                                </p>

                                <div class="mt-12 d-none js-field-input w-75">
                                    {{ form_widget(form.devise, {
                                        attr: {
                                            class: 'form-control',
                                            'data-name': 'devise'
                                        }
                                    }) }}
                                </div>
                            </div>

                            <button
                                type="button"
                                class="btn btn-link p-0 text-decoration-none btn-buttom-agence mt-15 js-edit-button"
                                data-action="click->field-save#handle"
                                data-field-save-field-param="devise"
                                data-field-save-multiple-param="false"
                                data-field-save-output-param="#devise-value"
                            >
                                Modifier
                            </button>
                        </div>

                        <span class="flash-message flash-message-error js-field-error d-none"></span>
                    </div>

                    {# fuseau horaire #}
                    <div class="js-editable-field formulaire my-20">
                        <div class="d-flex justify-content-between align-items-start pb-20">
                            <div class="w-100">
                                <h3 class="mb-0">Fuseau horaire</h3>

                                <p class="mt-12 mb-0 js-field-value" id="fuseau-horaire-value">
                                    {{ app.user.fuseauHoraire ? app.user.fuseauHoraire.nom : '***' }}
                                </p>

                                <div class="mt-12 d-none js-field-input w-75">
                                    {{ form_widget(form.fuseauHoraire, {
                                        attr: {
                                            class: 'form-control js-address-input',
                                            'data-name': 'fuseauHoraire'
                                        }
                                    }) }}
                                </div>
                            </div>

                            <button
                                type="button"
                                class="btn btn-link p-0 text-decoration-none btn-buttom-agence mt-15 js-edit-button"
                                data-action="click->field-save#handle"
                                data-field-save-field-param="fuseauHoraire"
                                data-field-save-multiple-param="false"
                                data-field-save-output-param="#fuseau-horaire-value"
                            >
                                Modifier
                            </button>
                        </div>

                        <span class="flash-message flash-message-error js-field-error d-none"></span>
                    </div>


                </div>
            </div>
        </div>
    </div>


</div>
