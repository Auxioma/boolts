{#
 Template: templates/dashboard/agence_immobiliere/_partials/parametres/historique-des-paiements.html.twig
 Role: Renders the dashboard/agence_immobiliere/_partials/parametres Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

<div
    class="js-tab-content d-none contenue-des-page-des-parametres"
    id="cat5"
    data-controller="parametre--payment-history-menu"
>
    <div class="row">
        <div class="col-12 col-md-10 mx-auto">

            <h3 class="mb-0 d-none d-md-block">
                Historique des paiements
            </h3>

            <div
                class="invoices-card my-32"
                data-controller="field-save"
                data-field-save-url-value="{{ path('api_profile_agence_immobiliere') }}"
                data-field-save-csrf-value="{{ csrf_token('profile_edit') }}"
            >

                <div class="invoices-list">
                {% if subscription_payments is defined and subscription_payments is not empty %}
                    {% for payment in subscription_payments %}
                        {% set payment_method = payment.paymentMethod %}
                        {% set payment_method_snapshot = payment.paymentMethodSnapshot %}
                        {% set payment_card_brand = payment_method and payment_method.brand
                            ? payment_method.brand
                            : payment_method_snapshot.brand|default(null)
                        %}
                        {% set payment_card_brand_key = payment_card_brand ? payment_card_brand|lower : 'card' %}
                        {% set payment_card_label = {
                            visa: 'Visa',
                            mastercard: 'Mastercard',
                            amex: 'American Express',
                            american_express: 'American Express',
                            cartes_bancaires: 'Cartes Bancaires',
                            diners: 'Diners Club',
                            discover: 'Discover',
                            eftpos_au: 'Eftpos',
                            jcb: 'JCB',
                            link: 'Link',
                            unionpay: 'UnionPay',
                            card: 'Carte bancaire',
                        }[payment_card_brand_key]|default(payment_card_brand|default('Carte bancaire')|capitalize) %}
                        {% set payment_card_last4 = payment_method and payment_method.last4
                            ? payment_method.last4
                            : payment_method_snapshot.last4|default(null)
                        %}
                        {% set purchase_date = payment.paidAt|default(payment.createdAt) %}
                        {% set currency_sign = payment.currency ? payment.currency.signe|default('€') : '€' %}
                        {% set invoice = invoices_by_payment[payment.id]|default(null) %}

                        <div class="invoice-row position-relative">
                            <div class="invoice-row__info">
                                <div class="d-flex flex-column gap-1">
                                    <p class="invoice-row__reference__invoice p-accent mb-0" style="color:#0b0f14">
                                        {{ payment_card_label }}
                                        {% if payment_card_last4 %}
                                            {{ payment_card_last4 }}
                                        {% endif %}
                                    </p>

                                    <p class="invoice-row__date paragraphe" style="color:#858789">
                                        {{ purchase_date|date('d/m/Y') }}
                                    </p>
                                </div>

                                <p class="invoice-row__date p-accent position-absolute start-50 translate-middle-x" style="color; #0b0f14">
                                    {{ (payment.amountPaidMinor > 0 ? payment.amountPaidMinor : payment.amountTotalMinor)|minor_amount(payment.currency) }}
                                    {{ currency_sign }}
                                </p>
                            </div>

                            {% if invoice %}
                                <div class="invoice-row__actions">
                                    <a
                                        href="{{ path('agence_immobiliere_facture_show', {id: invoice.id}) }}"
                                        class="invoice-action p-accent"
                                        target="_blank"
                                        rel="noopener"
                                    >
                                        <i class="icon-eye" aria-hidden="true"></i>
                                        Voir
                                    </a>

                                    <a
                                        href="{{ path('agence_immobiliere_facture_download', {id: invoice.id}) }}"
                                        class="invoice-action p-accent"
                                    >
                                        <i class="icon-arrow-down-to-line" aria-hidden="true"></i>
                                        Télécharger
                                    </a>
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="invoice-row">
                        <p class="invoice-row__date">Aucun paiement d’abonnement. Les renouvellements Stripe apparaîtront ici après synchronisation.</p>
                    </div>
                {% endif %}
                </div>

            </div>

        </div>
    </div>
</div>
