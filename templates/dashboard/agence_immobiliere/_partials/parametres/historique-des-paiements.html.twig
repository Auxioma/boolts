<div class="js-tab-content d-none px-48 pb-92 contenue-des-page-des-parametres" id="cat5">
    <div class="row">
        <div class="col-10 mx-auto">

            <h2 class="mb-0">
                Historique des paiements
            </h2>

            <div
                class="card-information-public-profile my-32 py-18 px-24"
                data-controller="field-save"
                data-field-save-url-value="{{ path('api_profile_agence_immobiliere') }}"
                data-field-save-csrf-value="{{ csrf_token('profile_edit') }}"
            >

                {% for i in 1..4 %}
                    <div class="js-editable-field formulaire {{ not loop.first ? 'mt-20' }}">
                        <div class="d-flex justify-content-between align-items-start pb-20 {{ not loop.last ? 'ligne-border-bottom' }}">
                            <div>
                                <h3 class="mb-0">
                                    Mastercard {{ random(1000, 9999) }}
                                </h3>
                                <p class="mt-12 mb-0 js-field-value">
                                    Date d’expiration :
                                    {{ '%02d'|format(random(1, 12)) }}/{{ random(2027, 2032) }}
                                </p>
                            </div>
                            <p class="btn btn-link p-0 text-decoration-none btn-buttom-agence mt-15 mb-0">
                                19.99€
                            </p>
                        </div>
                    </div>
                {% endfor %}

            </div>

        </div>
    </div>
</div>
<script>
    document.addEventListener('click', function (event) {
        const toggleButton = event.target.closest('.js-payment-menu-toggle');
        document.querySelectorAll('.js-payment-line').forEach((line) => {
            const menu = line.querySelector('.js-payment-menu');
            const button = line.querySelector('.js-payment-menu-toggle');
            if (!menu || !button) {
                return;
            }
            if (!toggleButton || !line.contains(toggleButton)) {
                menu.classList.add('d-none');
                button.setAttribute('aria-expanded', 'false');
            }
        });
        if (!toggleButton) {
            return;
        }
        event.preventDefault();
        event.stopPropagation();

        const line = toggleButton.closest('.js-payment-line');
        const menu = line.querySelector('.js-payment-menu');

        if (!menu) {
            return;
        }

        const isOpen = !menu.classList.contains('d-none');
        menu.classList.toggle('d-none', isOpen);

        toggleButton.setAttribute(
            'aria-expanded',
            isOpen ? 'false' : 'true'
        );
    });

</script>
