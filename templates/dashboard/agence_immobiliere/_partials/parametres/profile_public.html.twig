<div class="js-tab-content px-48 pb-92 contenue-des-page-des-parametres" id="cat1">
    <div class="row">
        <div class="col-10 mx-auto">
            <h2 class="mb-0">Fiche agence</h2>

            {% set profileItems = [
                {
                    field: 'entreprise',
                    label: 'Ajouter un nom d’agence',
                    done: app.user.entreprise is not empty,
                    optional: false,
                },
                {
                    field: 'description',
                    label: 'Ajouter une description',
                    done: app.user.description is not empty,
                    optional: false,
                },
                {
                    field: 'adresseContact',
                    label: 'Ajouter une adresse postale',
                    done: app.user.adresseContact is not empty and app.user.codePostalContact is not empty and app.user.villeContact is not empty,
                    optional: false,
                },
                {
                    field: 'emailContact',
                    label: 'Ajouter une adresse mail',
                    done: app.user.emailContact is not empty,
                    optional: true,
                },
                {
                    field: 'numeroContact',
                    label: 'Ajouter un numéro',
                    done: app.user.numeroContact is not empty,
                    optional: true,
                },
            ] %}

            {% set requiredItems = profileItems|filter(item => not item.optional) %}
            {% set doneRequiredItems = requiredItems|filter(item => item.done) %}

            {% set totalRequired = requiredItems|length %}
            {% set totalDone = doneRequiredItems|length %}

            {% set progress = totalRequired > 0 ? ((totalDone / totalRequired) * 100)|round : 0 %}

            <div
                class="complete-profile py-24 px-24 mt-32"
                data-controller="profile-progress"
            >
                <h3 class="mn-0">Complétez votre profil pour pouvoir publier des annonces</h3>

                <div class="progress my-12" style="height: 10px;">
                    <div
                        class="progress-bar"
                        data-profile-progress-target="bar"
                        role="progressbar"
                        style="width: {{ progress }}%;"
                        aria-valuenow="{{ progress }}"
                        aria-valuemin="0"
                        aria-valuemax="100"
                    ></div>
                </div>

                {% for item in profileItems %}
                    <p
                        class="{{ loop.first ? 'mb-0' : 'mt-2 mb-0' }} {% if item.done %} active {% endif %}"
                        data-profile-progress-target="item"
                        data-field="{{ item.field }}"
                        data-optional="{{ item.optional ? 'true' : 'false' }}"
                        data-done="{{ item.done ? 'true' : 'false' }}"
                    >
            <span data-profile-progress-target="icon">
                {% if item.done %}
                    <i class="icon-check mr-8"></i>
                {% endif %}
            </span>

                        {{ item.label }}

                        {% if item.optional %}
                            <span>(optionnel)</span>
                        {% endif %}
                    </p>
                {% endfor %}
            </div>

            <div
                class="card-information-public-profile my-32 py-18 px-24"
                data-controller="field-save"
                data-field-save-url-value="{{ path('api_profile_agence_immobiliere') }}"
                data-field-save-csrf-value="{{ csrf_token('profile_edit') }}"
            >
                <div class="d-flex align-items-center gap-3">
                    <div class="position-relative">

                        {% set avatar = app.user.imageName ? vich_uploader_asset(app.user, 'imageFile') : null %}
                        {% set firstLetter = app.user.prenom ? app.user.prenom|first|upper : null %}

                        {% if avatar %}
                            <img
                                src="{{ avatar }}"
                                alt="avatar"
                                class="rounded-circle object-fit-cover js-avatar-preview"
                                width="100"
                                height="100"
                            >
                        {% elseif firstLetter %}
                            <img
                                src="{{ asset('images/svg/' ~ firstLetter ~ '.svg') }}"
                                alt="avatar"
                                class="rounded-circle object-fit-cover js-avatar-preview"
                                width="100"
                                height="100"
                            >
                        {% endif %}

                        <button
                            class="btn btn-change-image rounded-pill position-absolute start-50 translate-middle-x"
                            type="button"
                            style="bottom: -12px;"
                            id="change-image-button"
                        >
                            Modifier
                        </button>

                        {{ form_widget(form.imageFile, {
                            attr: {
                                class: 'd-none js-image-input',
                                accept: 'image/*',
                            },
                        }) }}
                    </div>

                    <div class="d-flex flex-column w-100 formulaire formulaire-profile-public">

                        <div class="js-editable-field">
                            <div class="w-100">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="js-field-value">
                                        <h2 class="profile-public-name mb-0" id="entreprise-public-value">
                                            {{ app.user.entreprise ?? 'Définissez le nom de votre agence' }}
                                        </h2>
                                    </div>

                                    <button
                                        type="button"
                                        class="btn btn-link p-0 text-decoration-none js-edit-button js-btn-pen"
                                        data-action="click->field-save#handle"
                                        data-field-save-field-param="entreprise"
                                        data-field-save-input-param="#{{ form.entreprise.vars.id }}"
                                        data-field-save-output-param="#entreprise-public-value"
                                    >
                                        <i class="icon-pen"></i>
                                    </button>
                                </div>

                                <div class="d-none js-field-input">
                                    <div class="d-flex align-items-center gap-2 mt-2">
                                        {{ form_widget(form.entreprise, {
                                            attr: {
                                                class: 'form-control w-75',
                                            },
                                        }) }}

                                        <button
                                            type="button"
                                            class="btn btn-link p-0 text-decoration-none js-btn-save"
                                            data-action="click->field-save#handle"
                                            data-field-save-field-param="entreprise"
                                            data-field-save-input-param="#{{ form.entreprise.vars.id }}"
                                            data-field-save-output-param="#entreprise-public-value"
                                        >
                                            <i class="icon-save"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="js-editable-field mt-10">
                            <div class="w-100">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="js-field-value" id="description-public-value">
                                        <p class="profile-public-description mb-0">
                                            {{ app.user.description ?? 'Rédigez une courte description ici.' }}
                                        </p>
                                    </div>

                                    <button
                                        type="button"
                                        class="btn btn-link p-0 text-decoration-none js-edit-button js-btn-pen"
                                        data-action="click->field-save#handle"
                                        data-field-save-field-param="description"
                                        data-field-save-input-param="#{{ form.description.vars.id }}"
                                        data-field-save-output-param="#description-public-value"
                                    >
                                        <i class="icon-pen"></i>
                                    </button>
                                </div>

                                <div class="d-none js-field-input">
                                    <div class="d-flex align-items-center gap-2 mt-2">
                                        {{ form_widget(form.description, {
                                            attr: {
                                                class: 'form-control w-75',
                                            },
                                        }) }}

                                        <button
                                            type="button"
                                            class="btn btn-link p-0 text-decoration-none js-btn-save"
                                            data-action="click->field-save#handle"
                                            data-field-save-field-param="description"
                                            data-field-save-input-param="#{{ form.description.vars.id }}"
                                            data-field-save-output-param="#description-public-value"
                                        >
                                            <i class="icon-save"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="d-inline-block"></div>

                <div class="connexion-securite mt-24">

                    {# Adresse de contact #}
                    <div class="js-editable-field formulaire my-20">
                        <div class="d-flex justify-content-between align-items-start pb-20 ligne-border-bottom">
                            <div class="w-100">
                                <h3 class="mb-0">Adresse de l’agence*</h3>

                                <p class="mt-12 mb-0 js-field-value" id="adresse-contact-value">
                                    {% if app.user and app.user.adresseContact %}
                                        {{ app.user.adresseContact }}

                                        {% if app.user.codePostalContact or app.user.villeContact %}
                                            , {{ app.user.codePostalContact }} {{ app.user.villeContact }}
                                        {% endif %}

                                        {% if app.user.paysContact %}
                                            , {{ app.user.paysContact }}
                                        {% endif %}
                                    {% else %}
                                        Saisissez votre adresse postale
                                    {% endif %}
                                </p>

                                <div class="mt-12 d-none js-field-input w-75">
                                    <div class="mb-16">
                                        {{ form_widget(form.adresseContact, {
                                            attr: {
                                                class: 'form-control js-address-input',
                                                placeholder: 'Entrez un numéro et un nom de rue',
                                                'data-name': 'adresseContact',
                                            },
                                        }) }}
                                    </div>

                                    <div class="row">
                                        <div class="col-6">
                                            <div class="mb-16">
                                                <label class="form-label mb-16">Code postal</label>

                                                {{ form_widget(form.codePostalContact, {
                                                    attr: {
                                                        class: 'form-control js-address-input',
                                                        placeholder: 'Entrez un code postal',
                                                        'data-name': 'codePostalContact',
                                                    },
                                                }) }}
                                            </div>
                                        </div>

                                        <div class="col-6">
                                            <label class="form-label mb-16">Ville</label>

                                            {{ form_widget(form.villeContact, {
                                                attr: {
                                                    class: 'form-control js-address-input',
                                                    placeholder: 'Choisissez une ville',
                                                    'data-name': 'villeContact',
                                                },
                                            }) }}
                                        </div>
                                    </div>

                                    <div>
                                        <label class="form-label mb-16">Pays*</label>

                                        {{ form_widget(form.paysContact, {
                                            attr: {
                                                class: 'form-control js-address-input',
                                                placeholder: 'France',
                                                'data-name': 'paysContact',
                                            },
                                        }) }}
                                    </div>
                                </div>
                            </div>

                            <button
                                type="button"
                                class="btn btn-link p-0 text-decoration-none btn-buttom-agence mt-15 js-edit-button"
                                data-action="click->field-save#handle"
                                data-field-save-field-param="adresseContact"
                                data-field-save-multiple-param="true"
                                data-field-save-output-param="#adresse-contact-value"
                            >
                                Définir
                            </button>
                        </div>
                    </div>

                    {# Numéro de contact #}
                    <div class="js-editable-field formulaire my-20">
                        <div class="d-flex justify-content-between align-items-start pb-20 ligne-border-bottom">
                            <div class="w-100">

                                <div class="d-flex justify-content-between align-items-start w-100">
                                    <div>
                                        <h3 class="mb-0">Numéro de téléphone</h3>

                                        <p class="mt-12 mb-0 js-field-value" id="numero-contact-value">
                                            {{ app.user.numeroContact ?? 'Définissez un numéro de contact' }}
                                        </p>
                                    </div>

                                    <button
                                        type="button"
                                        class="btn btn-link p-0 text-decoration-none btn-buttom-agence mt-15 js-edit-button"
                                        data-action="click->field-save#handle"
                                        data-field-save-field-param="numeroContact"
                                        data-field-save-input-param="#telephone-input"
                                        data-field-save-output-param="#numero-contact-value"
                                        data-field-save-whatsapp-switch-param="#whatsapp-switch"
                                        data-field-save-same-number-param="#same-number-checkbox"
                                        data-field-save-whatsapp-input-param="#whatsapp-phone"
                                    >
                                        Définir
                                    </button>
                                </div>

                                <div class="js-field-input d-none mt-12">

                                    <div data-controller="phone">
                                        {{ form_widget(form.numeroContact, {
                                            id: 'telephone-input',
                                            attr: {
                                                class: 'form-control w-75',
                                                'data-phone-target': 'input',
                                            },
                                        }) }}
                                    </div>

                                    <div class="mt-12">
                                        <div class="d-flex justify-content-between align-items-center w-100">
                                            <span class="fw-semibold">Whatsapp</span>

                                            <label class="contenue-des-page-des-parametres-switch">
                                                <input type="checkbox" id="whatsapp-switch">
                                                <span class="contenue-des-page-des-parametres-switch-slider"></span>
                                            </label>
                                        </div>

                                        <div
                                            class="contenue-des-page-des-parametres-checkbox-wrapper mt-12 d-none"
                                            id="whatsapp-checkbox-wrapper"
                                        >
                                            <label class="contenue-des-page-des-parametres-checkbox">
                                                <input type="checkbox" id="same-number-checkbox">

                                                <span class="contenue-des-page-des-parametres-checkbox-custom"></span>

                                                <span class="contenue-des-page-des-parametres-checkbox-label">
                                                    Utiliser le même numéro
                                                </span>
                                            </label>
                                        </div>

                                        <div class="mt-12 d-none" id="whatsapp-phone-wrapper">
                                            <div data-controller="phone">
                                                {{ form_widget(form.whatsApp, {
                                                    id: 'whatsapp-phone',
                                                    attr: {
                                                        class: 'form-control w-75',
                                                        'data-phone-target': 'input',
                                                    },
                                                }) }}
                                            </div>
                                        </div>
                                    </div>

                                    <span class="flash-message flash-message-error js-field-error d-none"></span>
                                </div>

                            </div>
                        </div>
                    </div>

                    {# Email de contact #}
                    <div class="js-editable-field formulaire my-20">
                        <div class="d-flex justify-content-between align-items-start pb-20">
                            <div class="w-100">
                                <h3 class="mb-0">Adresse e-mail</h3>

                                <p class="mt-12 mb-0 js-field-value" id="email-contact-value">
                                    {{ app.user.emailContact ?? 'Définissez une adresse e-mail de contact' }}
                                </p>

                                <div class="mt-12 d-none js-field-input">
                                    {{ form_widget(form.emailContact, {
                                        attr: {
                                            class: 'form-control w-75',
                                        },
                                    }) }}
                                </div>
                            </div>

                            <button
                                type="button"
                                class="btn btn-link p-0 text-decoration-none btn-buttom-agence mt-15 js-edit-button"
                                data-action="click->field-save#handle"
                                data-field-save-field-param="emailContact"
                                data-field-save-input-param="#{{ form.emailContact.vars.id }}"
                                data-field-save-output-param="#email-contact-value"
                            >
                                Définir
                            </button>
                        </div>
                    </div>

                </div>
            </div>

            <div class="fiche-public mt-48">
                <a href="{{ path('app_public_detail_agence', { slug: app.user.slug }) }} " target="_blank" class="btn btn-primary">
                    <i class="icon-eye mr10"></i>
                    Voir la fiche publique
                </a>

                <p class="mt-8">Telle qu'elle apparaitra aux utilisateurs</p>
            </div>
        </div>
    </div>
    <script>
        // AVATAR
        const changeImageButton = document.querySelector('#change-image-button');
        const imageInput = document.querySelector('.js-image-input');
        const avatarPreview = document.querySelector('.js-avatar-preview');

        if (changeImageButton && imageInput) {
            changeImageButton.addEventListener('click', () => {
                imageInput.click();
            });

            imageInput.addEventListener('change', async (event) => {
                const file = event.target.files[0];

                if (!file) {
                    return;
                }

                if (avatarPreview) {
                    avatarPreview.src = URL.createObjectURL(file);
                }

                const formData = new FormData();
                formData.append('imageFile', file);
                formData.append('_token', '{{ csrf_token('profile_edit') }}');

                try {
                    changeImageButton.textContent = '...';
                    changeImageButton.disabled = true;

                    const response = await fetch('{{ path('api_profile_agence_immobiliere') }}', {
                        method: 'POST',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: formData
                    });

                    const data = await response.json();

                    changeImageButton.textContent = data.success ? 'Modifier' : 'Erreur';
                } catch (e) {
                    console.error(e);
                    changeImageButton.textContent = 'Erreur';
                } finally {
                    changeImageButton.disabled = false;
                }
            });
        }

        // WHATSAPP
            document.addEventListener('DOMContentLoaded', () => {
            const whatsappSwitch = document.querySelector('#whatsapp-switch');
            const checkboxWrapper = document.querySelector('#whatsapp-checkbox-wrapper');
            const sameNumberCheckbox = document.querySelector('#same-number-checkbox');
            const whatsappPhoneWrapper = document.querySelector('#whatsapp-phone-wrapper');
            const whatsappPhoneInput = document.querySelector('#whatsapp-phone');
            const telephoneInput = document.querySelector('#telephone-input');

            //console.log(whatsappSwitch, checkboxWrapper, sameNumberCheckbox, whatsappPhoneWrapper, whatsappPhoneInput, telephoneInput);

            if (
            !whatsappSwitch ||
            !checkboxWrapper ||
            !sameNumberCheckbox ||
            !whatsappPhoneWrapper ||
            !whatsappPhoneInput ||
            !telephoneInput
            ) {
            //console.warn('WhatsApp switch: élément manquant');
            return;
        }

            whatsappSwitch.addEventListener('change', () => {
            if (whatsappSwitch.checked) {
            checkboxWrapper.classList.remove('d-none');
            sameNumberCheckbox.checked = true;
            whatsappPhoneWrapper.classList.add('d-none');
            whatsappPhoneInput.value = telephoneInput.value;
        } else {
            checkboxWrapper.classList.add('d-none');
            whatsappPhoneWrapper.classList.add('d-none');
            sameNumberCheckbox.checked = false;
            whatsappPhoneInput.value = '';
        }
        });

            sameNumberCheckbox.addEventListener('change', () => {
            if (sameNumberCheckbox.checked) {
            whatsappPhoneWrapper.classList.add('d-none');
            whatsappPhoneInput.value = telephoneInput.value;
        } else {
            whatsappPhoneWrapper.classList.remove('d-none');
            whatsappPhoneInput.value = '';
            whatsappPhoneInput.focus();
        }
        });

            telephoneInput.addEventListener('input', () => {
            if (whatsappSwitch.checked && sameNumberCheckbox.checked) {
            whatsappPhoneInput.value = telephoneInput.value;
        }
        });
        });
    </script>

</div>
