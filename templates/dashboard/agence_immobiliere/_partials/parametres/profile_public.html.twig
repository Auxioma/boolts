<style>
    .address-switch-card {
        max-width: 667px;
        min-height: 84px;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        padding: 12px 10px;
        background: #F3F3F3;
    }

    .address-switch-content h3 {
        margin: 0;
        color: #000;
        font-family: Inter, sans-serif;
        font-size: 14px;
        font-weight: 700;
        line-height: 18px;
    }

    .address-switch-content p {
        max-width: 287px;
        margin: 4px 0 0;
        color: #8D8D8D;
        font-family: Inter, sans-serif;
        font-size: 12px;
        font-weight: 400;
        line-height: 16px;
    }

    .switch {
        position: relative;
        width: 39px;
        height: 25px;
        display: inline-block;
        margin-top: 15px;
        flex-shrink: 0;
    }

    .switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .slider {
        position: absolute;
        inset: 0;
        cursor: pointer;
        background: #5D00FF;
        border-radius: 100px;
        transition: 0.2s ease;
    }

    .slider::before {
        content: "";
        position: absolute;
        width: 21px;
        height: 21px;
        left: 2px;
        top: 2px;
        background: #FFF;
        border-radius: 50%;
        transition: 0.2s ease;
    }

    .switch input:checked + .slider::before {
        transform: translateX(14px);
    }

    .switch input:not(:checked) + .slider {
        background: #CFCFCF;
    }
</style>
