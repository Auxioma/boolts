<div class="js-tab-content px-48 pb-92 contenue-des-page-des-parametres" id="cat1">
    <div class="row">
        <div class="col-10 mx-auto">
            <h2>Profil public</h2>

            <div
                class="card-information-public-profile my-32 py-18 px-24"
                data-controller="field-save"
                data-field-save-url-value="{{ path('api_profile_agence_immobiliere') }}"
                data-field-save-csrf-value="{{ csrf_token('profile_edit') }}"
            >
                <div class="d-flex align-items-center gap-3">
                    <div class="position-relative">
                        <img
                            src="{{ asset('images/agence/profile-1.png') }}"
                            alt="avatar"
                            class="rounded-circle object-fit-cover"
                            width="100"
                            height="100"
                        >

                        <button
                            class="btn btn-primary rounded-pill position-absolute start-50 translate-middle-x"
                            type="button"
                            style="bottom: -12px;"
                        >
                            Modifier
                        </button>
                    </div>

                    <div>
                        <h2 class="fw-bold mb-2">Axa Immobilier</h2>
                        <p class="text-secondary mb-0 fs-5">
                            Agence immobilière premium <br>
                            spécialisée villas luxe.
                        </p>
                    </div>
                </div>

                <div class="connexion-securite">

                    {# Entreprise #}
                    <div class="js-editable-field formulaire my-20">
                        <div class="d-flex justify-content-between align-items-start pb-20 ligne-border-bottom">
                            <div class="w-100">
                                <h3 class="mb-0">Nom de l’agence*</h3>

                                <p class="mt-12 mb-0 js-field-value" id="entreprise-value">
                                    {{ app.user.entreprise ?? 'Définissez le nom de l’agence' }}
                                </p>

                                <div class="mt-12 d-none js-field-input">
                                    {{ form_widget(form.entreprise, {
                                        attr: {
                                            class: 'form-control w-75'
                                        }
                                    }) }}
                                </div>
                            </div>

                            <button
                                type="button"
                                class="btn btn-link p-0 text-decoration-none btn-buttom-agence my-auto js-edit-button"
                                data-action="click->field-save#handle"
                                data-field-save-field-param="entreprise"
                                data-field-save-input-param="#{{ form.entreprise.vars.id }}"
                                data-field-save-output-param="#entreprise-value"
                            >
                                Modifier
                            </button>
                        </div>
                    </div>

                    {# Description #}
                    <div class="js-editable-field formulaire my-20">
                        <div class="d-flex justify-content-between align-items-start pb-20 ligne-border-bottom">
                            <div class="w-100">
                                <h3 class="mb-0">Description*</h3>

                                <p class="mt-12 mb-0 js-field-value" id="description-value">
                                    {{ app.user.description ?? 'Rédigez une courte description qui s’affichera sur votre profil' }}
                                </p>

                                <div class="mt-12 d-none js-field-input">
                                    {{ form_widget(form.description, {
                                        attr: {
                                            class: 'form-control w-75'
                                        }
                                    }) }}
                                </div>
                            </div>

                            <button
                                type="button"
                                class="btn btn-link p-0 text-decoration-none btn-buttom-agence my-auto js-edit-button"
                                data-action="click->field-save#handle"
                                data-field-save-field-param="description"
                                data-field-save-input-param="#{{ form.description.vars.id }}"
                                data-field-save-output-param="#description-value"
                            >
                                Modifier
                            </button>
                        </div>
                    </div>

                    {# Adresse de contact #}
                    <div class="js-editable-field formulaire my-20">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="w-100">
                                <h3 class="mb-0">Adresse*</h3>

                                <p class="mt-12 mb-0 js-field-value" id="adresse-contact-value">
                                    {% if app.user and app.user.adresseContact %}
                                        {{ app.user.adresseContact }}

                                        {% if app.user.codePostalContact or app.user.villeContact %}
                                            , {{ app.user.codePostalContact }} {{ app.user.villeContact }}
                                        {% endif %}

                                        {% if app.user.paysContact %}
                                            , {{ app.user.paysContact.nom }}
                                        {% endif %}
                                    {% else %}
                                        ***
                                    {% endif %}
                                </p>

                                <div class="mt-12 d-none js-field-input w-75">
                                    <div class="mb-16">
                                        {{ form_widget(form.adresseContact, {
                                            attr: {
                                                class: 'form-control js-address-input',
                                                placeholder: 'Entrez un numéro et un nom de rue',
                                                'data-name': 'adresseContact'
                                            }
                                        }) }}
                                    </div>

                                    <div class="row">
                                        <div class="col-6">
                                            <div class="mb-16">
                                                <label class="form-label mb-16">
                                                    Code postal
                                                </label>

                                                {{ form_widget(form.codePostalContact, {
                                                    attr: {
                                                        class: 'form-control js-address-input',
                                                        placeholder: 'Entrez un code postal',
                                                        'data-name': 'codePostalContact'
                                                    }
                                                }) }}
                                            </div>
                                        </div>

                                        <div class="col-6">
                                            <label class="form-label mb-16">
                                                Ville
                                            </label>

                                            {{ form_widget(form.villeContact, {
                                                attr: {
                                                    class: 'form-control js-address-input',
                                                    placeholder: 'Choisissez une ville',
                                                    'data-name': 'villeContact'
                                                }
                                            }) }}
                                        </div>
                                    </div>

                                    <div>
                                        <label class="form-label mb-16">
                                            Pays*
                                        </label>

                                        {{ form_widget(form.paysContact, {
                                            attr: {
                                                class: 'form-control js-address-input',
                                                placeholder: 'France',
                                                'data-name': 'paysContact'
                                            }
                                        }) }}
                                    </div>
                                </div>
                            </div>

                            <button
                                type="button"
                                class="btn btn-link p-0 text-decoration-none btn-buttom-agence my-auto js-edit-button"
                                data-action="click->field-save#handle"
                                data-field-save-field-param="adresseContact"
                                data-field-save-multiple-param="true"
                                data-field-save-output-param="#adresse-contact-value"
                            >
                                Modifier
                            </button>
                        </div>
                    </div>

                    {# Numéro de contact #}
                    <div class="js-editable-field formulaire my-20">
                        <div class="d-flex justify-content-between align-items-start pb-20 ligne-border-bottom">
                            <div class="w-100">
                                <h3 class="mb-0">Numéro de contact*</h3>

                                <p class="mt-12 mb-0 js-field-value" id="numero-contact-value">
                                    {{ app.user.numeroContact ?? 'Définissez un numéro de contact' }}
                                </p>

                                <div class="mt-12 d-none js-field-input">
                                    {{ form_widget(form.numeroContact, {
                                        attr: {
                                            class: 'form-control w-75'
                                        }
                                    }) }}

                                    <div class="mt-12">
                                        <div class="d-flex justify-content-between align-items-center w-100">
                                            <span class="fw-semibold">
                                                Whatsapp
                                            </span>

                                            <label class="contenue-des-page-des-parametres-switch">
                                                <input
                                                    type="checkbox"
                                                    id="whatsapp-switch"
                                                >

                                                <span class="contenue-des-page-des-parametres-switch-slider"></span>
                                            </label>
                                        </div>

                                        <div
                                            class="contenue-des-page-des-parametres-checkbox-wrapper mt-20 d-none"
                                            id="whatsapp-checkbox-wrapper"
                                        >
                                            <label class="contenue-des-page-des-parametres-checkbox">
                                                <input
                                                    type="checkbox"
                                                    id="same-number-checkbox"
                                                >

                                                <span class="contenue-des-page-des-parametres-checkbox-custom"></span>

                                                <span class="contenue-des-page-des-parametres-checkbox-label">
                                                    Utiliser le même numéro
                                                </span>
                                            </label>
                                        </div>

                                        <div
                                            class="mt-20 d-none"
                                            id="whatsapp-phone-wrapper"
                                        >
                                            <input
                                                type="text"
                                                class="form-control w-75"
                                                id="whatsapp-phone"
                                                placeholder="Numéro Whatsapp"
                                            >
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <button
                                type="button"
                                class="btn btn-link p-0 text-decoration-none btn-buttom-agence my-auto js-edit-button"
                                data-action="click->field-save#handle"
                                data-field-save-field-param="numeroContact"
                                data-field-save-input-param="#{{ form.numeroContact.vars.id }}"
                                data-field-save-output-param="#numero-contact-value"
                            >
                                Modifier
                            </button>
                        </div>
                    </div>


                    {# Email de contact #}
                    <div class="js-editable-field formulaire my-20">
                        <div class="d-flex justify-content-between align-items-start pb-20 ligne-border-bottom">
                            <div class="w-100">
                                <h3 class="mb-0">Email de contact*</h3>

                                <p class="mt-12 mb-0 js-field-value" id="email-contact-value">
                                    {{ app.user.emailContact ?? 'Ajoutez votre email de contact' }}
                                </p>

                                <div class="mt-12 d-none js-field-input">
                                    {{ form_widget(form.emailContact, {
                                        attr: {
                                            class: 'form-control w-75'
                                        }
                                    }) }}
                                </div>
                            </div>

                            <button
                                type="button"
                                class="btn btn-link p-0 text-decoration-none btn-buttom-agence my-auto js-edit-button"
                                data-action="click->field-save#handle"
                                data-field-save-field-param="emailContact"
                                data-field-save-input-param="#{{ form.emailContact.vars.id }}"
                                data-field-save-output-param="#email-contact-value"
                            >
                                Modifier
                            </button>
                        </div>
                    </div>










                </div>
            </div>
        </div>
    </div>


    <script>
        const whatsappSwitch = document.querySelector('#whatsapp-switch');

        const checkboxWrapper = document.querySelector('#whatsapp-checkbox-wrapper');

        whatsappSwitch.addEventListener('change', () => {

            if (whatsappSwitch.checked) {

                checkboxWrapper.classList.remove('d-none');

            } else {

                checkboxWrapper.classList.add('d-none');
            }
        });
        const sameNumberCheckbox = document.querySelector('#same-number-checkbox');

        const whatsappPhoneWrapper = document.querySelector('#whatsapp-phone-wrapper');

        const whatsappPhoneInput = document.querySelector('#whatsapp-phone');

        const telephoneInput = document.querySelector('#telephone-input');

        sameNumberCheckbox.addEventListener('change', () => {

            if (sameNumberCheckbox.checked) {

                whatsappPhoneWrapper.classList.remove('d-none');

                whatsappPhoneInput.value = telephoneInput.value;

            } else {

                whatsappPhoneWrapper.classList.add('d-none');

                whatsappPhoneInput.value = '';
            }
        });
    </script>
