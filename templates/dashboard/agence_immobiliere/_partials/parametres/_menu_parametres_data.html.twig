{#
 Template: templates/dashboard/agence_immobiliere/_partials/parametres/_menu_parametres_data.html.twig
 Role: Renders the dashboard/agence_immobiliere/_partials/parametres Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

{% set menuParametres = [
    {
        title: 'Gestion du compte',
        items: [
        {
            wrapper: 'profile-public',
            tab: 'cat1',
            icon: 'icon-user-round',
            label: 'Fiche agence',
            active: true,
        },
        {
            wrapper: 'information-personnelles',
            tab: 'cat2',
            icon: 'icon-circle-user',
            label: 'Informations personnelles',
            active: false,
        },
    ],
    },
    {
        title: 'Sécurité et paiement',
        titleClass: 'mt-32',
        items: [
        {
            wrapper: 'connexion-securite',
            tab: 'cat3',
            icon: 'icon-lock',
            label: 'Connexion et sécurité',
            active: false,
        },
        {
            wrapper: 'moyen-de-paiement',
            tab: 'cat4',
            icon: 'icon-credit-card',
            label: 'Moyen de paiement',
            active: false,
        },
                {
            wrapper: 'historique-des-paiements',
            tab: 'cat5',
            icon: 'icon-history',
            label: 'Historique des paiements',
            active: false,
        },
        {
            wrapper: 'langue-et-devise',
            tab: 'cat6',
            icon: 'icon-languages',
            label: 'Langue et devise',
            active: false,
        },
    ],
    },
] %}

{# variant 'mobile' : menu ouvert depuis la barre du bas (Figma « Paramètres » 6172:24683), liens vers la page Paramètres + onglet (#catX) #}
{% if variant|default('') == 'mobile' %}
    {% for section in menuParametres %}
        <div class="dashboard-settings-menu__section">
            <p class="dashboard-settings-menu__section-title">{{ section.title }}</p>

            <div class="dashboard-settings-menu__items">
                {% for item in section.items %}
                    <a href="{{ path('agence_immobiliere_parametres') }}#{{ item.tab }}"
                       class="dashboard-settings-menu__item"
                       data-action="dashboard-bottom-bar#navigate">
                        <span class="dashboard-settings-menu__item-label p-accent">
                            <i class="{{ item.icon }}"></i>
                            {{ item.label }}
                        </span>
                        <i class="icon-chevron-right"></i>
                    </a>
                {% endfor %}
            </div>
        </div>
    {% endfor %}
{% else %}
{% for section in menuParametres %}
    <span class="dashboard-agence-title paragraphe d-block {{ section.titleClass|default('') }}" style="color:#858789">
        {{ section.title }}
    </span>

    {% for item in section.items %}
        <div class="{{ item.wrapper }} {{ loop.first ? 'mt-16' : 'mt-8' }} px-10 py-10">
            <a href="#"
               class="menu-btn js-tab-link{{ item.active ? ' active' : '' }} p-accent"
               data-tab="{{ item.tab }}">
                <i class="{{ item.icon }} mr-10"></i>
                {{ item.label }}
            </a>
        </div>
    {% endfor %}
{% endfor %}
{% endif %}
