<div class="js-tab-content d-none px-48 pb-92 contenue-des-page-des-parametres" id="cat4">
    <div class="row">
        <div class="col-10 mx-auto">
            <h2 class="mb-0">Paiement A finir page forfait</h2>
            <div
                class="card-information-public-profile my-32 py-18 px-24"
                data-controller="field-save"
                data-field-save-url-value="{{ path('api_profile_agence_immobiliere') }}"
                data-field-save-csrf-value="{{ csrf_token('profile_edit') }}"
            >
                <div class="connexion-securite">
                    <h5 class="mb-32 mode-de-paiement-profile">Modes de paiement</h5>

                    {# card 1 #}
                    <div class="js-editable-field formulaire">
                        <div class="d-flex justify-content-between align-items-start pb-20 ligne-border-bottom">
                            <div class="w-100">
                                <h3 class="mb-0">Mastercard 3640</h3>
                                <p class="mt-12 mb-0 js-field-value" id="password-value">
                                    Date d’expiration : 12/08/2027
                                </p>
                            </div>

                            <button
                                type="button"
                                class="btn btn-link p-0 text-decoration-none btn-buttom-agence mt-15 js-edit-button mr-20"
                                data-action="click->field-save#handle"
                                data-field-save-field-param="plainPassword"
                                data-field-save-multiple-param="true"
                                data-field-save-output-param="#password-value"
                            >
                                Modifier
                            </button>
                            <button
                                type="button"
                                class="btn btn-link p-0 text-decoration-none btn-buttom-agence mt-15 js-edit-button"
                                data-action="click->field-save#handle"
                                data-field-save-field-param="plainPassword"
                                data-field-save-multiple-param="true"
                                data-field-save-output-param="#password-value"
                            >
                                Supprimer
                            </button>
                        </div>
                    </div>

                    {# card 2 #}
                    <div class="js-editable-field formulaire mt-20">
                        <div class="d-flex justify-content-between align-items-start pb-20 ligne-border-bottom">
                            <div class="w-100">
                                <h3 class="mb-0">Mastercard 3640</h3>
                                <p class="mt-12 mb-0 js-field-value" id="password-value">
                                    Date d’expiration : 12/08/2027
                                </p>
                            </div>

                            <button
                                type="button"
                                class="btn btn-link p-0 text-decoration-none btn-buttom-agence mt-15 js-edit-button mr-20"
                                data-action="click->field-save#handle"
                                data-field-save-field-param="plainPassword"
                                data-field-save-multiple-param="true"
                                data-field-save-output-param="#password-value"
                            >
                                Modifier
                            </button>
                            <button
                                type="button"
                                class="btn btn-link p-0 text-decoration-none btn-buttom-agence mt-15 js-edit-button"
                                data-action="click->field-save#handle"
                                data-field-save-field-param="plainPassword"
                                data-field-save-multiple-param="true"
                                data-field-save-output-param="#password-value"
                            >
                                Supprimer
                            </button>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-32 mb-32">
                        <button type="button" class="btn-add-payment">
                            <span class="btn-plus">+</span>
                                je ne fait rien, ne sais pas si bnt ou link
                        </button>
                    </div>

                    <h5 class="my-32 mode-de-paiement-profile">Historique des paiements</h5>

                    {% for i in 1..4 %}
                        <div class="js-editable-field formulaire {{ not loop.first ? 'mt-20' }}">
                            <div class="d-flex justify-content-between align-items-start pb-20 ligne-border-bottom">

                                <div>
                                    <h3 class="mb-0">Mastercard 3640</h3>

                                    <p class="mt-12 mb-0 js-field-value" id="password-value-{{ i }}">
                                        Date d’expiration : 12/08/2027
                                    </p>
                                </div>

                                <p class="btn btn-link p-0 text-decoration-none btn-buttom-agence mt-15 mb-0">
                                    19.99€
                                </p>

                            </div>
                        </div>
                    {% endfor %}


                </div>
            </div>
        </div>
    </div>
</div>
