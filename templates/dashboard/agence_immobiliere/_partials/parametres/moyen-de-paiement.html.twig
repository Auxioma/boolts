{#
 Template :
 templates/dashboard/agence_immobiliere/_partials/parametres/moyen-de-paiement.html.twig
#}

<div
    class="js-tab-content d-none px-48 pb-92 contenue-des-page-des-parametres"
    id="cat4"
    data-controller="payment-method parametre--payment-menu"
    data-payment-method-public-key-value="{{ stripe_public_key }}"
    data-payment-method-create-url-value="{{ path('api_agency_billing_setup_intent') }}"
    data-payment-method-complete-url-value="{{ path('api_agency_billing_payment_method_complete') }}"
    data-payment-method-csrf-value="{{ csrf_token('agency_payment_method') }}"
    data-payment-method-return-hash-value="cat4"
>
    <div class="row">
        <div class="col-10 mx-auto">
            <h2 class="mb-0">
                Moyens de paiement
            </h2>

            <div class="card-information-public-profile my-32 py-18 px-24">
                <div class="connexion-securite">
                    <h5 class="mb-32 mode-de-paiement-profile">
                        Cartes enregistrées
                    </h5>

                    {% if payment_methods is empty %}
                        <p class="mb-0 text-muted">
                            Aucun moyen de paiement n’est enregistré.
                        </p>
                    {% else %}
                        <div class="saved-payment-methods">
                            {% for paymentMethod in payment_methods %}
                                {% set brand = paymentMethod.brand|default('card')|lower %}

                                {% set brandLabel = {
                                    visa: 'Visa',
                                    mastercard: 'Mastercard',
                                    amex: 'Amex',
                                    american_express: 'Amex',
                                }[brand]|default(
                                    paymentMethod.brand|default('Carte bancaire')|capitalize,
                                ) %}

                                {% set logo = brand in [
                                    'visa',
                                    'mastercard',
                                    'amex',
                                    'american_express',
                                ]
                                    ? 'images/paiement_card/' ~ (
                                        brand == 'american_express'
                                            ? 'amex'
                                            : brand
                                    ) ~ '.svg'
                                    : null
                                %}

                                <div
                                    class="saved-payment-method"
                                    data-payment-method-id="{{ paymentMethod.id }}"
                                >
                                    <div class="saved-payment-method__main">
                                        <div class="saved-payment-method__logo">
                                            {% if logo %}
                                                <img
                                                    src="{{ asset(logo) }}"
                                                    alt="{{ brandLabel }}"
                                                    class="saved-payment-method__logo-image"
                                                >
                                            {% else %}
                                                <span
                                                    class="icon-credit-card saved-payment-method__logo-icon"
                                                    aria-hidden="true"
                                                ></span>
                                            {% endif %}
                                        </div>

                                        <div class="saved-payment-method__information">
                                            <div class="saved-payment-method__name">
                                                {{ brandLabel }}
                                                {{ paymentMethod.last4 }}

                                                {% if paymentMethod.isIsDefault %}
                                                    <span class="saved-payment-method__default-text">
                                                        — Par défaut
                                                    </span>
                                                {% endif %}
                                            </div>

                                            <div class="saved-payment-method__expiration">
                                                Date d’expiration :
                                                {{ '%02d'|format(paymentMethod.expMonth) }}/{{ paymentMethod.expYear }}
                                            </div>
                                        </div>
                                    </div>

                                    <div class="saved-payment-method__menu-wrapper">
                                        <button
                                            type="button"
                                            class="saved-payment-method__menu-button"
                                            aria-label="Afficher les actions de la carte"
                                            aria-expanded="false"
                                            data-payment-menu-button
                                        >
                                            <span aria-hidden="true">•••</span>
                                        </button>

                                        <div
                                            class="saved-payment-method__menu"
                                            data-payment-menu
                                            hidden
                                        >
                                            {% if not paymentMethod.isIsDefault %}
                                                <button
                                                    type="button"
                                                    class="saved-payment-method__menu-item"
                                                    data-payment-id="{{ paymentMethod.id }}"
                                                    data-action="click->payment-method#setDefault"
                                                >
                                                    <svg
                                                        width="14"
                                                        height="14"
                                                        viewBox="0 0 24 24"
                                                        fill="none"
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        aria-hidden="true"
                                                    >
                                                        <rect
                                                            x="3"
                                                            y="5"
                                                            width="18"
                                                            height="14"
                                                            rx="2"
                                                            stroke="currentColor"
                                                            stroke-width="1.8"
                                                        />

                                                        <path
                                                            d="M3 9H21"
                                                            stroke="currentColor"
                                                            stroke-width="1.8"
                                                        />
                                                    </svg>

                                                    <span>
                                                        Définir par défaut
                                                    </span>
                                                </button>
                                            {% endif %}

                                            <button
                                                type="button"
                                                class="saved-payment-method__menu-item saved-payment-method__menu-item--delete"
                                                data-payment-url="{{ path('api_agency_billing_payment_method_delete', { id: paymentMethod.id }) }}"
                                                data-payment-id="{{ paymentMethod.id }}"
                                                data-card-last4="{{ paymentMethod.last4 }}"
                                                data-action="click->payment-method#delete"
                                            >
                                                <svg
                                                    width="14"
                                                    height="14"
                                                    viewBox="0 0 24 24"
                                                    fill="none"
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    aria-hidden="true"
                                                >
                                                    <path
                                                        d="M4 7H20"
                                                        stroke="currentColor"
                                                        stroke-width="1.8"
                                                        stroke-linecap="round"
                                                    />

                                                    <path
                                                        d="M9 3H15"
                                                        stroke="currentColor"
                                                        stroke-width="1.8"
                                                        stroke-linecap="round"
                                                    />

                                                    <path
                                                        d="M6 7L7 21H17L18 7"
                                                        stroke="currentColor"
                                                        stroke-width="1.8"
                                                        stroke-linejoin="round"
                                                    />

                                                    <path
                                                        d="M10 11V17"
                                                        stroke="currentColor"
                                                        stroke-width="1.8"
                                                        stroke-linecap="round"
                                                    />

                                                    <path
                                                        d="M14 11V17"
                                                        stroke="currentColor"
                                                        stroke-width="1.8"
                                                        stroke-linecap="round"
                                                    />
                                                </svg>

                                                <span>
                                                    Supprimer
                                                </span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>

                <div class="d-flex mt-32 mb-32">
                    <button
                        type="button"
                        class="btn-add-payment py-10 px-16 payment-open-btn"
                        data-action="click->payment-method#open"
                    >
                        <span
                            class="icon-plus mr-6"
                            aria-hidden="true"
                        ></span>

                        Ajouter un mode de paiement
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div
        class="payment-modal-overlay"
        data-payment-method-target="modal"
        data-action="
            click->payment-method#closeFromOverlay
            keydown@window->payment-method#closeFromKeyboard
        "
        aria-hidden="true"
    >
        <div
            class="payment-modal"
            role="dialog"
            aria-modal="true"
            aria-labelledby="payment-modal-title"
        >
            <button
                type="button"
                class="payment-modal-close"
                data-action="click->payment-method#close"
                aria-label="Fermer"
            >
                <i
                    class="icon-x"
                    aria-hidden="true"
                ></i>
            </button>

            <div class="payment-modal-header">
                <h2
                    id="payment-modal-title"
                    class="payment-modal-title"
                >
                    Indiquez les informations de votre carte
                </h2>
            </div>

            <form
                class="payment-modal-form formulaire"
                data-payment-method-target="form"
                data-action="submit->payment-method#submit"
                novalidate
            >
                <div
                    class="payment-form-error d-none mb-16"
                    role="alert"
                    data-payment-method-target="error"
                ></div>

                <div
                    class="payment-form-success d-none mb-16"
                    role="status"
                    data-payment-method-target="success"
                ></div>

                <div class="payment-form-group">
                    <label
                        for="payment-cardholder-name-cat4"
                        class="payment-form-label"
                    >
                        Nom du titulaire
                    </label>

                    <input
                        type="text"
                        id="payment-cardholder-name-cat4"
                        class="payment-form-control"
                        placeholder="Saisissez le nom du titulaire"
                        autocomplete="cc-name"
                        data-payment-method-target="cardholderName"
                        data-action="
                            input->payment-method#cardholderChanged
                            change->payment-method#cardholderChanged
                        "
                        required
                    >
                </div>

                <div class="payment-form-group">
                    <label class="payment-form-label">
                        Numéro de la carte
                    </label>

                    <div
                        class="payment-stripe-element"
                        data-payment-method-target="cardNumber"
                        aria-label="Numéro de la carte bancaire"
                    ></div>
                </div>

                <div class="payment-form-row">
                    <div class="payment-form-group payment-form-group--half">
                        <label class="payment-form-label">
                            Date d’expiration
                        </label>

                        <div
                            class="payment-stripe-element"
                            data-payment-method-target="cardExpiry"
                            aria-label="Date d’expiration de la carte"
                        ></div>
                    </div>

                    <div class="payment-form-group payment-form-group--half">
                        <label class="payment-form-label">
                            Code de sécurité
                        </label>

                        <div
                            class="payment-stripe-element"
                            data-payment-method-target="cardCvc"
                            aria-label="Code de sécurité de la carte"
                        ></div>
                    </div>
                </div>

                <div class="payment-form-group">
                    <label
                        for="payment-country-cat4"
                        class="payment-form-label"
                    >
                        Pays
                    </label>

                    <select
                        id="payment-country-cat4"
                        class="payment-form-control"
                        autocomplete="country"
                        data-payment-method-target="country"
                        data-action="change->payment-method#countryChanged"
                        required
                    >
                        <option value="FR" selected>
                            France
                        </option>

                        <option value="BE">
                            Belgique
                        </option>

                        <option value="CH">
                            Suisse
                        </option>

                        <option value="LU">
                            Luxembourg
                        </option>

                        <option value="MC">
                            Monaco
                        </option>

                        <option value="DE">
                            Allemagne
                        </option>

                        <option value="ES">
                            Espagne
                        </option>

                        <option value="IT">
                            Italie
                        </option>

                        <option value="PT">
                            Portugal
                        </option>

                        <option value="NL">
                            Pays-Bas
                        </option>

                        <option value="GB">
                            Royaume-Uni
                        </option>
                    </select>
                </div>

                <label class="payment-checkbox">
                    <input
                        type="checkbox"
                        name="defaultPayment"
                        value="1"
                        class="mr-12"
                        data-payment-method-target="defaultCheckbox"
                    >

                    <span></span>

                    Définir comme moyen de paiement par défaut
                </label>

                <div class="payment-modal-actions">
                    <button
                        type="button"
                        class="payment-btn-cancel"
                        data-action="click->payment-method#close"
                    >
                        Annuler
                    </button>

                    <button
                        type="submit"
                        class="payment-btn-submit"
                        data-payment-method-target="submitButton"
                        disabled
                    >
                        Ajouter
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    /*
     * Liste des cartes bancaires
     */

    .saved-payment-methods {
        width: 100%;
    }

    .saved-payment-method {
        position: relative;

        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;

        min-height: 57px;
        padding: 0 0 14px;
        margin-bottom: 14px;

        border-bottom: 1px solid #eeeeee;
    }

    .saved-payment-method:last-child {
        padding-bottom: 0;
        margin-bottom: 0;

        border-bottom: 0;
    }

    .saved-payment-method__main {
        display: flex;
        align-items: flex-start;
        gap: 18px;

        min-width: 0;
    }

    .saved-payment-method__logo {
        display: flex;
        flex: 0 0 50px;
        align-items: center;
        justify-content: center;

        width: 50px;
        height: 36px;

        padding: 6px;

        background: #ffffff;

        border: 1px solid #e8e8e8;
        border-radius: 5px;
    }

    .saved-payment-method__logo-image {
        display: block;

        width: auto;
        max-width: 36px;
        height: auto;
        max-height: 19px;

        object-fit: contain;
    }

    .saved-payment-method__logo-icon {
        color: #5e6570;

        font-size: 20px;
    }

    .saved-payment-method__information {
        min-width: 0;
        padding-top: 1px;
    }

    .saved-payment-method__name {
        margin: 0;

        color: #111111;

        font-size: 13px;
        font-weight: 600;
        line-height: 18px;
    }

    .saved-payment-method__default-text {
        color: #777777;

        font-size: 11px;
        font-weight: 400;
    }

    .saved-payment-method__expiration {
        margin-top: 5px;

        color: #8a8a8a;

        font-size: 11px;
        font-weight: 400;
        line-height: 15px;
    }

    /*
     * Menu à trois points
     */

    .saved-payment-method__menu-wrapper {
        position: relative;

        flex: 0 0 auto;
        margin-top: 1px;
    }

    .saved-payment-method__menu-button {
        display: flex;
        align-items: center;
        justify-content: center;

        width: 30px;
        height: 26px;

        padding: 0;

        color: #111111;
        background: transparent;

        border: 0;
        border-radius: 5px;

        font-family: Arial, sans-serif;
        font-size: 16px;
        font-weight: 700;
        line-height: 1;
        letter-spacing: 1px;

        cursor: pointer;

        transition: background-color 150ms ease;
    }

    .saved-payment-method__menu-button:hover,
    .saved-payment-method__menu-button[aria-expanded="true"] {
        background: #f5f5f5;
    }

    .saved-payment-method__menu-button:focus-visible {
        outline: 2px solid #ff8a1e;
        outline-offset: 2px;
    }

    .saved-payment-method__menu {
        position: absolute;
        top: 30px;
        right: 0;
        z-index: 100;

        width: 122px;

        padding: 0;

        background: #ffffff;

        border: 1px solid #eeeeee;
        border-radius: 6px;

        box-shadow:
            0 4px 16px rgba(0, 0, 0, 0.08);

        overflow: hidden;
    }

    .saved-payment-method__menu[hidden] {
        display: none;
    }

    .saved-payment-method__menu-item {
        display: flex;
        align-items: center;
        gap: 7px;

        width: 100%;
        height: 31px;

        padding: 0 11px;

        color: #292929;
        background: #ffffff;

        border: 0;

        font-family: inherit;
        font-size: 10px;
        font-weight: 400;
        line-height: 14px;
        text-align: left;
        white-space: nowrap;

        cursor: pointer;

        transition: background-color 150ms ease;
    }

    .saved-payment-method__menu-item:hover {
        background: #f7f7f7;
    }

    .saved-payment-method__menu-item + .saved-payment-method__menu-item {
        border-top: 1px solid #f1f1f1;
    }

    .saved-payment-method__menu-item--delete {
        color: #ff3347;
    }

    .saved-payment-method__menu-item svg {
        flex: 0 0 auto;
    }

    /*
     * Modale Stripe
     */

    .payment-modal-overlay {
        position: fixed;
        inset: 0;
        z-index: 99999;

        display: flex;
        align-items: center;
        justify-content: center;

        padding: 24px;

        background: rgba(17, 24, 39, 0.58);

        opacity: 0;
        visibility: hidden;
        pointer-events: none;

        overflow-y: auto;

        transition:
            opacity 180ms ease,
            visibility 180ms ease;
    }

    .payment-modal-overlay.is-open {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
    }

    .payment-modal {
        position: relative;
        z-index: 100000;

        width: 100%;
        max-width: 560px;

        padding: 32px;

        background: #ffffff;
        border-radius: 16px;

        box-shadow:
            0 24px 70px rgba(17, 24, 39, 0.24);

        pointer-events: auto;
    }

    .payment-modal-close {
        position: absolute;
        top: 18px;
        right: 18px;

        display: flex;
        align-items: center;
        justify-content: center;

        width: 38px;
        height: 38px;

        padding: 0;

        color: #161616;
        background: transparent;

        border: 0;
        border-radius: 50%;

        cursor: pointer;
    }

    .payment-modal-close:hover {
        background: #f3f4f6;
    }

    .payment-modal-header {
        padding-right: 45px;
        margin-bottom: 28px;
    }

    .payment-modal-title {
        margin: 0;

        color: #161616;

        font-size: 24px;
        font-weight: 700;
        line-height: 32px;
    }

    .payment-modal-form,
    .payment-form-group,
    .payment-form-row,
    .payment-stripe-element,
    .payment-stripe-element iframe {
        position: relative;
        pointer-events: auto !important;
    }

    .payment-form-group {
        width: 100%;
        margin-bottom: 20px;
    }

    .payment-form-row {
        display: flex;
        align-items: flex-start;
        gap: 16px;
    }

    .payment-form-group--half {
        flex: 1;
        min-width: 0;
    }

    .payment-form-label {
        display: block;

        margin-bottom: 9px;

        color: #252525;

        font-size: 14px;
        font-weight: 600;
        line-height: 20px;
    }

    .payment-form-control {
        position: relative;
        z-index: 1;

        display: block;

        width: 100%;
        min-height: 50px;

        padding: 12px 14px;

        color: #161616;
        background: #ffffff;

        border: 1px solid #d5d9e2;
        border-radius: 10px;

        outline: none;

        font-size: 16px;
        line-height: 24px;

        pointer-events: auto !important;
        user-select: text;

        transition:
            border-color 150ms ease,
            box-shadow 150ms ease;
    }

    .payment-form-control:focus {
        border-color: #ff8a1e;

        box-shadow:
            0 0 0 3px rgba(255, 138, 30, 0.14);
    }

    .payment-stripe-element {
        position: relative;
        z-index: 1;

        width: 100%;
        min-height: 50px;

        padding: 14px;

        background: #ffffff;

        border: 1px solid #d5d9e2;
        border-radius: 10px;

        cursor: text;
        pointer-events: auto !important;

        transition:
            border-color 150ms ease,
            box-shadow 150ms ease;
    }

    .payment-stripe-element iframe {
        position: relative !important;
        z-index: 2 !important;

        width: 100% !important;

        pointer-events: auto !important;
    }

    .payment-stripe-element.StripeElement--focus {
        border-color: #ff8a1e;

        box-shadow:
            0 0 0 3px rgba(255, 138, 30, 0.14);
    }

    .payment-stripe-element.StripeElement--invalid {
        border-color: #dc3545;

        box-shadow:
            0 0 0 3px rgba(220, 53, 69, 0.1);
    }

    .payment-stripe-element.StripeElement--complete {
        border-color: #198754;
    }

    .payment-checkbox {
        display: flex;
        align-items: center;

        margin: 4px 0 26px;

        color: #343a40;

        font-size: 14px;
        line-height: 20px;

        cursor: pointer;
    }

    .payment-checkbox input {
        flex: 0 0 auto;

        width: 18px;
        height: 18px;

        cursor: pointer;
    }

    .payment-modal-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 12px;
    }

    .payment-btn-cancel,
    .payment-btn-submit {
        min-height: 46px;

        padding: 11px 20px;

        border-radius: 9px;

        font-size: 15px;
        font-weight: 600;
        line-height: 22px;

        cursor: pointer;

        transition:
            opacity 150ms ease,
            background-color 150ms ease,
            border-color 150ms ease;
    }

    .payment-btn-cancel {
        color: #343a40;
        background: #ffffff;

        border: 1px solid #d5d9e2;
    }

    .payment-btn-submit {
        color: #ffffff;
        background: #ff8a1e;

        border: 1px solid #ff8a1e;
    }

    .payment-btn-submit:hover:not(:disabled) {
        background: #ed770c;
        border-color: #ed770c;
    }

    .payment-btn-submit:disabled {
        cursor: not-allowed;
        opacity: 0.5;
    }

    .payment-btn-submit.is-loading {
        cursor: wait;
    }

    .payment-form-error,
    .payment-form-success {
        padding: 12px 14px;

        border-radius: 8px;

        font-size: 14px;
        line-height: 21px;
    }

    .payment-form-error {
        color: #842029;
        background: #f8d7da;

        border: 1px solid #f5c2c7;
    }

    .payment-form-success {
        color: #0f5132;
        background: #d1e7dd;

        border: 1px solid #badbcc;
    }

    body.payment-modal-open {
        overflow: hidden;
    }
</style>

<script src="https://js.stripe.com/v3/"></script>
