{#
 Template :
 templates/dashboard/agence_immobiliere/_partials/parametres/moyen-de-paiement.html.twig
#}

<div
    class="js-tab-content d-none contenue-des-page-des-parametres"
    id="cat4"
    data-controller="payment-method parametre--payment-menu"
    data-payment-method-public-key-value="{{ stripe_public_key }}"
    data-payment-method-create-url-value="{{ path('api_agency_billing_setup_intent') }}"
    data-payment-method-complete-url-value="{{ path('api_agency_billing_payment_method_complete') }}"
    data-payment-method-csrf-value="{{ csrf_token('agency_payment_method') }}"
    data-payment-method-return-hash-value="cat4"
>
    <div class="row">
        <div class="col-12 col-md-10 mx-auto">
            <h3 class="mb-0 d-none d-md-block">
                Moyens de paiement
            </h3>

    {% set abonnement_actuel = current_subscription is defined ? current_subscription : null %}
    {% set subscription = abonnement_actuel ? {
        plan: abonnement_actuel.plan,
        status: abonnement_actuel.status.value,
        billingPeriod: abonnement_actuel.planPrice ? abonnement_actuel.planPrice.billingPeriod.value : 'monthly',
        currentPeriodEnd: abonnement_actuel.currentPeriodEnd,
        price: abonnement_actuel.amountSnapshotMinor|minor_amount(abonnement_actuel.currencySnapshot),
        currencySign: abonnement_actuel.currencySnapshot ? abonnement_actuel.currencySnapshot.signe : '€',
        cancelAtPeriodEnd: abonnement_actuel.cancelAtPeriodEnd,
    } : null %}

        {# Le cadre « Abonnement » n'a de sens que pour un forfait payant.
           Sur une offre gratuite, on n'affiche que le choix des forfaits et des boosts. #}
        {% if subscription and not subscription.plan.isFree %}

            <section class="subscription-card mt-32">

                <div class="subscription-card-header">

                    <div>

                        <div class="p-accent" style="color:#858789;">
                            {{ 'agency_options.subscription.current'|trans }}
                        </div>
                    </div>

                    {% if subscription.status in ['active', 'free'] %}

                        <span class="subscription-status paragraphe">
                            {{ 'agency_options.subscription.status.active'|trans }}
                        </span>

                    {% elseif subscription.status|default('') == 'canceled' %}

                        <span class="subscription-status cancelled paragraphe">
                            {{ 'agency_options.subscription.status.canceled'|trans }}
                        </span>

                    {% else %}

                        <span class="subscription-status pending paragraphe">
                            {{ 'agency_options.subscription.status.pending'|trans }}
                        </span>

                    {% endif %}

                </div>

                {# ==================================================
                   DETAILS
                ================================================== #}

                <div class="subscription-details">

                    <div class="subscription-detail">

                        <span class="subscription-detail-label">
                            {{ 'agency_options.subscription.plan'|trans }}
                        </span>

                        <span class="subscription-detail-value p-accent">

                            {% if subscription.plan is defined and subscription.plan %}

                                {{ subscription.plan.name }}

                            {% else %}

                                {{ 'agency_options.subscription.not_specified'|trans }}

                            {% endif %}

                        </span>

                    </div>

                    <div class="subscription-detail">

                        <span class="subscription-detail-label">
                            {{ 'agency_options.subscription.billing_period'|trans }}
                        </span>

                        <span class="subscription-detail-value p-accent">

                            {% if subscription.billingPeriod == 'annual' %}

                                {{ 'agency_options.subscription.billing_period.annual'|trans }}

                            {% else %}

                                {{ 'agency_options.subscription.billing_period.monthly'|trans }}

                            {% endif %}

                        </span>

                    </div>

                    <div class="subscription-detail">

                        <span class="subscription-detail-label">
                            {{ 'agency_options.subscription.next_renewal'|trans }}
                        </span>

                        <span class="subscription-detail-value p-accent">

                            {% if subscription.currentPeriodEnd is defined and subscription.currentPeriodEnd %}

                                {{ subscription.currentPeriodEnd|date('d/m/Y') }}

                            {% elseif subscription.endDate is defined and subscription.endDate %}

                                {{ subscription.endDate|date('d/m/Y') }}

                            {% else %}

                                {{ 'agency_options.subscription.not_specified'|trans }}

                            {% endif %}

                        </span>

                    </div>

                    <div class="subscription-detail">

                        <span class="subscription-detail-label">
                            {{ 'agency_options.subscription.price'|trans }}
                        </span>

                        <span class="subscription-detail-value p-accent">

                            {% if subscription.price is defined %}

                                {{ subscription.price }}
                                {{ subscription.currencySign }}

                            {% elseif subscription.plan is defined
                                and subscription.plan
                                and subscription.plan.price is defined %}

                                {{ subscription.plan.price|number_format(2, ',', ' ') }}
                                €

                            {% else %}

                                {{ 'agency_options.subscription.not_specified'|trans }}

                            {% endif %}

                        </span>

                    </div>

                </div>

                {# ==================================================
                   ACTIONS
                ================================================== #}

                <div class="subscription-actions">

                    {# <a
                        href="{{ path('agence_immobiliere_parametres') }}#cat4"
                        class="btn-full-blue"
                    >
                        {{ 'agency_options.subscription.update_payment_method'|trans }}
                    </a>
 #}
                    {% if not subscription.plan.isFree and not subscription.cancelAtPeriodEnd %}

                        <button
                            type="button"
                            class="btn-subscription-cancel ms-auto"
                            data-bs-toggle="modal"
                            data-bs-target="#cancelSubscriptionModal"
                        >
                            {{ 'agency_options.subscription.cancel'|trans }}
                        </button>

                    {% elseif subscription.cancelAtPeriodEnd %}

                        <span class="subscription-status cancelled">
                            {{ 'agency_options.subscription.cancellation_scheduled'|trans }}
                        </span>

                    {% endif %}

                </div>

                {% if subscription.cancelAtPeriodEnd|default(false) %}

                    <div class="subscription-cancellation-info">

                        {{ 'agency_options.subscription.cancellation_info.before_date'|trans }}

                        {% if subscription.currentPeriodEnd is defined
                            and subscription.currentPeriodEnd %}

                            <strong>
                                {{ subscription.currentPeriodEnd|date('d/m/Y') }}
                            </strong>

                        {% elseif subscription.endDate is defined
                            and subscription.endDate %}

                            <strong>
                                {{ subscription.endDate|date('d/m/Y') }}
                            </strong>

                        {% endif %}

                        {{ 'agency_options.subscription.cancellation_info.after_date'|trans }}

                        <form
                            method="post"
                            action="{{ path('account_subscription_reactivate') }}"
                            class="mt-2"
                        >
                            <input
                                type="hidden"
                                name="_token"
                                value="{{ csrf_token('account_subscription_reactivate') }}"
                            >

                            <input
                                type="hidden"
                                name="_redirect_route"
                                value="agence_immobiliere_options"
                            >

                            <button type="submit" class="btn-subscription-resume">
                                {{ 'agency_options.subscription.reactivate'|trans }}
                            </button>
                        </form>

                    </div>

                {% endif %}

                {% if abonnement_actuel and abonnement_actuel.hasPendingPlanChange %}

                    <div class="subscription-cancellation-info">

                        {{ 'agency_options.subscription.pending_change.before_plan'|trans }}

                        <strong>{{ abonnement_actuel.pendingPlanPrice.plan.name }}</strong>

                        {% if abonnement_actuel.pendingPlanChangeEffectiveAt %}
                            {{ 'agency_options.subscription.pending_change.on_date'|trans }}
                            <strong>
                                {{ abonnement_actuel.pendingPlanChangeEffectiveAt|date('d/m/Y') }}
                            </strong>
                        {% else %}
                            {{ 'agency_options.subscription.pending_change.end_of_period'|trans }}
                        {% endif %}.

                        {{ 'agency_options.subscription.pending_change.before_amount'|trans }}

                        <strong>
                            {{ abonnement_actuel.pendingPlanPrice.amountMinor|minor_amount(abonnement_actuel.pendingPlanPrice.currency) }}
                            {{ abonnement_actuel.pendingPlanPrice.currency.signe }}
                        </strong>

                        {{ 'agency_options.subscription.pending_change.after_amount'|trans }}

                        <form
                            method="post"
                            action="{{ path('account_subscription_cancel_plan_change') }}"
                            class="mt-2"
                        >
                            <input
                                type="hidden"
                                name="_token"
                                value="{{ csrf_token('account_subscription_cancel_plan_change') }}"
                            >

                            <input
                                type="hidden"
                                name="_redirect_route"
                                value="agence_immobiliere_options"
                            >

                            <button type="submit" class="btn-subscription-cancel">
                                {{ 'agency_options.subscription.cancel_plan_change'|trans }}
                            </button>
                        </form>

                    </div>

                {% endif %}

            </section>

        {% endif %}

    {% if subscription and not subscription.plan.isFree and not subscription.cancelAtPeriodEnd %}
        <div
            class="modal fade"
            id="cancelSubscriptionModal"
            tabindex="-1"
            aria-labelledby="cancelSubscriptionModalLabel"
            aria-hidden="true"
        >
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content" style="border-radius: 24px; border: 0;padding:24px">
                    <div class="modal-header border-0 py-0 px-0 justify-content-center position-relative">
                        <h3
                            class="mb-0 text-center"
                            id="cancelSubscriptionModalLabel"
                            style="color:#0b0f14"
                        >
                            {{ 'agency_options.cancel_modal.title'|trans }}
                        </h3>

                        <button
                            type="button"
                            class="btn-close position-absolute top-0 end-0"
                            data-bs-dismiss="modal"
                            aria-label="{{ 'agency_options.cancel_modal.close'|trans }}"
                            style="padding-top:17px"
                        ></button>
                    </div>

                    <div class="p-accent my-48 text-center">
                        <p class="mb-2 p-accent" style="color:#0b0f14">
                            {{ 'agency_options.cancel_modal.question'|trans }}
                        </p>

                        <p class="text-muted mb-0 paragraphe" style="color:#858789!important">
                            {{ 'agency_options.cancel_modal.description'|trans }}
                        </p>
                    </div>

                    <div class="modal-footer" style="margin-top:0;padding:0; border-top:transparent; display:flex; flex-wrap:nowrap; justify-content:space-between; gap:12px">
                        <button
                            type="button"
                            class="btn-full-white"
                            data-bs-dismiss="modal"
                        >
                            {{ 'agency_options.cancel_modal.cancel'|trans }}
                        </button>

                        <form
                            method="post"
                            action="{{ path('account_subscription_cancel') }}"
                        >
                            <input
                                type="hidden"
                                name="_token"
                                value="{{ csrf_token('account_subscription_cancel') }}"
                            >

                            <input
                                type="hidden"
                                name="_redirect_route"
                                value="agence_immobiliere_options"
                            >

                            <button
                                type="submit"
                                class="btn-subscription-cancel"
                                style="color:#fff;background:#dc3545"
                            >
                                {{ 'agency_options.cancel_modal.confirm'|trans }}
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

            <div class="card-information-public-profile my-32 py-24 px-24">
                <div class="connexion-securite">
                    <h3 class="mb-24">
                        Cartes enregistrées
                    </h3>

                    {% if payment_methods is empty %}
                        <p class="mb-0 text-muted">
                            Aucun moyen de paiement n’est enregistré.
                        </p>
                    {% else %}
                        <div class="saved-payment-methods">
                            {% for paymentMethod in payment_methods %}
                                {% set brand = paymentMethod.brand|default('card')|lower %}

                                {% set brandLabel = {
                                    visa: 'Visa',
                                    mastercard: 'Mastercard',
                                    amex: 'Amex',
                                    american_express: 'Amex',
                                    discover: 'Discover',
                                    diners: 'Diners Club',
                                    diners_club: 'Diners Club',
                                    jcb: 'JCB',
                                    unionpay: 'UnionPay',
                                }[brand]|default(
                                    paymentMethod.brand|default('Carte bancaire')|capitalize,
                                ) %}

                                {% set logoFile = {
                                    visa: 'visa',
                                    mastercard: 'mastercard',
                                    amex: 'amex',
                                    american_express: 'amex',
                                    discover: 'discover',
                                    diners: 'diners',
                                    diners_club: 'diners',
                                    jcb: 'jcb',
                                    unionpay: 'unionpay',
                                }[brand]|default(null) %}

                                {% set logo = logoFile
                                    ? 'images/paiement_card/' ~ logoFile ~ '.svg'
                                    : null
                                %}

                                <div
                                    class="saved-payment-method"
                                    data-payment-method-id="{{ paymentMethod.id }}"
                                >
                                    <div class="saved-payment-method__main">
                                        <div class="saved-payment-method__logo">
                                            {% if logo %}
                                                <img
                                                    src="{{ asset(logo) }}"
                                                    alt="{{ brandLabel }}"
                                                    class="saved-payment-method__logo-image"
                                                >
                                            {% else %}
                                                <span
                                                    class="icon-credit-card saved-payment-method__logo-icon"
                                                    aria-hidden="true"
                                                ></span>
                                            {% endif %}
                                        </div>

                                        <div class="saved-payment-method__information">
                                            <div class="saved-payment-method__name">
                                                <span class="p-accent">{{ brandLabel }}
                                                {{ paymentMethod.last4 }}</span>

                                                {% if paymentMethod.isIsDefault %}
                                                    <span class="saved-payment-method__default-text paragraphe">
                                                        — Par défaut
                                                    </span>
                                                {% endif %}
                                            </div>

                                            <div class="saved-payment-method__expiration paragraphe">
                                                Date d’expiration :
                                                {{ '%02d'|format(paymentMethod.expMonth) }}/{{ paymentMethod.expYear }}
                                            </div>
                                        </div>
                                    </div>

                                    <div class="saved-payment-method__menu-wrapper">
                                        <button
                                            type="button"
                                            class="saved-payment-method__menu-button"
                                            aria-label="Afficher les actions de la carte"
                                            aria-expanded="false"
                                            data-payment-menu-button
                                        >
                                            <span aria-hidden="true">•••</span>
                                        </button>

                                        <div
                                            class="saved-payment-method__menu"
                                            data-payment-menu
                                            hidden
                                        >
                                            {% if not paymentMethod.isIsDefault %}
                                                <button
                                                    type="button"
                                                    class="saved-payment-method__menu-item"
                                                    data-payment-id="{{ paymentMethod.id }}"
                                                    data-action="click->payment-method#setDefault"
                                                >
                                                    <svg
                                                        width="14"
                                                        height="14"
                                                        viewBox="0 0 24 24"
                                                        fill="none"
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        aria-hidden="true"
                                                    >
                                                        <rect
                                                            x="3"
                                                            y="5"
                                                            width="18"
                                                            height="14"
                                                            rx="2"
                                                            stroke="currentColor"
                                                            stroke-width="1.8"
                                                        />

                                                        <path
                                                            d="M3 9H21"
                                                            stroke="currentColor"
                                                            stroke-width="1.8"
                                                        />
                                                    </svg>

                                                    <span>
                                                        Définir par défaut
                                                    </span>
                                                </button>
                                            {% endif %}

                                            <button
                                                type="button"
                                                class="saved-payment-method__menu-item saved-payment-method__menu-item--delete"
                                                data-payment-url="{{ path('api_agency_billing_payment_method_delete', {id: paymentMethod.id}) }}"
                                                data-payment-id="{{ paymentMethod.id }}"
                                                data-card-last4="{{ paymentMethod.last4 }}"
                                                data-action="click->payment-method#delete"
                                            >
                                                <svg
                                                    width="14"
                                                    height="14"
                                                    viewBox="0 0 24 24"
                                                    fill="none"
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    aria-hidden="true"
                                                >
                                                    <path
                                                        d="M4 7H20"
                                                        stroke="currentColor"
                                                        stroke-width="1.8"
                                                        stroke-linecap="round"
                                                    />

                                                    <path
                                                        d="M9 3H15"
                                                        stroke="currentColor"
                                                        stroke-width="1.8"
                                                        stroke-linecap="round"
                                                    />

                                                    <path
                                                        d="M6 7L7 21H17L18 7"
                                                        stroke="currentColor"
                                                        stroke-width="1.8"
                                                        stroke-linejoin="round"
                                                    />

                                                    <path
                                                        d="M10 11V17"
                                                        stroke="currentColor"
                                                        stroke-width="1.8"
                                                        stroke-linecap="round"
                                                    />

                                                    <path
                                                        d="M14 11V17"
                                                        stroke="currentColor"
                                                        stroke-width="1.8"
                                                        stroke-linecap="round"
                                                    />
                                                </svg>

                                                <span>
                                                    Supprimer
                                                </span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>

                <div class="d-flex mt-32 mb-32">
                    <button
                        type="button"
                        class="btn-add-payment py-10 px-16 payment-open-btn"
                        data-action="click->payment-method#open"
                    >
                        <span
                            class="icon-plus mr-6"
                            aria-hidden="true"
                        ></span>

                        Ajouter un mode de paiement
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div
        class="payment-modal-overlay"
        data-payment-method-target="modal"
        data-action="
            click->payment-method#closeFromOverlay
            keydown@window->payment-method#closeFromKeyboard
        "
        aria-hidden="true"
    >
        <div
            class="payment-modal"
            role="dialog"
            aria-modal="true"
            aria-labelledby="payment-modal-title"
        >
            <button
                type="button"
                class="payment-modal-close"
                data-action="click->payment-method#close"
                aria-label="Fermer"
            >
                <i
                    class="icon-x"
                    aria-hidden="true"
                ></i>
            </button>

            <div class="payment-modal-header">
                <h3
                    id="payment-modal-title"
                    class="payment-modal-title"
                >
                    Indiquez les informations de votre carte
                </h3>
            </div>

            <form
                class="payment-modal-form formulaire"
                data-payment-method-target="form"
                data-action="submit->payment-method#submit"
                novalidate
            >
                <div
                    class="payment-form-error d-none mb-16"
                    role="alert"
                    data-payment-method-target="error"
                ></div>

                <div
                    class="payment-form-success d-none mb-16"
                    role="status"
                    data-payment-method-target="success"
                ></div>

                <div class="payment-form-group">
                    <label
                        for="payment-cardholder-name-cat4"
                        class="mb-16 p-accent"
                    >
                        Nom du titulaire
                    </label>

                    <input
                        type="text"
                        id="payment-cardholder-name-cat4"
                        class="form-control input mb-16"
                        placeholder="Saisissez le nom du titulaire"
                        autocomplete="cc-name"
                        data-payment-method-target="cardholderName"
                        data-action="
                            input->payment-method#cardholderChanged
                            change->payment-method#cardholderChanged
                        "
                        required
                    >
                </div>

                <div class="payment-form-group">
                    <label class="mb-16 p-accent">
                        Numéro de la carte
                    </label>

                    <div
                        class="payment-stripe-element mb-16"
                        data-payment-method-target="cardNumber"
                        aria-label="Numéro de la carte bancaire"
                    ></div>
                </div>

                <div class="payment-form-row">
                    <div class="payment-form-group payment-form-group--half">
                        <label class="mb-16 p-accent">
                            Date d’expiration
                        </label>

                        <div
                            class="payment-stripe-element mb-16"
                            data-payment-method-target="cardExpiry"
                            aria-label="Date d’expiration de la carte"
                        ></div>
                    </div>

                    <div class="payment-form-group payment-form-group--half">
                        <label class="mb-16 p-accent">
                            Code de sécurité
                        </label>

                        <div
                            class="payment-stripe-element mb-16"
                            data-payment-method-target="cardCvc"
                            aria-label="Code de sécurité de la carte"
                        ></div>
                    </div>
                </div>

                <div class="payment-form-group">
                    <label
                        for="payment-country-cat4"
                        class="mb-16 p-accent"
                    >
                        Pays
                    </label>

                    <select
                        id="payment-country-cat4"
                        class="payment-form-control mb-16"
                        autocomplete="country"
                        data-payment-method-target="country"
                        data-action="change->payment-method#countryChanged"
                        required
                    >
                        <option value="FR" selected>
                            France
                        </option>

                        <option value="BE">
                            Belgique
                        </option>

                        <option value="CH">
                            Suisse
                        </option>

                        <option value="LU">
                            Luxembourg
                        </option>

                        <option value="MC">
                            Monaco
                        </option>

                        <option value="DE">
                            Allemagne
                        </option>

                        <option value="ES">
                            Espagne
                        </option>

                        <option value="IT">
                            Italie
                        </option>

                        <option value="PT">
                            Portugal
                        </option>

                        <option value="NL">
                            Pays-Bas
                        </option>

                        <option value="GB">
                            Royaume-Uni
                        </option>
                    </select>
                </div>

                <label class="payment-checkbox">
                    <input
                        type="checkbox"
                        name="defaultPayment"
                        value="1"
                        class="mr-12"
                        data-payment-method-target="defaultCheckbox"
                    >

                    <span></span>

                    Définir comme moyen de paiement par défaut
                </label>

                <div class="payment-modal-actions">
                    <button
                        type="button"
                        class="btn-full-white w-auto"
                        data-action="click->payment-method#close"
                    >
                        Annuler
                    </button>

                    <button
                        type="submit"
                        class="payment-btn-submit btn-full-blue "
                        data-payment-method-target="submitButton"
                        disabled
                    >
                        Ajouter
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    /*
     * Liste des cartes bancaires
     */

    .saved-payment-methods {
        width: 100%;
    }

    .saved-payment-method {
        position: relative;

        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;

        min-height: 57px;
        padding: 0 0 14px;
        margin-bottom: 14px;

        border-bottom: 1px solid #eeeeee;
    }

    .saved-payment-method:last-child {
        padding-bottom: 0;
        margin-bottom: 0;

        border-bottom: 0;
    }

    .saved-payment-method__main {
        display: flex;
        align-items: flex-start;
        gap: 24px;

        min-width: 0;
    }

    .saved-payment-method__logo {
        display: flex;
        margin: auto 0;
        align-items: center;
        justify-content: center;

        width: 70px;
        height: 48px;

        padding: 6px;

        background: #ffffff;

        border: 1px solid #e8e8e8;
        border-radius: 5px;
    }

    .saved-payment-method__logo-image {
        display: block;

        width: auto;
        max-width: 36px;
        height: auto;
        max-height: 19px;

        object-fit: contain;
    }

    .saved-payment-method__logo-icon {
        color: #5e6570;

        font-size: 20px;
    }

    .saved-payment-method__information {
        min-width: 0;
        padding-top: 1px;
    }

    .saved-payment-method__name {
        margin: 0;

        color: #111111;

        font-size: 13px;
        font-weight: 600;
        line-height: 18px;
    }

    .saved-payment-method__default-text {
        color: #777777;
    }

    .saved-payment-method__expiration {
        margin-top: 8px;
        color: #8a8a8a;
    }

    /*
     * Menu à trois points
     */

    .saved-payment-method__menu-wrapper {
        position: relative;

        flex: 0 0 auto;
        margin: auto 0;
       
    }

    .saved-payment-method__menu-button {
        display: flex;
        align-items: center;
        justify-content: center;

