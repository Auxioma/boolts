{% set boost_balance_title = 'boost_balance.title'|trans({
    '%plan%': boosts_forfait|default(0),
    '%independent%': boosts_independants|default(0),
}) %}
{% if variant == 'options' %}
    <button
        class="btn achat-btn-outline-brand achat-boost-balance"
        type="button"
        title="{{ boost_balance_title }}"
    >
        <img
            src="https://www.figma.com/api/mcp/asset/4abf21cc-aaec-40db-aef8-19e91701de8e"
            alt=""
            class="achat-icon-24"
        >

        <span>
            {{ 'boost_balance.count'|trans({'%count%': boosts_restants|default(0)}) }}
            <small>
                {{ 'boost_balance.detail'|trans({
                    '%plan%': boosts_forfait|default(0),
                    '%independent%': boosts_independants|default(0),
                }) }}
            </small>
        </span>
    </button>
{% else %}
    <a
        href="#"
        class="p-accent btn dashboard-boost-button"
        title="{{ boost_balance_title }}"
    >
        <i class="icon-zap"></i>
        <span>
            <span class="dashboard-boost-label d-none d-md-inline">{{ 'boost_balance.label'|trans }}</span>
            {{ boosts_restants|default(0) }}

        </span>
    </a>
{% endif %}
