{#
 Template: templates/dashboard/agence_immobiliere/_partials/mes_biens/caracteristiques.html.twig
 Role: Renders the dashboard/agence_immobiliere/_partials/mes_biens Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

<div class="js-tab-content mes-biens-immobilier formulaire" id="cat4">
    <div class="d-flex justify-content-between align-items-end">
        <h2 class="w-75 mb-0">
            {{ 'mes_biens.caracteristiques.title'|trans }}
        </h2>

        <div class="d-none align-items-end my-auto">
            {{ form_widget(form.saveAndExit) }}
        </div>
    </div>

    <div class="mt-48 caracteristique-logements">
        <div class="row">
            <div class="col-12">
                <div class="row">
                    <div class="">
                        <div class="row">

                            <h3 class="mb-32">{{ 'mes_biens.caracteristiques.pieces'|trans }}</h3>

                            <div>

                                {# CHAMBRES #}
                                <div
                                    class="position-relative mb-18"
                                    data-controller="mes-biens--chambres"
                                >
                                    {{ form_widget(form.chambres, {
                                        attr: {
                                            'class': 'chambre-input',
                                            'data-mes-biens--chambres-target': 'input',
                                            'data-mes-biens-required-min-value': '1',
                                        },
                                    }) }}

                                    <input
                                        type="text"
                                        class="form-control input p-accent-placeholder"
                                        placeholder="{{ 'mes_biens.caracteristiques.chambre'|trans }}"
                                        readonly
                                    >

                                    <div class="position-absolute top-50 end-0 translate-middle-y d-flex align-items-center mr-14">

                                        <button
                                            type="button"
                                            class="btn btn-sm p-0 border-0 bg-transparent"
                                            data-action="click->mes-biens--chambres#decrement"
                                        >
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                                <path d="M8 12H16M22 12C22 17.5228 17.5228 22 12 22C6.47715 22 2 17.5228 2 12C2 6.47715 2 12 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12Z" stroke="#858789" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                        </button>

                                        <span
                                            class="chambre-value"
                                            data-mes-biens--chambres-target="value"
                                        >
                                            {{ form.chambres.vars.value|default(0) }}
                                        </span>

                                        <button
                                            type="button"
                                            class="btn btn-sm p-0 border-0 bg-transparent"
                                            data-action="click->mes-biens--chambres#increment"
                                        >
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                                <path d="M8 12H16M12 8V16M22 12C22 17.5228 17.5228 22 12 22C6.47715 22 2 17.5228 2 12C2 6.47715 2 12 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12Z" stroke="#858789" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                        </button>

                                    </div>

                                    {{ form_errors(form.chambres) }}
                                </div>

                                {# SALLE DE BAIN #}
                                <div
                                    class="position-relative mb-7"
                                    data-controller="mes-biens--salle-de-bains"
                                >
                                    {{ form_widget(form.salleDeBains, {
                                        attr: {
                                            'class': 'salle-bain-input',
                                            'data-mes-biens--salle-de-bains-target': 'input',
                                            'data-mes-biens-required-min-value': '0.5',
                                        },
                                    }) }}

                                    <input
                                        type="text"
                                        class="form-control input p-accent-placeholder"
                                        placeholder="{{ 'mes_biens.caracteristiques.salle_de_bain'|trans }}"
                                        readonly
                                    >

                                    <div class="position-absolute top-50 end-0 translate-middle-y d-flex align-items-center mr-14">

                                        <button
                                            type="button"
                                            class="btn btn-sm p-0 border-0 bg-transparent"
                                            data-action="click->mes-biens--salle-de-bains#decrement"
                                        >
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                                <path d="M8 12H16M22 12C22 17.5228 17.5228 22 12 22C6.47715 22 2 17.5228 2 12C2 6.47715 2 12 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12Z" stroke="#858789" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                        </button>

                                        <span
                                            class="salle-bain-value"
                                            data-mes-biens--salle-de-bains-target="value"
                                        >
                                            {{ form.salleDeBains.vars.value|default(0)|replace({'.': ','}) }}
                                        </span>

                                        <button
                                            type="button"
                                            class="btn btn-sm p-0 border-0 bg-transparent"
                                            data-action="click->mes-biens--salle-de-bains#increment"
                                        >
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                                <path d="M8 12H16M12 8V16M22 12C22 17.5228 17.5228 22 12 22C6.47715 22 2 17.5228 2 12C2 6.47715 2 12 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12Z" stroke="#858789" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                        </button>

                                    </div>

                                    {{ form_errors(form.salleDeBains) }}
                                </div>

                                <p class="mb-32" style="color:#858789">
                                    {{ 'mes_biens.caracteristiques.salle_de_bain.help'|trans }}
                                </p>

                                {# SURFACE #}
                                <div>
                                    <label
                                        for="{{ form.surfaceTotal.vars.id }}"
                                        class="mb-16 p-accent"
                                    >
                                        {{ 'mes_biens.caracteristiques.surface.label'|trans }}
                                    </label>

                                    {{ form_widget(form.surfaceTotal, {
                                        attr: {
                                            class: 'form-control input mb-32',
                                            placeholder: 'mes_biens.caracteristiques.surface.placeholder'|trans,
                                            'data-mes-biens-required-field': 'true',
                                        },
                                    }) }}

                                    {{ form_errors(form.surfaceTotal) }}
                                </div>

                                {# ANNEE #}
                                <div>
                                    <label
                                        for="{{ form.anneeConstruction.vars.id }}"
                                        class="mb-16 p-accent"
                                    >
                                        {{ 'mes_biens.caracteristiques.annee.label'|trans }} <span>{{ 'mes_biens.optional'|trans }}</span>
                                    </label>

                                    {{ form_widget(form.anneeConstruction, {
                                        attr: {
                                            class: 'form-control input mb-48',
                                            placeholder: 'mes_biens.caracteristiques.annee.placeholder'|trans,
                                        },
                                    }) }}

                                    {{ form_errors(form.anneeConstruction) }}
                                </div>

                                {# CARACTERISTIQUES #}
                                <h3 class="mb-32">
                                    {{ 'mes_biens.caracteristiques.caracteristiques'|trans }}
                                </h3>

                                <div
                                    class="row"
                                    data-controller="mes-biens--caracteristiques"
                                >
                                    {% for choice in form.caracteristique.vars.choices %}
                                        {% set isChecked = choice.value in form.caracteristique.vars.value|default([]) %}

                                        <div class="col-4 mb-21">
                                            <label
                                                class="type-bien px-24 py-24 w-100 js-property-feature-card {% if isChecked %}active{% endif %}"
                                                for="property_feature_{{ loop.index0 }}"
                                                data-mes-biens--caracteristiques-target="item"
                                            >
                                                <input
                                                    type="checkbox"
                                                    id="property_feature_{{ loop.index0 }}"
                                                    name="{{ form.caracteristique.vars.full_name }}[]"
                                                    value="{{ choice.value }}"
                                                    class="d-none js-property-feature-input"
                                                    data-mes-biens--caracteristiques-target="input"
                                                    data-action="change->mes-biens--caracteristiques#toggle"
                                                    {% if isChecked %}checked="checked"{% endif %}
                                                >

                                                <div>
                                                    <div>
                                                        <i class="{{ choice.attr.icon }} mb-12"></i>
                                                    </div>

                                                    <div>
                                                        <span class="p-accent">
                                                            {{ choice.label }}
                                                        </span>
                                                    </div>
                                                </div>
                                            </label>
                                        </div>
                                    {% endfor %}

                                    {% if form.caracteristique.vars.errors|length > 0 %}
                                        <div class="col-12 mt-2">
                                            <div class="invalid-feedback d-block">
                                                {% for error in form.caracteristique.vars.errors %}
                                                    <div>
                                                        {{ error.message }}
                                                    </div>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    {% endif %}

                                    {% do form.caracteristique.setRendered %}
                                </div>

                                {% do form.chambres.setRendered %}
                                {% do form.salleDeBains.setRendered %}
                                {% do form.surfaceTotal.setRendered %}
                                {% do form.anneeConstruction.setRendered %}

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
