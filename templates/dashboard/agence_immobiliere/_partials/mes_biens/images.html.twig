<div class="js-tab-content mes-biens-immobilier formulaire" id="cat6">
    <div class="d-flex justify-content-between align-items-end">
        <h1>
            Téléchargez quelques photos de votre bien
        </h1>

        <div class="d-flex align-items-end">
            <button type="submit" class="btn-retour py-10 px-16">
                Enregistrer
            </button>
        </div>
    </div>

    <div class="mt-48 mb-24">
        <div class="attention-photos-images py-22 px-22">
            <span>Attention :</span> Les annonces comprenant moins de 5 images sont généralement moins attrayantes pour les particuliers et, de ce fait, moins mises en avant par Boolts. Nous vous recommandons d’ajouter au moins 5 images.
        </div>
    </div>

    {% set existingImagesCount = form.propertyImages|length %}
    {% set emptyCardsCount = existingImagesCount < 5 ? 5 - existingImagesCount : 0 %}

    <div
        class="property-upload-grid"
        id="property-images-collection"
        data-prototype="{{ form_widget(form.propertyImages.vars.prototype)|e('html_attr') }}"
        data-index="{{ form.propertyImages|length }}"
    >
        {# Images déjà enregistrées en BDD #}
        {% for propertyImageForm in form.propertyImages %}
            {% set image = propertyImageForm.vars.data %}

            <div
                class="property-preview-card is-filled"
                data-position="{{ loop.index }}"
                draggable="true"
            >
                {% if image %}
                    <img src="{{ vich_uploader_asset(image, 'imageFile') }}" alt="Photo du bien">
                {% endif %}

                <div class="property-image-actions">
                    <button
                        type="button"
                        class="property-image-actions-button js-property-image-actions-button"
                        aria-label="Actions de l'image"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <path d="M12 13C12.5523 13 13 12.5523 13 12C13 11.4477 12.5523 11 12 11C11.4477 11 11 11.4477 11 12C11 12.5523 11.4477 13 12 13Z" stroke="#5D00FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M19 13C19.5523 13 20 12.5523 20 12C20 11.4477 19.5523 11 19 11C18.4477 11 18 11.4477 18 12C18 12.5523 18.4477 13 19 13Z" stroke="#5D00FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M5 13C5.55228 13 6 12.5523 6 12C6 11.4477 5.55228 11 5 11C4.44772 11 4 11.4477 4 12C4 12.5523 4.44772 13 5 13Z" stroke="#5D00FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>

                    <div class="property-image-actions-menu d-none">
                        <button type="button" data-image-action="cover">
                            Définir comme couverture
                        </button>

                        <button type="button" data-image-action="backward">
                            Déplacer vers l’arrière
                        </button>

                        <button type="button" data-image-action="forward">
                            Déplacer vers l’avant
                        </button>

                        <button type="button" data-image-action="delete">
                            Supprimer
                        </button>
                    </div>
                </div>

                <div class="d-none">
                    {{ form_widget(propertyImageForm.imageFile, {
                        attr: {
                            class: 'd-none'
                        }
                    }) }}

                    {{ form_widget(propertyImageForm.position, {
                        attr: {
                            class: 'js-image-position'
                        }
                    }) }}
                </div>
            </div>
        {% endfor %}

        {# Les 5 premières cards vides : uniquement SVG, mais cliquables #}
        {% if emptyCardsCount > 0 %}
            {% for i in 1..emptyCardsCount %}
                {% set position = existingImagesCount + i %}

                <div
                    class="property-preview-card is-empty js-property-empty-card"
                    data-position="{{ position }}"
                >
                    <div class="property-empty-content">
                        <svg xmlns="http://www.w3.org/2000/svg" width="29" height="24" viewBox="0 0 29 24" fill="none">
                            <path d="M21 15L17.914 11.914C17.5389 11.5391 17.0303 11.3284 16.5 11.3284C15.9697 11.3284 15.4611 11.5391 15.086 11.914L6 21M5 3H19C20.1046 3 21 3.89543 21 5V19C21 20.1046 20.1046 21 19 21H5C3.89543 21 3 20.1046 3 19V5C3 3.89543 3.89543 5 5 3ZM11 9C11 10.1046 10.1046 11 9 11C7.89543 11 7 10.1046 7 9C7 7.89543 7.89543 7 9 7C10.1046 7 11 7.89543 11 9Z" stroke="#858789" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                </div>
            {% endfor %}
        {% endif %}

        {# 6e card : uniquement Parcourir #}
        <div
            class="property-preview-card property-browse-card"
            id="property-browse-card"
        >
            <button
                type="button"
                class="property-browse-button"
                id="property-browse-button"
            >
                Parcourir
            </button>
        </div>
    </div>

    {% do form.propertyImages.setRendered %}

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const maxImages = 50;
            const minimumVisibleCards = 5;

            const collection = document.getElementById('property-images-collection');
            const browseCard = document.getElementById('property-browse-card');
            const browseButton = document.getElementById('property-browse-button');

            if (!collection || !browseCard || !browseButton) {
                return;
            }

            let draggedCard = null;
            let dragGhost = null;

            const imageActionsHtml = `
                <div class="property-image-actions">
                    <button
                        type="button"
                        class="property-image-actions-button js-property-image-actions-button"
                        aria-label="Actions de l'image"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <path d="M12 13C12.5523 13 13 12.5523 13 12C13 11.4477 12.5523 11 12 11C11.4477 11 11 11.4477 11 12C11 12.5523 11.4477 13 12 13Z" stroke="#5D00FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M19 13C19.5523 13 20 12.5523 20 12C20 11.4477 19.5523 11 19 11C18.4477 11 18 11.4477 18 12C18 12.5523 18.4477 13 19 13Z" stroke="#5D00FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M5 13C5.55228 13 6 12.5523 6 12C6 11.4477 5.55228 11 5 11C4.44772 11 4 11.4477 4 12C4 12.5523 4.44772 13 5 13Z" stroke="#5D00FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>

                    <div class="property-image-actions-menu d-none">
                        <button type="button" data-image-action="cover">
                            Définir comme couverture
                        </button>

                        <button type="button" data-image-action="backward">
                            Déplacer vers l’arrière
                        </button>

                        <button type="button" data-image-action="forward">
                            Déplacer vers l’avant
                        </button>

                        <button type="button" data-image-action="delete">
                            Supprimer
                        </button>
                    </div>
                </div>
            `;

            const emptyCardHtml = `
                <div class="property-empty-content">
                    <svg xmlns="http://www.w3.org/2000/svg" width="29" height="24" viewBox="0 0 29 24" fill="none">
                        <path d="M21 15L17.914 11.914C17.5389 11.5391 17.0303 11.3284 16.5 11.3284C15.9697 11.3284 15.4611 11.5391 15.086 11.914L6 21M5 3H19C20.1046 3 21 3.89543 21 5V19C21 20.1046 20.1046 21 19 21H5C3.89543 21 3 20.1046 3 19V5C3 3.89543 3.89543 5 5 3ZM11 9C11 10.1046 10.1046 11 9 11C7.89543 11 7 10.1046 7 9C7 7.89543 7.89543 7 9 7C10.1046 7 11 7.89543 11 9Z" stroke="#858789" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
            `;

            function getPreviewCards() {
                return Array.from(collection.querySelectorAll('.property-preview-card')).filter(function (card) {
                    return !card.classList.contains('property-browse-card');
                });
            }

            function getFilledCards() {
                return getPreviewCards().filter(function (card) {
                    return card.classList.contains('is-filled');
                });
            }

            function getEmptyCards() {
                return getPreviewCards().filter(function (card) {
                    return card.classList.contains('is-empty');
                });
            }

            function closeAllMenus() {
                collection.querySelectorAll('.property-image-actions-menu').forEach(function (menu) {
                    menu.classList.add('d-none');
                });

                collection.querySelectorAll('.property-preview-card').forEach(function (card) {
                    card.classList.remove('is-menu-open');
                });
            }

            function getNextIndex() {
                return parseInt(collection.dataset.index || '0', 10);
            }

            function setNextIndex(index) {
                collection.dataset.index = String(index);
            }

            function updatePositions() {
                getPreviewCards().forEach(function (card, index) {
                    const position = index + 1;

                    card.dataset.position = position;

                    const positionInput = card.querySelector('.js-image-position')
                        || card.querySelector('input[name$="[position]"]');

                    if (positionInput) {
                        positionInput.classList.add('js-image-position');
                        positionInput.value = position;
                    }
                });

                getFilledCards().forEach(function (card, index) {
                    card.classList.toggle('is-cover', index === 0);
                });
            }

            function normalizeGrid() {
                getFilledCards().forEach(function (card) {
                    collection.insertBefore(card, browseCard);
                });

                getEmptyCards().forEach(function (card) {
                    collection.insertBefore(card, browseCard);
                });

                collection.appendChild(browseCard);

                updatePositions();
            }

            function createEmptyCard() {
                const card = document.createElement('div');

                card.className = 'property-preview-card is-empty js-property-empty-card';
                card.dataset.position = getPreviewCards().length + 1;
                card.innerHTML = emptyCardHtml;

                collection.insertBefore(card, browseCard);

                enableEmptyCard(card);
                updatePositions();

                return card;
            }

            function ensureMinimumCards() {
                const totalCards = getPreviewCards().length;

                if (totalCards >= minimumVisibleCards) {
                    return;
                }

                for (let i = totalCards; i < minimumVisibleCards; i++) {
                    createEmptyCard();
                }

                updatePositions();
            }

            function ensureOneEmptyCardIfPossible() {
                if (getPreviewCards().length >= maxImages) {
                    return;
                }

                if (getEmptyCards().length > 0) {
                    return;
                }

                createEmptyCard();
            }

            function createPrototypeWrapper() {
                const index = getNextIndex();
                const prototype = collection.dataset.prototype.replace(/__name__/g, index);

                const wrapper = document.createElement('div');

                wrapper.classList.add('d-none');
                wrapper.innerHTML = prototype;

                const fileInput = wrapper.querySelector('input[type="file"]');

                if (!fileInput) {
                    return null;
                }

                fileInput.classList.add('d-none');
                fileInput.setAttribute('accept', 'image/*');

                const positionInput = wrapper.querySelector('.js-image-position')
                    || wrapper.querySelector('input[name$="[position]"]');

                if (positionInput) {
                    positionInput.classList.add('js-image-position');
                }

                setNextIndex(index + 1);

                return {
                    wrapper: wrapper,
                    fileInput: fileInput,
                    positionInput: positionInput,
                };
            }

            function setInputFile(fileInput, file) {
                const dataTransfer = new DataTransfer();

                dataTransfer.items.add(file);
                fileInput.files = dataTransfer.files;
            }

            function isImageFile(file) {
                return file && file.type && file.type.startsWith('image/');
            }

            function fillCardWithFile(card, file, wrapper) {
                if (!card || !file || !wrapper) {
                    return;
                }

                if (!isImageFile(file)) {
                    return;
                }

                const reader = new FileReader();

                reader.onload = function (event) {
                    card.classList.remove('is-empty');
                    card.classList.add('is-filled');
                    card.setAttribute('draggable', 'true');

                    card.innerHTML = `
                        <img src="${event.target.result}" alt="Photo du bien">
                        ${imageActionsHtml}
                    `;

                    card.appendChild(wrapper);

                    const positionInput = card.querySelector('.js-image-position')
                        || card.querySelector('input[name$="[position]"]');

                    if (positionInput) {
                        positionInput.classList.add('js-image-position');
                        positionInput.value = card.dataset.position;
                    }

                    enableFilledCard(card);

                    normalizeGrid();
                    ensureMinimumCards();
                    ensureOneEmptyCardIfPossible();
                };

                reader.readAsDataURL(file);
            }

            function openFileInputForCard(card) {
                if (!card || !card.classList.contains('is-empty')) {
                    return;
                }

                const prototypeData = createPrototypeWrapper();

                if (!prototypeData) {
                    return;
                }

                prototypeData.fileInput.addEventListener('change', function () {
                    const file = prototypeData.fileInput.files[0];

                    if (!file) {
                        return;
                    }

                    fillCardWithFile(card, file, prototypeData.wrapper);
                });

                prototypeData.fileInput.click();
            }

            function openFileInputFromBrowseCard() {
                const card = getEmptyCards()[0] || createEmptyCard();

                openFileInputForCard(card);
            }

            function handleDroppedFiles(files, targetCard) {
                const validFiles = Array.from(files).filter(isImageFile);

                if (validFiles.length === 0) {
                    return;
                }

                validFiles.forEach(function (file, index) {
                    let card = null;

                    if (index === 0 && targetCard && targetCard.classList.contains('is-empty')) {
                        card = targetCard;
                    } else {
                        card = getEmptyCards()[0] || createEmptyCard();
                    }

                    if (!card) {
                        return;
                    }

                    const prototypeData = createPrototypeWrapper();

                    if (!prototypeData) {
                        return;
                    }

                    setInputFile(prototypeData.fileInput, file);

                    fillCardWithFile(card, file, prototypeData.wrapper);
                });
            }

            function moveCardToCover(card) {
                const firstFilledCard = getFilledCards()[0];

                if (firstFilledCard && firstFilledCard !== card) {
                    collection.insertBefore(card, firstFilledCard);
                }

                normalizeGrid();
            }

            function moveCardBackward(card) {
                const filledCards = getFilledCards();
                const currentIndex = filledCards.indexOf(card);
                const previousCard = filledCards[currentIndex - 1];

                if (!previousCard) {
                    return;
                }

                collection.insertBefore(card, previousCard);
                normalizeGrid();
            }

            function moveCardForward(card) {
                const filledCards = getFilledCards();
                const currentIndex = filledCards.indexOf(card);
                const nextCard = filledCards[currentIndex + 1];

                if (!nextCard) {
                    return;
                }

                collection.insertBefore(card, nextCard.nextSibling);
                normalizeGrid();
            }

            function deleteCard(card) {
                card.remove();

                ensureMinimumCards();
                ensureOneEmptyCardIfPossible();
                normalizeGrid();
            }

            function bindActions(card) {
                if (card.dataset.actionsEnabled === '1') {
                    return;
                }

                card.dataset.actionsEnabled = '1';

                const actionsButton = card.querySelector('.js-property-image-actions-button');
                const actionsMenu = card.querySelector('.property-image-actions-menu');

                if (!actionsButton || !actionsMenu) {
                    return;
                }

                actionsButton.addEventListener('click', function (event) {
                    event.preventDefault();
                    event.stopPropagation();

                    const isOpen = !actionsMenu.classList.contains('d-none');

                    closeAllMenus();

                    if (!isOpen) {
                        card.classList.add('is-menu-open');
                        actionsMenu.classList.remove('d-none');
                    }
                });

                actionsMenu.addEventListener('click', function (event) {
                    event.preventDefault();
                    event.stopPropagation();

                    const button = event.target.closest('[data-image-action]');

                    if (!button) {
                        return;
                    }

                    const action = button.dataset.imageAction;

                    if (action === 'cover') {
                        moveCardToCover(card);
                    }

                    if (action === 'backward') {
                        moveCardBackward(card);
                    }

                    if (action === 'forward') {
                        moveCardForward(card);
                    }

                    if (action === 'delete') {
                        deleteCard(card);
                    }

                    closeAllMenus();
                });
            }

            function createDragGhost(card, event) {
                removeDragGhost();

                dragGhost = card.cloneNode(true);

                const rectangle = card.getBoundingClientRect();

                dragGhost.classList.add('property-preview-card-drag-ghost');
                dragGhost.style.width = `${rectangle.width}px`;
                dragGhost.style.height = `${rectangle.height}px`;

                document.body.appendChild(dragGhost);

                const offsetX = event.clientX - rectangle.left;
                const offsetY = event.clientY - rectangle.top;

                if (event.dataTransfer) {
                    event.dataTransfer.setDragImage(dragGhost, offsetX, offsetY);
                }
            }

            function removeDragGhost() {
                if (dragGhost) {
                    dragGhost.remove();
                    dragGhost = null;
                }
            }

            function enableFilledCard(card) {
                bindActions(card);
                enableFilledCardDragAndDrop(card);
            }

            function enableFilledCardDragAndDrop(card) {
                if (!card.classList.contains('is-filled')) {
                    return;
                }

                if (card.dataset.dragEnabled === '1') {
                    return;
                }

                card.dataset.dragEnabled = '1';
                card.setAttribute('draggable', 'true');

                card.addEventListener('dragstart', function (event) {
                    if (event.target.closest('.property-image-actions')) {
                        event.preventDefault();
                        return;
                    }

                    draggedCard = card;

                    closeAllMenus();
                    createDragGhost(card, event);

                    card.classList.add('is-dragging');

                    if (event.dataTransfer) {
                        event.dataTransfer.effectAllowed = 'move';
                    }
                });

                card.addEventListener('dragend', function () {
                    draggedCard = null;

                    card.classList.remove('is-dragging');

                    removeDragGhost();
                    normalizeGrid();
                });

                card.addEventListener('dragover', function (event) {
                    if (!draggedCard || draggedCard === card) {
                        return;
                    }

                    event.preventDefault();

                    const rectangle = card.getBoundingClientRect();
                    const middle = rectangle.height / 2;
                    const mousePosition = event.clientY - rectangle.top;

                    if (mousePosition > middle) {
                        collection.insertBefore(draggedCard, card.nextSibling);
                    } else {
                        collection.insertBefore(draggedCard, card);
                    }

                    updatePositions();
                });

                card.addEventListener('drop', function (event) {
                    if (!draggedCard) {
                        return;
                    }

                    event.preventDefault();
                    normalizeGrid();
                });
            }

            function enableEmptyCard(card) {
                if (!card.classList.contains('is-empty')) {
                    return;
                }

                if (card.dataset.emptyEnabled === '1') {
                    return;
                }

                card.dataset.emptyEnabled = '1';

                card.addEventListener('click', function () {
                    openFileInputForCard(card);
                });

                card.addEventListener('dragenter', function (event) {
                    event.preventDefault();

                    if (draggedCard) {
                        return;
                    }

                    card.classList.add('is-drag-over');
                });

                card.addEventListener('dragover', function (event) {
                    if (draggedCard) {
                        return;
                    }

                    event.preventDefault();

                    if (event.dataTransfer) {
                        event.dataTransfer.dropEffect = 'copy';
                    }

                    card.classList.add('is-drag-over');
                });

                card.addEventListener('dragleave', function () {
                    card.classList.remove('is-drag-over');
                });

                card.addEventListener('drop', function (event) {
                    if (draggedCard) {
                        return;
                    }

                    event.preventDefault();
                    event.stopPropagation();

                    card.classList.remove('is-drag-over');

                    if (!event.dataTransfer || !event.dataTransfer.files) {
                        return;
                    }

                    handleDroppedFiles(event.dataTransfer.files, card);
                });
            }

            function enableAllCards() {
                getFilledCards().forEach(function (card) {
                    enableFilledCard(card);
                });

                getEmptyCards().forEach(function (card) {
                    enableEmptyCard(card);
                });
            }

            browseButton.addEventListener('click', function () {
                openFileInputFromBrowseCard();
            });

            browseCard.addEventListener('dragover', function (event) {
                event.preventDefault();

                if (event.dataTransfer) {
                    event.dataTransfer.dropEffect = 'copy';
                }
            });

            browseCard.addEventListener('drop', function (event) {
                event.preventDefault();

                if (!event.dataTransfer || !event.dataTransfer.files) {
                    return;
                }

                const targetCard = getEmptyCards()[0] || createEmptyCard();

                handleDroppedFiles(event.dataTransfer.files, targetCard);
            });

            document.addEventListener('click', function () {
                closeAllMenus();
            });

            enableAllCards();
            ensureMinimumCards();
            ensureOneEmptyCardIfPossible();
            normalizeGrid();
        });
    </script>

    <style>
        .property-upload-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 8px;
            overflow: visible;
        }

        .property-preview-card,
        .property-upload-card {
            position: relative;
            height: 197px;
            background: #f1f1f1;
            border-radius: 12px;
            overflow: visible;
        }

        .property-preview-card {
            position: relative;
            overflow: visible;
            z-index: 1;
        }

        .property-preview-card.is-menu-open {
            z-index: 3000;
        }

        .property-preview-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            border-radius: 12px;
        }

        .property-upload-card {
            cursor: pointer;
        }

        .property-upload-input {
            position: absolute;
            inset: 0;
            opacity: 0;
            cursor: pointer;
            z-index: 2;
        }

        .property-hidden-input {
            display: none;
        }

        .property-upload-placeholder {
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            color: #777;
        }

        .property-upload-placeholder span {
            font-size: 18px;
        }

        .property-upload-placeholder strong {
            margin-top: 6px;
            padding: 4px 14px;
            border: 1px solid #5D00FF;
            border-radius: 20px;
            color: #5D00FF;
            font-size: 11px;
        }

        .property-image-position {
            position: absolute;
            top: 8px;
            left: 8px;
            background: #5D00FF;
            color: #fff;
            border-radius: 20px;
            padding: 3px 10px;
            font-size: 11px;
        }

        .navigation-fixed {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            z-index: 9999;
            display: flex;
            justify-content: end;
            align-items: center;
            border-top: 1px solid #EBECEC;
            background: #FFF;
            box-shadow: 0 -4px 20px 0 rgba(0, 0, 0, 0.07);
            padding-right: 108px;
        }

        .navigation-fixed .is-last-page {
            border-radius: 50px;
            border: 2px solid #EBECEC;
            background: #FFF;
            color: #858789;
            font-size: 16px;
            font-style: normal;
            font-weight: 700;
            line-height: 20px;
        }

        .property-preview-card.is-empty {
            cursor: pointer;
        }

        .property-preview-card.is-empty.is-drag-over {
            border-color: #5D00FF;
            background: #F4F0FF;
        }

        .property-empty-content {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 100%;
            transform: translate(-50%, -50%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #858789;
        }

        .property-browse-card {
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        .property-browse-button {
            border: 0;
            background: transparent;
            color: #5D00FF;
            font-weight: 700;
            padding: 0;
            cursor: pointer;
        }

        .property-image-actions {
            position: absolute;
            top: 8px;
            right: 8px;
            z-index: 3500;
        }

        .property-image-actions-button {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #FFFFFF;
            display: flex;
            align-items: center;
