{#
 Template: templates/dashboard/agence_immobiliere/_partials/mes_biens/_partials/navbar.html.twig
 Role: Renders the dashboard/agence_immobiliere/_partials/mes_biens/_partials Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

{% set paysCode = form.vars.data.pays ?? null %}
{% set paysNormalized = paysCode is not empty ? paysCode|trim|lower : '' %}

{#
    Priorité à la valeur calculée par le contrôleur.
    Le fallback permet aussi de reconnaître "France" ou "FR"
    directement depuis le formulaire.
#}
{% set showBilanEnergetique = showBilanEnergetique|default(
    paysNormalized in ['fr', 'france'],
) %}

{# Étape réellement affichée à l'écran. #}
{% set visualStep = step %}

{# Étape maximale déjà atteinte, utilisée uniquement pour rendre les liens cliquables. #}
{% set reachedStep = stepperStep|default(step) %}

{% set steps = [
    {
        step: 1,
        tab: 'cat1',
        title: 'mes_biens.stepper.type_bien'|trans,
    },
    {
        step: 2,
        tab: 'cat2',
        title: 'mes_biens.stepper.type_transaction'|trans,
    },
    {
        step: 3,
        tab: 'cat3',
        title: 'mes_biens.stepper.adresse'|trans,
    },
    {
        step: 4,
        tab: 'cat4',
        title: 'mes_biens.stepper.caracteristiques'|trans,
    },
] %}

{# L'étape 5 est affichée uniquement si l'adresse est en France. #}
{% if showBilanEnergetique %}
    {% set steps = steps|merge([
        {
            step: 5,
            tab: 'cat5',
            title: 'mes_biens.stepper.bilan_energetique'|trans,
        },
    ]) %}
{% endif %}

{% set steps = steps|merge([
    {
        step: 6,
        tab: 'cat6',
        title: 'mes_biens.stepper.photos'|trans,
    },
    {
        step: 7,
        tab: 'cat7',
        title: 'mes_biens.stepper.description'|trans,
    },
    {
        step: 8,
        tab: 'cat8',
        title: 'mes_biens.stepper.prix'|trans,
    },
]) %}

{#
    Position visuelle dans le stepper.
    Si l'étape énergétique est masquée, les étapes 6/7/8
    remontent d'une position visuelle.
#}
{% if visualStep <= 4 %}
    {% set activePosition = visualStep %}
{% elseif visualStep == 5 %}
    {% set activePosition = showBilanEnergetique ? 5 : 4 %}
{% else %}
    {% set activePosition = showBilanEnergetique ? visualStep : visualStep - 1 %}
{% endif %}

{#
    Étapes effectuées : indépendantes de l'étape affichée.
    Une étape est effectuée dès qu'elle a été validée, c'est-à-dire
    lorsque l'étape maximale atteinte la dépasse. Revenir en arrière
    ne modifie donc pas cet état.
    Une étape enregistrée lors d'un retour en arrière (savedSteps) est
    également effectuée.
    L'étape 8 n'est jamais dépassée (la session est vidée à sa validation) :
    elle est considérée effectuée si un prix ou un loyer est déjà enregistré
    (modification d'une annonce existante).
#}
{% set propertyData = form.vars.data ?? null %}
{% set hasSavedPrice = propertyData is not null
    and (propertyData.prix is not null or propertyData.montantLoyerHorsCharge is not null)
%}

{% set completedSteps = [] %}
{% set lastCompletedPosition = 0 %}
{% for item in steps %}
    {% if item.step < reachedStep
        or item.step in savedSteps|default([])
        or (item.step == 8 and hasSavedPrice)
    %}
        {% set completedSteps = completedSteps|merge([item.step]) %}
        {% set lastCompletedPosition = loop.index %}
    {% endif %}
{% endfor %}

{# La ligne de progression couvre l'étape active et toutes les étapes effectuées. #}
{% set progressPosition = max(activePosition, lastCompletedPosition) %}

{% set totalSteps = steps|length %}
{% set progressPercent = totalSteps > 1
    ? ((progressPosition - 1) / (totalSteps - 1) * 99)
    : 0
%}

<div
    class="mes-bien-stepper"
    style="--stepper-progress: {{ progressPercent }}%;"
>
    <div class="mes-bien-stepper-line-background"></div>

    <div
        class="mes-bien-stepper-line"
        style="height: {{ progressPercent }}%;"
    ></div>

    {% for item in steps %}
        {% set isCurrentDisplayedStep = item.step == step %}
        {% set isVisualActive = item.step == visualStep %}
        {# L'état actif prime visuellement : l'étape affichée garde son style actif. #}
        {% set isCompleted = item.step in completedSteps and not isVisualActive %}
        {% set isClickable = item.step <= reachedStep or isCurrentDisplayedStep %}

        {% set routeParams = {
            step: item.step,
        } %}

        {# Conserve toujours l'ID réel et dynamique de la transaction dans l'URL. #}
        {% if typeTransactionId is defined and typeTransactionId %}
            {% set routeParams = routeParams|merge({
                typeTransaction: typeTransactionId,
            }) %}
        {% endif %}

        {% if isClickable %}
            <a
                href="{{ path('agence_immobiliere_mes_biens', routeParams) }}"
                class="
                    mes-bien-stepper-item
                    js-stepper-link
                    {% if isCompleted %}mes-bien-stepper-item-completed{% endif %}
                    {% if isCurrentDisplayedStep %}active{% endif %}
                    {% if isVisualActive %}mes-bien-stepper-item-active{% endif %}
                "
                data-tab="{{ item.tab }}"
                {# Étape précédente : les données de la page sont enregistrées avant le retour. #}
                {% if item.step < step %}data-mes-biens-back-step="{{ item.step }}"{% endif %}
                title="{{ 'mes_biens.stepper.go_to_step'|trans({'%step%': item.title}) }}"
            >
                <div class="mes-bien-stepper-circle"></div>

                <div class="mes-bien-stepper-content">
                    <p class="mes-bien-stepper-title p-accent">
                        {{ item.title }} <i class="icon-chevron-right"></i>
                    </p>
                </div>
            </a>
        {% else %}
            <div
                class="
                    mes-bien-stepper-item
                    mes-bien-stepper-item-disabled
                "
                data-tab="{{ item.tab }}"
            >
                <div class="mes-bien-stepper-circle"></div>

                <div class="mes-bien-stepper-content">
                    <p class="mes-bien-stepper-title p-accent">
                        {{ item.title }}
                    </p>
                </div>
            </div>
        {% endif %}
    {% endfor %}
</div>
