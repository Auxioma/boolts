{% set paysCode = form.vars.data.pays ?? null %}

{% set showBilanEnergetique = paysCode is empty or paysCode == 'FR' %}

{% set visualStep = stepperStep|default(step) %}

{% set steps = [
    {
        step: 1,
        tab: 'cat1',
        title: 'Type de bien',
    },
    {
        step: 2,
        tab: 'cat2',
        title: 'Type de transaction',
    },
    {
        step: 3,
        tab: 'cat3',
        title: 'Adresse',
    },
    {
        step: 4,
        tab: 'cat4',
        title: 'Caractéristiques',
    },
] %}

{% if showBilanEnergetique %}
    {% set steps = steps|merge([
        {
            step: 5,
            tab: 'cat5',
            title: 'Bilan énergétique',
        },
    ]) %}
{% endif %}

{% set steps = steps|merge([
    {
        step: 6,
        tab: 'cat6',
        title: 'Photos',
    },
    {
        step: 7,
        tab: 'cat7',
        title: 'Description',
    },
    {
        step: 8,
        tab: 'cat8',
        title: 'Prix',
    },
]) %}

{% if visualStep <= 4 %}
    {% set activePosition = visualStep %}
{% elseif visualStep == 5 %}
    {% set activePosition = showBilanEnergetique ? 5 : 4 %}
{% else %}
    {% set activePosition = showBilanEnergetique ? visualStep : visualStep - 1 %}
{% endif %}

{% set totalSteps = steps|length %}
{% set progressPercent = totalSteps > 1 ? ((activePosition - 1) / (totalSteps - 1) * 100) : 0 %}

<div
    class="mes-bien-stepper"
    style="--stepper-progress: {{ progressPercent }}%;"
>
    <div class="mes-bien-stepper-line-background"></div>

    <div
        class="mes-bien-stepper-line"
        style="height: {{ progressPercent }}%;"
    ></div>

    {% for item in steps %}
        {% set isCurrentDisplayedStep = item.step == step %}
        {% set isVisualActive = item.step == visualStep %}
        {% set isCompleted = item.step < visualStep %}
        {% set isClickable = isCompleted or isCurrentDisplayedStep or isVisualActive %}

        {% if isClickable %}
            <a
                href="{{ path('agence_immobiliere_mes_biens', {step: item.step}) }}"
                class="
                    mes-bien-stepper-item
                    js-stepper-link
                    {% if isCompleted %}mes-bien-stepper-item-completed{% endif %}
                    {% if isCurrentDisplayedStep %}active{% endif %}
                    {% if isVisualActive %}mes-bien-stepper-item-active{% endif %}
                "
                data-tab="{{ item.tab }}"
                title="Aller à l’étape {{ item.title }}"
            >
                <div class="mes-bien-stepper-circle"></div>

                <div class="mes-bien-stepper-content">
                    <p class="mes-bien-stepper-title">
                        {{ item.title }}
                    </p>
                </div>
            </a>
        {% else %}
            <div
                class="
                    mes-bien-stepper-item
                    mes-bien-stepper-item-disabled
                "
                data-tab="{{ item.tab }}"
            >
                <div class="mes-bien-stepper-circle"></div>

                <div class="mes-bien-stepper-content">
                    <p class="mes-bien-stepper-title">
                        {{ item.title }}
                    </p>
                </div>
            </div>
        {% endif %}
    {% endfor %}
</div>
