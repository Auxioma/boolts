{#
 Template: templates/dashboard/agence_immobiliere/_partials/mes_biens/_partials/location.html.twig
 Role: Renders the dashboard/agence_immobiliere/_partials/mes_biens/_partials Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

<div
    class="row"
    data-controller="mes-biens--loyer"
>
    <div class="col-6">
        <div>
            <label
                for="{{ form.montantLoyerHorsCharge.vars.id }}"
                class="mb-16 p-accent"
            >
                {{ 'mes_biens.prix.loyer.label'|trans }}
            </label>

            {{ form_widget(form.montantLoyerHorsCharge, {
                attr: {
                    class: 'form-control input mb-32',
                    placeholder: 'mes_biens.prix.per_month'|trans,
                    'data-mes-biens-required-field': 'true',
                    'data-mes-biens--loyer-target': 'loyerHorsCharge',
                    'data-action': 'input->mes-biens--loyer#calculate change->mes-biens--loyer#calculate',
                },
            }) }}

            {{ form_errors(form.montantLoyerHorsCharge) }}
        </div>
    </div>

    <div class="col-6">
        <div>
            <label
                for="{{ form.montantDesCharges.vars.id }}"
                class="mb-16 p-accent"
            >
                {{ 'mes_biens.prix.charges.label'|trans }}
            </label>

            {{ form_widget(form.montantDesCharges, {
                attr: {
                    class: 'form-control input mb-32',
                    placeholder: 'mes_biens.prix.per_month'|trans,
                    'data-mes-biens-required-field': 'true',
                    'data-mes-biens--loyer-target': 'charges',
                    'data-action': 'input->mes-biens--loyer#calculate change->mes-biens--loyer#calculate',
                },
            }) }}

            {{ form_errors(form.montantDesCharges) }}
        </div>
    </div>

    <div class="mb-32">
        <h3>
            {{ 'mes_biens.prix.loyer_affiche'|trans }}
            <span data-mes-biens--loyer-target="total">0</span>
            <span class="cc-mois">{{ 'mes_biens.prix.cc_mois'|trans }}</span>
        </h3>
    </div>

    <div>
        <label
            for="{{ form.montantDepotDeGarantie.vars.id }}"
            class="mb-16 p-accent"
        >
            {{ 'mes_biens.prix.depot.label'|trans }} <span>{{ 'mes_biens.optional'|trans }}</span>
        </label>

        {{ form_widget(form.montantDepotDeGarantie, {
            attr: {
                class: 'form-control input mb-32',
                placeholder: '€',
            },
        }) }}

        {{ form_errors(form.montantDepotDeGarantie) }}
    </div>
</div>
