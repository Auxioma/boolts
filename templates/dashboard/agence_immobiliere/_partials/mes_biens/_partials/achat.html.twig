<div class="col-12">
    <div>
        <label
            for="{{ form.prix.vars.id }}"
            class="mb-16 p-accent"
        >
            {{ 'mes_biens.prix.prix.label'|trans }}
        </label>

        <div class="input-group mes-biens-price-group mb-32">
            {{ form_widget(form.prix, {
                attr: {
                    class: 'form-control input',
                    'aria-describedby': form.prix.vars.id ~ '_devise',
                    'data-mes-biens-required-field': 'true',
                },
            }) }}

            <span class="input-group-text" id="{{ form.prix.vars.id }}_devise">{{ devise }}</span>
        </div>

        {{ form_errors(form.prix) }}
    </div>
</div>
