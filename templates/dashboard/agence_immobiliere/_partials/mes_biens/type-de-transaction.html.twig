{#
 Template: templates/dashboard/agence_immobiliere/_partials/mes_biens/type-de-transaction.html.twig
 Role: Renders the dashboard/agence_immobiliere/_partials/mes_biens Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

<div
    class="js-tab-content mes-biens-immobilier"
    id="cat2"
    data-controller="mes-biens--type-transaction"
>
    <div class="d-flex justify-content-between align-items-end">
        <h1>
            Quel est le type de transaction pour ce bien ?
        </h1>

        <div class="d-flex align-items-end">
            {{ form_widget(form.saveAndExit) }}
        </div>
    </div>

    <div class="mt-48">
        <div class="row">

            {% set totalChoices = form.typeTransaction.vars.choices|length %}
            {% set colClass = totalChoices == 2 ? 'col-6' : 'col-4' %}

            {% for choice in form.typeTransaction.vars.choices %}

                {% set inputId = form.typeTransaction.vars.id ~ '_' ~ loop.index0 %}
                {% set isChecked = form.typeTransaction.vars.value == choice.value %}

                <div class="{{ colClass }} mb-21">
                    <label
                        class="type-bien px-24 py-24 w-100 js-type-transaction-item {% if isChecked %}active{% endif %}"
                        for="{{ inputId }}"
                        data-mes-biens--type-transaction-target="item"
                    >
                        <input
                            type="radio"
                            id="{{ inputId }}"
                            name="{{ form.typeTransaction.vars.full_name }}"
                            value="{{ choice.value }}"
                            class="d-none js-type-transaction-input"
                            data-mes-biens--type-transaction-target="input"
                            data-action="change->mes-biens--type-transaction#select"
                            data-mes-biens-required-group="typeTransaction"
                            {% if isChecked %}checked="checked"{% endif %}
                        >

                        <div>
                            <div>
                                <i class="{{ choice.attr.icon }} mb-12"></i>
                            </div>

                            <div>
                                <span>
                                    {{ choice.label }}
                                </span>
                            </div>
                        </div>
                    </label>
                </div>

            {% endfor %}

            {% if form.typeTransaction.vars.errors|length > 0 %}
                <div class="col-12 mt-2">
                    <div class="invalid-feedback d-block">
                        {% for error in form.typeTransaction.vars.errors %}
                            <div>
                                {{ error.message }}
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            {% do form.typeTransaction.setRendered %}

        </div>
    </div>
</div>
