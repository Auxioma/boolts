<div class="js-tab-content mes-biens-immobilier" id="cat2">
    <div class="d-flex justify-content-between align-items-end">
        <h1>
            Quel est le type de transaction pour ce bien ?
        </h1>

        <div class="d-flex align-items-end">
            <a href="#" class="btn-retour py-10 px-16">
                Enregistrer
            </a>
        </div>
    </div>

    <div class="mt-48">
        <div class="row">
            <div class="col-12">
                <div class="row">
                    <div>
                        <div class="row">

                            {% set totalChoices = form.typeTransaction.vars.choices|length %}
                            {% set colClass = totalChoices == 2 ? 'col-6' : 'col-4' %}

                            {% for choice in form.typeTransaction.vars.choices %}
                                {% set isChecked = form.typeTransaction.vars.value == choice.value %}

                                <div class="{{ colClass }} mb-21">
                                    <label
                                        class="type-bien px-24 py-24 w-100 js-type-transaction-item {% if isChecked %}active{% endif %}"
                                        for="type_transaction_{{ loop.index0 }}"
                                    >
                                        <input
                                            type="radio"
                                            id="type_transaction_{{ loop.index0 }}"
                                            name="{{ form.typeTransaction.vars.full_name }}"
                                            value="{{ choice.value }}"
                                            class="d-none js-type-transaction-input"
                                            {% if isChecked %}checked{% endif %}
                                        >

                                        <div>
                                            <div>
                                                <i class="{{ choice.attr.icon }} mb-12"></i>
                                            </div>

                                            <div>
                                                <span>
                                                    {{ choice.label }}
                                                </span>
                                            </div>
                                        </div>
                                    </label>
                                </div>
                            {% endfor %}
                            {% do form.typeTransaction.setRendered %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
