{#
 Template: templates/dashboard/agence_immobiliere/_partials/mes_biens/description.html.twig
 Role: Renders the dashboard/agence_immobiliere/_partials/mes_biens Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

<div
    class="js-tab-content mes-biens-immobilier formulaire"
    id="cat7"
    data-controller="mes-biens--ai-description"
    data-mes-biens--ai-description-url-value="{{ path('agence_immobiliere_mes_biens_generate_description_ai') }}"
    data-mes-biens--ai-description-csrf-token-value="{{ csrf_token('generate_ai_description') }}"
>
    <div class="d-flex justify-content-between align-items-end">
        <h1>
            Saisissez la description de votre bien
        </h1>

        <div class="d-flex align-items-end">
            {{ form_widget(form.saveAndExit) }}
        </div>
    </div>

    <div class="mt-48 caracteristique-logements">
        <div class="row">
            <div class="col-12">

                <div>
                    <label
                        for="{{ form.titreDuLogement.vars.id }}"
                        class="mb-16"
                    >
                        Titre du logement <span>(facultatif)</span>
                    </label>

                    {{ form_widget(form.titreDuLogement, {
                        attr: {
                            class: 'form-control mb-32',
                            placeholder: 'Exemple : Logement spacieux et lumineux',
                            'data-mes-biens--ai-description-target': 'title',
                        },
                    }) }}

                    {{ form_errors(form.titreDuLogement) }}
                </div>

                <div>
                    <label
                        for="{{ form.descriptionLogement.vars.id }}"
                        class="mb-16"
                    >
                        Description du logement*
                    </label>

                    {{ form_widget(form.descriptionLogement, {
                        attr: {
                            class: 'form-control mb-26',
                            placeholder: 'Exemple : Logement spacieux et lumineux',
                            'data-mes-biens-required-field': 'true',
                            'data-mes-biens--ai-description-target': 'description',
                        },
                    }) }}

                    {{ form_errors(form.descriptionLogement) }}
                </div>

                <div>
                    <button
                        type="button" 
                        class="btn-suivant py-10 px-16"
                        data-mes-biens--ai-description-target="button"
                        data-action="click->mes-biens--ai-description#generate"
                    >
                        Générer avec IA
                    </button>
                </div>

                <div class="mt-32">
                    <label
                        for="{{ form.referenceInterne.vars.id }}"
                        class="mb-16"
                    >
                        Référence interne <span>(facultatif)</span>
                    </label>

                    {{ form_widget(form.referenceInterne, {
                        attr: {
                            class: 'form-control mb-26',
                            placeholder: 'Saisissez votre référence interne',
                        },
                    }) }}

                    {{ form_errors(form.referenceInterne) }}
                </div>

                {% do form.titreDuLogement.setRendered %}
                {% do form.descriptionLogement.setRendered %}
                {% do form.referenceInterne.setRendered %}

            </div>
        </div>
    </div>
</div>
