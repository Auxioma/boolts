<div class="js-tab-content d-none mes-biens-immobilier formulaire" id="cat5">
    <div class="d-flex justify-content-between align-items-end">
        <h1>
            Indiquez les résultats de votre diagnostic de performance énergétique (DPE)
        </h1>

        <div class="d-flex align-items-end">
            <a href="#" class="btn-retour py-10 px-16 mr-12">
                Enregistrer
            </a>
        </div>
    </div>

    <div class="mt-48 caracteristique-logements">
        <div class="row">
            <div class="col-12">
                <div>
                    <label class="mb-16">
                        Consommation en énergie primaire*
                    </label>

                    <div class="position-relative">
                        {{ form_widget(form.dpe, {
                            attr: {
                                class: 'form-control pe-120',
                                placeholder: '0'
                            }
                        }) }}

                        <span class="position-absolute top-50 end-0 translate-middle-y pr-16 text-muted">
                            kWhEP/m2/an
                        </span>
                    </div>
                </div>

                <div class="mt-32">
                    <div class="energy-scale">
                        {% for child in form.dpeLettre %}
                            <div class="energy-item energy-{{ child.vars.value|lower }} {% if child.vars.checked %}active{% endif %}">
                                {{ form_widget(child, {
                                    attr: {
                                        class: 'd-none'
                                    }
                                }) }}

                                {{ child.vars.label }}
                            </div>
                        {% endfor %}
                    </div>
                    <div class="d-flex justify-content-between mt-16">
                        <small class="">
                            Logement économe
                        </small>

                        <small class="">
                            Logement énergivore
                        </small>
                    </div>
                </div>


                <div class="mt-32">
                    <label class="mb-16">
                        Emissions de gaz à effet de serre*
                    </label>

                    <div class="position-relative">
                        {{ form_widget(form.ges, {
                            attr: {
                                class: 'form-control pe-120',
                                placeholder: '0'
                            }
                        }) }}

                        <span class="position-absolute top-50 end-0 translate-middle-y pr-16 text-muted">
                            kgCO2/m2/an
                        </span>
                    </div>
                </div>
                <div class="mt-32 mb-24">
                    <h2>Estimation des coûts d'énergie du logement</h2>
                </div>
                <div class="row mb-32">
                    <div class="col-6">
                        <div class="">
                            <label class="mb-16">
                                Minimum
                            </label>

                            <div class="position-relative">
                                {{ form_widget(form.dpeMin, {
                                    attr: {
                                        class: 'form-control pe-120',
                                        placeholder: ''
                                    }
                                }) }}

                                <span class="position-absolute top-50 end-0 translate-middle-y pr-16 text-muted">
                                   €/an
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="">
                            <label class="mb-16">
                                Maximum
                            </label>

                            <div class="position-relative">
                                {{ form_widget(form.dpeMax, {
                                    attr: {
                                        class: 'form-control pe-120',
                                        placeholder: ''
                                    }
                                }) }}

                                <span class="position-absolute top-50 end-0 translate-middle-y pr-16 text-muted">
                                   €/an
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-32">
                        <label class="mb-16">
                            Date d'indexation du prix des énergies
                        </label>

                        <div class="position-relative">
                            {{ form_widget(form.dateIndexationEnergie, {
                                attr: {
                                    class: 'form-control pe-120',
                                    placeholder: ''
                                }
                            }) }}

                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>
</div>

<style>
    .pe-120 {
        padding-right: 120px;
    }

    .energy-scale {
        width: 100%;
        height: 52px;
        border: 2px solid #E8E8E8;
        border-radius: 999px;
        display: flex;
        overflow: visible;
        background: #FFFFFF;
    }

    .energy-item {
        flex: 1;
        height: 100%;
        border-right: 1px solid #EEEEEE;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        font-weight: 700;
        position: relative;
        cursor: pointer;
        transition: .2s ease;
    }

    .energy-item:first-child {
        border-radius: 999px 0 0 999px;
    }

    .energy-item:last-child {
        border-right: none;
        border-radius: 0 999px 999px 0;
    }

    .energy-item:hover {
        background: #F5F5F5;
    }

    .energy-item.active {
        background: #5D00FF;
        color: #FFFFFF;
    }

    .energy-item.active:hover {
        background: #5D00FF;
    }

    .energy-a {
        color: #038748;
    }

    .energy-b {
        color: #5FAC2D;
    }

    .energy-c {
        color: #CADB0D;
    }

    .energy-d {
        color: #F6ED05;
    }

    .energy-e {
        color: #EBA900;
    }

    .energy-f {
        color: #E38102;
    }

    .energy-g {
        color: #D64302
    }

    .energy-item.active.energy-a,
    .energy-item.active.energy-b,
    .energy-item.active.energy-c,
    .energy-item.active.energy-d,
    .energy-item.active.energy-e,
    .energy-item.active.energy-f,
    .energy-item.active.energy-g {
        color: #FFFFFF;
    }
</style>

<script>
    document.querySelectorAll('.energy-item').forEach(function (item) {
        item.addEventListener('click', function () {
            const scale = item.closest('.energy-scale');

            scale.querySelectorAll('.energy-item').forEach(function (el) {
                el.classList.remove('active');
            });

            item.classList.add('active');

            const input = item.querySelector('input');

            if (input) {
                input.checked = true;
                input.dispatchEvent(new Event('change', { bubbles: true }));
            }
        });
    });
</script>
