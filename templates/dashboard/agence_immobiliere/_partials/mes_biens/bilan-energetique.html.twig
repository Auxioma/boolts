{#
 Template: templates/dashboard/agence_immobiliere/_partials/mes_biens/bilan-energetique.html.twig
 Role: Renders the dashboard/agence_immobiliere/_partials/mes_biens Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

<div class="js-tab-content mes-biens-immobilier formulaire" id="cat5">
    <div class="d-flex justify-content-between align-items-end">
        <h2 class="w-75 mb-0">
            {{ 'mes_biens.bilan_energetique.title'|trans }}
        </h2>

        <div class="d-none align-items-end my-auto">
            {{ form_widget(form.saveAndExit) }}
        </div>
    </div>

    <div class="mt-48 caracteristique-logements">
        <div class="row">
            <div class="col-12">

                <div>
                    <label
                        for="{{ form.dpe.vars.id }}"
                        class="mb-16 p-accent"
                    >
                        {{ 'mes_biens.bilan_energetique.dpe.label'|trans }}
                    </label>

                    <div class="position-relative">
                        {{ form_widget(form.dpe, {
                            attr: {
                                class: 'form-control pe-120 js-dpe-input input',
                                placeholder: '0',
                                'data-mes-biens-required-field': 'true',
                            },
                        }) }}

                        <span class="position-absolute top-50 end-0 translate-middle-y pr-16 text-muted kwhep-m-an">
                            {{ 'mes_biens.bilan_energetique.dpe.unit'|trans }}
                        </span>
                    </div>

                    {{ form_errors(form.dpe) }}
                </div>

                <div class="mt-32">
                    <div class="energy-scale js-dpe-scale">
                        {% for child in form.dpeLettre %}
                            <div class="energy-item energy-{{ child.vars.value|lower }} {% if child.vars.checked %}active{% endif %}" data-letter="{{ child.vars.value|lower }}">
                                {{ form_widget(child, {
                                    attr: {
                                        class: 'd-none',
                                        'data-mes-biens-required-group': 'dpeLettre',
                                    },
                                }) }}

                                {{ child.vars.label }}
                            </div>
                        {% endfor %}
                    </div>

                    <div class="d-flex justify-content-between mt-16">
                        <small class="paragraphe">
                            {{ 'mes_biens.bilan_energetique.dpe.econome'|trans }}
                        </small>

                        <small class="paragraphe">
                            {{ 'mes_biens.bilan_energetique.dpe.energivore'|trans }}
                        </small>
                    </div>

                    {{ form_errors(form.dpeLettre) }}
                </div>

                <div class="mt-32">
                    <label
                        for="{{ form.ges.vars.id }}"
                        class="mb-16 p-accent"
                    >
                        {{ 'mes_biens.bilan_energetique.ges.label'|trans }}
                    </label>

                    <div class="position-relative">
                        {{ form_widget(form.ges, {
                            attr: {
                                class: 'form-control pe-120 input js-ges-input',
                                placeholder: '0',
                                'data-mes-biens-required-field': 'true',
                            },
                        }) }}

                        <span class="position-absolute top-50 end-0 translate-middle-y pr-16 text-muted kwhep-m-an">
                            {{ 'mes_biens.bilan_energetique.ges.unit'|trans }}
                        </span>
                    </div>

                    {{ form_errors(form.ges) }}
                </div>

                <div class="mt-32">
                    <div class="energy-scale js-ges-scale">
                        {% for child in form.gesLettre %}
                            <div class="energy-item ges-{{ child.vars.value|lower }} {% if child.vars.checked %}active{% endif %}" data-letter="{{ child.vars.value|lower }}">
                                {{ form_widget(child, {
                                    attr: {
                                        class: 'd-none',
                                        'data-mes-biens-required-group': 'gesLettre',
                                    },
                                }) }}

                                {{ child.vars.label }}
                            </div>
                        {% endfor %}
                    </div>

                    <div class="d-flex justify-content-between mt-16">
                        <small class="paragraphe">
                            {{ 'mes_biens.bilan_energetique.ges.peu'|trans }}
                        </small>

                        <small class="paragraphe">
                            {{ 'mes_biens.bilan_energetique.ges.beaucoup'|trans }}
                        </small>
                    </div>

                    {{ form_errors(form.gesLettre) }}
                </div>

                {# Classe finale = la moins bonne des deux lettres (DPE / GES). #}
                {% set dpe_bien_active = null %}
                {% for field in [form.dpeLettre, form.gesLettre] %}
                    {% for child in field %}
                        {% if child.vars.checked and (dpe_bien_active is null or child.vars.value|lower > dpe_bien_active) %}
                            {% set dpe_bien_active = child.vars.value|lower %}
                        {% endif %}
                    {% endfor %}
                {% endfor %}

                <div class="dpe-bien mt-32 js-dpe-bien">
                    <p class="p-accent mb-16">
                        {{ 'mes_biens.bilan_energetique.resultat.title'|trans }}
                    </p>

                    <ul class="dpe-bien-list">
                        {% for row in [
                            { letter: 'a', range: '< 71' },
                            { letter: 'b', range: '71 – 110' },
                            { letter: 'c', range: '111 – 180' },
                            { letter: 'd', range: '181 – 250' },
                            { letter: 'e', range: '251 – 330' },
                            { letter: 'f', range: '331 – 420' },
                            { letter: 'g', range: '> 420' },
                        ] %}
                            <li class="dpe-bien-row dpe-bien-row-{{ row.letter }} {% if row.letter == dpe_bien_active %}active{% endif %}" data-letter="{{ row.letter }}">
                                <span class="dpe-bien-letter paragraphe">{{ row.letter|upper }}</span>
                                <span class="dpe-bien-bar paragraphe">{{ row.range }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                </div>

                <div class="mt-32 mb-24">
                    <p class="p-accent">
                        {{ 'mes_biens.bilan_energetique.couts.title'|trans }}
                    </p>
                </div>

                <div class="row mb-32">
                    <div class="col-12 col-md-6">
                        <div>
                            <label
                                for="{{ form.dpeMin.vars.id }}"
                                class="mb-16 p-accent"
                            >
                                {{ 'mes_biens.bilan_energetique.couts.minimum'|trans }} 
                                <span>{{ 'mes_biens.optional'|trans }}</span>
                            </label>

                            <div class="position-relative">
                                {{ form_widget(form.dpeMin, {
                                    attr: {
                                        class: 'form-control input pe-120',
                                        placeholder: '',
                                    },
                                }) }}

                                <span class="position-absolute top-50 end-0 translate-middle-y pr-16 text-muted kwhep-m-an">
                                    {{ 'mes_biens.bilan_energetique.couts.unit'|trans({'%devise%': app.user.devise.signe ?? '€'}) }}
                                </span>
                            </div>

                            {{ form_errors(form.dpeMin) }}
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div>
                            <label
                                for="{{ form.dpeMax.vars.id }}"
                                class="mb-16 p-accent"
                            >
                                {{ 'mes_biens.bilan_energetique.couts.maximum'|trans }} <span>{{ 'mes_biens.optional'|trans }}</span>
                            </label>

                            <div class="position-relative">
                                {{ form_widget(form.dpeMax, {
                                    attr: {
                                        class: 'form-control input pe-120',
                                        placeholder: '',
                                    },
                                }) }}

                                <span class="position-absolute top-50 end-0 translate-middle-y pr-16 text-muted kwhep-m-an">
                                    {{ 'mes_biens.bilan_energetique.couts.unit'|trans({'%devise%': app.user.devise.signe ?? '€'}) }}
                                </span>
                            </div>

                            {{ form_errors(form.dpeMax) }}
                        </div>
                    </div>

                    <div class="mt-32">
                        <label
                            for="{{ form.dateIndexationEnergie.vars.id }}"
                            class="mb-16 p-accent"
                        >
                            {{ 'mes_biens.bilan_energetique.couts.date_indexation'|trans }} <span>{{ 'mes_biens.optional'|trans }}</span>
                        </label>

                        <div class="position-relative">
                            {{ form_widget(form.dateIndexationEnergie, {
                                attr: {
                                    class: 'form-control text-uppercase input',
                                    placeholder: '',
                                },
                            }) }}
                        </div>

                        {{ form_errors(form.dateIndexationEnergie) }}
                    </div>
                </div>

                {% do form.dpe.setRendered %}
                {% do form.ges.setRendered %}
                {% do form.dpeMin.setRendered %}
                {% do form.dpeMax.setRendered %}
                {% do form.dateIndexationEnergie.setRendered %}
                {% do form.dpeLettre.setRendered %}
                {% do form.gesLettre.setRendered %}

            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        const LETTERS = ['a', 'b', 'c', 'd', 'e', 'f', 'g'];

        // Seuils officiels du DPE (arrêté du 31 mars 2021, méthode 3CL), source ademe.fr.
        // Bornes supérieures incluses ; au-delà du dernier seuil : G.
        const DPE_THRESHOLDS = [
            { letter: 'a', max: 70 },
            { letter: 'b', max: 110 },
            { letter: 'c', max: 180 },
            { letter: 'd', max: 250 },
            { letter: 'e', max: 330 },
            { letter: 'f', max: 420 },
        ];

        const GES_THRESHOLDS = [
            { letter: 'a', max: 6 },
            { letter: 'b', max: 11 },
            { letter: 'c', max: 30 },
            { letter: 'd', max: 50 },
            { letter: 'e', max: 70 },
            { letter: 'f', max: 100 },
        ];

        function letterFromValue(rawValue, thresholds) {
            const value = parseFloat(String(rawValue).replace(',', '.'));

            if (Number.isNaN(value)) {
                return null;
            }

            const match = thresholds.find(function (threshold) {
                return value <= threshold.max;
            });

            return match ? match.letter : 'g';
        }

        // Valeur la plus basse de la plage correspondant a une lettre :
        // 0 pour A, sinon borne superieure de la lettre precedente + 1.
        function minValueForLetter(letter, thresholds) {
            const index = LETTERS.indexOf(letter);

            if (index <= 0) {
                return 0;
            }

            return thresholds[index - 1].max + 1;
        }

        function selectLetter(scale, letter) {
            if (!scale) {
                return;
            }

            const item = scale.querySelector('[data-letter="' + letter + '"]');

            if (!item) {
                return;
            }

            scale.querySelectorAll('.energy-item').forEach(function (el) {
                el.classList.remove('active');
            });

            item.classList.add('active');

            const input = item.querySelector('input');

            if (input) {
                input.checked = true;
                input.dispatchEvent(new Event('change', { bubbles: true }));
            }
        }

        function bindAutoLetter(inputSelector, scaleSelector, thresholds) {
            const input = document.querySelector(inputSelector);
            const scale = document.querySelector(scaleSelector);

            if (!input || !scale) {
                return;
            }

            input.addEventListener('input', function () {
                const letter = letterFromValue(input.value, thresholds);

                if (letter) {
                    selectLetter(scale, letter);
                }
            });

            // Le clic sur une lettre renseigne dynamiquement l'input avec la
            // valeur la plus basse de la plage correspondante.
            scale.querySelectorAll('.energy-item').forEach(function (item) {
                item.addEventListener('click', function () {
                    input.value = minValueForLetter(item.dataset.letter, thresholds);
                    input.dispatchEvent(new Event('input', { bubbles: true }));
                });
            });
        }

        // La saisie de la valeur propose automatiquement la lettre correspondante,
        // mais l'agence immobilière reste libre de cliquer une autre lettre ensuite.
        bindAutoLetter('.js-dpe-input', '.js-dpe-scale', DPE_THRESHOLDS);
        bindAutoLetter('.js-ges-input', '.js-ges-scale', GES_THRESHOLDS);

        document.querySelectorAll('.energy-item').forEach(function (item) {
            item.addEventListener('click', function () {
                selectLetter(item.closest('.energy-scale'), item.dataset.letter);
            });
        });

        // Le bloc "Résultat de votre bilan énergétique" affiche la classe finale :
        // la moins bonne des deux lettres sélectionnées (DPE et GES).
        const dpeBien = document.querySelector('.js-dpe-bien');

        function activeLetter(scaleSelector) {
            const item = document.querySelector(scaleSelector + ' .energy-item.active');

            return item ? item.dataset.letter : null;
        }

        function updateDpeBien() {
            const letters = [activeLetter('.js-dpe-scale'), activeLetter('.js-ges-scale')]
                .filter(function (letter) {
                    return letter !== null;
                });

            const worst = letters.length
                ? letters.reduce(function (a, b) {
                    return LETTERS.indexOf(a) >= LETTERS.indexOf(b) ? a : b;
                })
                : null;

            dpeBien.querySelectorAll('.dpe-bien-row').forEach(function (row) {
                row.classList.toggle('active', row.dataset.letter === worst);
            });
        }

        if (dpeBien) {
            document.querySelectorAll('.js-dpe-scale, .js-ges-scale').forEach(function (scale) {
                scale.addEventListener('change', updateDpeBien);
            });

            updateDpeBien();
        }
    })();
</script>
