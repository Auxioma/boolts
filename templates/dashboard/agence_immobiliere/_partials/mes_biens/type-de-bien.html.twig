<div class="js-tab-content mes-biens-immobilier" id="cat1">
    <div class="d-flex justify-content-between align-items-end">
        <h1>
            Quel est le type de bien que vous souhaitez publier ?
        </h1>

        <div class="d-flex align-items-end">
            <a href="#" class="btn-retour py-10 px-16">
                Enregistrer et quitter
            </a>
        </div>
    </div>

    <div class="mt-48">
        <div class="row">
            <div class="col-12">
                <div class="row">
                    <div>
                        <div class="row">
                            {% for choice in form.typeBien.vars.choices %}
                                {% set inputId = form.typeBien.vars.id ~ '_' ~ loop.index0 %}
                                {% set isChecked = form.typeBien.vars.value == choice.value %}

                                <div class="col-4 mb-21">
                                    <label
                                        class="type-bien px-24 py-24 w-100 js-type-bien-item {% if isChecked %}active{% endif %}"
                                        for="{{ inputId }}"
                                    >
                                        <input
                                            type="radio"
                                            id="{{ inputId }}"
                                            name="{{ form.typeBien.vars.full_name }}"
                                            value="{{ choice.value }}"
                                            class="d-none js-type-bien-input"
                                            {% if isChecked %}checked="checked"{% endif %}
                                        >

                                        <div>
                                            <div>
                                                <i class="{{ choice.attr.icon }} mb-12"></i>
                                            </div>

                                            <div>
                                                <span>
                                                    {{ choice.label }}
                                                </span>
                                            </div>
                                        </div>
                                    </label>
                                </div>
                            {% endfor %}
                            {% do form.typeBien.setRendered %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const inputs = document.querySelectorAll('.js-type-bien-input');

        inputs.forEach(function (input) {
            input.addEventListener('change', function () {
                document.querySelectorAll('.js-type-bien-item').forEach(function (item) {
                    item.classList.remove('active');
                });

                const label = input.closest('.js-type-bien-item');

                if (label) {
                    label.classList.add('active');
                }
            });
        });
    });
</script>