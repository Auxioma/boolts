                        {# Statistiques rapides #}
                        <section
                            class="dashboard-card statistics-card"
                            data-controller="dashboard-statistics"
                            data-dashboard-statistics-url-value="{{ path('agence_immobiliere_dashboard_statistics') }}"
                        >
                            <div class="d-flex align-items-center justify-content-between statistics-header">
                                <h2 class="dashboard-section-title mb-0">
                                    Statistiques
                                </h2>

                                <div class="d-flex align-items-center statistics-periods">
                                    <button type="button" class="statistics-period-button {{ statistics.period == '7d' ? 'active' }}" data-period="7d" data-action="dashboard-statistics#selectPeriod">
                                        7 jours
                                    </button>

                                    <button type="button" class="statistics-period-button {{ statistics.period == '30d' ? 'active' }}" data-period="30d" data-action="dashboard-statistics#selectPeriod">
                                        30 jours
                                    </button>

                                    <button type="button" class="statistics-period-button {{ statistics.period == '12m' ? 'active' }}" data-period="12m" data-action="dashboard-statistics#selectPeriod">
                                        12 mois
                                    </button>

                                    <button type="button" class="statistics-period-button {{ statistics.period == 'max' ? 'active' }}" data-period="max" data-action="dashboard-statistics#selectPeriod">
                                        Maximum
                                    </button>

                                    <button
                                        type="button"
                                        class="statistics-period-button {{ statistics.period == 'custom' ? 'active' }}"
                                        data-period="custom"
                                        data-action="dashboard-statistics#selectPeriod"
                                        data-bs-toggle="modal"
                                        data-bs-target="#statistics-custom-period-modal"
                                    >
                                        Personnalisé
                                    </button>
                                </div>
                            </div>

                            <div class="row g-4 statistics-summary">

                                                            <div class="col-3">
                                    <div
                                        class="stat-card statistics-series-toggle"
                                        role="button"
                                        tabindex="0"
                                        aria-pressed="true"
                                        data-series-index="0"
                                        data-action="click->dashboard-statistics#toggleSeries"
                                    >
                                        <div class="stat-card-label">
                                            <i class="icon-building-2 stat-card-icon"></i>

                                            <span>Vues du profil</span>
                                        </div>

                                        <span class="stat-card-value" data-dashboard-statistics-target="profileViews">{{ statistics.totals.profileViews }}</span>
                                    </div>
                                </div>

                                <div class="col-3">
                                    <div
                                        class="stat-card statistics-series-toggle"
                                        role="button"
                                        tabindex="0"
                                        aria-pressed="true"
                                        data-series-index="1"
                                        data-action="click->dashboard-statistics#toggleSeries"
                                    >
                                        <div class="stat-card-label">
                                            <i class="icon-building-2 stat-card-icon"></i>

                                            <span>Annonces publiées</span>
                                        </div>

                                        <span class="stat-card-value" data-dashboard-statistics-target="published">{{ statistics.totals.published }}</span>
                                    </div>
                                </div>

                                <div class="col-3">
                                    <div
                                        class="stat-card stat-card-purple statistics-series-toggle"
                                        role="button"
                                        tabindex="0"
                                        aria-pressed="true"
                                        data-series-index="2"
                                        data-action="click->dashboard-statistics#toggleSeries"
                                    >
                                        <div class="stat-card-label">
                                            <i class="icon-eye stat-card-icon"></i>

                                            <span>Vues des annonces</span>
                                        </div>

                                        <span class="stat-card-value" data-dashboard-statistics-target="views">{{ statistics.totals.views }}</span>
                                    </div>
                                </div>

                                <div class="col-3">
                                    <div
                                        class="stat-card stat-card-green statistics-series-toggle"
                                        role="button"
                                        tabindex="0"
                                        aria-pressed="true"
                                        data-series-index="3"
                                        data-action="click->dashboard-statistics#toggleSeries"
                                    >
                                        <div class="stat-card-label">
                                            <i class="icon-heart stat-card-icon"></i>

                                            <span>Mis en favoris</span>
                                        </div>

                                        <span class="stat-card-value" data-dashboard-statistics-target="favorites">{{ statistics.totals.favorites }}</span>
                                    </div>
                                </div>

                            </div>

                            {# Zone du graphique #}
                            <div class="statistics-chart">

                                <div class="statistics-chart-content">
                                    {{ render_chart(
                                        statistics_chart, {
                                            class: 'statistics-chart-canvas',
                                            'data-dashboard-statistics-target': 'chart'
                                    }) }}
                                </div>
                            </div>

                            <div
                                id="statistics-custom-period-modal"
                                class="modal fade"
                                tabindex="-1"
                                aria-labelledby="statistics-custom-period-modal-title"
                                aria-hidden="true"
                                data-dashboard-statistics-target="modal"
                            >
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h2 id="statistics-custom-period-modal-title" class="modal-title fs-5">Période personnalisée</h2>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                                        </div>
                                        <div class="modal-body">
                                            <div class="mb-3">
                                                <label for="statistics-start" class="form-label">Date de début</label>
                                                <input id="statistics-start" type="date" class="form-control" max="{{ 'now'|date('Y-m-d') }}" value="{{ statistics.start|date('Y-m-d') }}" data-dashboard-statistics-target="start">
                                            </div>
                                            <div>
                                                <label for="statistics-end" class="form-label">Date de fin</label>
                                                <input id="statistics-end" type="date" class="form-control" max="{{ 'now'|date('Y-m-d') }}" value="{{ statistics.end|date('Y-m-d') }}" data-dashboard-statistics-target="end">
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                            <button type="button" class="btn btn-primary" data-action="dashboard-statistics#loadCustomPeriod">Appliquer</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>

                        {# Notifications #}
                        <section class="dashboard-card notifications-card">
                            <h2 class="dashboard-section-title">
                                Notifications
                            </h2>

                            <div class="notifications-list">

                                <div class="notification-item">
                                    <span class="notification-dot"></span>

                                    <p class="notification-text">
                                        Bienvenue sur
                                        <strong>boolts.com</strong>.
                                        Veuillez compléter votre inscription en déposant les documents demandés.
                                    </p>
                                </div>

                                <div class="notification-item">
                                    <span class="notification-dot"></span>

                                    <p class="notification-text">
                                        Your listing
                                        <strong>House on the Beverly Hills</strong>
                                        has been approved.
                                    </p>
                                </div>

                            </div>

                            <a href="#" class="btn notifications-more-button">
                                Voir plus
                            </a>
                        </section>

                        {# Performances des annonces #}
                        <section
                            class="dashboard-card properties-performance-card"
                            data-controller="dashboard-property-performance"
                            data-dashboard-property-performance-url-value="{{ path('agence_immobiliere_dashboard_performances') }}"
                        >
                            <div class="properties-performance-header">
                                <h2 class="dashboard-section-title">
                                    Performances des annonces
                                </h2>

                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center statistics-periods">
                                        <button type="button" class="statistics-period-button" data-period="7d" data-action="dashboard-property-performance#selectPeriod">
                                            7 jours
                                        </button>

                                        <button
                                            type="button"
                                            class="statistics-period-button active"
                                            data-period="30d"
                                            data-action="dashboard-property-performance#selectPeriod"
                                        >
                                            30 jours
                                        </button>

                                        <button type="button" class="statistics-period-button" data-period="12m" data-action="dashboard-property-performance#selectPeriod">
                                            12 mois
                                        </button>

                                        <button type="button" class="statistics-period-button" data-period="max" data-action="dashboard-property-performance#selectPeriod">
                                            Maximum
                                        </button>

                                        <button
                                            type="button"
                                            class="statistics-period-button"
                                            data-period="custom"
                                            data-action="dashboard-property-performance#selectPeriod"
                                            data-bs-toggle="modal"
                                            data-bs-target="#property-performance-custom-period-modal"
                                        >
                                            Personnalisé
                                        </button>
                                    </div>

                                    <div class="d-flex align-items-center properties-actions">
                                        <button
                                            type="button"
                                            class="btn properties-action-button properties-filter-button"
                                        >
                                            <span class="properties-filter-count">2</span>
                                            <i class="icon-sliders-horizontal"></i>
                                            Filtres
                                        </button>

                                        <div
                                            class="properties-sort"
                                            data-controller="agence-sort"
                                            data-action="keydown.esc@window->agence-sort#close"
                                        >
                                            <button
                                                type="button"
                                                class="btn properties-action-button"
                                                data-action="click->agence-sort#toggle"
                                                data-agence-sort-target="button"
                                                aria-haspopup="listbox"
                                                aria-expanded="false"
                                                aria-controls="dashboard-sort-menu"
                                            >
                                                <i class="icon-arrow-up-down"></i>
                                                Trier
                                            </button>

                                            {# trie des annonces #}
                                            <div
                                                id="dashboard-sort-menu"
                                                class="sort-menu d-none"
                                                data-agence-sort-target="menu"
                                                role="listbox"
                                                aria-label="Trier les résultats"
                                            >
    <button
        class="sort-menu__item sort-menu__item--active"
        type="button"
        role="option"
        aria-selected="true"
        data-sort="created-desc"
        data-action="click->agence-sort#selectOption"
    >
        Date d'ajout (récent → ancien)
    </button>

    <button
        class="sort-menu__item"
        type="button"
        role="option"
        aria-selected="false"
        data-sort="created-asc"
        data-action="click->agence-sort#selectOption"
    >
        Date d'ajout (ancien → récent)
    </button>

    <button
        class="sort-menu__item"
        type="button"
        role="option"
        aria-selected="false"
        data-sort="views-desc"
        data-action="click->agence-sort#selectOption"
    >
        Vues (plus → moins)
    </button>

    <button
        class="sort-menu__item"
        type="button"
        role="option"
        aria-selected="false"
        data-sort="views-asc"
        data-action="click->agence-sort#selectOption"
    >
        Vues (moins → plus)
    </button>

    <button
        class="sort-menu__item"
        type="button"
        role="option"
        aria-selected="false"
        data-sort="favorites-desc"
        data-action="click->agence-sort#selectOption"
    >
        Favoris (plus → moins)
    </button>

    <button
        class="sort-menu__item"
        type="button"
        role="option"
        aria-selected="false"
        data-sort="favorites-asc"
        data-action="click->agence-sort#selectOption"
    >
        Favoris (moins → plus)
    </button>
</div>
                                        </div>

<style>
:root {
    --sort-menu-background: #ffffff;
    --sort-menu-border: #ebecec;
    --sort-menu-text: #0b0f14;
    --sort-menu-primary: #5d00ff;
    --sort-menu-radius: 8px;
    --sort-menu-font-size: 14px;
}

.properties-sort {
    position: relative;
    display: inline-flex;
}

.sort-menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    z-index: 100;

    display: flex;
    flex-direction: column;
    width: max-content;
    min-width: 229px;
    overflow: hidden;

    background: var(--sort-menu-background);
    border: 1px solid var(--sort-menu-border);
    border-radius: var(--sort-menu-radius);
    box-shadow: 0 4px 24.1px rgba(0, 0, 0, 0.05);
}

.sort-menu.d-none {
    display: none;
}

.sort-menu__item {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 36px;
    padding: 8px 16px;

    font-family: "Eudoxus Sans", Inter, Arial, sans-serif;
    font-size: var(--sort-menu-font-size);
    font-weight: 500;
    line-height: 20px;
    text-align: left;
    white-space: nowrap;

    color: var(--sort-menu-text);
    background: transparent;
    border: 0;
    cursor: pointer;

    transition:
        color 150ms ease,
        background-color 150ms ease;
}

.sort-menu__item:hover,
.sort-menu__item:focus-visible {
    background: rgba(93, 0, 255, 0.08);
    outline: none;
}

.sort-menu__item--active,
.sort-menu__item[aria-selected="true"] {
    color: #ffffff;
    background: var(--sort-menu-primary);
}

.sort-menu__item--active:hover,
.sort-menu__item[aria-selected="true"]:hover {
    background: #5000db;
}

.sort-menu__item:focus-visible {
    box-shadow: inset 0 0 0 2px rgba(93, 0, 255, 0.35);
}

.sort-menu__item--active:focus-visible,
.sort-menu__item[aria-selected="true"]:focus-visible {
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.65);
}
</style>

                                        <a
                                            href="{{ path('agence_immobiliere_dashboard_properties_export') }}"
                                            class="btn properties-action-button"
                                        >
                                            <i class="icon-download"></i>
                                            Exporter
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <turbo-frame
                                id="dashboard-property-performance"
                                src="{{ path('agence_immobiliere_dashboard_performances') }}"
                                loading="eager"
                                data-dashboard-property-performance-target="frame"
                            >
                                <p class="mb-0">Chargement des annonces...</p>
                            </turbo-frame>

                            <div
                                id="property-performance-custom-period-modal"
                                class="modal fade"
                                tabindex="-1"
                                aria-labelledby="property-performance-custom-period-modal-title"
                                aria-hidden="true"
                                data-dashboard-property-performance-target="modal"
                            >
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h2 id="property-performance-custom-period-modal-title" class="modal-title fs-5">Période personnalisée</h2>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                                        </div>
                                        <div class="modal-body">
                                            <div class="mb-3">
                                                <label for="property-performance-start" class="form-label">Date de début</label>
                                                <input id="property-performance-start" type="date" class="form-control" max="{{ 'now'|date('Y-m-d') }}" data-dashboard-property-performance-target="start">
                                            </div>
                                            <div>
                                                <label for="property-performance-end" class="form-label">Date de fin</label>
                                                <input id="property-performance-end" type="date" class="form-control" max="{{ 'now'|date('Y-m-d') }}" data-dashboard-property-performance-target="end">
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                            <button type="button" class="btn btn-primary" data-action="dashboard-property-performance#loadCustomPeriod">Appliquer</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>

                    </div>
                </div>

            </div>
        </div>
    </main>

{% endblock %}
