{#
 Template: templates/dashboard/agence_immobiliere/dashboard/index.html.twig
 Role: Renders the dashboard/agence_immobiliere/dashboard Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

{% extends 'base.html.twig' %} 

{% block title %}Tableau de bord immobilier{% endblock %}

{% block body %}

    <main id="dashboard" class="dashboard">
        <div class="container-fluid dashboard-container">
            <div class="row g-0">

                {# Sidebar existante #}
                {{ include('composant/__agence_immobiliere/_tableau_de_bord.html.twig') }}

                {# Contenu principal #}
                <div class="col-10 dashboard-main">
                    <div class="dashboard-content">

                        {# En-tête de la page #}
                        <div class="d-flex align-items-center justify-content-between dashboard-heading">
                            <h1 class="dashboard-title">
                                Welcome,
                                {{ app.user.prenom|default('John') }}
                                {{ app.user.nom|default('Doe') }}
                                !
                            </h1>

                            <a href="#" class="btn dashboard-boost-button">
                                <i class="icon-zap"></i>
                                Boost : 4
                            </a>
                        </div>

                        {# Finalisation du compte #}
                        <section class="dashboard-card account-completion-card">
                            <div class="account-completion-header">
                                <div>
                                    <h2 class="dashboard-section-title">
                                        Terminez la création de votre compte pro !
                                    </h2>

                                    <p class="dashboard-section-description">
                                        Veuillez déposer les derniers documents afin de valider la création de votre compte.
                                    </p>
                                </div>
                            </div>

                            <div class="account-country-block">
                                <label
                                    for="domiciliation-country"
                                    class="account-country-label"
                                >
                                    Confirmez votre pays de domiciliation*
                                </label>

                                <div class="d-flex align-items-center account-country-form">
                                    <input
                                        type="text"
                                        id="domiciliation-country"
                                        name="domiciliation_country"
                                        class="form-control account-country-input"
                                        placeholder="France"
                                        autocomplete="country-name"
                                    >

                                    <button
                                        type="button"
                                        class="btn account-country-button"
                                    >
                                        Continuer
                                    </button>
                                </div>
                            </div>
                        </section>


{# termier et entrez les documents #}
<section
    class="finish-setup"
    data-node-id="2465:10931"
>
    <header class="finish-setup__header">
        <div class="finish-setup__heading">
            <h2 class="finish-setup__title">
                Terminez la création de votre compte pro !
            </h2>

            <p class="finish-setup__subtitle">
                Veuillez déposer les derniers documents afin de valider la création de votre compte.
            </p>
        </div>

        <div class="finish-setup__country">
            <span class="finish-setup__country-value">
                France
            </span>

            <svg
                class="finish-setup__country-icon"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
            >
                <path
                    d="M7 9.5L12 14.5L17 9.5"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                />
            </svg>
        </div>
    </header>

    <div class="finish-setup__documents">
        <div class="finish-setup__document">
            <div class="finish-setup__document-content">
                <h3 class="finish-setup__document-title">
                    Extrait KBIS
                </h3>

                <p class="finish-setup__document-description">
                    Ce document est important car...
                </p>
            </div>

            <p class="finish-setup__formats">
                (Formats requis : jpeg, png, heic, pdf)
            </p>

            <label class="finish-setup__upload">
                <input
                    class="finish-setup__file-input"
                    type="file"
                    name="kbis"
                    accept=".jpeg,.jpg,.png,.heic,.pdf"
                >

                <svg
                    class="finish-setup__upload-icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    aria-hidden="true"
                >
                    <path
                        d="M12 16V3"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                    />

                    <path
                        d="M7.5 7.5L12 3L16.5 7.5"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    />

                    <path
                        d="M5 14.5V19C5 20.1046 5.89543 21 7 21H17C18.1046 21 19 20.1046 19 19V14.5"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                    />
                </svg>

                <span>Téléverser</span>
            </label>
        </div>

        <div class="finish-setup__document">
            <div class="finish-setup__document-content">
                <h3 class="finish-setup__document-title">
                    Pièce d’identité
                </h3>

                <p class="finish-setup__document-description">
                    Ce document est important car...
                </p>
            </div>

            <p class="finish-setup__formats">
                (Formats requis : jpeg, png, heic, pdf)
            </p>

            <label class="finish-setup__upload">
                <input
                    class="finish-setup__file-input"
                    type="file"
                    name="identity"
                    accept=".jpeg,.jpg,.png,.heic,.pdf"
                >

                <svg
                    class="finish-setup__upload-icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    aria-hidden="true"
                >
                    <path
                        d="M12 16V3"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                    />

                    <path
                        d="M7.5 7.5L12 3L16.5 7.5"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    />

                    <path
                        d="M5 14.5V19C5 20.1046 5.89543 21 7 21H17C18.1046 21 19 20.1046 19 19V14.5"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                    />
                </svg>

                <span>Téléverser</span>
            </label>
        </div>
    </div>

    <button
        class="finish-setup__submit"
        type="submit"
        disabled
    >
        Envoyer les documents
    </button>
</section>

<style>
.finish-setup,
.finish-setup * {
    box-sizing: border-box;
}

.finish-setup {
    --finish-brand: #5d00ff;
    --finish-black: #0b0f14;
    --finish-grey: #858789;
    --finish-light-grey: #ebecec;
    --finish-white: #ffffff;

    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;

    width: 100%;
    padding: 24px;

    background: var(--finish-white);
    border: 2px solid var(--finish-brand);
    border-radius: 24px;

    font-family: "Eudoxus Sans", Arial, sans-serif;
}

.finish-setup__header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;

    width: 100%;
}

.finish-setup__heading {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;

    min-width: 0;
}

.finish-setup__title {
    width: 100%;
    margin: 0;

    color: #000000;
    font-size: 20px;
    font-weight: 700;
    line-height: 24px;
    letter-spacing: 0;
}

.finish-setup__subtitle {
    width: 100%;
    margin: 0;

    color: var(--finish-grey);
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    letter-spacing: 0;
}

.finish-setup__country {
    display: flex;
    flex: 0 0 140px;
    align-items: center;
    justify-content: center;
    gap: 10px;

    width: 140px;
    height: 44px;
    padding: 12px 14px;

    background: var(--finish-white);
    border: 2px solid var(--finish-light-grey);
    border-radius: 8px;
}

.finish-setup__country-value {
    flex: 1 1 0;
    min-width: 0;

    color: var(--finish-black);
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
}

.finish-setup__country-icon {
    width: 24px;
    height: 24px;
    flex: 0 0 24px;

    color: var(--finish-grey);
}

.finish-setup__documents {
    display: flex;
    flex-direction: column;
    align-items: flex-start;

    width: 100%;
}

.finish-setup__document {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;

    width: 100%;
    padding: 12px 0;

    border-bottom: 2px solid var(--finish-light-grey);
}

.finish-setup__document-content {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 15px;

    min-width: 0;
}

.finish-setup__document-title {
    width: 100%;
    margin: 0;

    color: var(--finish-black);
    font-size: 16px;
    font-weight: 700;
    line-height: 20px;
    letter-spacing: 0;
}

.finish-setup__document-description {
    width: 100%;
    margin: 0;

    color: var(--finish-grey);
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    letter-spacing: 0;
}

.finish-setup__formats {
    flex: 0 0 auto;
    margin: 0;

    color: var(--finish-grey);
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    letter-spacing: 0;
    white-space: nowrap;
}

.finish-setup__upload {
    position: relative;

    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    gap: 10px;

    height: 44px;
    padding: 10px 16px;

    color: var(--finish-brand);
    background: var(--finish-white);
    border: 2px solid var(--finish-brand);
    border-radius: 50px;

    font-size: 16px;
    font-weight: 700;
    line-height: 20px;
    letter-spacing: 0;

    cursor: pointer;
}

.finish-setup__file-input {
    position: absolute;

    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;

    overflow: hidden;

    clip: rect(0, 0, 0, 0);
    clip-path: inset(50%);

    white-space: nowrap;
    border: 0;
}

.finish-setup__upload-icon {
    width: 24px;
    height: 24px;
    flex: 0 0 24px;
}

.finish-setup__submit {
    display: flex;
    align-items: center;
    justify-content: center;

    height: 44px;
    padding: 10px 16px;

    color: var(--finish-grey);
    background: var(--finish-light-grey);
    border: 0;
    border-radius: 50px;

    font-family: inherit;
    font-size: 16px;
    font-weight: 700;
    line-height: 20px;
    letter-spacing: 0;
    white-space: nowrap;

    cursor: not-allowed;
}

@media (max-width: 800px) {
    .finish-setup {
        align-items: stretch;
        padding: 20px;
    }

    .finish-setup__header {
        align-items: stretch;
        flex-direction: column;
    }

    .finish-setup__country {
        width: 100%;
        flex-basis: auto;
    }

    .finish-setup__document {
        align-items: flex-start;
        flex-direction: column;
        gap: 16px;
    }

    .finish-setup__formats {
        white-space: normal;
    }

    .finish-setup__upload,
    .finish-setup__submit {
        width: 100%;
    }
}
</style>


                        {# Statistiques rapides #}
                        <section
                            class="dashboard-card statistics-card"
                            data-controller="dashboard-statistics"
                            data-dashboard-statistics-url-value="{{ path('agence_immobiliere_dashboard_statistics') }}"
                        >
                            <div class="d-flex align-items-center justify-content-between statistics-header">
                                <h2 class="dashboard-section-title mb-0">
                                    Statistiques
                                </h2>

                                <div class="d-flex align-items-center statistics-periods">
                                    <button type="button" class="statistics-period-button {{ statistics.period == '7d' ? 'active' }}" data-period="7d" data-action="dashboard-statistics#selectPeriod">
                                        7 jours
                                    </button>

                                    <button type="button" class="statistics-period-button {{ statistics.period == '30d' ? 'active' }}" data-period="30d" data-action="dashboard-statistics#selectPeriod">
                                        30 jours
                                    </button>

                                    <button type="button" class="statistics-period-button {{ statistics.period == '12m' ? 'active' }}" data-period="12m" data-action="dashboard-statistics#selectPeriod">
                                        12 mois
                                    </button>

                                    <button type="button" class="statistics-period-button {{ statistics.period == 'max' ? 'active' }}" data-period="max" data-action="dashboard-statistics#selectPeriod">
                                        Maximum
                                    </button>

                                    <button
                                        type="button"
                                        class="statistics-period-button {{ statistics.period == 'custom' ? 'active' }}"
                                        data-period="custom"
                                        data-action="dashboard-statistics#selectPeriod"
                                        data-bs-toggle="modal"
                                        data-bs-target="#statistics-custom-period-modal"
                                    >
                                        Personnalisé
                                    </button>
                                </div>
                            </div>

                            <div class="row g-4 statistics-summary">

                                                            <div class="col-3">
                                    <div
                                        class="stat-card statistics-series-toggle"
                                        role="button"
                                        tabindex="0"
                                        aria-pressed="true"
                                        data-series-index="0"
                                        data-action="click->dashboard-statistics#toggleSeries"
                                    >
                                        <div class="stat-card-label">
                                            <i class="icon-building-2 stat-card-icon"></i>

                                            <span>Vues du profil</span>
                                        </div>

                                        <span class="stat-card-value" data-dashboard-statistics-target="profileViews">{{ statistics.totals.profileViews }}</span>
                                    </div>
                                </div>

                                <div class="col-3">
                                    <div
                                        class="stat-card statistics-series-toggle"
                                        role="button"
                                        tabindex="0"
                                        aria-pressed="true"
                                        data-series-index="1"
                                        data-action="click->dashboard-statistics#toggleSeries"
                                    >
                                        <div class="stat-card-label">
                                            <i class="icon-building-2 stat-card-icon"></i>

                                            <span>Annonces publiées</span>
                                        </div>

                                        <span class="stat-card-value" data-dashboard-statistics-target="published">{{ statistics.totals.published }}</span>
                                    </div>
                                </div>

                                <div class="col-3">
                                    <div
                                        class="stat-card stat-card-purple statistics-series-toggle"
                                        role="button"
                                        tabindex="0"
                                        aria-pressed="true"
                                        data-series-index="2"
                                        data-action="click->dashboard-statistics#toggleSeries"
                                    >
                                        <div class="stat-card-label">
                                            <i class="icon-eye stat-card-icon"></i>

                                            <span>Vues des annonces</span>
                                        </div>

                                        <span class="stat-card-value" data-dashboard-statistics-target="views">{{ statistics.totals.views }}</span>
                                    </div>
                                </div>

                                <div class="col-3">
                                    <div
                                        class="stat-card stat-card-green statistics-series-toggle"
                                        role="button"
                                        tabindex="0"
                                        aria-pressed="true"
                                        data-series-index="3"
                                        data-action="click->dashboard-statistics#toggleSeries"
                                    >
                                        <div class="stat-card-label">
                                            <i class="icon-heart stat-card-icon"></i>

                                            <span>Mis en favoris</span>
                                        </div>

                                        <span class="stat-card-value" data-dashboard-statistics-target="favorites">{{ statistics.totals.favorites }}</span>
                                    </div>
                                </div>

                            </div>

                            {# Zone du graphique #}
                            <div class="statistics-chart">

                                <div class="statistics-chart-content">
                                    {{ render_chart(
                                        statistics_chart, {
                                            class: 'statistics-chart-canvas',
                                            'data-dashboard-statistics-target': 'chart'
                                    }) }}
                                </div>
                            </div>

                            <div
                                id="statistics-custom-period-modal"
                                class="modal fade"
                                tabindex="-1"
                                aria-labelledby="statistics-custom-period-modal-title"
                                aria-hidden="true"
                                data-dashboard-statistics-target="modal"
                            >
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h2 id="statistics-custom-period-modal-title" class="modal-title fs-5">Période personnalisée</h2>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                                        </div>
                                        <div class="modal-body">
                                            <div class="mb-3">
                                                <label for="statistics-start" class="form-label">Date de début</label>
                                                <input id="statistics-start" type="date" class="form-control" max="{{ 'now'|date('Y-m-d') }}" value="{{ statistics.start|date('Y-m-d') }}" data-dashboard-statistics-target="start">
                                            </div>
                                            <div>
                                                <label for="statistics-end" class="form-label">Date de fin</label>
                                                <input id="statistics-end" type="date" class="form-control" max="{{ 'now'|date('Y-m-d') }}" value="{{ statistics.end|date('Y-m-d') }}" data-dashboard-statistics-target="end">
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                            <button type="button" class="btn btn-primary" data-action="dashboard-statistics#loadCustomPeriod">Appliquer</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>

                        {# Notifications #}
                        <section class="dashboard-card notifications-card">
                            <h2 class="dashboard-section-title">
                                Notifications
                            </h2>

                            <div class="notifications-list">

                                <div class="notification-item">
                                    <span class="notification-dot"></span>

                                    <p class="notification-text">
                                        Bienvenue sur
                                        <strong>boolts.com</strong>.
                                        Veuillez compléter votre inscription en déposant les documents demandés.
                                    </p>
                                </div>

                                <div class="notification-item">
                                    <span class="notification-dot"></span>

                                    <p class="notification-text">
                                        Your listing
                                        <strong>House on the Beverly Hills</strong>
                                        has been approved.
                                    </p>
                                </div>

                            </div>

                            <a href="#" class="btn notifications-more-button">
                                Voir plus
                            </a>
                        </section>

                        {# Performances des annonces #}
                        <section class="dashboard-card properties-performance-card">
                            <div class="properties-performance-header">
                                <h2 class="dashboard-section-title">
                                    Performances des annonces
                                </h2>

                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center statistics-periods">
                                        <button type="button" class="statistics-period-button">
                                            7 jours
                                        </button>

                                        <button
                                            type="button"
                                            class="statistics-period-button active"
                                        >
                                            30 jours
                                        </button>

                                        <button type="button" class="statistics-period-button">
                                            12 mois
                                        </button>

                                        <button type="button" class="statistics-period-button">
                                            Maximum
                                        </button>

                                        <button type="button" class="statistics-period-button">
                                            Personnalisé
                                        </button>
                                    </div>

                                    <div class="d-flex align-items-center properties-actions">
                                        <button
                                            type="button"
                                            class="btn properties-action-button properties-filter-button"
                                        >
                                            <span class="properties-filter-count">2</span>
                                            <i class="icon-sliders-horizontal"></i>
                                            Filtres
                                        </button>

                                        <button
                                            type="button"
                                            class="btn properties-action-button"
                                        >
                                            <i class="icon-arrow-up-down"></i>
                                            Trier
                                        </button>

                                        <button
                                            type="button"
                                            class="btn properties-action-button"
                                        >
                                            <i class="icon-download"></i>
                                            Exporter
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="property-list">

                                {% for property in 1..8 %}
                                    <article class="property-item">
                                        <div class="d-flex align-items-center property-main">

                                            <div class="property-image-wrapper">
                                                <img
                                                    src="{{ asset('images/dashboard/property-example.jpg') }}"
                                                    alt="Maison à Marrakech"
                                                    class="property-image"
                                                >
                                            </div>

                                            <div class="property-information">
                                                <h3 class="property-title">
                                                    Location saisonnière Maison haut standing à Marrakech
                                                </h3>

                                                <div class="d-flex align-items-center property-price-line">
                                                    <span class="property-price">
                                                        1 801 DH
                                                    </span>

                                                    {% if property <= 4 %}
                                                        <span class="property-status property-status-published">
                                                            Publiée
                                                        </span>
                                                    {% else %}
                                                        <span class="property-status property-status-paused">
                                                            Pause
                                                        </span>
                                                    {% endif %}

                                                    {% if property == 4 or property == 5 %}
                                                        <span class="property-status property-status-boosted">
                                                            Boostée
                                                        </span>
                                                    {% endif %}
                                                </div>

                                                <p class="property-location">
                                                    <strong>Marrakech, Maroc</strong>
                                                    <span>- Créée le 29 juin 2026</span>
                                                </p>

                                                <span class="property-reference">
                                                    AUXIOM-8899-100
                                                </span>
                                            </div>
                                        </div>

                                        <div class="property-statistics">
                                            <span class="property-statistic">
                                                <i class="icon-eye"></i>
                                                320
                                            </span>

                                            <span class="property-statistic">
                                                <i class="icon-heart"></i>
                                                37
                                            </span>
                                        </div>

                                        {% if property <= 4 %}
                                            <a href="#" class="btn property-boost-button">
                                                <i class="icon-zap"></i>
                                                Booster
                                            </a>
                                        {% endif %}
                                    </article>
                                {% endfor %}

                            </div>

                            <nav
                                class="dashboard-pagination"
                                aria-label="Pagination des annonces"
                            >
                                <a href="#" class="pagination-arrow" aria-label="Page précédente">
                                    ‹
                                </a>

                                <a href="#" class="pagination-number active">
                                    1
                                </a>

                                <a href="#" class="pagination-number">
                                    2
                                </a>

                                <a href="#" class="pagination-number">
                                    3
                                </a>

                                <a href="#" class="pagination-number">
                                    4
                                </a>

                                <span class="pagination-number">
                                    …
                                </span>

                                <a href="#" class="pagination-number">
                                    32
                                </a>

                                <a href="#" class="pagination-arrow" aria-label="Page suivante">
                                    ›
                                </a>
                            </nav>
                        </section>

                    </div>
                </div>

            </div>
        </div>
    </main>

{% endblock %}
