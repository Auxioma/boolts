{#
 Template: templates/dashboard/agence_immobiliere/dashboard/index.html.twig
 Role: Renders the dashboard/agence_immobiliere/dashboard Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

{% extends 'base.html.twig' %} 

{% block title %}Tableau de bord immobilier{% endblock %}

{% block body %}

    <main id="dashboard" class="dashboard">
        <div class="container-fluid dashboard-container">
            <div class="row g-0">

                {# Sidebar existante #}
                {{ include('composant/__agence_immobiliere/_tableau_de_bord.html.twig') }}

                {# Contenu principal #}
                <div class="col-10 dashboard-main">
                    <div class="dashboard-content">

                        {# En-tête de la page #}
                        <div class="d-flex align-items-center justify-content-between dashboard-heading">
                            <h1 class="dashboard-title">
                                Welcome,
                                {{ app.user.prenom|default('John') }}
                                {{ app.user.nom|default('Doe') }}
                                !
                            </h1>

                            <a href="#" class="btn dashboard-boost-button">
                                <i class="icon-zap"></i>
                                Boost : 4
                            </a>
                        </div>

                        {# Finalisation du compte #}
                        <div data-controller="dashboard-account-completion">
                        <section
                            class="dashboard-card account-completion-card"
                            data-dashboard-account-completion-target="countryStep"
                            {% if documents_step_active %}hidden{% endif %}
                        >
                            <div class="account-completion-header">
                                <div>
                                    <h2 class="dashboard-section-title">
                                        Terminez la création de votre compte pro !
                                    </h2>

                                    <p class="dashboard-section-description">
                                        Veuillez déposer les derniers documents afin de valider la création de votre compte.
                                    </p>
                                </div>
                            </div>

                            <div class="account-country-block">
                                <label
                                    for="domiciliation-country"
                                    class="account-country-label"
                                >
                                    Confirmez votre pays de domiciliation*
                                </label>

                                <div class="d-flex align-items-center account-country-form">
                                    {{ form_widget(form.pays, {
                                        attr: {
                                            id: 'domiciliation-country',
                                            class: 'form-select account-country-input',
                                            'data-dashboard-account-completion-target': 'country'
                                        }
                                    }) }}

                                    <button
                                        type="button"
                                        class="btn account-country-button"
                                        data-action="dashboard-account-completion#continue"
                                    >
                                        Continuer
                                    </button>
                                </div>
                            </div>
                        </section>


{# termier et entrez les documents #}
<section
    class="finish-setup"
    data-node-id="2465:10931"
    data-dashboard-account-completion-target="documentsStep"
    {% if not documents_step_active %}hidden{% endif %}
>
    <header class="finish-setup__header">
        <div class="finish-setup__heading">
            <h2 class="finish-setup__title">
                Terminez la création de votre compte pro !
            </h2>

            <p class="finish-setup__subtitle">
                Veuillez déposer les derniers documents afin de valider la création de votre compte.
            </p>
        </div>

        <div class="finish-setup__country">
            <span class="finish-setup__country-value">
                <span data-dashboard-account-completion-target="selectedCountry"></span>
            </span>

            <svg
                class="finish-setup__country-icon"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
            >
                <path
                    d="M7 9.5L12 14.5L17 9.5"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                />
            </svg>
        </div>
    </header>

    <div class="finish-setup__documents">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success w-100" role="status">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger w-100" role="alert">{{ message }}</div>
        {% endfor %}

        {% for requiredDocument in required_documents %}
        <div class="finish-setup__document">
            <div class="finish-setup__document-content">
                <h3 class="finish-setup__document-title">
                    {{ requiredDocument.name }}
                </h3>

                <p class="finish-setup__document-description">
                    {{ requiredDocument.description }}
                </p>
            </div>

            <p
                class="finish-setup__formats"
                data-document-formats
                data-default-formats="(Formats acceptés : images et PDF, maximum {{ requiredDocument.maxFileSizeMb }} Mo)"
            >
                (Formats acceptés : images et PDF, maximum {{ requiredDocument.maxFileSizeMb }} Mo)
            </p>

            {% set documentForm = document_forms[requiredDocument.id] %}
            {{ form_start(documentForm, {
                action: path('agence_immobiliere_dashboard_document_upload'),
                attr: {
                    class: 'finish-setup__upload-form',
                    'data-document-upload-form': '',
                    'data-required-document': requiredDocument.required ? 'true' : 'false'
                }
            }) }}
                {{ form_widget(documentForm.requiredDocument, {attr: {hidden: 'hidden'}}) }}
                <label class="finish-setup__upload">
                {{ form_widget(documentForm.document, {
                    attr: {
                        class: 'finish-setup__file-input',
                        'data-document-upload': ''
                    }
                }) }}

                <svg
                    class="finish-setup__upload-icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    aria-hidden="true"
                >
                    <path
                        d="M12 16V3"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                    />

                    <path
                        d="M7.5 7.5L12 3L16.5 7.5"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    />

                    <path
                        d="M5 14.5V19C5 20.1046 5.89543 21 7 21H17C18.1046 21 19 20.1046 19 19V14.5"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                    />
                </svg>

                <span data-upload-status>Téléverser</span>
                </label>
                <p class="finish-setup__remove-file" data-remove-file hidden>Supprimer</p>
            {{ form_end(documentForm) }}
            <div class="alert alert-danger finish-setup__document-flash" data-document-upload-error role="alert" hidden></div>
        </div>
        {% endfor %}
    </div>

    <button
        class="finish-setup__submit"
        type="button"
        data-documents-continue
        data-documents-complete="{{ documents_complete ? 'true' : 'false' }}"
        disabled
    >
        Continuer
    </button>

    <div class="document-limit-message" data-document-limit-message{% if not documents_submission_limit_reached %} hidden{% endif %}>
        <h2 class="document-limit-title">
            Vous avez atteint la limite de dépôt de document
        </h2>

        <p class="document-limit-description">
            Contactez le support pour plus d’informations en cliquant
            <a href="#" class="document-limit-link">ici.</a>
        </p>
    </div>

    <div class="document-confirmation" data-document-confirmation hidden>
        <p class="document-confirmation__success">
            Les documents ont bien été envoyés !
        </p>

        <p class="document-confirmation__status">
            Nous traitons votre dossier.
        </p>

        <p class="document-confirmation__text">
            Changez les documents déposés en cliquant
            <a href="#" class="document-confirmation__link" data-document-confirmation-link>ici</a>.
        </p>

        <p class="document-confirmation__help">
            Pour toute question, contactez le support via l’onglet “aide”.
        </p>
    </div>

</section>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const continueButton = document.querySelector('[data-documents-continue]');
    const documentConfirmation = document.querySelector('[data-document-confirmation]');
    const documentConfirmationLink = document.querySelector('[data-document-confirmation-link]');
    const documentLimitMessage = document.querySelector('[data-document-limit-message]');
    const forms = [...document.querySelectorAll('[data-document-upload-form]')];

    if (!continueButton || !forms.length) {
        return;
    }

    documentConfirmationLink?.addEventListener('click', (event) => {
        event.preventDefault();

        forms.forEach((form) => {
            if (form.dataset.uploaded !== 'true') {
                return;
            }

            const input = form.querySelector('[data-document-upload]');
            const status = form.querySelector('[data-upload-status]');
            const formats = form.parentElement.querySelector('[data-document-formats]');
            const uploadLabel = form.querySelector('.finish-setup__upload');
            const removeFile = form.querySelector('[data-remove-file]');

            form.dataset.uploaded = 'false';
            input.disabled = false;
            status.textContent = 'Téléverser';
            formats.textContent = input.files[0]?.name || formats.dataset.defaultFormats;
            uploadLabel.hidden = Boolean(input.files.length);
            removeFile.hidden = !input.files.length;
            removeFile.textContent = 'Supprimer';
            removeFile.classList.remove('finish-setup__remove-file--uploaded');
        });

        documentConfirmation?.replaceWith(continueButton);
        updateContinueButton();
        forms[0]?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    const isRequired = (form) => form.dataset.requiredDocument === 'true';
    const isSatisfied = (form) => {
        const input = form.querySelector('[data-document-upload]');

        return form.dataset.uploaded === 'true' || Boolean(input?.files?.length);
    };
    const updateContinueButton = () => {
        const allRequiredDocumentsSelected = forms
            .filter(isRequired)
            .every(isSatisfied);

        continueButton.disabled = !allRequiredDocumentsSelected;
    };
    const uploadForm = async (form) => {
        const input = form.querySelector('[data-document-upload]');
        const status = form.querySelector('[data-upload-status]');
        const errorFlash = form.parentElement.querySelector('[data-document-upload-error]');
        const formData = new FormData(form);
        const originalFileName = input.files[0]?.name ?? '';

        input.disabled = true;
        status.textContent = 'Téléversement en cours…';

        try {
            const response = await fetch(form.action, {
                method: form.method,
                body: formData,
                credentials: 'same-origin',
                headers: {
                    Accept: 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });
            const result = await response.json().catch(() => ({
                success: false,
                message: 'Le serveur n’a pas pu traiter ce document. Veuillez réessayer.'
            }));

            if (!response.ok || !result.success) {
                const uploadError = new Error(result.message || 'Le téléversement a échoué.');
                uploadError.submissionLimitReached = Boolean(result.submissionLimitReached);

                throw uploadError;
            }

            form.dataset.uploaded = 'true';
            status.textContent = 'Téléversé';
            errorFlash.hidden = true;
            const removeFile = form.querySelector('[data-remove-file]');
            removeFile.textContent = originalFileName;
            removeFile.classList.add('finish-setup__remove-file--uploaded');

            return result;
        } catch (error) {
            input.disabled = false;
            status.textContent = error.message || 'Erreur de téléversement';
            errorFlash.textContent = error.message || 'Erreur de téléversement';
            errorFlash.hidden = false;
            throw error;
        }
    };

    forms.forEach((form) => {
        const input = form.querySelector('[data-document-upload]');
        const status = form.querySelector('[data-upload-status]');
        const formats = form.parentElement.querySelector('[data-document-formats]');
        const uploadLabel = form.querySelector('.finish-setup__upload');
        const removeFile = form.querySelector('[data-remove-file]');
        const errorFlash = form.parentElement.querySelector('[data-document-upload-error]');

        input.addEventListener('change', () => {
            errorFlash.hidden = true;

            if (input.files.length) {
                form.dataset.uploaded = 'false';
                formats.textContent = input.files[0].name;
                uploadLabel.hidden = true;
                removeFile.hidden = false;
                removeFile.textContent = 'Supprimer';
                removeFile.classList.remove('finish-setup__remove-file--uploaded');
            } else {
                status.textContent = 'Téléverser';
                formats.textContent = formats.dataset.defaultFormats;
                uploadLabel.hidden = false;
                removeFile.hidden = true;
            }

            updateContinueButton();
        });

        removeFile.addEventListener('click', () => {
            if (input.disabled) {
                return;
            }

            input.value = '';
            input.dispatchEvent(new Event('change'));
        });
    });

    continueButton.addEventListener('click', async () => {
        const formsToUpload = forms.filter((form) => {
            const input = form.querySelector('[data-document-upload]');

            return input.files.length && form.dataset.uploaded !== 'true';
        });

        if (!formsToUpload.length) {
            return;
        }

        continueButton.disabled = true;
        continueButton.textContent = 'Téléversement en cours…';

        try {
            for (const form of formsToUpload) {
                const result = await uploadForm(form);
                continueButton.dataset.documentsComplete = result.documentsComplete ? 'true' : 'false';
            }

            if (documentConfirmation) {
                documentConfirmation.hidden = false;
                continueButton.replaceWith(documentConfirmation);
            } else {
                continueButton.remove();
            }
        } catch (error) {
            if (error.submissionLimitReached && documentLimitMessage) {
                documentLimitMessage.hidden = false;
            }

            // Le statut détaillé est affiché sur la ligne du document en erreur.
        } finally {
            continueButton.textContent = 'Continuer';
            updateContinueButton();
        }
    });

    updateContinueButton();
});
</script>

