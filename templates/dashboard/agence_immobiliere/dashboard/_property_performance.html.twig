<turbo-frame
    id="dashboard-property-performance"
    data-dashboard-property-performance-target="frame"
>
    {% set documents_validated = is_granted(constant('App\\Security\\Voter\\AgencyDocumentVoter::ACCESS_RESTRICTED_DASHBOARD')) %}

    <div
        class="property-list{{ documents_validated ? '' : ' dashboard-preview-blur' }}"
        {% if not documents_validated %}style="filter: blur(8px) !important; pointer-events: none; user-select: none;"{% endif %}
    >
        {% for property in affiche_performance_annonce %}
            <article class="property-item">
                <div class="d-flex align-items-center property-main">
                    <div class="property-image-wrapper">
                        {% set imagePerformance = property.propertyImages|first %}
                        {% if imagePerformance %}
                            <img src="{{ vich_uploader_asset(imagePerformance, 'imageFile') }}" alt="">
                        {% endif %}
                    </div>

                    <div class="property-information">
                        <h3 class="property-title">{{ property.referenceInterne }}</h3>
                        <div class="d-flex align-items-center property-price-line">
                            {% set price = property.prix ?? property.montantLoyerHorsCharge %}
                            <span class="property-price">
                                {{ price|number_format(0, ',', ' ') }}
                                {{ property.user.devise.signe|default('') }}
                            </span>
                            <span class="property-status property-status-published">{{ property.statut.value|capitalize }}</span>
                            {% if property.id in boosted_property_ids %}
                                <div class="property-status property-status-boosted">Boost</div>
                            {% endif %}
                        </div>
                        <p class="property-location">
                            <strong>{{ property.ville }}, {{ property.pays }}</strong>
                            <span>- Créée le {{ property.createdAt|date('d/m/Y') }}</span>
                        </p>
                        <span class="property-reference">{{ property.referenceInterne }}</span>
                    </div>
                </div>

                <div class="property-statistics">
                    <span class="property-statistic">
                        <i class="icon-eye"></i>
                        {{ view_counts[property.id]|default(0) }}
                    </span>
                    <span class="property-statistic">
                        <i class="icon-heart"></i>
                        {{ favorite_counts[property.id]|default(0) }}
                    </span>
                </div>

                {% if property.id not in boosted_property_ids %}
                    <button
                        class="btn property-boost-button"
                        type="button"
                        data-bs-toggle="modal"
                        data-bs-target="#propertyPerformanceBoostModal{{ property.id }}"
                    >
                        <i class="icon-zap"></i>
                        Booster
                    </button>
                {% endif %}

            </article>

            {% if property.id not in boosted_property_ids %}
                <div
                    id="propertyPerformanceBoostModal{{ property.id }}"
                    class="modal fade"
                    tabindex="-1"
                    aria-labelledby="propertyPerformanceBoostModalTitle{{ property.id }}"
                    aria-hidden="true"
                >
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content property-performance-boost-modal">
                            <div class="modal-header">
                                <h2
                                    id="propertyPerformanceBoostModalTitle{{ property.id }}"
                                    class="modal-title fs-5"
                                >
                                    Booster cette annonce
                                </h2>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                            </div>

                            <div class="modal-body">
                                <p class="property-performance-boost-listing">
                                    {{ property.titreDuLogement ?: property.referenceInterne ?: 'Annonce sans titre' }}
                                </p>

                                {% if boostPreview.available < 1 %}
                                    <p class="property-performance-boost-empty">
                                        Vous n’avez plus de boost disponible.
                                        Achetez un pack boost pour mettre cette annonce en avant.
                                    </p>
                                {% else %}
                                    <ul class="property-performance-boost-details">
                                        <li>
                                            <span>Boosts restants</span>
                                            <strong>{{ boostPreview.available }}</strong>
                                        </li>
                                        <li>
                                            <span>Durée de mise en avant</span>
                                            <strong>
                                                {{ boostPreview.durationDays }}
                                                jour{{ boostPreview.durationDays > 1 ? 's' : '' }}
                                            </strong>
                                        </li>
                                        <li>
                                            <span>Boost décompté sur</span>
                                            <strong>
                                                {{ boostPreview.source == 'subscription'
                                                    ? 'votre forfait'
                                                    : 'vos boosts achetés' }}
                                            </strong>
                                        </li>
                                    </ul>

                                    <p class="property-performance-boost-warning">
                                        Cette action est définitive : le boost sera activé
                                        immédiatement et décompté de votre solde.
                                    </p>
                                {% endif %}
                            </div>

                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                    Annuler
                                </button>

                                {% if boostPreview.available >= 1 %}
                                    <form
                                        method="post"
                                        action="{{ path('agence_immobiliere_mes_biens_boost', {id: property.id}) }}"
                                        data-turbo-frame="_top"
                                    >
                                        <input
                                            type="hidden"
                                            name="_property_token"
                                            value="{{ csrf_token('property_boost_' ~ property.id) }}"
                                        >
                                        <input
                                            type="hidden"
                                            name="_redirect_route"
                                            value="agence_immobiliere_dashboard"
                                        >

                                        <button type="submit" class="btn btn-primary">
                                            Confirmer le boost
                                        </button>
                                    </form>
                                {% else %}
                                    <a
                                        class="btn btn-primary"
                                        href="{{ path('agence_immobiliere_options') }}#boosts"
                                        data-turbo-frame="_top"
                                    >
                                        Voir les packs boost
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}
        {% else %}
            <p class="mb-0">Aucune annonce à afficher.</p>
        {% endfor %}
    </div>

    {{ knp_pagination_render(
        affiche_performance_annonce,
        'pagination/dashboard_property_performance.html.twig',
    ) }}
</turbo-frame>
