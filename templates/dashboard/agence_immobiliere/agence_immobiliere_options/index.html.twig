{#
 Template: templates/dashboard/agence_immobiliere/agence_immobiliere_options/index.html.twig
 Role: Renders the dashboard/agence_immobiliere/agence_immobiliere_options Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

{% extends 'base.html.twig' %}

{#
 Caractéristiques d'un forfait : contenu libre saisi dans la description
 (une puce par ligne non vide) ; à défaut, valeurs calculées du forfait.
#}
{#
 Carte d'un forfait pour une périodicité donnée.
 entry = { plan, price } ; period = 'monthly' | 'annual'.
#}
{% macro plan_card(entry, period, currentPlanPriceId, abonnement_actuel) %}
    {% import _self as forfait_ui %}

    {% set plan = entry.plan %}
    {% set price = entry.price %}
    {% set canSubscribe = not plan.isFree and price.id != currentPlanPriceId %}
    {% set isCurrentPlan = abonnement_actuel
        and abonnement_actuel.planPrice
        and abonnement_actuel.planPrice.id == price.id
    %}

    <div class="col-12 col-lg-4 d-flex">
        <article
            class="achat-pricing-card {{ plan.isFree ? 'achat-basic-card' : '' }} {{ isCurrentPlan ? 'achat-current-pricing-card' : '' }} w-100"
        >
            <div>
                {# Repère du forfait souscrit, réservé aux offres payantes. #}
                {% if isCurrentPlan and not plan.isFree %}
                    <p class="p-accent mb-3" style="color:#5d00ff">Abonnement actuel</p>
                {% endif %}
                <h3>
                    {{ plan.name }}
                </h3>

                <h2 class="achat-price">
                    {% if plan.isFree %}
                        Gratuit
                    {% else %}
                        <span class="achat-price-value">
                            {{ (price.amountMinor / 100)|number_format(2, ',', ' ') }}
                            {{ price.currency.signe }}
                        </span>

                        <span class="achat-price-period p-accent">
                            {{ period == 'annual' ? '/an' : '/mois' }}
                        </span>
                    {% endif %}
                </h2>

                <div class="achat-feature-list">
                    {{ forfait_ui.plan_features(plan) }}
                </div>
            </div>

            {% if not plan.isFree %}
                <a
                    href="{{ path('agence_immobiliere_achat', {id: plan.id, period: period}) }}"
                    class="btn-full-blue w-100 {{ canSubscribe ? '' : 'd-none' }}"
                >
                    Souscrire
                </a>
            {% endif %}
        </article>
    </div>
{% endmacro %}

{% macro plan_features(plan) %}
    {% if plan.description|trim %}
        {% for ligne in plan.description|split('\n') %}
            {% if ligne|trim is not empty %}
                <p>{{ ligne|trim }}</p>
            {% endif %}
        {% endfor %}
    {% else %}
        <p>
            <strong>
                ✓
                {{ plan.propertyLimit is null
                    ? 'Biens illimités'
                    : plan.propertyLimit ~ ' biens'
                }}
            </strong>
        </p>

        <p>
            <strong>
                ✓
                {{ plan.includedBoosts }}
                boost{{ plan.includedBoosts > 1 ? 's' : '' }}
                inclus
            </strong>
        </p>

        <p>
            Durée d’un boost :
            {{ plan.boostDurationDays }}
            jours
        </p>
    {% endif %}
{% endmacro %}

{% block title %}
    Options et abonnements
{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    <style>
        .subscription-card {
            padding: 24px;
            background: #ffffff;
            border: 2px solid #ebecec;
            border-radius: 24px;
            margin-bottom: 24px;
        }

        .subscription-card-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 25px;
            margin-bottom: 33px;
        }

        .subscription-card-title {
            margin: 0 0 6px;
            color: #171717;
            font-size: 24px;
            line-height: 1.2;
            font-weight: 700;
        }

        .subscription-card-subtitle {
            margin: 0;
            color: #747474;
            font-size: 15px;
            line-height: 1.4;
        }

        .subscription-status {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 32px;
            padding: 5px 12px;
            background: #e2f3e7;
            border-radius: 9999px;
            color: #2a7f48;
            font-size: 12px;
            line-height: 1;
            font-weight: 600;
        }

        .subscription-status.cancelled {
            background: #fff2f2;
            color: #d43b4b;
        }

        .subscription-status.pending {
            background: #fff7df;
            color: #a56c00;
        }

        .subscription-details {
            display: grid;
            grid-template-columns:
                minmax(140px, 1fr)
                minmax(140px, 1fr)
                minmax(180px, 1fr)
                minmax(100px, .75fr);
            gap: 30px;
            margin-bottom: 32px;
        }

        .subscription-detail {
            min-width: 0;
        }

        .subscription-detail-label {
            display: block;
            margin-bottom: 7px;
            color: #717171;
            font-size: 11px;
            line-height: 1.3;
            font-weight: 600;
            text-transform: uppercase;
        }

        .subscription-detail-value {
            display: block;
            color: #181818;
            font-size: 15px;
            line-height: 1.4;
            font-weight: 700;
        }

        .subscription-actions {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }

        .btn-subscription-payment {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 48px;
            padding: 0 25px;
            border: none;
            border-radius: 25px;
            background: linear-gradient(
                90deg,
                #7625ec 0%,
                #6518e8 50%,
                #5000db 100%
            );
            color: #ffffff;
            text-decoration: none;
            font-size: 15px;
            line-height: 1;
            font-weight: 700;
            cursor: pointer;
            transition:
                transform .15s ease,
                box-shadow .15s ease;
        }

        .btn-subscription-payment:hover {
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 7px 18px rgba(97, 20, 224, .22);
        }

        .btn-subscription-cancel {
display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 44px;
  padding: 10px 16px;
  border-radius: 50px;
  font-size: 16px;
  font-weight: 600;
  line-height: 20px;
  text-decoration: none;
  white-space: nowrap;
  border: 2px solid #dc3545;
  background: var(--color-white);
  color: #dc3545;
        }

        .btn-subscription-cancel:hover {
            background: #dc3545;
            border-color: #dc3545;
            color: #ffffff;
        }

        .btn-subscription-resume {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 44px;
            padding: 0 22px;
            border: 1px solid #2a7f48;
            border-radius: 8px;
            background: #ffffff;
            color: #2a7f48;
            text-decoration: none;
            font-size: 14px;
            line-height: 1;
            font-weight: 700;
            cursor: pointer;
            transition: all .15s ease;
        }

        .btn-subscription-resume:hover {
            background: #2a7f48;
            border-color: #2a7f48;
            color: #ffffff;
        }

        .subscription-cancellation-info {
            margin-top: 20px;
            padding: 15px 18px;
            border: 1px solid #f3d0d5;
            border-radius: 12px;
            background: #fff8f8;
            color: #9f3340;
            font-size: 14px;
            line-height: 1.5;
        }

        /* Sous 991px : deux détails par ligne (50 % chacun), jusqu'au mobile. */
        @media (max-width: 991px) {
            .subscription-details {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            /* Boutons empilés, en pleine largeur. */
            .subscription-actions {
                flex-direction: column;
                align-items: stretch;
            }

            .subscription-actions .btn-full-blue,
            .btn-subscription-payment,
            .btn-subscription-cancel {
                width: 100%;
            }

            .achat-boost-description {
                text-align: center!important;
            }
        }

        @media (max-width: 700px) {
            .subscription-card {
                padding: 24px 20px;
                border-radius: 20px;
            }

            .subscription-card-header {
                margin-bottom: 32px;
            }

            .subscription-details {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 24px 20px;
            }
        }
    </style>
{% endblock %}

{% block body %}
    {% import _self as forfait_ui %}

    {% set subscription = abonnement_actuel ? {
        plan: abonnement_actuel.plan,
        status: abonnement_actuel.status.value,
        billingPeriod: abonnement_actuel.planPrice ? abonnement_actuel.planPrice.billingPeriod.value : 'monthly',
        currentPeriodEnd: abonnement_actuel.currentPeriodEnd,
        price: abonnement_actuel.amountSnapshotMinor / 100,
        currencySign: abonnement_actuel.currencySnapshot ? abonnement_actuel.currencySnapshot.signe : '€',
        cancelAtPeriodEnd: abonnement_actuel.cancelAtPeriodEnd,
    } : null %}
    {% set selectedPeriod = subscription ? subscription.billingPeriod : 'monthly' %}
    {% set currentPlanPriceId = abonnement_actuel and abonnement_actuel.planPrice
        ? abonnement_actuel.planPrice.id
        : null
    %}

    <main
        id="dashboard"
        class="dashboard"
        data-controller="options--billing-period"
    >
        <div class="container-fluid">
            <div class="row">

                {# Menu du tableau de bord #}
                {{ include('composant/__agence_immobiliere/_tableau_de_bord.html.twig') }}

                {# Contenu du tableau de bord #}
                <div class="col-md-9 col-lg-10 col-12 dashboard-main">
                    <div class="col-12 col-md-10 mx-auto">

                        <div class="achat-title-row d-flex align-items-center justify-content-between">
                            <h2>
                                Options et abonnements
                            </h2>

                                                    <div class="d-flex align-items-center">
                                {{ render(controller('App\\Controller\\Dashboard\\AgenceImmobiliere\\BoostBalanceController::annonce')) }}

                                {{ render(controller('App\\Controller\\Dashboard\\AgenceImmobiliere\\BoostBalanceController::button')) }}

                            </div>
                        </div>

                        {# Flashes propres à l'espace « Options et abonnements ».
                           Les clés génériques (success/error/warning/danger) posées
                           par d'autres pages ne doivent pas apparaître ici. #}
                        {% for message in app.flashes('subscription_success') %}
                            <div class="alert alert-success mt-24 mb-0" role="status">
                                {{ message }}
                            </div>
                        {% endfor %}

                        {% for message in app.flashes('subscription_error') %}
                            <div class="alert alert-danger mt-24 mb-0" role="alert">
                                {{ message }}
                            </div>
                        {% endfor %}

                        {# =====================================================
                           ABONNEMENTS
                           ===================================================== #}

                        <h3 class="mb-4">
                            Choisissez votre abonnement
                        </h3>

        {# Le cadre « Abonnement » n'a de sens que pour un forfait payant.
           Sur une offre gratuite, on n'affiche que le choix des forfaits et des boosts. #}
        {% if subscription and not subscription.plan.isFree %}

            <section class="subscription-card">

                <div class="subscription-card-header">

                    <div>

                        <div class="p-accent" style="color:#858789;">
                            Abonnement actuel
                        </div>
                    </div>

                    {% if subscription.status in ['active', 'free'] %}

                        <span class="subscription-status paragraphe">
                            Actif
                        </span>

                    {% elseif subscription.status|default('') == 'canceled' %}

                        <span class="subscription-status cancelled paragraphe">
                            Résilié
                        </span>

                    {% else %}

                        <span class="subscription-status pending paragraphe">
                            En attente
                        </span>

                    {% endif %}

                </div>

                {# ==================================================
                   DETAILS
                ================================================== #}

                <div class="subscription-details">

                    <div class="subscription-detail">

                        <span class="subscription-detail-label">
                            Forfait
                        </span>

                        <span class="subscription-detail-value p-accent">

                            {% if subscription.plan is defined and subscription.plan %}

                                {{ subscription.plan.name }}

                            {% else %}

                                Non renseigné

                            {% endif %}

                        </span>

                    </div>

                    <div class="subscription-detail">

                        <span class="subscription-detail-label">
                            Périodicité
                        </span>

                        <span class="subscription-detail-value p-accent">

                            {% if subscription.billingPeriod == 'annual' %}

                                Annuelle

                            {% else %}

                                Mensuelle

                            {% endif %}

                        </span>

                    </div>

                    <div class="subscription-detail">

                        <span class="subscription-detail-label">
                            Prochain
                           
                            renouvellement
                        </span>

                        <span class="subscription-detail-value p-accent">

                            {% if subscription.currentPeriodEnd is defined and subscription.currentPeriodEnd %}

                                {{ subscription.currentPeriodEnd|date('d/m/Y') }}

                            {% elseif subscription.endDate is defined and subscription.endDate %}

                                {{ subscription.endDate|date('d/m/Y') }}

                            {% else %}

                                Non renseigné

                            {% endif %}

                        </span>

                    </div>

                    <div class="subscription-detail">

                        <span class="subscription-detail-label">
                            Prix
                        </span>

                        <span class="subscription-detail-value p-accent">

                            {% if subscription.price is defined %}

                                {{ subscription.price|number_format(2, ',', ' ') }}
                                {{ subscription.currencySign }}

                            {% elseif subscription.plan is defined
                                and subscription.plan
                                and subscription.plan.price is defined %}

                                {{ subscription.plan.price|number_format(2, ',', ' ') }}
                                €

                            {% else %}

                                Non renseigné

                            {% endif %}

                        </span>

                    </div>

                </div>

                {# ==================================================
                   ACTIONS
                ================================================== #}

                <div class="subscription-actions">

                    <a
                        href="{{ path('agence_immobiliere_parametres') }}#cat4"
                        class="btn-full-blue"
                    >
                        Mettre à jour mon moyen de paiement
                    </a>

                    {% if not subscription.plan.isFree and not subscription.cancelAtPeriodEnd %}

                        <button
                            type="button"
                            class="btn-subscription-cancel"
                            data-bs-toggle="modal"
                            data-bs-target="#cancelSubscriptionModal"
                        >
                            Résilier mon abonnement
                        </button>

                    {% elseif subscription.cancelAtPeriodEnd %}

                        <span class="subscription-status cancelled">
                            Résiliation programmée
                        </span>

                    {% endif %}

                </div>

                {% if subscription.cancelAtPeriodEnd|default(false) %}

                    <div class="subscription-cancellation-info">

                        Votre abonnement est résilié.

                        Il restera actif jusqu'au

                        {% if subscription.currentPeriodEnd is defined
                            and subscription.currentPeriodEnd %}

                            <strong>
                                {{ subscription.currentPeriodEnd|date('d/m/Y') }}
                            </strong>

                        {% elseif subscription.endDate is defined
                            and subscription.endDate %}

                            <strong>
                                {{ subscription.endDate|date('d/m/Y') }}
                            </strong>

                        {% endif %}

                        puis votre compte repassera automatiquement
                        sur le forfait gratuit.

                        <form
                            method="post"
                            action="{{ path('account_subscription_reactivate') }}"
                            class="mt-2"
                        >
                            <input
                                type="hidden"
                                name="_token"
                                value="{{ csrf_token('account_subscription_reactivate') }}"
                            >

                            <input
                                type="hidden"
                                name="_redirect_route"
                                value="agence_immobiliere_options"
                            >

                            <button type="submit" class="btn-subscription-resume">
                                Annuler la résiliation
                            </button>
                        </form>

                    </div>

                {% endif %}

                {% if abonnement_actuel and abonnement_actuel.hasPendingPlanChange %}

                    <div class="subscription-cancellation-info">

                        Changement de forfait programmé pour

                        <strong>{{ abonnement_actuel.pendingPlanPrice.plan.name }}</strong>

                        {% if abonnement_actuel.pendingPlanChangeEffectiveAt %}
                            le
                            <strong>
                                {{ abonnement_actuel.pendingPlanChangeEffectiveAt|date('d/m/Y') }}
                            </strong>
                        {% else %}
                            à la fin de votre période en cours
                        {% endif %}.

                        Le paiement de

                        <strong>
                            {{ (abonnement_actuel.pendingPlanPrice.amountMinor / 100)|number_format(2, ',', ' ') }}
                            {{ abonnement_actuel.pendingPlanPrice.currency.signe }}
                        </strong>

                        sera effectué ce jour-là. D'ici là, votre forfait actuel reste inchangé.

                        <form
                            method="post"
                            action="{{ path('account_subscription_cancel_plan_change') }}"
                            class="mt-2"
                        >
                            <input
                                type="hidden"
                                name="_token"
                                value="{{ csrf_token('account_subscription_cancel_plan_change') }}"
                            >

                            <input
                                type="hidden"
                                name="_redirect_route"
                                value="agence_immobiliere_options"
                            >

                            <button type="submit" class="btn-subscription-cancel">
                                Annuler le changement programmé
                            </button>
                        </form>

                    </div>

                {% endif %}

            </section>

        {% endif %}

                        <div
                            class="achat-billing-switch mx-auto"
                            role="group"
                            aria-label="Période de facturation"
                        >
                            <button
                                type="button"
                                class="achat-billing-option p-accent {{ selectedPeriod == 'annual' ? 'achat-active' : '' }}"
                                data-period="annual"
                                data-options--billing-period-target="option"
                                data-action="click->options--billing-period#select"
                                aria-pressed="{{ selectedPeriod == 'annual' ? 'true' : 'false' }}"
                            >
                                Annuel
                            </button>

                            <button
                                type="button"
                                class="achat-billing-option p-accent {{ selectedPeriod == 'monthly' ? 'achat-active' : '' }}"
                                data-period="monthly"
                                data-options--billing-period-target="option"
                                data-action="click->options--billing-period#select"
                                aria-pressed="{{ selectedPeriod == 'monthly' ? 'true' : 'false' }}"
                            >
                                Mensuel
                            </button>
                        </div>

                        {% for period, entries in forfaits %}
                            <section
                                class="row g-4 achat-plans-grid {{ selectedPeriod == period ? '' : 'd-none' }}"
                                data-options--billing-period-target="group"
                                data-period="{{ period }}"
                            >
                                {% for entry in entries %}
                                    {{ forfait_ui.plan_card(
                                        entry,
                                        period,
                                        currentPlanPriceId,
                                        abonnement_actuel,
                                    ) }}
                                {% else %}
                                    <div class="col-12">
                                        <p>
                                            Aucun forfait
                                            {{ period == 'annual' ? 'annuel' : 'mensuel' }}
                                            n’est disponible pour le moment.
                                        </p>
                                    </div>
                                {% endfor %}
                            </section>
                        {% endfor %}

                        {# =====================================================
                           BOOSTS
                           ===================================================== #}

                        <h3 class="achat-boost-title">
                            Boostez vos annonces
                        </h3>

                        <section id="boosts" class="achat-boost-card">
                            <div class="row g-4"> 

{% set boostImages = [
    asset('images/boost/01.png'),
    asset('images/boost/02.png'),
    asset('images/boost/03.png')
] %}

                                {% for boostPrice in packs_boost %}

                                    {% set pack = boostPrice.boosterPack %}

                                    <div class="col-12 col-lg-4">
                                        <article class="achat-boost-item h-100">

                                            <img
                                                src="{{ boostImages[loop.index0] ?? boostImages[0] }}"
                                                alt="{{ pack.name }}"
                                                class="achat-boost-image"
                                            >

                                            <h2>
                                                {{ pack.name }}
                                            </h2>

                                            <h3 class="achat-boost-price">
                                                {{ (boostPrice.amountMinor / 100)|number_format(2, ',', ' ') }}
                                                {{ boostPrice.currency.signe }}
                                            </h3>

                                            <p class="achat-boost-description">
                                                {{ pack.description
                                                    ?: pack.boostQuantity
                                                    ~ ' boost'
                                                    ~ (pack.boostQuantity > 1 ? 's' : '')
                                                    ~ ' s’applique sur '
                                                    ~ pack.boostQuantity
                                                    ~ ' annonce'
                                                    ~ (pack.boostQuantity > 1 ? 's' : '')
                                                    ~ ' et dure '
                                                    ~ pack.boostDurationDays
                                                    ~ ' jours.'
                                                }}
                                            </p>

                                            <a
                                                href="{{ path('agence_immobiliere_boost', {id: boostPrice.id}) }}"
                                                class="btn-full-white w-100"
                                            >
                                                Acheter
                                            </a>

                                        </article>
                                    </div>

                                {% else %}

                                    <div class="col-12">
                                        <p>
                                            Aucun pack boost n’est disponible pour le moment.
                                        </p>
                                    </div>

                                {% endfor %}

                            </div>
                        </section>

                    </div>
                </div>
            </div>
        </div>
    </main>

    {% if subscription and not subscription.plan.isFree and not subscription.cancelAtPeriodEnd %}
        <div
            class="modal fade"
            id="cancelSubscriptionModal"
            tabindex="-1"
            aria-labelledby="cancelSubscriptionModalLabel"
            aria-hidden="true"
        >
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content" style="border-radius: 24px; border: 0;padding:24px">
                    <div class="modal-header border-0 py-0 px-0 justify-content-center position-relative">
                        <h3
                            class="mb-0 text-center"
                            id="cancelSubscriptionModalLabel"
                            style="color:#0b0f14"
                        >
                            Résilier mon abonnement
                        </h3>

                        <button
                            type="button"
                            class="btn-close position-absolute top-0 end-0"
                            data-bs-dismiss="modal"
                            aria-label="Fermer"
                            style="padding-top:17px"
                        ></button>
                    </div>

                    <div class="p-accent my-48 text-center">
                        <p class="mb-2 p-accent" style="color:#0b0f14">
                            Êtes-vous certain de vouloir résilier votre abonnement ?
                        </p>

                        <p class="text-muted mb-0 paragraphe" style="color:#858789!important">
                            Votre abonnement restera actif jusqu'à la fin de votre période de facturation actuelle.
                        </p>
                    </div>

                    <div class="modal-footer" style="margin-top:0;padding:0; border-top:transparent; display:flex; flex-wrap:nowrap; justify-content:space-between; gap:12px">
                        <button
                            type="button"
                            class="btn-full-white"
                            data-bs-dismiss="modal"
                        >
                            Annuler
                        </button>

                        <form
                            method="post"
                            action="{{ path('account_subscription_cancel') }}"
                        >
                            <input
                                type="hidden"
                                name="_token"
                                value="{{ csrf_token('account_subscription_cancel') }}"
                            >

                            <input
                                type="hidden"
                                name="_redirect_route"
                                value="agence_immobiliere_options"
                            >

                            <button
                                type="submit"
                                class="btn-subscription-cancel"
                                style="color:#fff;background:#dc3545"
                            >
                                Confirmer la résiliation
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

{% endblock %}
