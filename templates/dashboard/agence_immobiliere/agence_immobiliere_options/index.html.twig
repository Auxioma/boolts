{#
 Template: templates/dashboard/agence_immobiliere/agence_immobiliere_options/index.html.twig
 Role: Renders the dashboard/agence_immobiliere/agence_immobiliere_options Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

{% extends 'base.html.twig' %}

{% block title %}
	Options et abonnements
{% endblock %}

{% block body %}

	<style>
		/* =========================================================
		   MOYENS DE PAIEMENT
		   ========================================================= */

		.achat-payment-section {
			margin-top: 48px;
			margin-bottom: 48px;
		}

		.achat-payment-section-title {
			margin-bottom: 24px;
		}

		.achat-payment-wrapper {
			border: 1px solid #e7e7ec;
			border-radius: 16px;
			background-color: #ffffff;
			overflow: hidden;
		}

		.achat-payment-header {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 24px;
			padding: 24px;
		}

		.achat-payment-header-content {
			display: flex;
			align-items: center;
			gap: 16px;
			min-width: 0;
		}

		.achat-payment-icon {
			display: flex;
			flex: 0 0 48px;
			align-items: center;
			justify-content: center;
			width: 48px;
			height: 48px;
			border-radius: 12px;
			background-color: #f5f1ff;
			color: #5d00ff;
		}

		.achat-payment-header-text {
			min-width: 0;
		}

		.achat-payment-header-text h3 {
			margin: 0 0 6px;
			font-size: 16px;
			font-weight: 700;
			line-height: 1.4;
			color: #1d1d26;
		}

		.achat-payment-header-text p {
			margin: 0;
			font-size: 14px;
			line-height: 1.5;
			color: #6d6d78;
		}

		.achat-payment-modify {
			flex-shrink: 0;
			padding: 10px 18px;
			border: 1px solid #5d00ff;
			border-radius: 10px;
			background-color: #ffffff;
			color: #5d00ff;
			font-size: 14px;
			font-weight: 700;
			transition:
				background-color 0.2s ease,
				color 0.2s ease;
		}

		.achat-payment-modify:hover,
		.achat-payment-modify:focus {
			background-color: #5d00ff;
			color: #ffffff;
		}

		.achat-payment-list-container {
			padding: 0 24px 24px;
			border-top: 1px solid #ededf1;
		}

		.achat-payment-list-title {
			margin: 24px 0 16px;
			font-size: 15px;
			font-weight: 700;
			color: #1d1d26;
		}

		.achat-payment-list {
			display: flex;
			flex-direction: column;
			gap: 12px;
		}

		.achat-payment-card-option {
			position: relative;
			display: flex;
			align-items: center;
			gap: 16px;
			width: 100%;
			margin: 0;
			padding: 16px;
			border: 1px solid #dedee5;
			border-radius: 12px;
			background-color: #ffffff;
			cursor: pointer;
			transition:
				border-color 0.2s ease,
				box-shadow 0.2s ease,
				background-color 0.2s ease;
		}

		.achat-payment-card-option:hover {
			border-color: #b99dff;
			background-color: #faf8ff;
		}

		.achat-payment-card-option.achat-payment-card-selected {
			border-color: #5d00ff;
			background-color: #faf8ff;
			box-shadow: 0 0 0 2px rgba(93, 0, 255, 0.08);
		}

		.achat-payment-radio {
			position: absolute;
			width: 1px;
			height: 1px;
			padding: 0;
			margin: -1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
			white-space: nowrap;
			border: 0;
		}

		.achat-payment-radio-visual {
			position: relative;
			display: block;
			flex: 0 0 20px;
			width: 20px;
			height: 20px;
			border: 2px solid #babac4;
			border-radius: 50%;
			background-color: #ffffff;
		}

		.achat-payment-radio:checked + .achat-payment-radio-visual {
			border-color: #5d00ff;
		}

		.achat-payment-radio:checked + .achat-payment-radio-visual::after {
			position: absolute;
			top: 50%;
			left: 50%;
			width: 10px;
			height: 10px;
			border-radius: 50%;
			background-color: #5d00ff;
			content: "";
			transform: translate(-50%, -50%);
		}

		.achat-payment-brand-logo {
			display: flex;
			flex: 0 0 54px;
			align-items: center;
			justify-content: center;
			width: 54px;
			height: 36px;
			padding: 5px;
			border: 1px solid #e8e8ed;
			border-radius: 8px;
			background-color: #ffffff;
		}

		.achat-payment-brand-logo img {
			display: block;
			max-width: 42px;
			max-height: 24px;
			object-fit: contain;
		}

		.achat-payment-brand-text {
			font-size: 11px;
			font-weight: 800;
			text-transform: uppercase;
			color: #33333d;
		}

		.achat-payment-card-information {
			display: flex;
			flex: 1;
			align-items: center;
			justify-content: space-between;
			gap: 20px;
			min-width: 0;
		}

		.achat-payment-card-number {
			margin: 0 0 4px;
			font-size: 15px;
			font-weight: 700;
			color: #1d1d26;
		}

		.achat-payment-card-expiration {
			margin: 0;
			font-size: 13px;
			color: #747480;
		}

		.achat-payment-default-badge {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			padding: 6px 10px;
			border-radius: 999px;
			background-color: #eee7ff;
			color: #5d00ff;
			font-size: 12px;
			font-weight: 700;
			white-space: nowrap;
		}

		.achat-payment-actions {
			display: flex;
			align-items: center;
			justify-content: flex-end;
			gap: 12px;
			margin-top: 20px;
		}

		.achat-payment-cancel,
		.achat-payment-confirm {
			min-height: 44px;
			padding: 10px 18px;
			border-radius: 10px;
			font-size: 14px;
			font-weight: 700;
		}

		.achat-payment-cancel {
			border: 1px solid #d7d7df;
			background-color: #ffffff;
			color: #44444f;
		}

		.achat-payment-cancel:hover {
			background-color: #f7f7f9;
		}

		.achat-payment-confirm {
			border: 1px solid #5d00ff;
			background-color: #5d00ff;
			color: #ffffff;
		}

		.achat-payment-confirm:hover {
			border-color: #4900c9;
			background-color: #4900c9;
		}

		.achat-payment-confirm:disabled {
			border-color: #b9a0f2;
			background-color: #b9a0f2;
			cursor: not-allowed;
		}

		.achat-payment-empty {
			padding: 24px;
			color: #747480;
		}

		.achat-payment-feedback {
			display: none;
			margin-top: 16px;
			padding: 12px 14px;
			border-radius: 10px;
			font-size: 14px;
			font-weight: 600;
		}

		.achat-payment-feedback.is-visible {
			display: block;
		}

		.achat-payment-feedback.is-success {
			border: 1px solid #b7e4c7;
			background-color: #edf9f1;
			color: #176b39;
		}

		.achat-payment-feedback.is-error {
			border: 1px solid #f4b8b8;
			background-color: #fff1f1;
			color: #a52626;
		}

		@media (max-width: 767.98px) {
			.achat-payment-header {
				align-items: flex-start;
				flex-direction: column;
			}

			.achat-payment-modify {
				width: 100%;
			}

			.achat-payment-card-information {
				align-items: flex-start;
				flex-direction: column;
				gap: 8px;
			}

			.achat-payment-actions {
				align-items: stretch;
				flex-direction: column-reverse;
			}

			.achat-payment-cancel,
			.achat-payment-confirm {
				width: 100%;
			}
		}
	</style>

	<main id="dashboard" class="dashboard">
		<div class="container-fluid">
			<div class="row">

				{# Menu du tableau de bord #}
				{{ include('composant/__agence_immobiliere/_tableau_de_bord.html.twig') }}

				{# Contenu du tableau de bord #}
				<div class="col-10">
					<div class="container pt-48 achat-content-shell px-0">

						<div class="achat-title-row d-flex align-items-center justify-content-between">
							<h1>
								Options et abonnements
							</h1>

							<button
								class="btn achat-btn-outline-brand achat-boost-balance"
								type="button"
							>
								<img
									src="https://www.figma.com/api/mcp/asset/4abf21cc-aaec-40db-aef8-19e91701de8e"
									alt=""
									class="achat-icon-24"
								>

								<span>
									Boost : 4
								</span>
							</button>
						</div>

						{# =====================================================
						   MOYENS DE PAIEMENT
						   ===================================================== #}

						{% set registeredPaymentMethods = payment_methods|default([]) %}

						{% set defaultPaymentMethod = null %}

						{% for paymentMethod in registeredPaymentMethods %}
							{% if defaultPaymentMethod is null and paymentMethod.isDefault|default(false) %}
								{% set defaultPaymentMethod = paymentMethod %}
							{% endif %}
						{% endfor %}

						{% if defaultPaymentMethod is null and registeredPaymentMethods|length > 0 %}
							{% set defaultPaymentMethod = registeredPaymentMethods|first %}
						{% endif %}

						<section
							class="achat-payment-section"
							data-payment-methods-section
						>
							<h2 class="achat-payment-section-title">
								Moyen de paiement
							</h2>

							<div class="achat-payment-wrapper">

								{% if defaultPaymentMethod %}

									{% set currentBrand = defaultPaymentMethod.brand|default('Carte') %}
									{% set currentLast4 = defaultPaymentMethod.last4|default('') %}
									{% set currentExpMonth = defaultPaymentMethod.expMonth|default('') %}
									{% set currentExpYear = defaultPaymentMethod.expYear|default('') %}

									<div class="achat-payment-header">
										<div class="achat-payment-header-content">

											<div class="achat-payment-icon" aria-hidden="true">
												<svg
													width="24"
													height="24"
													viewBox="0 0 24 24"
													fill="none"
													stroke="currentColor"
													stroke-width="2"
													stroke-linecap="round"
													stroke-linejoin="round"
												>
													<rect x="2" y="5" width="20" height="14" rx="2"></rect>
													<path d="M2 10h20"></path>
												</svg>
											</div>

											<div class="achat-payment-header-text">
												<h3>
													Carte utilisée pour le paiement
												</h3>

												<p data-current-payment-description>
													{{ currentBrand|upper }}
													•••• {{ currentLast4 }}

													{% if currentExpMonth and currentExpYear %}
														— expire le
														{{ '%02d'|format(currentExpMonth) }}/{{ currentExpYear }}
													{% endif %}
												</p>
											</div>
										</div>

										<button
											type="button"
											class="achat-payment-modify"
											data-payment-modify
											aria-expanded="false"
											aria-controls="achat-payment-methods-list"
										>
											Modifier
										</button>
									</div>

									<div
										id="achat-payment-methods-list"
										class="achat-payment-list-container d-none"
										data-payment-list-container
									>
										<p class="achat-payment-list-title">
											Choisissez une carte bancaire
										</p>

										<div class="achat-payment-list">

											{% for paymentMethod in registeredPaymentMethods %}

												{% set paymentMethodId = paymentMethod.id|default(loop.index) %}
												{% set brand = paymentMethod.brand|default('Carte') %}
												{% set normalizedBrand = brand|lower %}
												{% set last4 = paymentMethod.last4|default('') %}
												{% set expMonth = paymentMethod.expMonth|default('') %}
												{% set expYear = paymentMethod.expYear|default('') %}

												{% set isSelectedPaymentMethod =
													defaultPaymentMethod.id|default(null) == paymentMethod.id|default(null)
												%}

												<label
													class="achat-payment-card-option {{ isSelectedPaymentMethod ? 'achat-payment-card-selected' : '' }}"
													data-payment-card-option
													data-payment-id="{{ paymentMethodId }}"
													data-payment-brand="{{ brand }}"
													data-payment-last4="{{ last4 }}"
													data-payment-exp-month="{{ expMonth }}"
													data-payment-exp-year="{{ expYear }}"
												>
													<input
														type="radio"
														name="selected_payment_method"
														value="{{ paymentMethodId }}"
														class="achat-payment-radio"
														data-payment-radio
														{{ isSelectedPaymentMethod ? 'checked' : '' }}
													>

													<span class="achat-payment-radio-visual"></span>

													<span class="achat-payment-brand-logo">

														{% if normalizedBrand == 'visa' %}

															<svg
																width="42"
																height="16"
																viewBox="0 0 42 16"
																aria-label="Visa"
																role="img"
															>
																<text
																	x="1"
																	y="13"
																	font-size="16"
																	font-family="Arial, sans-serif"
																	font-style="italic"
																	font-weight="900"
																	fill="#1a1f71"
																>VISA</text>
															</svg>

														{% elseif normalizedBrand in ['mastercard', 'master card'] %}

															<svg
																width="38"
																height="24"
																viewBox="0 0 38 24"
																aria-label="Mastercard"
																role="img"
															>
																<circle cx="15" cy="12" r="9" fill="#eb001b"></circle>
																<circle cx="23" cy="12" r="9" fill="#f79e1b"></circle>
																<path
																	d="M19 5.4a9 9 0 0 1 0 13.2 9 9 0 0 1 0-13.2Z"
																	fill="#ff5f00"
																></path>
															</svg>

														{% elseif normalizedBrand in ['amex', 'american express'] %}

															<span class="achat-payment-brand-text">
																AMEX
															</span>

														{% else %}

															<span class="achat-payment-brand-text">
																{{ brand }}
															</span>

														{% endif %}

													</span>

													<span class="achat-payment-card-information">

														<span>
															<span class="achat-payment-card-number">
																{{ brand|capitalize }}
																•••• {{ last4 }}
															</span>

															<span class="achat-payment-card-expiration">
																{% if expMonth and expYear %}
																	Expire le
																	{{ '%02d'|format(expMonth) }}/{{ expYear }}
																{% else %}
																	Date d’expiration non renseignée
																{% endif %}
															</span>
														</span>

														{% if paymentMethod.isDefault|default(false) %}
															<span class="achat-payment-default-badge">
																Par défaut
															</span>
														{% endif %}

													</span>
												</label>

											{% endfor %}

										</div>

										<div
											class="achat-payment-feedback"
											data-payment-feedback
											role="status"
											aria-live="polite"
										></div>

										<div class="achat-payment-actions">
											<button
												type="button"
												class="achat-payment-cancel"
												data-payment-cancel
											>
												Annuler
											</button>

											<button
												type="button"
												class="achat-payment-confirm"
												data-payment-confirm
											>
												Utiliser cette carte
											</button>
										</div>
									</div>

								{% else %}

									<div class="achat-payment-empty">
										Aucune carte bancaire n’est enregistrée.
									</div>

								{% endif %}

							</div>
						</section>

						{# =====================================================
						   ABONNEMENTS
						   ===================================================== #}

						<h2>
							Choisissez votre abonnement
						</h2>

						<div
							class="achat-billing-switch mx-auto"
							role="group"
							aria-label="Période de facturation"
						>
							<button
								type="button"
								class="achat-billing-option"
								data-period="annual"
								aria-pressed="false"
							>
								Annuel
							</button>

							<button
								type="button"
								class="achat-billing-option achat-active"
								data-period="monthly"
								aria-pressed="true"
							>
								Mensuel
							</button>
						</div>

						<section class="row g-4 achat-plans-grid">

							{% for forfait in forfaits %}

								{% set plan = forfait.plan %}
								{% set monthlyPrice = forfait.monthly %}
								{% set annualPrice = forfait.annual %}

								{% set isCurrentPlan =
									abonnement_actuel
									and abonnement_actuel.plan.id == plan.id
								%}

								<div class="col-12 col-lg-4 d-flex">
									<article
										class="achat-pricing-card {{ plan.isFree ? 'achat-basic-card' : '' }} w-100"
									>
										<div>
											<h3>
												{{ plan.name }}
											</h3>

											<p class="achat-price">

												{% if plan.isFree %}

													Gratuit

												{% elseif monthlyPrice %}

													<span
														class="achat-price-value"
														data-monthly="{{ (monthlyPrice.amountMinor / 100)|number_format(2, ',', ' ') }} {{ monthlyPrice.currency.signe }}"
														data-annual="{{ annualPrice ? (annualPrice.amountMinor / 100)|number_format(2, ',', ' ') ~ ' ' ~ annualPrice.currency.signe : '' }}"
													>
														{{ (monthlyPrice.amountMinor / 100)|number_format(2, ',', ' ') }}
														{{ monthlyPrice.currency.signe }}
													</span>

													<span class="achat-price-period">
														/mois
													</span>

												{% endif %}

											</p>

											<div class="achat-feature-list">

												{% if plan.description %}
													<p>
														{{ plan.description }}
													</p>
												{% endif %}

												<p>
													<strong>
														✓
														{{ plan.propertyLimit is null
															? 'Biens illimités'
															: plan.propertyLimit ~ ' biens'
														}}
													</strong>
												</p>

												<p>
													<strong>
														✓
														{{ plan.includedBoosts }}
														boost{{ plan.includedBoosts > 1 ? 's' : '' }}
														inclus
													</strong>
												</p>

												<p>
													Durée d’un boost :
													{{ plan.boostDurationDays }}
													jours
												</p>
											</div>
										</div>

										{% if isCurrentPlan %}

											<button
												class="btn achat-current-plan"
												type="button"
												disabled
											>
												Abonnement actuel
											</button>

										{% else %}

											<a
												href="{{ path('agence_immobiliere_achat', {
													id: plan.id,
													period: 'monthly'
												}) }}"
												data-monthly-url="{{ path('agence_immobiliere_achat', {
													id: plan.id,
													period: 'monthly'
												}) }}"
												data-annual-url="{{ path('agence_immobiliere_achat', {
													id: plan.id,
													period: 'annual'
												}) }}"
												class="btn {{ plan.isFree ? 'achat-current-plan' : 'achat-btn-brand' }} achat-subscribe-link"
											>
												Souscrire
											</a>

										{% endif %}

									</article>
								</div>

							{% else %}

								<div class="col-12">
									<p>
										Aucun forfait n’est disponible pour le moment.
									</p>
								</div>

							{% endfor %}

						</section>

						{# =====================================================
						   BOOSTS
						   ===================================================== #}

						<h2 class="achat-boost-title">
							Boostez vos annonces
						</h2>

						<section class="achat-boost-card">
							<div class="row g-4">

								{% set boostImages = [
									'https://www.figma.com/api/mcp/asset/a00cfadb-c5d2-407a-9a93-c4c1ba50a0fd',
									'https://www.figma.com/api/mcp/asset/971728a4-e716-408a-9189-278ea22e4b1b',
									'https://www.figma.com/api/mcp/asset/66e7e6de-f1f9-4808-9e75-1f0eeae98362'
								] %}

								{% for boostPrice in packs_boost %}

									{% set pack = boostPrice.boosterPack %}

									<div class="col-12 col-md-4">
										<article class="achat-boost-item h-100">

											<img
												src="{{ boostImages[loop.index0] ?? boostImages[0] }}"
												alt="{{ pack.name }}"
												class="achat-boost-image"
											>

											<h3>
												{{ pack.name }}
											</h3>

											<p class="achat-boost-price">
												{{ (boostPrice.amountMinor / 100)|number_format(2, ',', ' ') }}
												{{ boostPrice.currency.signe }}
											</p>

											<p class="achat-boost-description">
												{{ pack.description
													?: pack.boostQuantity
													~ ' boost'
													~ (pack.boostQuantity > 1 ? 's' : '')
													~ ' s’applique sur '
													~ pack.boostQuantity
													~ ' annonce'
													~ (pack.boostQuantity > 1 ? 's' : '')
													~ ' et dure '
													~ pack.boostDurationDays
													~ ' jours.'
												}}
											</p>

											<a
												href="#"
												class="btn achat-btn-outline-brand w-100"
											>
												Acheter
											</a>

										</article>
									</div>

								{% else %}

									<div class="col-12">
										<p>
											Aucun pack boost n’est disponible pour le moment.
										</p>
									</div>

								{% endfor %}

							</div>
						</section>

					</div>
				</div>
			</div>
		</div>
	</main>

	<script>
		document.addEventListener('DOMContentLoaded', function () {
			/* =====================================================
			   CHANGEMENT MENSUEL / ANNUEL
			   ===================================================== */

			const billingOptions = document.querySelectorAll(
				'.achat-billing-option'
			);

			const priceValues = document.querySelectorAll(
				'.achat-price-value'
			);

			const pricePeriods = document.querySelectorAll(
				'.achat-price-period'
			);

			const subscriptionLinks = document.querySelectorAll(
				'.achat-subscribe-link'
			);

			billingOptions.forEach(function (button) {
				button.addEventListener('click', function () {
					const selectedPeriod = button.dataset.period;

					billingOptions.forEach(function (option) {
						option.classList.remove('achat-active');
						option.setAttribute('aria-pressed', 'false');
					});

					button.classList.add('achat-active');
					button.setAttribute('aria-pressed', 'true');

					priceValues.forEach(function (price) {
						const newPrice = price.dataset[selectedPeriod];

						if (
							newPrice !== undefined
							&& newPrice !== null
							&& newPrice.trim() !== ''
						) {
							price.textContent = newPrice;
						}
					});

					pricePeriods.forEach(function (period) {
						period.textContent = selectedPeriod === 'annual'
							? '/an'
							: '/mois';
					});

					subscriptionLinks.forEach(function (link) {
						const newUrl = selectedPeriod === 'annual'
							? link.dataset.annualUrl
							: link.dataset.monthlyUrl;

						if (newUrl) {
							link.href = newUrl;
						}
					});
				});
			});

			/* =====================================================
			   AFFICHAGE DES AUTRES CARTES BANCAIRES
			   ===================================================== */

			const paymentSection = document.querySelector(
				'[data-payment-methods-section]'
			);

			if (!paymentSection) {
				return;
			}

			const modifyButton = paymentSection.querySelector(
				'[data-payment-modify]'
			);

			const listContainer = paymentSection.querySelector(
				'[data-payment-list-container]'
			);

			const cancelButton = paymentSection.querySelector(
				'[data-payment-cancel]'
			);

			const confirmButton = paymentSection.querySelector(
				'[data-payment-confirm]'
			);

			const currentDescription = paymentSection.querySelector(
				'[data-current-payment-description]'
			);

			const cardOptions = paymentSection.querySelectorAll(
				'[data-payment-card-option]'
			);

			const paymentRadios = paymentSection.querySelectorAll(
				'[data-payment-radio]'
			);

			const feedback = paymentSection.querySelector(
				'[data-payment-feedback]'
			);

			if (
				!modifyButton
				|| !listContainer
				|| cardOptions.length === 0
			) {
				return;
			}

			let initialPaymentId = '';

			const initiallyCheckedRadio = paymentSection.querySelector(
				'[data-payment-radio]:checked'
			);

			if (initiallyCheckedRadio) {
				initialPaymentId = initiallyCheckedRadio.value;
			}

			function openPaymentList() {
				listContainer.classList.remove('d-none');

				modifyButton.setAttribute(
					'aria-expanded',
					'true'
				);

				modifyButton.textContent = 'Fermer';

				const checkedRadio = paymentSection.querySelector(
					'[data-payment-radio]:checked'
				);

				if (checkedRadio) {
					const checkedCard = checkedRadio.closest(
						'[data-payment-card-option]'
					);

					if (checkedCard) {
						checkedCard.classList.add(
							'achat-payment-card-selected'
						);
					}
				}
			}

			function closePaymentList() {
				listContainer.classList.add('d-none');

				modifyButton.setAttribute(
					'aria-expanded',
					'false'
				);

				modifyButton.textContent = 'Modifier';

				if (feedback) {
					feedback.className = 'achat-payment-feedback';
					feedback.textContent = '';
				}
			}

			function selectPaymentCard(selectedCard) {
				cardOptions.forEach(function (card) {
					card.classList.remove(
						'achat-payment-card-selected'
					);
				});

				selectedCard.classList.add(
					'achat-payment-card-selected'
				);

				const radio = selectedCard.querySelector(
					'[data-payment-radio]'
				);

				if (radio) {
					radio.checked = true;
				}
			}

			function restoreInitialSelection() {
				if (!initialPaymentId) {
					return;
				}

				const initialRadio = Array.from(paymentRadios).find(
					function (radio) {
						return radio.value === initialPaymentId;
					}
				);

				if (!initialRadio) {
					return;
				}

				initialRadio.checked = true;

				const initialCard = initialRadio.closest(
					'[data-payment-card-option]'
				);

				if (initialCard) {
					selectPaymentCard(initialCard);
				}
			}

			modifyButton.addEventListener('click', function () {
				const isOpened = !listContainer.classList.contains(
					'd-none'
				);

				if (isOpened) {
					closePaymentList();
				} else {
					openPaymentList();
				}
			});

			cardOptions.forEach(function (card) {
				card.addEventListener('click', function () {
					selectPaymentCard(card);
				});
			});

			paymentRadios.forEach(function (radio) {
				radio.addEventListener('change', function () {
					const card = radio.closest(
						'[data-payment-card-option]'
					);

					if (card) {
						selectPaymentCard(card);
					}
				});
			});

			if (cancelButton) {
				cancelButton.addEventListener('click', function () {
					restoreInitialSelection();
					closePaymentList();
				});
			}

			if (confirmButton) {
				confirmButton.addEventListener('click', function () {
					const selectedRadio = paymentSection.querySelector(
						'[data-payment-radio]:checked'
					);

					if (!selectedRadio) {
						if (feedback) {
							feedback.textContent =
								'Veuillez sélectionner une carte bancaire.';

							feedback.className =
								'achat-payment-feedback is-visible is-error';
						}

						return;
					}

					const selectedCard = selectedRadio.closest(
						'[data-payment-card-option]'
					);

					if (!selectedCard) {
						return;
					}

					const brand =
						selectedCard.dataset.paymentBrand || 'Carte';

					const last4 =
						selectedCard.dataset.paymentLast4 || '';

					const expMonth =
						selectedCard.dataset.paymentExpMonth || '';

					const expYear =
						selectedCard.dataset.paymentExpYear || '';

					const formattedMonth = expMonth
						? String(expMonth).padStart(2, '0')
						: '';

					let description =
						brand.toUpperCase() + ' •••• ' + last4;

					if (formattedMonth && expYear) {
						description +=
							' — expire le '
							+ formattedMonth
							+ '/'
							+ expYear;
					}

					if (currentDescription) {
						currentDescription.textContent = description;
					}

					initialPaymentId = selectedRadio.value;

					if (feedback) {
						feedback.textContent =
							'La carte sélectionnée sera utilisée pour le paiement.';

						feedback.className =
							'achat-payment-feedback is-visible is-success';
					}

					window.setTimeout(function () {
						closePaymentList();
					}, 700);
				});
			}
		});
	</script>

{% endblock %}