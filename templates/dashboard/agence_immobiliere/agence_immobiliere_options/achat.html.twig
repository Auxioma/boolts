{#
 Template: templates/dashboard/agence_immobiliere/agence_immobiliere_options/achat.html.twig
 Role: Renders the dashboard/agence_immobiliere/agence_immobiliere_options Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

{% extends 'base.html.twig' %}

{% block title %}Récapitulatif de votre achat{% endblock %}

{% block body %}

<div
    data-controller="payment-method options--purchase"
    data-payment-method-public-key-value="{{ stripe_public_key }}"
    data-payment-method-create-url-value="{{ path('api_agency_billing_setup_intent') }}"
    data-payment-method-complete-url-value="{{ path('api_agency_billing_payment_method_complete') }}"
    data-payment-method-csrf-value="{{ csrf_token('agency_payment_method') }}"
    data-options--purchase-subscription-url-value="{{ path('api_agency_billing_subscription_create') }}"
    data-options--purchase-subscription-csrf-value="{{ csrf_token('agency_subscription') }}"
    data-options--purchase-plan-price-id-value="{{ plan_price.id }}"
    data-options--purchase-redirect-url-value="{{ path('agence_immobiliere_options') }}"
    data-options--purchase-default-payment-method-id-value="{{ default_payment_method ? default_payment_method.id : '' }}"
>
    <main id="dashboard" class="dashboard">
        <div class="container-fluid">
            <div class="row">

                {{ include('composant/__agence_immobiliere/_tableau_de_bord.html.twig') }}

                <div class="col-10">
                    <main class="achat-forfait-main">
                        <div class="container-fluid achat-forfait-container">
                            <div class="row achat-forfait-row">

                                {% if is_downgrade %}
                                    <div class="col-12">
                                        <h1 class="achat-forfait-main-title mb-24">
                                            Changement de forfait
                                        </h1>

                                        <div class="achat-forfait-plan-compare">
                                            <div class="achat-forfait-plan-compare-card">
                                                <p class="achat-forfait-plan-compare-label">
                                                    Forfait actuel
                                                </p>

                                                <p class="achat-forfait-plan-compare-name">
                                                    {{ current_plan.name }}
                                                </p>

                                                {% if current_plan_price %}
                                                    <p class="achat-forfait-plan-compare-price">
                                                        {{ (current_plan_price.amountMinor / 100)|number_format(2, ',', ' ') }}
                                                        {{ current_plan_price.currency.signe }}/{{ current_plan_price.billingPeriod.value == 'annual' ? 'an' : 'mois' }}
                                                    </p>
                                                {% endif %}
                                            </div>

                                            <span class="achat-forfait-plan-compare-arrow" aria-hidden="true">
                                                <i class="bi bi-chevron-right"></i>
                                            </span>

                                            <div class="achat-forfait-plan-compare-card achat-forfait-plan-compare-card-new">
                                                <p class="achat-forfait-plan-compare-label">
                                                    Nouveau forfait
                                                </p>

                                                <p class="achat-forfait-plan-compare-name">
                                                    {{ plan.name }}
                                                </p>

                                                <p class="achat-forfait-plan-compare-price">
                                                    {{ (plan_price.amountMinor / 100)|number_format(2, ',', ' ') }}
                                                    {{ plan_price.currency.signe }}/{{ period == 'annual' ? 'an' : 'mois' }}
                                                </p>
                                            </div>
                                        </div>

                                        <div class="achat-forfait-explain">
                                            <h2 class="achat-forfait-section-title">
                                                Que va-t-il se passer ?
                                            </h2>

                                            <ul class="achat-forfait-explain-list">
                                                <li>
                                                    {% if downgrade_effective_at %}
                                                        Le <strong>{{ downgrade_effective_at|date('d/m/Y') }}</strong>,
                                                    {% else %}
                                                        À la fin de votre période en cours,
                                                    {% endif %}
                                                    votre nouveau forfait
                                                    <strong>« {{ plan.name }} »</strong>
                                                    prendra effet et vous serez facturé de
                                                    <strong>
                                                        {{ (plan_price.amountMinor / 100)|number_format(2, ',', ' ') }}
                                                        {{ plan_price.currency.signe }}/{{ period == 'annual' ? 'an' : 'mois' }}
                                                    </strong>.
                                                </li>

                                                <li>
                                                    Jusqu’à cette date, vous continuerez de profiter des avantages de votre forfait
                                                    <strong>« {{ current_plan.name }} »</strong>.
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                {% endif %}

                                <div class="col-12 col-xl-6">
                                    <section class="achat-forfait-card achat-forfait-purchase-card">

                                        {% if not is_downgrade %}
                                            <h1 class="achat-forfait-main-title">
                                                Récapitulatif de votre achat
                                            </h1>

                                            <section class="achat-forfait-section">
                                                <h2 class="achat-forfait-section-title">
                                                    Article
                                                </h2>

                                                <div class="achat-forfait-product-description">
                                                    <p class="achat-forfait-product-name">
                                                        1 x Abonnement {{ plan.name }}
                                                    </p>
                                                </div>
                                            </section>
                                        {% endif %}

                                        <section class="achat-forfait-section">
                                            <h2 class="achat-forfait-section-title">
                                                {{ is_downgrade ? 'Moyen de paiement' : 'Carte bancaire par défaut' }}
                                            </h2>

                                            {% if default_payment_method %}
                                                <div class="achat-forfait-current-card">
                                                    <div class="achat-forfait-visa-box">
                                                        <img
                                                            src="https://www.figma.com/api/mcp/asset/ce43295d-91cd-4b8b-8856-526b341b5a04"
                                                            alt="{{ default_payment_method.brand|default('Carte bancaire')|capitalize }}"
                                                            class="achat-forfait-visa-logo"
                                                        >
                                                    </div>

                                                    <div class="achat-forfait-bank-card-content">
                                                        <p
                                                            class="achat-forfait-bank-card-name"
                                                            id="selected-card-name"
                                                            data-options--purchase-target="selectedCardName"
                                                        >
                                                            {{ default_payment_method.brand|default('Carte bancaire')|capitalize }}
                                                            {{ default_payment_method.last4 }}
                                                        </p>

                                                        <p
                                                            class="achat-forfait-bank-card-expiration"
                                                            id="selected-card-expiration"
                                                            data-options--purchase-target="selectedCardExpiration"
                                                        >
                                                            Date d’expiration :
                                                            {{ '%02d'|format(default_payment_method.expMonth) }}/{{ default_payment_method.expYear }}
                                                        </p>
                                                    </div>

                                                    {% if other_payment_methods is not empty %}
                                                        <button
                                                            class="achat-forfait-edit-button"
                                                            type="button"
                                                            id="show-payment-methods"
                                                            aria-controls="payment-methods-block"
                                                            aria-expanded="false"
                                                            data-options--purchase-target="showPaymentMethodsButton"
                                                            data-action="options--purchase#showPaymentMethods"
                                                        >
                                                            Modifier
                                                        </button>
                                                    {% endif %}
                                                </div>
                                            {% else %}
                                                <div class="d-flex mt-32 mb-32">
                                                    <button
                                                        type="button"
                                                        class="btn-add-payment py-10 px-16 payment-open-btn"
                                                        data-action="payment-method#open"
                                                    >
                                                        <span class="icon-plus mr-6"></span>
                                                        Ajouter un mode de paiement
                                                    </button>
                                                </div>
                                            {% endif %}
                                        </section>

                                        {% if other_payment_methods is not empty %}
                                            <section
                                                class="achat-forfait-section d-none"
                                                id="payment-methods-block"
                                                aria-hidden="true"
                                                data-options--purchase-target="paymentBlock"
                                            >
                                                <h2 class="achat-forfait-section-title">
                                                    Choisissez une autre carte bancaire
                                                </h2>

                                                <div class="achat-forfait-payment-list">
                                                    {% for payment_method in other_payment_methods %}
                                                        <label
                                                            class="achat-forfait-payment-option"
                                                            data-options--purchase-target="paymentOption"
                                                        >
                                                            <input
                                                                type="radio"
                                                                name="payment-method"
                                                                value="{{ payment_method.id }}"
                                                                class="visually-hidden"
                                                                data-card-name="{{ payment_method.brand|default('Carte bancaire')|capitalize }} {{ payment_method.last4 }}"
                                                                data-card-expiration="Date d’expiration : {{ '%02d'|format(payment_method.expMonth) }}/{{ payment_method.expYear }}"
                                                                data-options--purchase-target="paymentMethod"
                                                                data-action="change->options--purchase#selectPaymentMethod"
                                                            >

                                                            <span class="achat-forfait-bank-card-content">
                                                                <span class="achat-forfait-bank-card-name">
                                                                    {{ payment_method.brand|default('Carte bancaire')|capitalize }}
                                                                    {{ payment_method.last4 }}
                                                                </span>

                                                                <span class="achat-forfait-bank-card-expiration">
                                                                    Date d’expiration :
                                                                    {{ '%02d'|format(payment_method.expMonth) }}/{{ payment_method.expYear }}
                                                                </span>
                                                            </span>
                                                        </label>
                                                    {% endfor %}
                                                </div>

                                                <div class="achat-forfait-payment-actions">
                                                    <button
                                                        type="button"
                                                        class="btn achat-forfait-primary-button"
                                                        id="confirm-payment-method"
                                                        data-action="options--purchase#confirmPaymentMethod"
                                                    >
                                                        Utiliser cette méthode de paiement
                                                    </button>

                                                    <button
                                                        type="button"
                                                        class="btn achat-forfait-outline-button"
                                                        id="cancel-payment-method"
                                                        data-action="options--purchase#hidePaymentMethods"
                                                    >
                                                        Annuler
                                                    </button>

                                                    <button
                                                        type="button"
                                                        class="btn achat-forfait-outline-button"
                                                        data-action="payment-method#open"
                                                    >
                                                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                                                        <span>Ajouter un mode de paiement</span>
                                                    </button>
                                                </div>
                                            </section>
                                        {% endif %}

                                    </section>
                                </div>

                                <div class="col-12 col-xl-6">
                                    <aside class="achat-forfait-card achat-forfait-summary-card">
                                        {% if is_downgrade %}
                                            <p class="achat-forfait-legal-text">
                                                En confirmant ce changement de forfait, vous acceptez les
                                                conditions générales de vente de Boolts. Veuillez consulter
                                                notre notice de protection de vos informations personnelles,
                                                notre notice cookies et notre notice sur les annonces
                                                publicitaires basées sur vos centres d’intérêt.
                                            </p>

                                            <div class="achat-forfait-total">
                                                <div class="achat-forfait-total-label">
                                                    <strong>Montant :</strong>

                                                    <p class="achat-forfait-legal-text achat-forfait-total-note">
                                                        Le montant sera prélevé
                                                        {% if downgrade_effective_at %}
                                                            le <strong>{{ downgrade_effective_at|date('d/m/Y') }}</strong>.
                                                        {% else %}
                                                            à la fin de votre période en cours.
                                                        {% endif %}
                                                    </p>
                                                </div>

                                                <strong>
                                                    {{ (plan_price.amountMinor / 100)|number_format(2, ',', ' ') }}
                                                    {{ plan_price.currency.signe }}/{{ period == 'annual' ? 'an' : 'mois' }}
                                                </strong>
                                            </div>
                                        {% else %}
                                            <div class="achat-forfait-total">
                                                <strong>Montant total :</strong>

                                                <strong>
                                                    {{ (plan_price.amountMinor / 100)|number_format(2, ',', ' ') }}
                                                    {{ plan_price.currency.signe }}/{{ period == 'annual' ? 'an' : 'mois' }}
                                                </strong>
                                            </div>
                                        {% endif %}

                                        <button
                                            type="button"
                                            class="btn achat-forfait-primary-button"
                                            id="subscribe-button"
                                            data-options--purchase-target="subscribeButton"
                                            data-action="options--purchase#subscribe"
                                            {% if not default_payment_method %}disabled{% endif %}
                                        >
                                            {{ is_downgrade ? 'Changer de forfait' : 'S’abonner' }}
                                        </button>

                                        <p
                                            id="subscription-message"
                                            class="mt-16 mb-0"
                                            role="status"
                                            data-options--purchase-target="subscriptionMessage"
                                        ></p>
                                    </aside>
                                </div>

                            </div>
                        </div>
                    </main>
                </div>
            </div>
        </div>
    </main>

    <div
        class="payment-modal-overlay"
        data-payment-method-target="modal"
        data-action="
            click->payment-method#closeFromOverlay
            keydown@window->payment-method#closeFromKeyboard
        "
        aria-hidden="true"
    >
        <div
            class="payment-modal"
            role="dialog"
            aria-modal="true"
            aria-labelledby="payment-modal-title"
        >
            <button
                type="button"
                class="payment-modal-close"
                data-action="payment-method#close"
                aria-label="Fermer"
            >
                <i class="icon-x" aria-hidden="true"></i>
            </button>

            <div class="payment-modal-header">
                <h2 id="payment-modal-title" class="payment-modal-title">
                    Indiquez les informations de votre carte
                </h2>
            </div>

            <form
                class="payment-modal-form formulaire"
                data-action="submit->payment-method#submit"
                novalidate
            >
                <div
                    class="payment-form-error d-none mb-16"
                    role="alert"
                    data-payment-method-target="error"
                ></div>

                <div
                    class="payment-form-success d-none mb-16"
                    role="status"
                    data-payment-method-target="success"
                ></div>

                <div class="payment-form-group">
                    <label for="payment-cardholder-name" class="mb-16">
                        Nom du titulaire
                    </label>

                    <input
                        type="text"
                        id="payment-cardholder-name"
                        class="payment-form-control mb-16"
                        placeholder="Saisissez le nom du titulaire"
                        autocomplete="cc-name"
                        data-payment-method-target="cardholderName"
                        required
                    >
                </div>

                <div class="payment-form-group">
                    <label class="mb-16">
                        Numéro de la carte
                    </label>

                    <div
                        class="payment-stripe-element mb-16"
                        data-payment-method-target="cardNumber"
                    ></div>
                </div>

                <div class="payment-form-row">
                    <div class="payment-form-group payment-form-group--half">
                        <label class="mb-16">
                            Date d’expiration
                        </label>

                        <div
                            class="payment-stripe-element mb-16"
                            data-payment-method-target="cardExpiry"
                        ></div>
                    </div>

                    <div class="payment-form-group payment-form-group--half">
                        <label class="mb-16">
                            Code de sécurité
                        </label>

                        <div
                            class="payment-stripe-element mb-16"
                            data-payment-method-target="cardCvc"
                        ></div>
                    </div>
                </div>

                <div class="payment-form-group">
                    <label for="payment-country" class="mb-16">
                        Pays
                    </label>

                    <select
                        id="payment-country"
                        class="payment-form-control mb-16"
                        autocomplete="country"
                        data-payment-method-target="country"
                        required
                    >
                        <option value="FR" selected>France</option>
                        <option value="BE">Belgique</option>
                        <option value="CH">Suisse</option>
                        <option value="LU">Luxembourg</option>
                        <option value="MC">Monaco</option>
                        <option value="DE">Allemagne</option>
                        <option value="ES">Espagne</option>
                        <option value="IT">Italie</option>
                        <option value="PT">Portugal</option>
                        <option value="NL">Pays-Bas</option>
                        <option value="GB">Royaume-Uni</option>
                    </select>
                </div>

                <label class="payment-checkbox">
                    <input
                        type="checkbox"
                        name="defaultPayment"
                        value="1"
                        class="mr-12"
                        data-payment-method-target="defaultCheckbox"
                    >

                    <span></span>
                    Définir comme moyen de paiement par défaut
                </label>

                <div class="payment-modal-actions">
                    <button
                        type="button"
                        class="payment-btn-cancel"
                        data-action="payment-method#close"
                    >
                        Annuler
                    </button>

                    <button
                        type="submit"
                        class="payment-btn-submit"
                        data-payment-method-target="submitButton"
                        disabled
                    >
                        Ajouter
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>

<style>
.payment-form-row {
    display: flex;
    gap: 16px;
}

.payment-form-group--half {
    flex: 1;
    min-width: 0;
}

.payment-stripe-element {
    border: 1px solid #D5D9E2;
    border-radius: 10px;
    padding: 12px 14px;
    background: #fff;
}

.payment-stripe-element.StripeElement--focus {
    border-color: #FF8A1E;
}

.payment-stripe-element.StripeElement--invalid {
    border-color: #DC3545;
}
</style>
<script src="https://js.stripe.com/v3/"></script>

{% endblock %}
