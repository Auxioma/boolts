{% extends 'base.html.twig' %}

{% block title %}Récapitulatif de votre achat{% endblock %}

{% block body %}
    <main id="dashboard" class="dashboard">
        <div class="container-fluid">
            <div class="row">

                {# Menu du tableau de bord #}
                {{ include('composant/__agence_immobiliere/_tableau_de_bord.html.twig') }}

                {# Contenu du tableau de bord #}
                <div class="col-10">
                    <main class="achat-forfait-main">
                        <div class="container-fluid achat-forfait-container">
                            <div class="row achat-forfait-row">

                                <div class="col-12 col-xl-6">
                                    <section class="achat-forfait-card achat-forfait-purchase-card">

                                        <h1 class="achat-forfait-main-title">
                                            Récapitulatif de votre achat
                                        </h1>

                                        <section class="achat-forfait-section">
                                            <h2 class="achat-forfait-section-title">
                                                Article
                                            </h2>

                                            <div class="achat-forfait-product-description">
                                                <p class="achat-forfait-product-name">
                                                    1 x Abonnement Professionnel
                                                </p>

                                                <ul class="achat-forfait-features">
                                                    <li>
                                                        <strong>✓ 5 Projects</strong>
                                                        <span>Perfect for small teams</span>
                                                    </li>

                                                    <li>
                                                        <strong>✓ 10GB Storage</strong>
                                                        <span>Enough for basic needs</span>
                                                    </li>

                                                    <li>
                                                        <strong>✓ Basic Support</strong>
                                                        <span>Email support within 24h</span>
                                                    </li>

                                                    <li>
                                                        <strong>✓ Email Notifications</strong>
                                                        <span>Stay updated with alerts</span>
                                                    </li>
                                                </ul>
                                            </div>
                                        </section>

                                        {# Carte bancaire actuellement sélectionnée #}
                                        <section class="achat-forfait-section">
                                            <h2 class="achat-forfait-section-title">
                                                Carte bancaire sélectionnée
                                            </h2>

                                            <div class="achat-forfait-current-card">
                                                <div class="achat-forfait-visa-box">
                                                    <img
                                                        src="https://www.figma.com/api/mcp/asset/ce43295d-91cd-4b8b-8856-526b341b5a04"
                                                        alt="Visa"
                                                        class="achat-forfait-visa-logo"
                                                    >
                                                </div>

                                                <div class="achat-forfait-bank-card-content">
                                                    <p
                                                        class="achat-forfait-bank-card-name"
                                                        id="selected-card-name"
                                                    >
                                                        Visa 3640
                                                    </p>

                                                    <p
                                                        class="achat-forfait-bank-card-expiration"
                                                        id="selected-card-expiration"
                                                    >
                                                        Date d’expiration : 12/08/2027
                                                    </p>
                                                </div>

                                                <button
                                                    class="achat-forfait-edit-button"
                                                    type="button"
                                                    id="show-payment-methods"
                                                    aria-controls="payment-methods-block"
                                                    aria-expanded="false"
                                                >
                                                    Modifier
                                                </button>
                                            </div>
                                        </section>

                                        {#
                                            Bloc caché par défaut.
                                            Il est affiché au clic sur "Modifier".
                                        #}
                                        <section
                                            class="achat-forfait-section d-none"
                                            id="payment-methods-block"
                                            aria-hidden="true"
                                        >
                                            <h2 class="achat-forfait-section-title">
                                                Choisissez votre carte bancaire
                                            </h2>

                                            <div
                                                class="achat-forfait-payment-list"
                                                role="radiogroup"
                                                aria-label="Choisissez votre carte bancaire"
                                            >
                                                <label class="achat-forfait-payment-option achat-forfait-payment-option-selected">
                                                    <input
                                                        type="radio"
                                                        name="payment-method"
                                                        value="card-1"
                                                        class="visually-hidden"
                                                        data-card-name="Visa 3640"
                                                        data-card-expiration="Date d’expiration : 12/08/2027"
                                                        checked
                                                    >

                                                    <span class="achat-forfait-visa-box">
                                                        <img
                                                            src="https://www.figma.com/api/mcp/asset/ce43295d-91cd-4b8b-8856-526b341b5a04"
                                                            alt="Visa"
                                                            class="achat-forfait-visa-logo"
                                                        >
                                                    </span>

                                                    <span class="achat-forfait-bank-card-content">
                                                        <span class="achat-forfait-bank-card-name">
                                                            Visa 3640
                                                        </span>

                                                        <span class="achat-forfait-bank-card-expiration">
                                                            Date d’expiration : 12/08/2027
                                                        </span>
                                                    </span>
                                                </label>

                                                <label class="achat-forfait-payment-option">
                                                    <input
                                                        type="radio"
                                                        name="payment-method"
                                                        value="card-2"
                                                        class="visually-hidden"
                                                        data-card-name="Visa 3184"
                                                        data-card-expiration="Date d’expiration : 03/2030"
                                                    >

                                                    <span class="achat-forfait-visa-box">
                                                        <img
                                                            src="https://www.figma.com/api/mcp/asset/ce43295d-91cd-4b8b-8856-526b341b5a04"
                                                            alt="Visa"
                                                            class="achat-forfait-visa-logo"
                                                        >
                                                    </span>

                                                    <span class="achat-forfait-bank-card-content">
                                                        <span class="achat-forfait-bank-card-name">
                                                            Visa 3184
                                                        </span>

                                                        <span class="achat-forfait-bank-card-expiration">
                                                            Date d’expiration : 03/2030
                                                        </span>
                                                    </span>
                                                </label>

                                                <label class="achat-forfait-payment-option">
                                                    <input
                                                        type="radio"
                                                        name="payment-method"
                                                        value="card-3"
                                                        class="visually-hidden"
                                                        data-card-name="Mastercard 4587"
                                                        data-card-expiration="Date d’expiration : 06/2029"
                                                    >

                                                    <span class="achat-forfait-visa-box">
                                                        <img
                                                            src="https://www.figma.com/api/mcp/asset/ce43295d-91cd-4b8b-8856-526b341b5a04"
                                                            alt="Carte bancaire"
                                                            class="achat-forfait-visa-logo"
                                                        >
                                                    </span>

                                                    <span class="achat-forfait-bank-card-content">
                                                        <span class="achat-forfait-bank-card-name">
                                                            Mastercard 4587
                                                        </span>

                                                        <span class="achat-forfait-bank-card-expiration">
                                                            Date d’expiration : 06/2029
                                                        </span>
                                                    </span>
                                                </label>

                                                <label class="achat-forfait-payment-option">
                                                    <input
                                                        type="radio"
                                                        name="payment-method"
                                                        value="card-4"
                                                        class="visually-hidden"
                                                        data-card-name="Visa 7421"
                                                        data-card-expiration="Date d’expiration : 09/2028"
                                                    >

                                                    <span class="achat-forfait-visa-box">
                                                        <img
                                                            src="https://www.figma.com/api/mcp/asset/ce43295d-91cd-4b8b-8856-526b341b5a04"
                                                            alt="Visa"
                                                            class="achat-forfait-visa-logo"
                                                        >
                                                    </span>

                                                    <span class="achat-forfait-bank-card-content">
                                                        <span class="achat-forfait-bank-card-name">
                                                            Visa 7421
                                                        </span>

                                                        <span class="achat-forfait-bank-card-expiration">
                                                            Date d’expiration : 09/2028
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>

                                            <div class="achat-forfait-payment-actions">
                                                <button
                                                    type="button"
                                                    class="btn achat-forfait-primary-button"
                                                    id="confirm-payment-method"
                                                >
                                                    Utiliser cette méthode de paiement
                                                </button>

                                                <button
                                                    type="button"
                                                    class="btn achat-forfait-outline-button"
                                                    id="cancel-payment-method"
                                                >
                                                    Annuler
                                                </button>

                                                <button
                                                    type="button"
                                                    class="btn achat-forfait-outline-button achat-forfait-add-payment-button"
                                                >
                                                    <i
                                                        class="bi bi-plus-lg"
                                                        aria-hidden="true"
                                                    ></i>

                                                    <span>
                                                        Ajouter un mode de paiement
                                                    </span>
                                                </button>
                                            </div>
                                        </section>
                                    </section>
                                </div>

                                <div class="col-12 col-xl-6">
                                    <aside class="achat-forfait-card achat-forfait-summary-card">
                                        <p class="achat-forfait-legal-text">
                                            En passant votre commande, vous acceptez les
                                            <a href="#">Conditions générales de vente</a>
                                            de Boolts. Veuillez consulter notre
                                            <a href="#">
                                                Notice Protection de vos informations personnelles
                                            </a>,
                                            notre
                                            <a href="#">Notice Cookies</a>
                                            et notre
                                            <a href="#">
                                                Notice Annonces publicitaires basées sur vos centres d’intérêt
                                            </a>.
                                        </p>

                                        <div class="achat-forfait-total">
                                            <strong>Montant total :</strong>
                                            <strong>29,99 €/mois</strong>
                                        </div>

                                        <button
                                            type="button"
                                            class="btn achat-forfait-primary-button"
                                        >
                                            S’abonner
                                        </button>
                                    </aside>
                                </div>

                            </div>
                        </div>
                    </main>
                </div>
            </div>
        </div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const showButton = document.getElementById('show-payment-methods');
            const cancelButton = document.getElementById('cancel-payment-method');
            const confirmButton = document.getElementById('confirm-payment-method');
            const paymentBlock = document.getElementById('payment-methods-block');
            const selectedCardName = document.getElementById('selected-card-name');
            const selectedCardExpiration = document.getElementById('selected-card-expiration');
            const paymentOptions = document.querySelectorAll('.achat-forfait-payment-option');

            if (
                !showButton ||
                !cancelButton ||
                !confirmButton ||
                !paymentBlock
            ) {
                return;
            }

            function showPaymentMethods() {
                paymentBlock.classList.remove('d-none');
                paymentBlock.setAttribute('aria-hidden', 'false');
                showButton.setAttribute('aria-expanded', 'true');

                paymentBlock.scrollIntoView({
                    behavior: 'smooth',
                    block: 'nearest'
                });
            }

            function hidePaymentMethods() {
                paymentBlock.classList.add('d-none');
                paymentBlock.setAttribute('aria-hidden', 'true');
                showButton.setAttribute('aria-expanded', 'false');
            }

            showButton.addEventListener('click', showPaymentMethods);
            cancelButton.addEventListener('click', hidePaymentMethods);

            paymentOptions.forEach(function (option) {
                const radio = option.querySelector(
                    'input[name="payment-method"]'
                );

                if (!radio) {
                    return;
                }

                radio.addEventListener('change', function () {
                    paymentOptions.forEach(function (item) {
                        item.classList.remove(
                            'achat-forfait-payment-option-selected'
                        );
                    });

                    if (radio.checked) {
                        option.classList.add(
                            'achat-forfait-payment-option-selected'
                        );
                    }
                });
            });

            confirmButton.addEventListener('click', function () {
                const selectedRadio = document.querySelector(
                    'input[name="payment-method"]:checked'
                );

                if (!selectedRadio) {
                    return;
                }

                selectedCardName.textContent =
                    selectedRadio.dataset.cardName ?? '';

                selectedCardExpiration.textContent =
                    selectedRadio.dataset.cardExpiration ?? '';

                hidePaymentMethods();
            });
        });
    </script>
{% endblock %}