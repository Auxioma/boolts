{#
 Template: templates/dashboard/agence_immobiliere/agence_immobiliere_parametres/index.html.twig
 Role: Renders the dashboard/agence_immobiliere/agence_immobiliere_parametres Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

{% extends 'base.html.twig' %}

{% block title %}
    Paramètres agence immobilière
{% endblock %}

{% block body %}
    <main id="dashboard" class="dashboard" data-controller="parametre--tabs">
        <div class="container-fluid bg-white">
            <div class="row">
                {{ include('composant/__agence_immobiliere/_tableau_de_bord.html.twig') }}


                <div class="col-md-9 col-lg-10 col-12 dashboard-main bg-white">
                    {#
                        Navigation en étapes : la liste des sous-pages et le contenu
                        d'une sous-page ne sont jamais affichés en même temps.
                        Sans hash : liste. Avec un hash (#cat1 à #cat6) : contenu.
                    #}
                    <div class="row">
                        <nav
                            class="col-12 pt-48 parametres-step parametres-step--list"
                            data-parametre--tabs-target="list"
                            aria-label="Paramètres"
                        >
                            <div class="menu-parametres">
                                <h2 class="mb-0">Paramètres</h2>

                                {{ include(
                                    'dashboard/agence_immobiliere/_partials/parametres/_menu_parametres_data.html.twig',
                                ) }}
                            </div>
                        </nav>

                        <div
                            class="col-12 parametres-step parametres-step--content d-none"
                            data-parametre--tabs-target="content"
                        >
                            <div class="row bg-white">
                                <div class="col-12 pt-48">
                                    <div class="parametres-back px-48 mb-24">
                                        <div class="row">
                                            <div class="col-10 mx-auto">
                                                <a
                                                    href="{{ path('agence_immobiliere_parametres') }}"
                                                    class="btn-retour parametres-back__button py-10 px-16 p-accent"
                                                    data-parametre--tabs-target="back"
                                                    data-action="parametre--tabs#back"
                                                >
                                                    <i class="icon-chevron-left" aria-hidden="true"></i>
                                                    Retour
                                                </a>
                                            </div>
                                        </div>
                                    </div>

                                    {{ include('dashboard/agence_immobiliere/_partials/parametres/profile_public.html.twig') }}
                                    {{ include('dashboard/agence_immobiliere/_partials/parametres/informations_personnelles.html.twig') }}
                                    {{ include('dashboard/agence_immobiliere/_partials/parametres/connection-securise.html.twig') }}

                                    {{ include(
                                        'dashboard/agence_immobiliere/_partials/parametres/moyen-de-paiement.html.twig',
                                        {
                                            stripe_public_key: stripe_public_key,
                                            payment_methods: payment_methods,
                                            current_subscription: current_subscription,
                                        },
                                    ) }}

                                    {{ include(
                                        'dashboard/agence_immobiliere/_partials/parametres/historique-des-paiements.html.twig',
                                        {
                                            subscription_payments: subscription_payments,
                                            invoices_by_payment: invoices_by_payment,
                                        },
                                    ) }}
                                    {{ include('dashboard/agence_immobiliere/_partials/parametres/langue_et_devise.html.twig') }}

                                    <div class="js-success-message flash-message flash-message-success message-flash-profile d-none"></div>
                                    <div class="js-error-message flash-message flash-message-error message-flash-profile-error d-none"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
{% endblock %}
