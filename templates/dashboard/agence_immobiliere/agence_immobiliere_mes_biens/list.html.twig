{% extends 'base.html.twig' %}

{% block title %}Mes biens immobiliers{% endblock %}

{% block body %}
<main id="dashboard" class="dashboard">

    <div class="container-fluid">
        <div class="row">
            {{ include('composant/__agence_immobiliere/_tableau_de_bord.html.twig') }}
            <div class="col-10 p-48 bg-white">
                <div class="row">
                    <div class="col-10 mx-auto">
                        <div class="agence-mes-biens-list">
                            <div class="mes-biens-immobilier">
                                <div class="d-flex justify-content-between align-items-start mb-32">
                                    <div>
                                        <h1>
                                            Mes biens
                                        </h1>
                                        <p class="description-page">
                                            Retrouvez ici toutes vos annonces immobilières.
                                        </p>
                                    </div>
                                    <a
                                        href="{{ path('agence_immobiliere_mes_biens') }}"
                                        class="btn-deposer-annonce"
                                    >
                                        <i class="icon-circle-plus"></i>
                                        Déposer une annonce
                                    </a>
                                </div>

                                <div class="property-tools mb-24">

                                <form
                                    method="get"
                                    action="{{ path('agence_immobiliere_mes_biens_list') }}"
                                    class="property-search"
                                >
                                    <button
                                        type="submit"
                                        class="property-search-submit"
                                        aria-label="Rechercher"
                                    >
                                        <i class="icon-search" aria-hidden="true"></i>
                                    </button>

                                    <input
                                        type="search"
                                        name="search"
                                        value="{{ app.request.query.get('search') }}"
                                        placeholder="Rechercher un bien, une référence, une ville ou un pays"
                                        autocomplete="off"
                                    >

                                    {% if app.request.query.get('sort') %}
                                        <input
                                            type="hidden"
                                            name="sort"
                                            value="{{ app.request.query.get('sort') }}"
                                        >
                                    {% endif %}

                                    {% if app.request.query.get('direction') %}
                                        <input
                                            type="hidden"
                                            name="direction"
                                            value="{{ app.request.query.get('direction') }}"
                                        >
                                    {% endif %}

                                    {% for key, value in app.request.query.all('modal_filter') %}
                                        {% if value is iterable %}
                                            {% for childKey, childValue in value %}
                                                <input
                                                    type="hidden"
                                                    name="modal_filter[{{ key }}][{{ childKey }}]"
                                                    value="{{ childValue }}"
                                                >
                                            {% endfor %}
                                        {% else %}
                                            <input
                                                type="hidden"
                                                name="modal_filter[{{ key }}]"
                                                value="{{ value }}"
                                            >
                                        {% endif %}
                                    {% endfor %}
                                </form>
                                    <button
                                        type="button"
                                        class="btn-dashboard-filter"
                                        data-bs-toggle="modal"
                                        data-bs-target="#booltsFiltersModal"
                                    >
                                        <i class="icon-filter"></i>
                                        Filtres
                                    </button>
                                    <a 
                                        href="?sort=createdAt&direction=DESC"
                                        class="btn-dashboard-filter"
                                    >
                                        <i class="icon-arrow-down-up"></i>
                                        Trier
                                    </a>
                                </div>
                                <div class="property-count mb-24">
                                    {{ properties.getTotalItemCount }}
                                    bien{{ properties.getTotalItemCount > 1 ? 's' }}
                                </div>
                                {% if properties|length %}
                                    <form method="post">

                                        <div class="property-bulk-actions mb-24">

                                            <label class="select-all">
                                                <input 
                                                    type="checkbox"
                                                    id="select-all"
                                                >
                                                Tout sélectionner

                                            </label>

                                            <button type="button">
                                                <i class="icon-rocket"></i>
                                                Booster
                                            </button>
                                            <button type="button">
                                                Pause
                                            </button>

                                            <button type="button">
                                                Réactiver
                                            </button>

                                            <button 
                                                type="button"
                                                class="danger"
                                            >
                                                Supprimer
                                            </button>

                                        </div>
                                        <div class="properties-list">
                                            {% for property in properties %}
                                                {% set firstImage = property.propertyImages|first %}
                                                {% set uploadedImage = firstImage 
                                                    ? vich_uploader_asset(firstImage, 'imageFile')
                                                    : null
                                                %}
                                                <article class="property-row">
                                                    <div class="property-checkbox">

                                                        <input
                                                            type="checkbox"
                                                            name="properties[]"
                                                            value="{{ property.id }}"
                                                        >
                                                    </div>
                                                    <div class="property-row-image">
                                                        {% if uploadedImage %}
                                                            <img
                                                                src="{{ uploadedImage }}"
                                                                alt="{{ property.titreDuLogement }}"
                                                            >
                                                        {% else %}
                                                            <div class="property-image-empty">
                                                                <i class="icon-image-off"></i>
                                                            </div>
                                                        {% endif %}
                                                    </div>
                                                    <div class="property-row-content">
                                                        <div class="property-card-header">
                                                            <h2>
                                                                {{ property.titreDuLogement 
                                                                    ?: 'Annonce sans titre'
                                                                }}
                                                            </h2>
                                                            <span class="property-status">
                                                                {{ property.statut.label }}
                                                            </span>
                                                        </div>
                                                        <p class="property-type">
                                                            {{ property.typeBien
                                                                ? property.typeBien.name
                                                                : 'Type non renseigné'
                                                            }}
                                                            {% if property.typeTransaction %}
                                                                · {{ property.typeTransaction.name }}
                                                            {% endif %}
                                                        </p>
                                                        <p class="property-location">
                                                            <i class="icon-map-pin"></i>
                                                            {{ property.ville 
                                                                ?: 'Localisation non renseignée'
                                                            }}
                                                            {% if property.pays %}
                                                                , {{ property.pays }}
                                                            {% endif %}
                                                        </p>
                                                        <small>
                                                            Réf.
                                                            {{ property.referenceInterne ?: property.slug }}
                                                        </small>
                                                    </div>
                                                    <div class="property-row-actions">
                                                        <a href="#">
                                                            <i class="icon-pencil"></i>
                                                        </a>
                                                        <a href="#">
                                                            <i class="icon-trash"></i>
                                                        </a>
                                                        <button type="button">
                                                            <i class="icon-more-vertical"></i>
                                                        </button>
                                                    </div>
                                                </article>
                                            {% endfor %}
                                        </div>

                                        {% if properties.pageCount > 1 %}
                                            <div class="property-pagination mt-32">
                                                {{ knp_pagination_render(properties) }}
                                            </div>
                                        {% endif %}

                                    </form>
                                {% else %}
                                    <div class="property-empty">
                                        <i class="icon-building-2"></i>
                                        <h2>
                                            Vous n’avez pas encore de bien
                                        </h2>
                                        <p>
                                            Déposez votre première annonce pour la retrouver ici.
                                        </p>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
{% include 'composant/_search/_search.html.twig' with {
    formModal: filterForm,
    totalResults: properties.getTotalItemCount,
    filterCountUrl: path('agence_immobiliere_mes_biens_filters_count')
} %}
{% endblock %}