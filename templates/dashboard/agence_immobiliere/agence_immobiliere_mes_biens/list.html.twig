{% extends 'base.html.twig' %}

{% block title %}Mes biens immobiliers{% endblock %}

{% block body %}

{% set statusLabels = {
    'publiee': 'Publiée',
    'depubliee': 'Pause',
    'pending': 'En attente',
    'refusee': 'Refusée',
    'suspendue': 'Suspendue',
} %}

<main id="dashboard" class="dashboard">

    <div class="container-fluid">
        <div class="row">

            {{ include('composant/__agence_immobiliere/_tableau_de_bord.html.twig') }}

            <div class="col-10 p-48 bg-white">

                <div class="row">
                    <div class="col-10 mx-auto">

                        <div class="agence-mes-biens-list">

                            {# ===================================================
                               EN-TÊTE : titre + compteurs (annonces / boosts)
                               =================================================== #}
                            <div class="mes-biens-header mb-24">

                                <h1>Mes biens</h1>

                                <div class="mes-biens-badges">

                                    <span class="mes-biens-badge">
                                        <i class="icon-building-2" aria-hidden="true"></i>
                                        Annonces restantes : {{ annoncesRestantes is null ? '∞' : annoncesRestantes }}
                                    </span>

                                    <span class="mes-biens-badge">
                                        <i class="icon-zap" aria-hidden="true"></i>
                                        Boost : {{ boostsRestants }}
                                    </span>

                                </div>

                            </div>

                            {# ===================================================
                               BARRE DE RECHERCHE / FILTRES / TRI / DÉPÔT
                               =================================================== #}
                            <div class="property-tools mb-24">

                                <form
                                    method="get"
                                    action="{{ path('agence_immobiliere_mes_biens_list') }}"
                                    class="property-search"
                                    role="search"
                                >

                                    <input
                                        type="search"
                                        name="search"
                                        value="{{ app.request.query.get('search') }}"
                                        placeholder="Rechercher un bien, une référence, une ville ou un pays"
                                        autocomplete="off"
                                    >

                                    {% if app.request.query.get('sort') %}
                                        <input
                                            type="hidden"
                                            name="sort"
                                            value="{{ app.request.query.get('sort') }}"
                                        >
                                    {% endif %}

                                    {% if app.request.query.get('direction') %}
                                        <input
                                            type="hidden"
                                            name="direction"
                                            value="{{ app.request.query.get('direction') }}"
                                        >
                                    {% endif %}

                                    {% for key, value in app.request.query.all('modal_filter') %}

                                        {% if value is iterable %}

                                            {% for childKey, childValue in value %}
                                                <input
                                                    type="hidden"
                                                    name="modal_filter[{{ key }}][{{ childKey }}]"
                                                    value="{{ childValue }}"
                                                >
                                            {% endfor %}

                                        {% else %}

                                            <input
                                                type="hidden"
                                                name="modal_filter[{{ key }}]"
                                                value="{{ value }}"
                                            >

                                        {% endif %}

                                    {% endfor %}

                                    <button
                                        type="submit"
                                        class="property-search-submit"
                                        aria-label="Rechercher"
                                    >
                                        <i class="icon-search" aria-hidden="true"></i>
                                    </button>

                                </form>

                                <button
                                    type="button"
                                    class="btn-dashboard-filter"
                                    data-bs-toggle="modal"
                                    data-bs-target="#booltsFiltersModal"
                                >
                                    <i class="icon-filter"></i>
                                    Filtres
                                </button>

                                {% set routeName = app.request.attributes.get('_route') %}
                                {% set baseParams = app.request.query.all|merge({ page: 1 }) %}

                                {% set currentSort = sortValue|default('p.updatedAt') %}
                                {% set currentDirection = directionValue|default('DESC')|lower %}

                                {% set sortOptions = [
                                    { sort: 'p.updatedAt',  direction: 'desc', label: 'Date de modification (récent → ancien)', short: 'Modif. récente → ancienne' },
                                    { sort: 'p.updatedAt',  direction: 'asc',  label: 'Date de modification (ancien → récent)', short: 'Modif. ancienne → récente' },
                                    { sort: 'p.views',      direction: 'desc', label: 'Vues (plus → moins)',                     short: 'Vues : plus → moins' },
                                    { sort: 'p.views',      direction: 'asc',  label: 'Vues (moins → plus)',                     short: 'Vues : moins → plus' },
                                    { sort: 'favorisCount', direction: 'desc', label: 'Favoris (plus → moins)',                  short: 'Favoris : plus → moins' },
                                    { sort: 'favorisCount', direction: 'asc',  label: 'Favoris (moins → plus)',                  short: 'Favoris : moins → plus' },
                                ] %}

                                {% set currentLabel = 'Modif. récente → ancienne' %}
                                {% for option in sortOptions %}
                                    {% if option.sort == currentSort and option.direction == currentDirection %}
                                        {% set currentLabel = option.short %}
                                    {% endif %}
                                {% endfor %}

                                <div class="agence-filter-sort" data-controller="agence-sort">

                                    <button
                                        type="button"
                                        class="btn-dashboard-filter"
                                        data-action="click->agence-sort#toggle"
                                        data-agence-sort-target="button"
                                        aria-expanded="false"
                                    >
                                        <i class="icon-arrow-down-up"></i>
                                        Tri : {{ currentLabel }}
                                    </button>

                                    <div
                                        class="agence-filter-sort__dropdown d-none"
                                        data-agence-sort-target="menu"
                                        role="menu"
                                        aria-label="Trier les annonces"
                                    >
                                        {% for option in sortOptions %}
                                            <a
                                                href="{{ path(routeName, baseParams|merge({ sort: option.sort, direction: option.direction })) }}"
                                                class="agence-filter-sort__item {{ option.sort == currentSort and option.direction == currentDirection ? 'agence-filter-sort__item--active' : '' }}"
                                                role="menuitem"
                                            >
                                                {{ option.label }}
                                            </a>
                                        {% endfor %}
                                    </div>

                                </div>

                                <a
                                    href="{{ path('agence_immobiliere_mes_biens', { token: random(2147483647) }) }}"
                                    class="btn-deposer-annonce"
                                >
                                    <i class="icon-plus"></i>
                                    Déposer une annonce
                                </a>

                            </div>

                            {% if drafts is not empty or properties|length %}

                                <form
                                    method="post"
                                    action="{{ path('agence_immobiliere_mes_biens_bulk_action') }}"
                                    data-controller="mes-biens--property-bulk-actions"
                                >

                                    <input
                                        type="hidden"
                                        name="_token"
                                        value="{{ csrf_token('property_bulk_action') }}"
                                    >

                                    <input
                                        type="hidden"
                                        name="action"
                                        value=""
                                    >

                                    {# ===========================================
                                       BARRE D'OUTILS : sélection + actions groupées
                                       =========================================== #}
                                    {% if properties|length %}

                                    <div class="property-toolbar mb-24">

                                        <label class="property-select-all">

                                            <input
                                                type="checkbox"
                                                data-mes-biens--property-bulk-actions-target="selectAll"
                                                data-action="change->mes-biens--property-bulk-actions#toggleAll"
                                            >

                                            <span>Tout sélectionner</span>

                                            <span
                                                class="property-selection-count"
                                                data-mes-biens--property-bulk-actions-target="counter"
                                            ></span>

                                        </label>

                                        <div class="property-bulk-actions">

                                            {# TODO: action groupée "Booster" — endpoint back-end à implémenter #}
                                            <button
                                                type="button"
                                                class="bulk-action bulk-action--boost"
                                                disabled
                                                data-mes-biens--property-bulk-actions-target="action"
                                            >
                                                <i class="icon-rocket"></i>
                                                Booster
                                            </button>

                                            <button
                                                type="button"
                                                class="bulk-action"
                                                disabled
                                                data-mes-biens--property-bulk-actions-target="action"
                                                data-action="click->mes-biens--property-bulk-actions#setAction"
                                                data-action-value="pause"
                                            >
                                                <i class="icon-pause"></i>
                                                Pause
                                            </button>

                                            <button
                                                type="button"
                                                class="bulk-action"
                                                disabled
                                                data-mes-biens--property-bulk-actions-target="action"
                                                data-action="click->mes-biens--property-bulk-actions#setAction"
                                                data-action-value="reactivate"
                                            >
                                                <i class="icon-play"></i>
                                                Réactiver
                                            </button>

                                            <button
                                                type="button"
                                                class="bulk-action bulk-action--danger"
                                                disabled
                                                data-mes-biens--property-bulk-actions-target="action"
                                                data-action="click->mes-biens--property-bulk-actions#setAction"
                                                data-action-value="delete"
                                            >
                                                <i class="icon-trash"></i>
                                                Supprimer
                                            </button>

                                        </div>

                                    </div>

                                    {% endif %}

                                    {# ===========================================
                                       BROUILLONS
                                       Règle métier : 4 brouillons max par utilisateur,
                                       purge auto après 3 mois (mail 30 jours avant).
                                       =========================================== #}
                                    {% if drafts is not empty %}

                                        <section class="mes-biens-card mes-biens-drafts mb-24">

                                            <div class="mes-biens-drafts-grid">

                                                {% for draft in drafts %}

                                                    <article class="draft-row">

                                                        <span class="draft-thumb">
                                                            <i class="icon-file-text"></i>
                                                        </span>

                                                        <div class="draft-info">

                                                            <a
                                                                href="{{ path('agence_immobiliere_mes_biens_edit', {
                                                                    id: draft.id
                                                                }) }}"
                                                                class="draft-title"
                                                            >
                                                                {{ draft.titreDuLogement ?: 'Brouillon #' ~ loop.index }}
                                                            </a>

                                                            <p class="draft-meta">
                                                                Modifié le
                                                                {{ (draft.updatedAt ?? draft.createdAt)|date('d/m/Y à H:i') }}
                                                            </p>

                                                        </div>

                                                        <div class="draft-actions">

                                                            <a
                                                                href="{{ path('agence_immobiliere_mes_biens_edit', {
                                                                    id: draft.id
                                                                }) }}"
                                                                class="row-icon-btn"
                                                                title="Modifier le brouillon"
                                                            >
                                                                <i class="icon-pencil"></i>
                                                            </a>

                                                            <button
                                                                type="submit"
                                                                class="row-icon-btn row-icon-btn--wide"
                                                                title="Supprimer le brouillon"
                                                                formaction="{{ path('agence_immobiliere_mes_biens_delete', {
                                                                    id: draft.id
                                                                }) }}"
                                                                formmethod="post"
                                                                name="_property_token"
                                                                value="{{ csrf_token('property_delete_' ~ draft.id) }}"
                                                                onclick="return confirm('Supprimer ce brouillon ?');"
                                                            >
                                                                <i class="icon-trash"></i>
                                                            </button>

                                                        </div>

                                                    </article>

                                                {% endfor %}

                                            </div>

                                        </section>

                                    {% endif %}

                                    {# ===========================================
                                       LISTE DES ANNONCES
                                       =========================================== #}
                                    {% if properties|length %}

                                        <section class="mes-biens-card mes-biens-listings">

                                            <div class="property-listings">

                                                {% for property in properties %}

                                                    {% set firstImage = property.propertyImages|first %}

                                                    {% set uploadedImage = firstImage
                                                        ? vich_uploader_asset(firstImage, 'imageFile')
                                                        : null
                                                    %}

                                                    {% set isBoosted = property.id in boostedPropertyIds %}
                                                    {% set price = property.prix ?? property.montantLoyerHorsCharge %}

                                                    <article class="property-listing">

                                                        {% set isPending = property.statut.value == 'pending' %}

                                                        <label class="property-listing-check{{ isPending ? ' property-listing-check--disabled' : '' }}">

                                                            <input
                                                                type="checkbox"
                                                                name="properties[]"
                                                                value="{{ property.id }}"
                                                                data-mes-biens--property-bulk-actions-target="checkbox"
                                                                data-status="{{ property.statut.value }}"
                                                                data-action="change->mes-biens--property-bulk-actions#refresh"
                                                                {% if isPending %}
                                                                    disabled
                                                                    title="Annonce en attente de validation : sélection impossible"
                                                                {% endif %}
                                                            >

                                                        </label>

                                                        <a
                                                            href="{{ path('app_public_detail_bien', {
                                                                slug: property.slug
                                                            }) }}"
                                                            class="property-listing-image"
                                                            aria-label="Voir le détail de {{ property.titreDuLogement ?: 'cette annonce' }}"
                                                        >

                                                            {% if uploadedImage %}
                                                                <img
                                                                    src="{{ uploadedImage }}"
                                                                    alt="{{ property.titreDuLogement ?: 'Annonce immobilière' }}"
                                                                >
                                                            {% else %}
                                                                <span class="property-listing-image-empty">
                                                                    <i class="icon-image-off"></i>
                                                                </span>
                                                            {% endif %}

                                                        </a>

                                                        <div class="property-listing-body">

                                                            <a
                                                                href="{{ path('app_public_detail_bien', {
                                                                    slug: property.slug
                                                                }) }}"
                                                                class="property-listing-title"
                                                            >
                                                                {{ property.titreDuLogement ?: 'Annonce sans titre' }}
                                                            </a>

                                                            <div class="property-listing-price-row">

                                                                {% if price %}
                                                                    <span class="property-listing-price">
                                                                        {{ price|number_format(0, ',', ' ') }}
                                                                        {{ property.user.devise.signe|default('€') }}
                                                                    </span>
                                                                {% endif %}

                                                                <span class="status-badge status-badge--{{ property.statut.value }}">
                                                                    {{ statusLabels[property.statut.value] ?? property.statut.label }}
                                                                </span>

                                                                {% if isBoosted %}
                                                                    <span class="status-badge status-badge--boosted">
                                                                        Boostée
                                                                    </span>
                                                                {% endif %}

                                                            </div>

                                                            <p class="property-listing-location">
                                                                <strong>
                                                                    {{ property.ville ?: 'Localisation non renseignée' }}{% if property.pays %}, {{ property.pays }}{% endif %}
                                                                </strong>
                                                                <span>
                                                                    &nbsp;-&nbsp;
                                                                    {%- if property.updatedAt -%}
                                                                        Modifiée le {{ property.updatedAt|date('d/m/Y') }}
                                                                    {%- else -%}
                                                                        Créée le {{ property.createdAt|date('d/m/Y') }}
                                                                    {%- endif -%}
                                                                </span>
                                                            </p>

                                                            <p class="property-listing-ref">
                                                                {{ property.referenceInterne ?: property.slug }}
                                                            </p>

                                                        </div>

                                                        <div class="property-listing-actions">

                                                            {% if property.statut.value in ['publiee', 'depubliee'] and not isBoosted %}
                                                                <button
                                                                    type="button"
                                                                    class="btn-booster"
                                                                    data-bs-toggle="modal"
                                                                    data-bs-target="#boostModal{{ property.id }}"
                                                                >
                                                                    <i class="icon-rocket"></i>
                                                                    Booster
                                                                </button>
                                                            {% endif %}

                                                            <a
                                                                href="{{ path('agence_immobiliere_mes_biens_edit', {
                                                                    id: property.id
                                                                }) }}"
                                                                class="row-icon-btn"
                                                                title="Modifier l’annonce"
                                                            >
                                                                <i class="icon-pencil"></i>
                                                            </a>

                                                            <div class="dropdown property-listing-menu">

                                                                <button
                                                                    type="button"
                                                                    class="row-icon-btn"
                                                                    data-bs-toggle="dropdown"
                                                                    aria-expanded="false"
                                                                    aria-label="Plus d’actions"
                                                                >
                                                                    <i class="icon-more-vertical"></i>
                                                                </button>

                                                                <div class="dropdown-menu dropdown-menu-end property-menu">

                                                                    {% if property.statut.value == 'publiee' %}
                                                                        <button
                                                                            type="submit"
                                                                            class="property-menu-item"
                                                                            formaction="{{ path('agence_immobiliere_mes_biens_pause', {
                                                                                id: property.id
                                                                            }) }}"
                                                                            formmethod="post"
                                                                            name="_property_token"
                                                                            value="{{ csrf_token('property_pause_' ~ property.id) }}"
                                                                        >
                                                                            <i class="icon-pause"></i>
                                                                            Mettre en pause
                                                                        </button>
                                                                    {% elseif property.statut.value == 'depubliee' %}
                                                                        <button
                                                                            type="submit"
                                                                            class="property-menu-item"
                                                                            formaction="{{ path('agence_immobiliere_mes_biens_reactivate', {
                                                                                id: property.id
                                                                            }) }}"
                                                                            formmethod="post"
                                                                            name="_property_token"
                                                                            value="{{ csrf_token('property_reactivate_' ~ property.id) }}"
                                                                        >
                                                                            <i class="icon-play"></i>
                                                                            Réactiver
                                                                        </button>
                                                                    {% endif %}

                                                                    <button
                                                                        type="submit"
                                                                        class="property-menu-item property-menu-item--danger"
                                                                        formaction="{{ path('agence_immobiliere_mes_biens_delete', {
                                                                            id: property.id
                                                                        }) }}"
                                                                        formmethod="post"
                                                                        name="_property_token"
                                                                        value="{{ csrf_token('property_delete_' ~ property.id) }}"
                                                                        onclick="return confirm('Supprimer cette annonce ?');"
                                                                    >
                                                                        <i class="icon-trash"></i>
                                                                        Supprimer
                                                                    </button>

                                                                </div>

                                                            </div>

                                                        </div>

                                                    </article>

                                                    {# ===========================================
                                                       MODAL DE CONFIRMATION DU BOOST
                                                       =========================================== #}
                                                    {% if property.statut.value in ['publiee', 'depubliee'] and not isBoosted %}
                                                        <div
                                                            class="modal fade boost-confirm-modal"
                                                            id="boostModal{{ property.id }}"
                                                            tabindex="-1"
                                                            aria-labelledby="boostModalLabel{{ property.id }}"
                                                            aria-hidden="true"
                                                        >
                                                            <div class="modal-dialog modal-dialog-centered">
                                                                <div class="modal-content boost-confirm-content">

                                                                    <div class="modal-header boost-confirm-header">
                                                                        <h2
                                                                            class="modal-title boost-confirm-title"
                                                                            id="boostModalLabel{{ property.id }}"
                                                                        >
                                                                            <i class="icon-rocket"></i>
                                                                            Booster cette annonce
                                                                        </h2>
                                                                        <button
                                                                            type="button"
                                                                            class="boost-confirm-close"
                                                                            data-bs-dismiss="modal"
                                                                            aria-label="Fermer"
                                                                        >
                                                                            <span aria-hidden="true">&times;</span>
                                                                        </button>
                                                                    </div>

                                                                    <div class="modal-body boost-confirm-body">

                                                                        <p class="boost-confirm-listing">
                                                                            {{ property.titreDuLogement ?: 'Annonce sans titre' }}
                                                                        </p>

                                                                        {% if boostPreview.available < 1 %}
                                                                            <p class="boost-confirm-empty">
                                                                                Vous n’avez plus de boost disponible.
                                                                                Achetez un pack boost pour mettre cette annonce en avant.
                                                                            </p>
                                                                        {% else %}
                                                                            <ul class="boost-confirm-details">
                                                                                <li>
                                                                                    <span>Boosts restants</span>
                                                                                    <strong>{{ boostPreview.available }}</strong>
                                                                                </li>
                                                                                <li>
                                                                                    <span>Durée de mise en avant</span>
                                                                                    <strong>
                                                                                        {{ boostPreview.durationDays }}
                                                                                        jour{{ boostPreview.durationDays > 1 ? 's' : '' }}
                                                                                    </strong>
                                                                                </li>
                                                                                <li>
                                                                                    <span>Boost décompté sur</span>
                                                                                    <strong>
                                                                                        {{ boostPreview.source == 'subscription'
                                                                                            ? 'votre forfait'
                                                                                            : 'vos boosts achetés' }}
                                                                                    </strong>
                                                                                </li>
                                                                            </ul>

                                                                            {% if property.statut.value == 'depubliee' %}
                                                                                <p class="boost-confirm-warning">
                                                                                    Cette annonce est en pause : elle sera
                                                                                    republiée automatiquement lors du boost.
                                                                                </p>
                                                                            {% endif %}

                                                                            <p class="boost-confirm-warning">
                                                                                Cette action est définitive : le boost sera activé
                                                                                immédiatement et décompté de votre solde.
                                                                            </p>
                                                                        {% endif %}

                                                                    </div>

                                                                    <div class="modal-footer boost-confirm-footer">

                                                                        <button
                                                                            type="button"
                                                                            class="boost-confirm-cancel"
                                                                            data-bs-dismiss="modal"
                                                                        >
                                                                            Annuler
                                                                        </button>

                                                                        {% if boostPreview.available >= 1 %}
                                                                            <button
                                                                                type="submit"
                                                                                class="boost-confirm-submit"
                                                                                formaction="{{ path('agence_immobiliere_mes_biens_boost', {
                                                                                    id: property.id
                                                                                }) }}"
                                                                                formmethod="post"
                                                                                name="_property_token"
                                                                                value="{{ csrf_token('property_boost_' ~ property.id) }}"
                                                                            >
                                                                                <i class="icon-rocket"></i>
                                                                                Confirmer le boost
                                                                            </button>
                                                                        {% else %}
                                                                            <a
                                                                                href="{{ path('agence_immobiliere_options') }}"
                                                                                class="boost-confirm-submit"
                                                                            >
                                                                                Voir les packs boost
                                                                            </a>
                                                                        {% endif %}

                                                                    </div>

                                                                </div>
                                                            </div>
                                                        </div>
                                                    {% endif %}

                                                {% endfor %}

                                            </div>

                                            {% if properties.pageCount > 1 %}
                                                <div class="mes-biens-pagination">
                                                    {{ knp_pagination_render(properties, 'pagination/agence_pagination.html.twig') }}
                                                </div>
                                            {% endif %}

                                        </section>

                                    {% endif %}

                                </form>

                            {% endif %}

                            {% if drafts is empty and not properties|length %}

                                <div class="property-empty">

                                    <i class="icon-building-2"></i>

                                    <h2>
                                        Vous n’avez pas encore de bien
                                    </h2>

                                    <p>
                                        Déposez votre première annonce pour la retrouver ici.
                                    </p>

                                </div>

                            {% endif %}

                        </div>

                    </div>
                </div>

            </div>

        </div>
    </div>

</main>

{% include 'composant/_search/_search.html.twig' with {
    formModal: filterForm,
    totalResults: properties.getTotalItemCount,
    filterCountUrl: path('agence_immobiliere_mes_biens_filters_count')
} %}

{% endblock %}
