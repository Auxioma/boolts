{% extends 'base.html.twig' %}

{% block title %}Mes biens immobiliers{% endblock %}

{% block body %}

<main id="dashboard" class="dashboard">

    <div class="container-fluid">
        <div class="row">

            {{ include('composant/__agence_immobiliere/_tableau_de_bord.html.twig') }}

            <div class="col-10 p-48 bg-white">

                <div class="row">
                    <div class="col-10 mx-auto">

                        <div class="agence-mes-biens-list">

                            <div class="mes-biens-immobilier">

                                <div class="d-flex justify-content-between align-items-start mb-32">

                                    <div>
                                        <h1>
                                            Mes biens
                                        </h1>

                                        <p class="description-page">
                                            Retrouvez ici toutes vos annonces immobilières.
                                        </p>
                                    </div>

                                    <a
                                        href="{{ path('agence_immobiliere_mes_biens') }}"
                                        class="btn-deposer-annonce"
                                    >
                                        <i class="icon-circle-plus"></i>
                                        Déposer une annonce
                                    </a>

                                </div>

                                <div class="property-tools mb-24">

                                    <form
                                        method="get"
                                        action="{{ path('agence_immobiliere_mes_biens_list') }}"
                                        class="property-search"
                                    >

                                        <button
                                            type="submit"
                                            class="property-search-submit"
                                            aria-label="Rechercher"
                                        >
                                            <i
                                                class="icon-search"
                                                aria-hidden="true"
                                            ></i>
                                        </button>

                                        <input
                                            type="search"
                                            name="search"
                                            value="{{ app.request.query.get('search') }}"
                                            placeholder="Rechercher un bien, une référence, une ville ou un pays"
                                            autocomplete="off"
                                        >

                                        {% if app.request.query.get('order') %}
                                            <input
                                                type="hidden"
                                                name="order"
                                                value="{{ app.request.query.get('order') }}"
                                            >
                                        {% endif %}

                                        {% if app.request.query.get('orderDirection') %}
                                            <input
                                                type="hidden"
                                                name="orderDirection"
                                                value="{{ app.request.query.get('orderDirection') }}"
                                            >
                                        {% endif %}

                                        {% for key, value in app.request.query.all('modal_filter') %}

                                            {% if value is iterable %}

                                                {% for childKey, childValue in value %}
                                                    <input
                                                        type="hidden"
                                                        name="modal_filter[{{ key }}][{{ childKey }}]"
                                                        value="{{ childValue }}"
                                                    >
                                                {% endfor %}

                                            {% else %}

                                                <input
                                                    type="hidden"
                                                    name="modal_filter[{{ key }}]"
                                                    value="{{ value }}"
                                                >

                                            {% endif %}

                                        {% endfor %}

                                    </form>

                                    <button
                                        type="button"
                                        class="btn-dashboard-filter"
                                        data-bs-toggle="modal"
                                        data-bs-target="#booltsFiltersModal"
                                    >
                                        <i class="icon-filter"></i>
                                        Filtres
                                    </button>

                                    <div class="property-sort">

                                        <button
                                            type="button"
                                            class="btn-dashboard-filter property-sort-trigger"
                                            aria-expanded="false"
                                        >
                                            <i class="icon-arrow-down-up"></i>
                                            Trier
                                        </button>

                                        <div class="property-sort-menu">

                                            <a
                                                href="{{ path(
                                                    'agence_immobiliere_mes_biens_list',
                                                    app.request.query.all|merge({
                                                        order: 'p.createdAt',
                                                        orderDirection: 'DESC',
                                                        page: 1
                                                    })
                                                ) }}"
                                                class="{{
                                                    app.request.query.get('order', 'p.createdAt') == 'p.createdAt'
                                                    and app.request.query.get('orderDirection', 'DESC') == 'DESC'
                                                        ? 'active'
                                                        : ''
                                                }}"
                                            >
                                                Date d’ajout (récent → ancien)
                                            </a>

                                            <a
                                                href="{{ path(
                                                    'agence_immobiliere_mes_biens_list',
                                                    app.request.query.all|merge({
                                                        order: 'p.createdAt',
                                                        orderDirection: 'ASC',
                                                        page: 1
                                                    })
                                                ) }}"
                                                class="{{
                                                    app.request.query.get('order') == 'p.createdAt'
                                                    and app.request.query.get('orderDirection') == 'ASC'
                                                        ? 'active'
                                                        : ''
                                                }}"
                                            >
                                                Date d’ajout (ancien → récent)
                                            </a>

                                            <a
                                                href="{{ path(
                                                    'agence_immobiliere_mes_biens_list',
                                                    app.request.query.all|merge({
                                                        order: 'p.views',
                                                        orderDirection: 'DESC',
                                                        page: 1
                                                    })
                                                ) }}"
                                                class="{{
                                                    app.request.query.get('order') == 'p.views'
                                                    and app.request.query.get('orderDirection') == 'DESC'
                                                        ? 'active'
                                                        : ''
                                                }}"
                                            >
                                                Vues (plus → moins)
                                            </a>

                                            <a
                                                href="{{ path(
                                                    'agence_immobiliere_mes_biens_list',
                                                    app.request.query.all|merge({
                                                        order: 'p.views',
                                                        orderDirection: 'ASC',
                                                        page: 1
                                                    })
                                                ) }}"
                                                class="{{
                                                    app.request.query.get('order') == 'p.views'
                                                    and app.request.query.get('orderDirection') == 'ASC'
                                                        ? 'active'
                                                        : ''
                                                }}"
                                            >
                                                Vues (moins → plus)
                                            </a>

                                            <a
                                                href="{{ path(
                                                    'agence_immobiliere_mes_biens_list',
                                                    app.request.query.all|merge({
                                                        order: 'favorisCount',
                                                        orderDirection: 'DESC',
                                                        page: 1
                                                    })
                                                ) }}"
                                                class="{{
                                                    app.request.query.get('order') == 'favorisCount'
                                                    and app.request.query.get('orderDirection') == 'DESC'
                                                        ? 'active'
                                                        : ''
                                                }}"
                                            >
                                                Favoris (plus → moins)
                                            </a>

                                            <a
                                                href="{{ path(
                                                    'agence_immobiliere_mes_biens_list',
                                                    app.request.query.all|merge({
                                                        order: 'favorisCount',
                                                        orderDirection: 'ASC',
                                                        page: 1
                                                    })
                                                ) }}"
                                                class="{{
                                                    app.request.query.get('order') == 'favorisCount'
                                                    and app.request.query.get('orderDirection') == 'ASC'
                                                        ? 'active'
                                                        : ''
                                                }}"
                                            >
                                                Favoris (moins → plus)
                                            </a>

                                        </div>

                                    </div>

                                </div>

                                <div class="property-count mb-24">
                                    {{ properties.getTotalItemCount }}
                                    bien{{ properties.getTotalItemCount > 1 ? 's' }}
                                </div>

                                {% if properties|length %}

                                    <form
                                        method="post"
                                        action="{{ path('agence_immobiliere_mes_biens_bulk_action') }}"
                                        data-controller="mes-biens--property-bulk-actions"
                                    >

                                        <input
                                            type="hidden"
                                            name="_token"
                                            value="{{ csrf_token('property_bulk_action') }}"
                                        >

                                        <input
                                            type="hidden"
                                            name="action"
                                            value=""
                                        >

                                        <div class="property-bulk-actions mb-24">

                                            <label class="select-all">

                                                <input
                                                    type="checkbox"
                                                    data-mes-biens--property-bulk-actions-target="selectAll"
                                                    data-action="change->mes-biens--property-bulk-actions#toggleAll"
                                                >

                                                Tout sélectionner

                                            </label>

                                            <span
                                                class="property-selection-count"
                                                data-mes-biens--property-bulk-actions-target="counter"
                                            ></span>

                                            <button
                                                type="button"
                                                disabled
                                                data-mes-biens--property-bulk-actions-target="action"
                                                data-action="click->mes-biens--property-bulk-actions#setAction"
                                                data-action-value="pause"
                                            >
                                                <i class="icon-pause"></i>
                                                Pause
                                            </button>

                                            <button
                                                type="button"
                                                disabled
                                                data-mes-biens--property-bulk-actions-target="action"
                                                data-action="click->mes-biens--property-bulk-actions#setAction"
                                                data-action-value="reactivate"
                                            >
                                                <i class="icon-play"></i>
                                                Réactiver
                                            </button>

                                            <button
                                                type="button"
                                                class="danger"
                                                disabled
                                                data-mes-biens--property-bulk-actions-target="action"
                                                data-action="click->mes-biens--property-bulk-actions#setAction"
                                                data-action-value="delete"
                                            >
                                                <i class="icon-trash"></i>
                                                Supprimer
                                            </button>

                                        </div>

                                        <div class="properties-list">

                                            {% for property in properties %}

                                                {% set firstImage = property.propertyImages|first %}

                                                {% set uploadedImage = firstImage
                                                    ? vich_uploader_asset(firstImage, 'imageFile')
                                                    : null
                                                %}

                                                <article class="property-row">

                                                    <a
                                                        href="{{ path('app_public_detail_bien', {
                                                            slug: property.slug
                                                        }) }}"
                                                        class="property-row-clickable"
                                                        aria-label="Voir le détail de {{ property.titreDuLogement ?: 'cette annonce' }}"
                                                    ></a>

                                                    <div class="property-checkbox">

                                                        <input
                                                            type="checkbox"
                                                            name="properties[]"
                                                            value="{{ property.id }}"
                                                            data-mes-biens--property-bulk-actions-target="checkbox"
                                                            data-action="change->mes-biens--property-bulk-actions#refresh"
                                                        >

                                                    </div>

                                                    <div class="property-row-image">

                                                        {% if uploadedImage %}

                                                            <img
                                                                src="{{ uploadedImage }}"
                                                                alt="{{ property.titreDuLogement ?: 'Annonce immobilière' }}"
                                                            >

                                                        {% else %}

                                                            <div class="property-image-empty">
                                                                <i class="icon-image-off"></i>
                                                            </div>

                                                        {% endif %}

                                                    </div>

                                                    <div class="property-row-content">

                                                        <div class="property-card-header">

                                                            <h2>
                                                                {{ property.titreDuLogement
                                                                    ?: 'Annonce sans titre'
                                                                }}
                                                            </h2>

                                                            <span class="property-status">
                                                                {{ property.statut.label }}
                                                            </span>

                                                        </div>

                                                        <p class="property-type">

                                                            {{ property.typeBien
                                                                ? property.typeBien.name
                                                                : 'Type non renseigné'
                                                            }}

                                                            {% if property.typeTransaction %}
                                                                · {{ property.typeTransaction.name }}
                                                            {% endif %}

                                                        </p>

                                                        <p class="property-location">

                                                            <i class="icon-map-pin"></i>

                                                            {{ property.ville
                                                                ?: 'Localisation non renseignée'
                                                            }}

                                                            {% if property.pays %}
                                                                , {{ property.pays }}
                                                            {% endif %}

                                                        </p>

                                                        <small>
                                                            Réf.
                                                            {{ property.referenceInterne ?: property.slug }}
                                                        </small>

                                                    </div>

                                                    <div class="property-row-actions">

                                                        <a
                                                            href="{{ path('agence_immobiliere_mes_biens_edit', {
                                                                id: property.id
                                                            }) }}"
                                                            title="Modifier l’annonce"
                                                            class="property-edit-link"
                                                        >
                                                            <i class="icon-pencil"></i>
                                                        </a>

                                                        {% if property.statut.value == 'publiee' %}

                                                            <button
                                                                type="submit"
                                                                title="Mettre en pause"
                                                                formaction="{{ path('agence_immobiliere_mes_biens_pause', {
                                                                    id: property.id
                                                                }) }}"
                                                                formmethod="post"
                                                                name="_property_token"
                                                                value="{{ csrf_token('property_pause_' ~ property.id) }}"
                                                            >
                                                                <i class="icon-pause"></i>
                                                            </button>

                                                        {% elseif property.statut.value == 'depubliee' %}

                                                            <button
                                                                type="submit"
                                                                title="Réactiver"
                                                                formaction="{{ path('agence_immobiliere_mes_biens_reactivate', {
                                                                    id: property.id
                                                                }) }}"
                                                                formmethod="post"
                                                                name="_property_token"
                                                                value="{{ csrf_token('property_reactivate_' ~ property.id) }}"
                                                            >
                                                                <i class="icon-play"></i>
                                                            </button>

                                                        {% endif %}

                                                        <button
                                                            type="submit"
                                                            title="Supprimer"
                                                            formaction="{{ path('agence_immobiliere_mes_biens_delete', {
                                                                id: property.id
                                                            }) }}"
                                                            formmethod="post"
                                                            name="_property_token"
                                                            value="{{ csrf_token('property_delete_' ~ property.id) }}"
                                                            onclick="return confirm('Supprimer cette annonce ?');"
                                                        >
                                                            <i class="icon-trash"></i>
                                                        </button>

                                                        <button
                                                            type="button"
                                                            title="Plus d’actions"
                                                        >
                                                            <i class="icon-more-vertical"></i>
                                                        </button>

                                                    </div>

                                                </article>

                                            {% endfor %}

                                        </div>

                                        {% if properties.pageCount > 1 %}

                                            <div class="property-pagination mt-32">
                                                {{ knp_pagination_render(properties) }}
                                            </div>

                                        {% endif %}

                                    </form>

                                {% else %}

                                    <div class="property-empty">

                                        <i class="icon-building-2"></i>

                                        <h2>
                                            Vous n’avez pas encore de bien
                                        </h2>

                                        <p>
                                            Déposez votre première annonce pour la retrouver ici.
                                        </p>

                                    </div>

                                {% endif %}

                            </div>

                        </div>

                    </div>
                </div>

            </div>

        </div>
    </div>

</main>

{% include 'composant/_search/_search.html.twig' with {
    formModal: filterForm,
    totalResults: properties.getTotalItemCount,
    filterCountUrl: path('agence_immobiliere_mes_biens_filters_count')
} %}

<script>
document.addEventListener('DOMContentLoaded', function () {
    const sort = document.querySelector('.property-sort');

    if (!sort) {
        return;
    }

    const trigger = sort.querySelector('.property-sort-trigger');
    const menu = sort.querySelector('.property-sort-menu');

    if (!trigger || !menu) {
        return;
    }

    trigger.addEventListener('click', function (event) {
        event.preventDefault();
        event.stopPropagation();

        const opened = sort.classList.toggle('is-open');

        trigger.setAttribute(
            'aria-expanded',
            opened ? 'true' : 'false'
        );
    });

    menu.addEventListener('click', function (event) {
        event.stopPropagation();
    });

    document.addEventListener('click', function (event) {
        if (sort.contains(event.target)) {
            return;
        }

        sort.classList.remove('is-open');
        trigger.setAttribute(
            'aria-expanded',
            'false'
        );
    });
});
</script>

{% endblock %}