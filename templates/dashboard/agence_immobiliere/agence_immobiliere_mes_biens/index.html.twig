{% extends 'base.html.twig' %}

{% block title %}Mes biens immobiliers{% endblock %}

{% block body %}
    <main id="dashboard" class="dashboard">
        <div class="container-fluid">
            <div class="row">

                {{ include('composant/__agence_immobiliere/_tableau_de_bord.html.twig') }}

                <div class="col-10 p-48">
                    <div class="row">
                        <div class="col-10 mx-auto">
                            <div class="row">

                                <div class="col-4 pr-24">
                                    {{ include('dashboard/agence_immobiliere/_partials/mes_biens/_partials/navbar.html.twig') }}
                                </div>

                                <div class="col-8">
                                    <div class="col-12">

                                        {{ form_start(form, {
                                            attr: {
                                                novalidate: 'novalidate',
                                                enctype: 'multipart/form-data',
                                                'data-turbo': 'false',
                                                'data-controller': 'mes-biens--submit'
                                            }
                                        }) }}

                                        {% if step == 1 %}
                                            {{ include('dashboard/agence_immobiliere/_partials/mes_biens/type-de-bien.html.twig') }}
                                        {% elseif step == 2 %}
                                            {{ include('dashboard/agence_immobiliere/_partials/mes_biens/type-de-transaction.html.twig') }}
                                        {% elseif step == 3 %}
                                            {{ include('dashboard/agence_immobiliere/_partials/mes_biens/informations-principales.html.twig') }}
                                        {% elseif step == 4 %}
                                            {{ include('dashboard/agence_immobiliere/_partials/mes_biens/caracteristiques.html.twig') }}
                                        {% elseif step == 5 %}
                                            {{ include('dashboard/agence_immobiliere/_partials/mes_biens/bilan-energetique.html.twig') }}
                                        {% elseif step == 6 %}
                                            {{ include('dashboard/agence_immobiliere/_partials/mes_biens/images.html.twig') }}
                                        {% elseif step == 7 %}
                                            {{ include('dashboard/agence_immobiliere/_partials/mes_biens/description.html.twig') }}
                                        {% elseif step == 8 %}
                                            {{ include('dashboard/agence_immobiliere/_partials/mes_biens/prix.html.twig') }}
                                        {% endif %}

                                        <div class="py-20 navigation-fixed">
                                            {% if step > 1 %}
                                                <a
                                                    href="{{ path('agence_immobiliere_mes_biens', { step: step - 1 }) }}"
                                                    class="btn-retour py-10 px-16 mr-12 js-navigation-retour"
                                                >
                                                    Retour
                                                </a>
                                            {% else %}
                                                <a
                                                    href="#"
                                                    class="btn-retour py-10 px-16 mr-12 js-navigation-retour is-first-page"
                                                >
                                                    Retour
                                                </a>
                                            {% endif %}

                                            {{ form_widget(form.submit) }}
                                        </div>

                                        {{ form_end(form) }}

                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </main>

    <style>
        .btn-suivant:disabled,
        .btn-suivant.is-disabled {
            border-radius: 50px;
            border: 2px solid #EBECEC;
            background: #FFF;
            color: #858789;
            font-size: 16px;
            font-style: normal;
            font-weight: 700;
            line-height: 20px;
        }
    </style>

{% endblock %}

{% block js %}
    {{ parent() }}

    <script>
        /*
        |--------------------------------------------------------------------------
        | Gestion du stepper vertical
        |--------------------------------------------------------------------------
        */
        document.addEventListener('DOMContentLoaded', function () {
            const links = document.querySelectorAll('.js-stepper-link');
            const line = document.querySelector('.mes-bien-stepper-line');

            if (!links.length || !line) {
                return;
            }

            function updateLine(activeElement) {
                const currentIndex = [...links].indexOf(activeElement);

                if (currentIndex <= 0) {
                    line.style.height = '0px';
                    line.style.display = 'none';
                    return;
                }

                line.style.display = 'block';

                const totalSteps = links.length - 1;
                const percentage = currentIndex / totalSteps;

                const firstStep = links[0];
                const lastStep = links[links.length - 1];

                const firstTop = firstStep.offsetTop;
                const lastTop = lastStep.offsetTop;

                const totalHeight = lastTop - firstTop;

                line.style.height = (totalHeight * percentage) + 'px';
            }

            const activeStep = document.querySelector('.mes-bien-stepper-item-active');

            if (activeStep) {
                updateLine(activeStep);
            }
        });
    </script>
{% endblock %}
