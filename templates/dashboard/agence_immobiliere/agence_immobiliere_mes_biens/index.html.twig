{#
 Template: templates/dashboard/agence_immobiliere/agence_immobiliere_mes_biens/index.html.twig
 Role: Renders the dashboard/agence_immobiliere/agence_immobiliere_mes_biens Twig view.
 Context: Provided by the rendering controller, parent template, or including template.
 Maintenance: Preserve blocks, includes, macros, and data attributes used by this view.
#}

{% extends 'base.html.twig' %}

{% block title %}Mes biens immobiliers{% endblock %}

{% block body %}
    <main id="dashboard" class="dashboard">
        <div class="container-fluid">
            <div class="row">

                {{ include('composant/__agence_immobiliere/_tableau_de_bord.html.twig') }}

                <div class="col-10 p-48 bg-white">
                    <div class="row">
                        <div class="col-10 mx-auto">
                            <div class="row">

                                <div class="col-4 pr-24">
                                    {{ include('dashboard/agence_immobiliere/_partials/mes_biens/_partials/navbar.html.twig') }}
                                </div>

                                <div class="col-8">
                                    <div class="col-12">

                                        {{ form_start(form, {
                                            attr: {
                                                novalidate: 'novalidate',
                                                enctype: 'multipart/form-data',
                                                'data-turbo': 'false',
                                                'data-controller': 'mes-biens--submit',
                                            },
                                        }) }}

                                        {% if step == 1 %}
                                            {{ include('dashboard/agence_immobiliere/_partials/mes_biens/type-de-bien.html.twig') }}
                                        {% elseif step == 2 %}
                                            {{ include('dashboard/agence_immobiliere/_partials/mes_biens/type-de-transaction.html.twig') }}
                                        {% elseif step == 3 %}
                                            {{ include('dashboard/agence_immobiliere/_partials/mes_biens/informations-principales.html.twig') }}
                                        {% elseif step == 4 %}
                                            {{ include('dashboard/agence_immobiliere/_partials/mes_biens/caracteristiques.html.twig') }}
                                        {% elseif step == 5 %}
                                            {{ include('dashboard/agence_immobiliere/_partials/mes_biens/bilan-energetique.html.twig') }}
                                        {% elseif step == 6 %}
                                            {{ include('dashboard/agence_immobiliere/_partials/mes_biens/images.html.twig') }}
                                        {% elseif step == 7 %}
                                            {{ include('dashboard/agence_immobiliere/_partials/mes_biens/description.html.twig') }}
                                        {% elseif step == 8 %}
                                            {{ include('dashboard/agence_immobiliere/_partials/mes_biens/prix.html.twig') }}
                                        {% endif %}

                                        <div class="py-20 navigation-fixed">
                                            {% if step > 1 %}
                                                {% set previousStep = step - 1 %}

                                                {#
                                                    Pour un bien hors France, l'étape 5 n'existe pas.
                                                    Le retour depuis les photos doit donc revenir à l'étape 4.
                                                #}
                                                {% if step == 6 and not showBilanEnergetique|default(false) %}
                                                    {% set previousStep = 4 %}
                                                {% endif %}

                                                {% set previousParams = {
                                                    step: previousStep,
                                                } %}

                                                {% if typeTransactionId is defined and typeTransactionId %}
                                                    {% set previousParams = previousParams|merge({
                                                        typeTransaction: typeTransactionId,
                                                    }) %}
                                                {% endif %}

                                                <a
                                                    href="{{ path('agence_immobiliere_mes_biens', previousParams) }}"
                                                    class="btn-retour py-10 px-16 mr-12 js-navigation-retour"
                                                >
                                                    Retour
                                                </a>
                                            {% else %}
                                                <a
                                                    href="#"
                                                    class="btn-retour py-10 px-16 mr-12 js-navigation-retour is-first-page"
                                                >
                                                    Retour
                                                </a>
                                            {% endif %}

                                            {{ form_widget(form.submit) }}
                                        </div>

                                        {{ form_end(form) }}

                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

                <div class="boolts-limit-modal__backdrop" aria-hidden="true"></div>

                <div
                    id="limitAnnonceModal"
                    class="boolts-limit-modal"
                    role="dialog"
                    aria-modal="true"
                    aria-labelledby="limitAnnonceModalTitle"
                    aria-describedby="limitAnnonceModalDescription"
                >
                    <div class="boolts-limit-modal__content">
                        <div class="boolts-limit-modal__text">
                            <h2 id="limitAnnonceModalTitle" class="boolts-limit-modal__title">
                                Vous avez atteint la limite<br>
                                de dépôt d’annonces
                            </h2>

                            <p id="limitAnnonceModalDescription" class="boolts-limit-modal__description">
                                Vous avez atteint la limite de dépôt d’annonce que permet votre plan gratuit.
                                Pour pouvoir publier d’avantage d’annonces sur Boolts rendez-vous sur nos offres d’abonnements.
                            </p>
                        </div>

                        <a
                            href="{{ abonnementUrl|default('#') }}"
                            class="boolts-limit-modal__button"
                        >
                            Voir les abonnements
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </main>

    <style>
        .btn-suivant:disabled,
        .btn-suivant.is-disabled {
            border-radius: 50px;
            border: 2px solid #EBECEC;
            background: #FFF;
            color: #858789;
            font-size: 16px;
            font-style: normal;
            font-weight: 700;
            line-height: 20px;
        }


        /* Modal Figma - node 5400:14709 */
        .boolts-limit-modal__backdrop {
            position: fixed;
            z-index: 1050;
            top: 75px;
            right: 0;
            bottom: 85px;
            left: 16.666667%;
            background: rgba(255, 255, 255, 0.22);
            -webkit-backdrop-filter: blur(12px);
            backdrop-filter: blur(12px);
        }

        .boolts-limit-modal {
            position: fixed;
            z-index: 1055;
            top: calc(50% - 55px);
            left: 58.333333%;
            transform: translate(-50%, -50%);
            width: 549px;
            max-width: calc(100vw - 48px);
            background: #FFF;
            border-radius: 24px;
            box-shadow: 0 4px 12.05px rgba(0, 0, 0, 0.16);
        }

        .boolts-limit-modal__content {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 24px;
            padding: 24px;
        }

        .boolts-limit-modal__text {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
            width: 100%;
            text-align: center;
        }

        .boolts-limit-modal__title {
            width: 100%;
            margin: 0;
            color: #0B0F14;
            font-family: 'Eudoxus Sans', sans-serif;
            font-size: 30px;
            font-style: normal;
            font-weight: 700;
            line-height: 34px;
        }

        .boolts-limit-modal__description {
            width: 100%;
            margin: 0;
            color: #858789;
            font-family: 'Eudoxus Sans', sans-serif;
            font-size: 14px;
            font-style: normal;
            font-weight: 500;
            line-height: 20px;
        }

        .boolts-limit-modal__button {
            display: inline-flex;
            height: 44px;
            align-items: center;
            justify-content: center;
            padding: 10px 16px;
            border-radius: 50px;
            background: #5D00FF;
            color: #FFF;
            font-family: 'Eudoxus Sans', sans-serif;
            font-size: 16px;
            font-style: normal;
            font-weight: 700;
            line-height: 20px;
            text-decoration: none;
            white-space: nowrap;
        }

        .boolts-limit-modal__button:hover,
        .boolts-limit-modal__button:focus-visible {
            color: #FFF;
            text-decoration: none;
        }

        @media (max-width: 991.98px) {
            .boolts-limit-modal__backdrop {
                top: 0;
                bottom: 0;
                left: 0;
            }

            .boolts-limit-modal {
                left: 50%;
                width: calc(100vw - 32px);
                max-width: 549px;
            }

            .boolts-limit-modal__title {
                font-size: 26px;
                line-height: 30px;
            }
        }
    </style>

{% endblock %}
