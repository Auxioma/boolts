{#
 Template: templates/emails/subscription/subscription_cancel_requested.html.twig
 Role: Confirmation envoyée immédiatement à l'agence lorsqu'elle clique sur « Résilier mon abonnement ».
 Context: App\MessageHandler\Billing\SendSubscriptionEmailMessageHandler + contexte du SubscriptionEmailLog.
 Maintenance: le contenu s'adapte au forfait en cours et à la date d'effet (fin de la période déjà payée).
#}

<p>{{ 'email.common.hello'|trans }}</p>

<p>
    {% if plan_name is defined and plan_name %}
        {{ 'email.subscription.cancel.intro_plan'|trans({'%plan%': '<strong>' ~ plan_name|e ~ '</strong>'})|raw }}
    {% elseif plan is defined and plan %}
        {{ 'email.subscription.cancel.intro_plan'|trans({'%plan%': '<strong>' ~ plan|upper|e ~ '</strong>'})|raw }}
    {% else %}
        {{ 'email.subscription.cancel.intro'|trans }}
    {% endif %}
</p>

<p>
    {% if effective_at is defined and effective_at %}
        {{ 'email.subscription.cancel.not_immediate_on'|trans({'%date%': '<strong>' ~ effective_at|date('d/m/Y') ~ '</strong>'})|raw }}
    {% else %}
        {{ 'email.subscription.cancel.not_immediate'|trans|raw }}
    {% endif %}
</p>

<table role="presentation" cellpadding="6" cellspacing="0" border="0">
    <tr>
        <td><strong>{{ 'email.subscription.label.cancelled_plan'|trans }}</strong></td>
        <td>{{ plan_name|default(plan|default('email.subscription.paid'|trans)|upper) }}</td>
    </tr>
    {% if cancel_requested_at is defined and cancel_requested_at %}
    <tr>
        <td><strong>{{ 'email.subscription.label.requested_at'|trans }}</strong></td>
        <td>{{ cancel_requested_at|date('d/m/Y') }}</td>
    </tr>
    {% endif %}
    <tr>
        <td><strong>{{ 'email.subscription.label.ends_at'|trans }}</strong></td>
        <td>
            {% if effective_at is defined and effective_at %}
                {{ effective_at|date('d/m/Y') }}
            {% else %}
                {{ 'email.subscription.end_of_period'|trans }}
            {% endif %}
        </td>
    </tr>
</table>

<p>
    {{ 'email.subscription.cancel.undo_intro'|trans }}
    <a href="{{ portal_url }}">{{ 'email.subscription.manage_link'|trans }}</a>
</p>

<p>{{ 'email.common.signature'|trans|raw }}</p>
