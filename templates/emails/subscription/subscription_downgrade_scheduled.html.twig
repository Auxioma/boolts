{#
 Template: templates/emails/subscription/subscription_downgrade_scheduled.html.twig
 Role: Récapitulatif envoyé à l'agence quand un passage à un forfait d'un montant inférieur est programmé (effet différé en fin de période).
 Context: App\MessageHandler\Billing\SendSubscriptionEmailMessageHandler + contexte du SubscriptionEmailLog.
 Maintenance: le contenu s'adapte à l'ancien et au nouveau forfait, à la périodicité et à la date d'effet.
#}

<p>{{ 'email.common.hello'|trans }}</p>

<p>
    {% if previous_plan_name is defined and previous_plan_name %}
        {{ 'email.subscription.downgrade.intro_from'|trans({'%previous%': '<strong>' ~ previous_plan_name|e ~ '</strong>', '%plan%': '<strong>' ~ plan_name|default('Boolts')|e ~ '</strong>', '%period%': (billing_period == 'annual' ? 'email.subscription.period.annual' : 'email.subscription.period.monthly')|trans})|raw }}
    {% else %}
        {{ 'email.subscription.downgrade.intro'|trans({'%plan%': '<strong>' ~ plan_name|default('Boolts')|e ~ '</strong>', '%period%': (billing_period == 'annual' ? 'email.subscription.period.annual' : 'email.subscription.period.monthly')|trans})|raw }}
    {% endif %}
</p>

<p>
    {% if effective_at is defined and effective_at %}
        {{ 'email.subscription.downgrade.not_immediate_on'|trans({'%date%': '<strong>' ~ effective_at|date('d/m/Y') ~ '</strong>'})|raw }}
    {% else %}
        {{ 'email.subscription.downgrade.not_immediate'|trans|raw }}
    {% endif %}
</p>

<table role="presentation" cellpadding="6" cellspacing="0" border="0">
    {% if previous_plan_name is defined and previous_plan_name %}
    <tr>
        <td><strong>{{ 'email.subscription.label.current_plan'|trans }}</strong></td>
        <td>
            {{ previous_plan_name }}
            {% if previous_amount_minor is defined and previous_amount_minor is not null %}
                ({{ previous_amount_minor|minor_amount(currency_name|default(null)) }} {{ currency_sign|default('') }})
            {% endif %}
        </td>
    </tr>
    {% endif %}
    <tr>
        <td><strong>{{ 'email.subscription.label.new_plan'|trans }}</strong></td>
        <td>{{ plan_name|default('Boolts') }}</td>
    </tr>
    <tr>
        <td><strong>{{ 'email.subscription.label.period'|trans }}</strong></td>
        <td>{{ (billing_period == 'annual' ? 'email.subscription.period.annual_cap' : 'email.subscription.period.monthly_cap')|trans }}</td>
    </tr>
    {% if amount_minor is defined and amount_minor is not null %}
    <tr>
        <td><strong>{{ 'email.subscription.label.new_amount'|trans }}</strong></td>
        <td>
            {{ amount_minor|minor_amount(currency_name|default(null)) }} {{ currency_sign|default('') }}
            {{ (billing_period == 'annual' ? 'email.subscription.per_year' : 'email.subscription.per_month')|trans }}
        </td>
    </tr>
    {% endif %}
    <tr>
        <td><strong>{{ 'email.subscription.label.effective'|trans }}</strong></td>
        <td>
            {% if effective_at is defined and effective_at %}
                {{ effective_at|date('d/m/Y') }}
            {% else %}
                {{ 'email.subscription.end_of_period'|trans }}
            {% endif %}
        </td>
    </tr>
    {% if property_limit is defined and property_limit is not null %}
    <tr>
        <td><strong>{{ 'email.subscription.label.property_limit_effective'|trans }}</strong></td>
        <td>{{ property_limit }}</td>
    </tr>
    {% endif %}
    {% if included_boosts is defined and included_boosts is not null %}
    <tr>
        <td><strong>{{ 'email.subscription.label.included_boosts_effective'|trans }}</strong></td>
        <td>{{ included_boosts }}</td>
    </tr>
    {% endif %}
</table>

<p>
    {{ 'email.subscription.downgrade.cancel_intro'|trans }}
    <a href="{{ portal_url }}">{{ 'email.subscription.manage_link'|trans }}</a>
</p>

<p>{{ 'email.common.signature'|trans|raw }}</p>
